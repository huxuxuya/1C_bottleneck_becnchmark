#Область ПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("Файловая проба 042")
		.ДобавитьСерверныйТест("Тест_Проба042ФайловыйВводВывод");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_Проба042ФайловыйВводВывод() Экспорт

	ИдентификаторПрогона = Строка(Новый УникальныйИдентификатор);
	ОчиститьРезультатыПроба042(ИдентификаторПрогона);

	Попытка
		Итог = БенчмаркПроба042Хранилище.ВыполнитьПрогон(ИдентификаторПрогона);
		Точки = БенчмаркПроба042Хранилище.ПолучитьТочкиПрогона(ИдентификаторПрогона);
		Сравнение = БенчмаркПроба042Хранилище.СравнитьПрогоны(
			ИдентификаторПрогона, ИдентификаторПрогона);

		ЮТест.ОжидаетЧто(Итог.КоличествоТочек).Равно(6);
		ЮТест.ОжидаетЧто(Итог.КоличествоОшибок).Равно(0);
		ЮТест.ОжидаетЧто(Итог.ОшибкаОчистки).Равно("");
		ЮТест.ОжидаетЧто(Точки.Количество()).Равно(6);
		ЮТест.ОжидаетЧто(Сравнение.Количество()).Равно(6);
		Для Каждого ТочкаСравнения Из Сравнение Цикл
			ЮТест.ОжидаетЧто(ТочкаСравнения.СтатусA).Равно("успешно");
			ЮТест.ОжидаетЧто(ТочкаСравнения.СтатусB).Равно("успешно");
			ЮТест.ОжидаетЧто(ТочкаСравнения.ИзменениеПроцентов).Равно(0);
		КонецЦикла;

		КоличествоЗаписей = 0;
		КоличествоЧтений = 0;
		ПутиПоПовторам = Новый Соответствие;
		Для Каждого Точка Из Точки Цикл
			ЮТест.ОжидаетЧто(Точка.Статус).Равно("успешно");
			ЮТест.ОжидаетЧто(Точка.ОбъемБайт).Равно(67108864);
			ЮТест.ОжидаетЧто(Точка.ДлительностьМс).Больше(0);
			ЮТест.ОжидаетЧто(Точка.МиБайтВСекунду).Больше(0);
			ЮТест.ОжидаетЧто(Точка.КонтрольнаяСумма).Больше(0);

			КлючПовтора = Строка(Точка.НомерПовтора);
			Если ПутиПоПовторам.Получить(КлючПовтора) <> Неопределено Тогда
				ЮТест.ОжидаетЧто(Точка.ПутьФайла).Равно(ПутиПоПовторам.Получить(КлючПовтора));
			Иначе
				ПутиПоПовторам.Вставить(КлючПовтора, Точка.ПутьФайла);
			КонецЕсли;

			Если Точка.Операция = "write" Тогда
				КоличествоЗаписей = КоличествоЗаписей + 1;
			ИначеЕсли Точка.Операция = "read" Тогда
				КоличествоЧтений = КоличествоЧтений + 1;
			Иначе
				ВызватьИсключение "Проба вернула неизвестную файловую операцию";
			КонецЕсли;
		КонецЦикла;

		ЮТест.ОжидаетЧто(КоличествоЗаписей).Равно(3);
		ЮТест.ОжидаетЧто(КоличествоЧтений).Равно(3);
		ЮТест.ОжидаетЧто(ПутиПоПовторам.Количество()).Равно(3);
	Исключение
		ОшибкаТеста = ОписаниеОшибки();
		ОчиститьРезультатыПроба042(ИдентификаторПрогона);
		ВызватьИсключение ОшибкаТеста;
	КонецПопытки;

	ОчиститьРезультатыПроба042(ИдентификаторПрогона);

КонецПроцедуры

Процедура ОчиститьРезультатыПроба042(Знач ИдентификаторПрогона)

	НаборЗаписей = РегистрыСведений.РезультатыФайловойПроб042.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторПрогона.Установить(ИдентификаторПрогона);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();

КонецПроцедуры

#КонецОбласти
