		Параметры + "; path=" + ПутьФайла + "; " + Результат.Комментарий,
		Ряд, "сервер 1С", "BSL FileStream", "временный файл", 1,
		НомерПовтора, 1, "измерение", 1, Результат.ОбъемБайт, 1);
	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
