// Модульные тесты ядра, генератора данных и проб бенчмарка для фреймворка YAxUnit.

#Область ПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("Ядро бенчмарка")
		.ДобавитьСерверныйТест("Тест_ВыполнитьТестовыйРасчет_КорректнаяСумма")
		.ДобавитьСерверныйТест("Тест_ВыполнитьТестовыйРасчет_НулевыеИтерации")
		.ДобавитьСерверныйТест("Тест_ВыполнитьТестовыйРасчет_ОтрицательныеИтерацииИсключение");

	ЮТТесты.ДобавитьТестовыйНабор("Пробы и генератор бенчмарка")
		.ДобавитьСерверныйТест("Тест_Проба001_СкоростьОдногоЯдра")
		.ДобавитьСерверныйТест("Тест_ПробаОдинПотокBSL_ДетерминированныйРезультат")
		.ДобавитьСерверныйТест("Тест_ПробаРабочийНаборКоллекции_КорректныеМетрики")
		.ДобавитьСерверныйТест("Тест_ГенераторИПроведениеДокумента_ДвиженияИОчистка")
		.ДобавитьСерверныйТест("Тест_ПробыЗапросовБД_ТочечныйИГруппировка")
		.ДобавитьСерверныйТест("Тест_ПробаФиксацияТранзакции_ПакетИРаздельно")
		.ДобавитьСерверныйТест("Тест_Раннер_ОценкаПоказателяИБаллы")
		.ДобавитьСерверныйТест("Тест_Раннер_ПолныйПрогонСЗаписьюВРегистр");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_ВыполнитьТестовыйРасчет_КорректнаяСумма() Экспорт

	Результат = БенчмаркЯдро.ВыполнитьТестовыйРасчет(10);

	// Сумма (1*31 + 2*31 + ... + 10*31) = 31 * 55 = 1705 (все значения < 997)
	ЮТест.ОжидаетЧто(Результат.Сумма).Равно(1705);
	ЮТест.ОжидаетЧто(Результат.ДлительностьМс).БольшеИлиРавно(0);

КонецПроцедуры

Процедура Тест_ВыполнитьТестовыйРасчет_НулевыеИтерации() Экспорт

	Результат = БенчмаркЯдро.ВыполнитьТестовыйРасчет(0);

	ЮТест.ОжидаетЧто(Результат.Сумма).Равно(0);

КонецПроцедуры

Процедура Тест_ВыполнитьТестовыйРасчет_ОтрицательныеИтерацииИсключение() Экспорт

	ИсключениеВыброшено = Ложь;
	ТекстОшибки = "";
	Попытка
		БенчмаркЯдро.ВыполнитьТестовыйРасчет(-1);
	Исключение
		ИсключениеВыброшено = Истина;
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);
	ЮТест.ОжидаетЧто(ТекстОшибки).Содержит("Число итераций не может быть отрицательным");

КонецПроцедуры

Процедура Тест_Проба001_СкоростьОдногоЯдра() Экспорт

	Результат = БенчмаркПробы.Проба001_СкоростьОдногоЯдра(1, 3, 2000, Неопределено);
	Эталон = БенчмаркПробы.ПробаОдинПотокBSL(2000);

	ЮТест.ОжидаетЧто(Результат.КонтрольнаяСумма).Равно(Эталон.КонтрольнаяСумма);
	ЮТест.ОжидаетЧто(Результат.ДлительностиМс.Количество()).Равно(3);
	ЮТест.ОжидаетЧто(Результат.МинМс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.МедианаМс).БольшеИлиРавно(Результат.МинМс);
	ЮТест.ОжидаетЧто(Результат.МаксМс).БольшеИлиРавно(Результат.МедианаМс);
	ЮТест.ОжидаетЧто(Результат.НсНаИтерацию).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.ЭквивалентЭталонаМГц = Неопределено).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.РасчетнаяЧастотаМГц = Неопределено).Равно(Истина);

	СКалибровкой = БенчмаркПробы.Проба001_СкоростьОдногоЯдра(1, 2, 100000, 250, Истина);
	ЮТест.ОжидаетЧто(СКалибровкой.МедианаМс).Равно((СКалибровкой.МинМс + СКалибровкой.МаксМс) / 2);
	ЮТест.ОжидаетЧто(СКалибровкой.ИтерацийВСерии).БольшеИлиРавно(100000);
	Если СКалибровкой.МедианаМс >= 10 Тогда
		ЮТест.ОжидаетЧто(СКалибровкой.МлнИтерацийВСекунду).Равно(
			СКалибровкой.ИтерацийВСерии / (1000 * СКалибровкой.МедианаМс));
		ЮТест.ОжидаетЧто(СКалибровкой.ЭквивалентЭталонаМГц).Равно(Окр(750000 / СКалибровкой.НсНаИтерацию, 0));
	Иначе
		ЮТест.ОжидаетЧто(СКалибровкой.ЭквивалентЭталонаМГц = Неопределено).Равно(Истина);
	КонецЕсли;

КонецПроцедуры

Процедура Тест_ПробаОдинПотокBSL_ДетерминированныйРезультат() Экспорт

	ПервыйЗапуск = БенчмаркПробы.ПробаОдинПотокBSL(500);
	ВторойЗапуск = БенчмаркПробы.ПробаОдинПотокBSL(500);

	ЮТест.ОжидаетЧто(ПервыйЗапуск.КонтрольнаяСумма).Равно(ВторойЗапуск.КонтрольнаяСумма);
	ЮТест.ОжидаетЧто(ПервыйЗапуск.ЧислоИтераций).Равно(500);
	ЮТест.ОжидаетЧто(ПервыйЗапуск.ДлительностьМс).БольшеИлиРавно(0);

КонецПроцедуры

Процедура Тест_ПробаРабочийНаборКоллекции_КорректныеМетрики() Экспорт

	Результат = БенчмаркПробы.ПробаРабочийНаборКоллекции(200, 50);

	ЮТест.ОжидаетЧто(Результат.КонтрольнаяСумма).Больше(0);
	ЮТест.ОжидаетЧто(Результат.ВремяСозданияМс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.ВремяОбходаМс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.ВремяПоискаМс).БольшеИлиРавно(0);

КонецПроцедуры

Процедура Тест_ГенераторИПроведениеДокумента_ДвиженияИОчистка() Экспорт

	ИдентификаторСерии = "ЮТ_ПРОВЕДЕНИЕ_01";
	БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);

	СправочникиБазы = БенчмаркГенераторДанных.ОбеспечитьСправочники(5, 2, "ЮТ");

	Параметры = Новый Структура;
	Параметры.Вставить("Товары", СправочникиБазы.Товары);
	Параметры.Вставить("Склад", СправочникиБазы.Склады[0]);
	Параметры.Вставить("ЧислоСтрок", 20);
	Параметры.Вставить("РежимРаспределения", "Равномерно");
	Параметры.Вставить("ИдентификаторСерии", ИдентификаторСерии);
	Параметры.Вставить("Проводить", Ложь);

	Создано = БенчмаркГенераторДанных.СоздатьДокументДвижения(Параметры);
	Проведение = БенчмаркПробы.ПробаПроведениеДокумента(Создано.Ссылка);

	ЮТест.ОжидаетЧто(Проведение.КоличествоДвижений).Равно(20);
	ЮТест.ОжидаетЧто(Проведение.СуммаКоличество).Равно(Создано.СуммаКоличество);

	Удалено = БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);
	ЮТест.ОжидаетЧто(Удалено).Равно(1);

КонецПроцедуры

Процедура Тест_ПробыЗапросовБД_ТочечныйИГруппировка() Экспорт

	ИдентификаторСерии = "ЮТ_ЗАПРОСЫ_01";
	БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);

	СправочникиБазы = БенчмаркГенераторДанных.ОбеспечитьСправочники(4, 1, "ЮТЗ");

	Точечный = БенчмаркПробы.ПробаТочечныйЗапросПоИндексу(СправочникиБазы.Товары, 8);
	ЮТест.ОжидаетЧто(Точечный.НайденоСтрок).Равно(8);
	ЮТест.ОжидаетЧто(Точечный.КонтрольнаяСумма).Больше(0);

	Параметры = Новый Структура;
	Параметры.Вставить("Товары", СправочникиБазы.Товары);
	Параметры.Вставить("Склад", СправочникиБазы.Склады[0]);
	Параметры.Вставить("ЧислоСтрок", 8);
	Параметры.Вставить("ИдентификаторСерии", ИдентификаторСерии);

	Создано = БенчмаркГенераторДанных.СоздатьДокументДвижения(Параметры);
	Выборка = БенчмаркПробы.ПробаВыборкаСоединениеСортировка(ИдентификаторСерии);

	ЮТест.ОжидаетЧто(Выборка.КоличествоСтрок).Равно(4);
	ЮТест.ОжидаетЧто(Выборка.ИтогоКоличество).Равно(Создано.СуммаКоличество);
	ЮТест.ОжидаетЧто(Выборка.ИтогоСумма).Равно(Создано.СуммаВсего);

	БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);

КонецПроцедуры

Процедура Тест_ПробаФиксацияТранзакции_ПакетИРаздельно() Экспорт

	ИдентификаторСерии = "ЮТ_ТРАНЗ_01";
	БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);

	СправочникиБазы = БенчмаркГенераторДанных.ОбеспечитьСправочники(3, 1, "ЮТТ");

	Раздельно = БенчмаркПробы.ПробаФиксацияТранзакции(
		СправочникиБазы.Товары, СправочникиБазы.Склады[0], 3, Ложь, ИдентификаторСерии
	);
	Пакетно = БенчмаркПробы.ПробаФиксацияТранзакции(
		СправочникиБазы.Товары, СправочникиБазы.Склады[0], 3, Истина, ИдентификаторСерии
	);

	ЮТест.ОжидаетЧто(Раздельно.ЧислоЗаписей).Равно(3);
	ЮТест.ОжидаетЧто(Пакетно.ЧислоЗаписей).Равно(3);
	ЮТест.ОжидаетЧто(Раздельно.КонтрольнаяСумма).Равно(Пакетно.КонтрольнаяСумма);

	Удалено = БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);
	ЮТест.ОжидаетЧто(Удалено).Равно(6);

КонецПроцедуры

Процедура Тест_Раннер_ОценкаПоказателяИБаллы() Экспорт

	Отлично = БенчмаркРаннер.ОценитьПоказатель(50, 100);
	ЮТест.ОжидаетЧто(Отлично.Баллы).Равно(100);
	ЮТест.ОжидаетЧто(Отлично.Статус).Равно("ОК");

	Замедление = БенчмаркРаннер.ОценитьПоказатель(200, 100);
	ЮТест.ОжидаетЧто(Замедление.Баллы).Равно(50);
	ЮТест.ОжидаетЧто(Замедление.Статус).Равно("Замедление");

	УзкоеМесто = БенчмаркРаннер.ОценитьПоказатель(500, 100);
	ЮТест.ОжидаетЧто(УзкоеМесто.Баллы).Равно(20);
	ЮТест.ОжидаетЧто(УзкоеМесто.Статус).Равно("УзкоеМесто");

КонецПроцедуры

Процедура Тест_Раннер_ПолныйПрогонСЗаписьюВРегистр() Экспорт

	ИдентификаторПрогона = "ЮТ_ПРОГОН_01";
	БенчмаркРаннер.ОчиститьРезультатыПрогона(ИдентификаторПрогона);

	Итог = Обработки.ЗапускБенчмарка.ВыполнитьПрогон(ИдентификаторПрогона, 0.05);
	Записи = БенчмаркРаннер.ПолучитьРезультатыПрогона(ИдентификаторПрогона);

	ЮТест.ОжидаетЧто(Итог.Результаты.Количество()).Равно(8);
	ЮТест.ОжидаетЧто(Записи.Количество()).Равно(8);
	Фиксированный = Записи.Найти("091", "КодПробы");
	Адаптивный = Записи.Найти("026", "КодПробы");
	ЮТест.ОжидаетЧто(СтрНайти(Фиксированный.Детали, " усл. МГц BSL;") > 1 Или СтрНайти(Фиксированный.Детали, "серия короче") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(Фиксированный.Статус).Равно("Справочно");
	ЮТест.ОжидаетЧто(Адаптивный.ЦелевоеЗначение).Равно(500);
	Сумма = 0;
	Для Каждого Строка Из Записи Цикл
		Если Строка.КодПробы <> "091" Тогда
			Сумма = Сумма + Строка.Баллы;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Итог.ОбщийБалл).Равно(Окр(Сумма / 7, 1));
	ЮТест.ОжидаетЧто(СтрНайти(Адаптивный.Детали, " усл. МГц BSL;")).Больше(1);
	ЮТест.ОжидаетЧто(Лев(Адаптивный.Детали, 1) >= "0" И Лев(Адаптивный.Детали, 1) <= "9").Равно(Истина);
	ЮТест.ОжидаетЧто(Итог.ОбщийБалл).Больше(0);
	ЮТест.ОжидаетЧто(Итог.ОбщийБалл).МеньшеИлиРавно(100);
	ЮТест.ОжидаетЧто(Не ПустаяСтрока(Итог.ГлавноеУзкоеМесто)).Равно(Истина);

	БенчмаркРаннер.ОчиститьРезультатыПрогона(ИдентификаторПрогона);

КонецПроцедуры

#КонецОбласти
