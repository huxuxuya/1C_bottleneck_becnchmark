#Область ПрограммныйИнтерфейс

// Регистрирует один серверный YAxUnit-тест.
Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты.ДобавитьТестовыйНабор("Ядро бенчмарка")
        .ДобавитьСерверныйТест("Тест_ВыполнитьТестовыйРасчет_КорректнаяСумма");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_ВыполнитьТестовыйРасчет_КорректнаяСумма() Экспорт

	Результат = БенчмаркЯдро.ВыполнитьТестовыйРасчет(10);

	// Сумма (1*31 + 2*31 + ... + 10*31) = 31 * 55 = 1705 (все значения < 997)
	ЮТест.ОжидаетЧто(Результат.Сумма).Равно(1705);
	ЮТест.ОжидаетЧто(Результат.ДлительностьМс).БольшеИлиРавно(0);

КонецПроцедуры

#КонецОбласти
