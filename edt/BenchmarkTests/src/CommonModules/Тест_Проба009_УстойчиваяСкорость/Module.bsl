Процедура Тест_Проба009_УстойчиваяСкорость() Экспорт

	Результат = БенчмаркПроба009УстойчиваяСкорость.Проба009_УстойчиваяСкорость(3, 100);

	ЮТест.ОжидаетЧто(Результат.МедианаМс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.ПерваяМс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.ПоследняяМс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.ИзменениеПроцентов).БольшеИлиРавно(-100);

