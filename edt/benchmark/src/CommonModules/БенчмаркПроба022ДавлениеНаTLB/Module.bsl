#Область ПрограммныйИнтерфейс

// Сравнивает внешние замеры случайного доступа к одной линии на страницу.
// Вариант: ИдентификаторСтенда, ИдентификаторНабора, ТипСтраниц,
// ФактическийРазмерСтраницыБайт, ОбъемРабочегоНабораБайт,
// РазмещениеПодтверждено, Наблюдения.
// Наблюдение: ЧислоДоступов, ДлительностьНс, ЧислоОбходовТаблицСтраниц,
// КонтрольнаяСумма.
Функция СравнитьРежимыСтраниц(Знач ОбычныеСтраницы, Знач КрупныеСтраницы) Экспорт

	Обычные = РассчитатьВариант(ОбычныеСтраницы);
	Крупные = РассчитатьВариант(КрупныеСтраницы);
	Если Обычные.ИдентификаторСтенда <> Крупные.ИдентификаторСтенда
		Или Обычные.ИдентификаторНабора <> Крупные.ИдентификаторНабора
		Или Обычные.ОбъемРабочегоНабораБайт <> Крупные.ОбъемРабочегоНабораБайт
		Или Обычные.ЧислоДоступов <> Крупные.ЧислоДоступов
		Или Обычные.КонтрольнаяСумма <> Крупные.КонтрольнаяСумма Тогда
		ВызватьИсключение "Размер набора, число доступов и результат должны совпадать между режимами";
	КонецЕсли;
	Если Крупные.РазмерСтраницыБайт <= Обычные.РазмерСтраницыБайт Тогда
		ВызватьИсключение "Фактический размер крупных страниц должен быть больше обычных";
	КонецЕсли;

	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторНабора,ОбъемРабочегоНабораБайт,ЧислоДоступов,КонтрольнаяСумма,ОбычныеСтраницы,КрупныеСтраницы,ИзменениеЗадержкиПроцентов,СнижениеPageWalksДоступно,СнижениеPageWalksПроцентов",
		Обычные.ИдентификаторСтенда, Обычные.ИдентификаторНабора, Обычные.ОбъемРабочегоНабораБайт,
		Обычные.ЧислоДоступов, Обычные.КонтрольнаяСумма, Обычные, Крупные,
		(Крупные.МедианаНсНаДоступ - Обычные.МедианаНсНаДоступ) * 100 / Обычные.МедианаНсНаДоступ,
		Обычные.PageWalksНа1000Доступов > 0,
		?(Обычные.PageWalksНа1000Доступов = 0, 0,
			(Обычные.PageWalksНа1000Доступов - Крупные.PageWalksНа1000Доступов) * 100 / Обычные.PageWalksНа1000Доступов));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РассчитатьВариант(Вариант)
	Если Вариант.ФактическийРазмерСтраницыБайт <= 0
		Или Вариант.ОбъемРабочегоНабораБайт <= 0
		Или Не Вариант.РазмещениеПодтверждено
		Или ПустаяСтрока(Вариант.ТипСтраниц) Тогда
		ВызватьИсключение "Нужны фактический размер страниц, набор и подтверждённое размещение";
	КонецЕсли;
	Если Вариант.Наблюдения.Количество() < 3 Тогда
		ВызватьИсключение "Для каждого режима нужны минимум три повтора";
	КонецЕсли;

	ЗадержкиНс = Новый СписокЗначений;
	PageWalksНаДоступ = Новый СписокЗначений;
	ЧислоДоступов = 0;
	КонтрольнаяСумма = Неопределено;
	Для Каждого Наблюдение Из Вариант.Наблюдения Цикл
		Если Наблюдение.ЧислоДоступов <= 0 Или Наблюдение.ДлительностьНс <= 0
			Или Наблюдение.ЧислоОбходовТаблицСтраниц < 0 Тогда
			ВызватьИсключение "Число доступов и время должны быть положительными, page walks неотрицательны";
		КонецЕсли;
		Если ЧислоДоступов = 0 Тогда
			ЧислоДоступов = Наблюдение.ЧислоДоступов;
			КонтрольнаяСумма = Наблюдение.КонтрольнаяСумма;
		ИначеЕсли ЧислоДоступов <> Наблюдение.ЧислоДоступов
			Или КонтрольнаяСумма <> Наблюдение.КонтрольнаяСумма Тогда
			ВызватьИсключение "Повторы должны выполнять одинаковые доступы с одной контрольной суммой";
		КонецЕсли;
		ЗадержкиНс.Добавить(Наблюдение.ДлительностьНс / Наблюдение.ЧислоДоступов);
		PageWalksНаДоступ.Добавить(Наблюдение.ЧислоОбходовТаблицСтраниц * 1000 / Наблюдение.ЧислоДоступов);
	КонецЦикла;

	МедианаНс = Медиана(ЗадержкиНс);
	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторНабора,ТипСтраниц,РазмерСтраницыБайт,ОбъемРабочегоНабораБайт,ЧислоДоступов,КонтрольнаяСумма,МедианаНсНаДоступ,PageWalksНа1000Доступов",
		Вариант.ИдентификаторСтенда, Вариант.ИдентификаторНабора, Вариант.ТипСтраниц,
		Вариант.ФактическийРазмерСтраницыБайт, Вариант.ОбъемРабочегоНабораБайт,
		ЧислоДоступов, КонтрольнаяСумма, МедианаНс, Медиана(PageWalksНаДоступ));
КонецФункции

Функция Медиана(Значения)
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение)
		+ Число(Значения[Количество / 2].Значение)) / 2;
КонецФункции

#КонецОбласти
