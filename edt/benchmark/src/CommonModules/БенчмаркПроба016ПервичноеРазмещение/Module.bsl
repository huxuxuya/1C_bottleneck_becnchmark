// Сравнивает внешние результаты first-touch: однопоточная инициализация и инициализация будущими владельцами.

#Область ПрограммныйИнтерфейс

// Вариант содержит СпособИнициализации, число владельцев, размер набора,
// подтверждённое распределение страниц по NUMA-узлам и серию одинаковых расчётов.
Функция СравнитьПервичноеРазмещение(Знач Однопоточно, Знач ПоВладельцам) Экспорт

	ПроверитьВариант(Однопоточно, "Однопоточно");
	ПроверитьВариант(ПоВладельцам, "ПоВладельцам");
	Если Однопоточно.СпособИнициализации <> "Однопоточно" Тогда
		ВызватьИсключение "Первый вариант должен использовать однопоточную инициализацию";
	КонецЕсли;
	Если ПоВладельцам.СпособИнициализации <> "ПоВладельцам" Тогда
		ВызватьИсключение "Второй вариант должен инициализироваться будущими владельцами";
	КонецЕсли;
	Если Однопоточно.ЧислоВладельцев <> 1 Или ПоВладельцам.ЧислоВладельцев < 2 Тогда
		ВызватьИсключение "Для сравнения требуется один инициализатор и несколько будущих владельцев";
	КонецЕсли;
	Если Однопоточно.ИдентификаторСтенда <> ПоВладельцам.ИдентификаторСтенда
		Или Однопоточно.ИдентификаторНагрузки <> ПоВладельцам.ИдентификаторНагрузки
		Или Однопоточно.ОбъемРабочегоНабораБайт <> ПоВладельцам.ОбъемРабочегоНабораБайт Тогда
		ВызватьИсключение "Варианты должны использовать один стенд, нагрузку и размер набора";
	КонецЕсли;
	Если Однопоточно.КонтрольнаяСумма <> ПоВладельцам.КонтрольнаяСумма Тогда
		ВызватьИсключение "Контрольные суммы расчёта должны совпадать";
	КонецЕсли;
	ПроверитьОдинаковыеNUMAУзлы(Однопоточно.РаспределениеСтраниц, ПоВладельцам.РаспределениеСтраниц);

	ДоляОднопоточно = РассчитатьДолюЦелевыхСтраниц(Однопоточно.РаспределениеСтраниц, Однопоточно.ОбъемРабочегоНабораБайт);
	ДоляПоВладельцам = РассчитатьДолюЦелевыхСтраниц(ПоВладельцам.РаспределениеСтраниц, ПоВладельцам.ОбъемРабочегоНабораБайт);
	ВремяОднопоточно = МедианаДлительностиРасчета(Однопоточно.Наблюдения);
	ВремяПоВладельцам = МедианаДлительностиРасчета(ПоВладельцам.Наблюдения);

	Результат = Новый Структура;
	Результат.Вставить("ДоляЦелевыхСтраницОднопоточноПроцентов", ДоляОднопоточно);
	Результат.Вставить("ДоляЦелевыхСтраницПоВладельцамПроцентов", ДоляПоВладельцам);
	Результат.Вставить("ИзменениеСоответствияПп", Окр(ДоляПоВладельцам - ДоляОднопоточно, 2));
	Результат.Вставить("МедианаРасчетаОднопоточноМс", ВремяОднопоточно);
	Результат.Вставить("МедианаРасчетаПоВладельцамМс", ВремяПоВладельцам);
	Результат.Вставить("ИзменениеДлительностиРасчетаПроцентов", Окр((ВремяПоВладельцам / ВремяОднопоточно - 1) * 100, 2));
	Результат.Вставить("КонтрольнаяСумма", Однопоточно.КонтрольнаяСумма);
	Результат.Вставить("Детали", "Внешнее подтверждение NUMA-размещения страниц; сравнивается одинаковый расчёт");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьВариант(Вариант, Описание)

	Если Не Вариант.Свойство("СпособИнициализации") Тогда
		ВызватьИсключение "Не задан способ инициализации для " + Описание;
	КонецЕсли;
	Если Не Вариант.Свойство("ИдентификаторСтенда") Или ПустаяСтрока(Строка(Вариант.ИдентификаторСтенда))
		Или Не Вариант.Свойство("ИдентификаторНагрузки") Или ПустаяСтрока(Строка(Вариант.ИдентификаторНагрузки)) Тогда
		ВызватьИсключение "Не заданы стенд и нагрузка для " + Описание;
	КонецЕсли;
	Если Не Вариант.Свойство("ОбъемРабочегоНабораБайт") Или Вариант.ОбъемРабочегоНабораБайт <= 0
		Или Не Вариант.Свойство("ЧислоВладельцев") Или Вариант.ЧислоВладельцев <= 0 Тогда
		ВызватьИсключение "Размер набора и число владельцев должны быть больше нуля";
	КонецЕсли;
	РазмещениеПодтверждено = Ложь;
	Если Не Вариант.Свойство("РазмещениеПодтверждено", РазмещениеПодтверждено) Или Не РазмещениеПодтверждено Тогда
		ВызватьИсключение "Для " + Описание + " не подтверждено фактическое размещение страниц";
	КонецЕсли;
	Если Не Вариант.Свойство("РаспределениеСтраниц") Или Вариант.РаспределениеСтраниц.Количество() < 2 Тогда
		ВызватьИсключение "Нужно распределение страниц минимум по двум NUMA-узлам";
	КонецЕсли;
	Если Не Вариант.Свойство("Наблюдения") Или Вариант.Наблюдения.Количество() < 3 Тогда
		ВызватьИсключение "Для каждого способа инициализации нужно не менее трёх расчётов";
	КонецЕсли;
	Если Не Вариант.Свойство("КонтрольнаяСумма") Тогда
		ВызватьИсключение "Вариант не содержит контрольную сумму";
	КонецЕсли;

	Для Каждого Наблюдение Из Вариант.Наблюдения Цикл
		Если Не Наблюдение.Свойство("ДлительностьРасчетаМс") Или Наблюдение.ДлительностьРасчетаМс <= 0
			Или Не Наблюдение.Свойство("КонтрольнаяСумма") Или Наблюдение.КонтрольнаяСумма <> Вариант.КонтрольнаяСумма Тогда
			ВызватьИсключение "Расчёты должны иметь положительную длительность и одинаковую контрольную сумму";
		КонецЕсли;
	КонецЦикла;
	ПроверитьРаспределениеСтраниц(Вариант.РаспределениеСтраниц, Вариант.ОбъемРабочегоНабораБайт);

КонецПроцедуры

Процедура ПроверитьРаспределениеСтраниц(Распределение, ОбщийОбъемБайт)

	ОжидаемыйОбъем = 0;
	ФактическийОбъем = 0;
	Узлы = Новый Массив;
	Для Каждого СтрокаРаспределения Из Распределение Цикл
		Если Не СтрокаРаспределения.Свойство("УзелNUMA") Или ПустаяСтрока(Строка(СтрокаРаспределения.УзелNUMA)) Тогда
			ВызватьИсключение "Не задан NUMA-узел страницы";
		КонецЕсли;
		Если СодержитЗначение(Узлы, Строка(СтрокаРаспределения.УзелNUMA)) Тогда
			ВызватьИсключение "NUMA-узел повторяется в распределении страниц";
		КонецЕсли;
		Если Не СтрокаРаспределения.Свойство("ОжидаемыйОбъемБайт") Или СтрокаРаспределения.ОжидаемыйОбъемБайт < 0
			Или Не СтрокаРаспределения.Свойство("ФактическийОбъемБайт") Или СтрокаРаспределения.ФактическийОбъемБайт < 0 Тогда
			ВызватьИсключение "Объём страниц на NUMA-узле не может быть отрицательным";
		КонецЕсли;
		Узлы.Добавить(Строка(СтрокаРаспределения.УзелNUMA));
		ОжидаемыйОбъем = ОжидаемыйОбъем + СтрокаРаспределения.ОжидаемыйОбъемБайт;
		ФактическийОбъем = ФактическийОбъем + СтрокаРаспределения.ФактическийОбъемБайт;
	КонецЦикла;
	Если ОжидаемыйОбъем <> ОбщийОбъемБайт Или ФактическийОбъем <> ОбщийОбъемБайт Тогда
		ВызватьИсключение "Ожидаемый и фактический объём страниц должны совпадать с размером набора";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОдинаковыеNUMAУзлы(ПервоеРаспределение, ВтороеРаспределение)

	Для Каждого СтрокаРаспределения Из ПервоеРаспределение Цикл
		Если Не НайтиУзел(ВтороеРаспределение, Строка(СтрокаРаспределения.УзелNUMA)) Тогда
			ВызватьИсключение "Варианты должны иметь одинаковый набор NUMA-узлов";
		КонецЕсли;
	КонецЦикла;
	Если ПервоеРаспределение.Количество() <> ВтороеРаспределение.Количество() Тогда
		ВызватьИсключение "Варианты должны иметь одинаковый набор NUMA-узлов";
	КонецЕсли;

КонецПроцедуры

Функция НайтиУзел(Распределение, УзелNUMA)

	Для Каждого СтрокаРаспределения Из Распределение Цикл
		Если Строка(СтрокаРаспределения.УзелNUMA) = УзелNUMA Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция СодержитЗначение(Значения, Значение)

	Для Каждого Элемент Из Значения Цикл
		Если Элемент = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция РассчитатьДолюЦелевыхСтраниц(Распределение, ОбщийОбъемБайт)

	СовпавшийОбъем = 0;
	Для Каждого СтрокаРаспределения Из Распределение Цикл
		СовпавшийОбъем = СовпавшийОбъем + Мин(СтрокаРаспределения.ОжидаемыйОбъемБайт, СтрокаРаспределения.ФактическийОбъемБайт);
	КонецЦикла;
	Возврат Окр(СовпавшийОбъем / ОбщийОбъемБайт * 100, 2);

КонецФункции

Функция МедианаДлительностиРасчета(Наблюдения)

	Значения = Новый СписокЗначений;
	Для Каждого Наблюдение Из Наблюдения Цикл
		Значения.Добавить(Наблюдение.ДлительностьРасчетаМс);
	КонецЦикла;
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение) + Число(Значения[Количество / 2].Значение)) / 2;

КонецФункции

#КонецОбласти
