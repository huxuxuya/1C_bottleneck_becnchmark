Процедура ДобавитьОшибкуПробе(Результаты, КонтекстПрогона, КодПоказателя,
	НаименованиеПробы, ЦелевоеЗначение, ЕдиницаИзмерения, ТекстОшибки)

	ДанныеПробы = СоздатьДанныеПроб(КодПоказателя, НаименованиеПробы, 0,
		ЦелевоеЗначение, ЕдиницаИзмерения, 0, ТекстОшибки);
	ДанныеПробы.КосвенныйСигнал = Ложь;
	Если СтрНайти(ВРег(ТекстОшибки), "РАЗРЕШ") > 0
		Или СтрНайти(ВРег(ТекстОшибки), "КОРОЧЕ РАЗРЕШЕНИЯ") > 0 Тогда
		ДанныеПробы.Вставить("СтатусПробы", "Недостаточно разрешения таймера");
	Иначе
		ДанныеПробы.Вставить("СтатусПробы", "Ошибка");
	КонецЕсли;
	ДанныеПробы.Вставить("ПричинаПроблемы", Лев(ТекстОшибки, 500));
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, ДанныеПробы);

