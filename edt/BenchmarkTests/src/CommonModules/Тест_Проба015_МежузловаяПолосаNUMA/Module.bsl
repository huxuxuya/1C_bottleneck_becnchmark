#Область ПрограммныйИнтерфейс
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТестовыйНабор("Виртуализация и NUMA")
		.ДобавитьСерверныйТест("Тест_Проба015_МежузловаяПолосаNUMA");
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба015_МежузловаяПолосаNUMA() Экспорт

	Измерения = СоздатьМатрицуПолосы();
	Результат = БенчмаркПроба015ПолосаNUMA.АнализироватьМатрицуПолосы(Измерения);
	Пара01 = НайтиПару(Результат.Матрица, "0", "1");
	ЮТест.ОжидаетЧто(Результат.ЧислоNUMAУзлов).Равно(2);
	ЮТест.ОжидаетЧто(Результат.Матрица.Количество()).Равно(4);
	ЮТест.ОжидаетЧто(Пара01.ПолосаГБВСек).Равно(5);
	ЮТест.ОжидаетЧто(Пара01.ПолосаГБВСекНаПоток).Равно(1.25);
	ЮТест.ОжидаетЧто(Результат.МинимальнаяПолосаГБВСек).Равно(4);
	ЮТест.ОжидаетЧто(Результат.МаксимальнаяПолосаГБВСек).Равно(10);
	ЮТест.ОжидаетЧто(Результат.ХудшаяПараУзлов).Равно("1->0");

	Измерения[0].ЧислоПотоков = 2;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба015ПолосаNUMA.АнализироватьМатрицуПолосы(Измерения);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);

	Измерения[0].ЧислоПотоков = 4;
	Измерения[0].БуферБольшеКешаПодтвержден = Ложь;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба015ПолосаNUMA.АнализироватьМатрицуПолосы(Измерения);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);

КонецПроцедуры

Функция СоздатьМатрицуПолосы()

	Измерения = Новый Массив;
	ДобавитьТриЗамера(Измерения, "0", "0", 100000);
	ДобавитьТриЗамера(Измерения, "0", "1", 200000);
	ДобавитьТриЗамера(Измерения, "1", "0", 250000);
	ДобавитьТриЗамера(Измерения, "1", "1", 125000);
	Возврат Измерения;

КонецФункции

Процедура ДобавитьТриЗамера(Измерения, УзелCPU, УзелПамяти, БазоваяДлительностьМкс)

	Для Индекс = 0 По 2 Цикл
		Измерения.Добавить(Новый Структура("ИдентификаторСтенда,ИдентификаторНабораДанных,УзелCPU,УзелПамяти,ЧислоПотоков,ОбъемБайт,ДлительностьМикросекунд,КонтрольнаяСумма,ПривязкаПодтверждена,РезидентностьПодтверждена,БуферБольшеКешаПодтвержден",
			"numa-lab", "stream-read-1gb", УзелCPU, УзелПамяти, 4, 1000000000, БазоваяДлительностьМкс + (Индекс - 1) * 1000, 909, Истина, Истина, Истина));
	КонецЦикла;

КонецПроцедуры

Функция НайтиПару(Матрица, УзелCPU, УзелПамяти)

	Для Каждого СтрокаРезультата Из Матрица Цикл
		Если СтрокаРезультата.УзелCPU = УзелCPU И СтрокаРезультата.УзелПамяти = УзелПамяти Тогда
			Возврат СтрокаРезультата;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Пара NUMA не найдена";

КонецФункции
#КонецОбласти
