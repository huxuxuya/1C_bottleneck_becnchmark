#Область ПрограммныйИнтерфейс
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТестовыйНабор("Память и кэши CPU")
		.ДобавитьСерверныйТест("Тест_Проба018_ЗадержкиКэшейDRAM");
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба018_ЗадержкиКэшейDRAM() Экспорт
	Точки = Новый Массив;
	Точки.Добавить(СоздатьТочку(4096, 100));
	Точки.Добавить(СоздатьТочку(32768, 170));
	Точки.Добавить(СоздатьТочку(4194304, 360));

	Результат = БенчмаркПроба018ЗадержкиКэшейDRAM.АнализироватьКривуюЗадержки(Точки);
	ЮТест.ОжидаетЧто(Результат.Кривая.Количество()).Равно(3);
	ЮТест.ОжидаетЧто(Результат.Кривая[0].МедианаНсНаДоступ).Равно(100);
	ЮТест.ОжидаетЧто(Результат.Кривая[1].ПриростКПредыдущемуПроцентов).Равно(70);
	ЮТест.ОжидаетЧто(Результат.Кривая[2].ПромахиLLCДоступны).Равно(Истина);

	Точки[1].ЗависимаяЦепочка = Ложь;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба018ЗадержкиКэшейDRAM.АнализироватьКривуюЗадержки(Точки);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);
КонецПроцедуры

Функция СоздатьТочку(Размер, ЗадержкаНс)
	Наблюдения = Новый Массив;
	Для Индекс = 1 По 3 Цикл
		Наблюдения.Добавить(Новый Структура("ЧислоДоступов,ДлительностьНс,КонтрольнаяСумма,ПромахиLLC",
			1000, ЗадержкаНс * 1000, 801, Индекс * 10));
	КонецЦикла;
	Возврат Новый Структура("РазмерНабораБайт,РазмерLLCБайт,ИдентификаторСтенда,ИдентификаторАлгоритма,ЗависимаяЦепочка,ПорядокСлучайный,Наблюдения",
		Размер, 2097152, "mem-lab", "dependent-random-v1", Истина, Истина, Наблюдения);
КонецФункции
#КонецОбласти
