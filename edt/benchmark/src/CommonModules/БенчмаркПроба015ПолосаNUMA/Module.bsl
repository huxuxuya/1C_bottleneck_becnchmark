// Анализирует матрицу межузловой полосы памяти по внешним замерам закреплённых потоков.
// Буферы должны быть резидентны и больше кэша; размещение потоков и страниц подтверждается снаружи.

#Область ПрограммныйИнтерфейс

// Измерение содержит стенд, набор данных, CPU-узел, узел памяти, число потоков,
// объём байт, длительность в микросекундах, контрольную сумму и подтверждения
// привязки потоков, резидентности страниц и размера буфера больше кэша.
// Для каждой пары узлов нужно не менее трёх измерений.
Функция АнализироватьМатрицуПолосы(Знач Измерения) Экспорт

	Если Измерения.Количество() < 12 Тогда
		ВызватьИсключение "Нужна полная матрица минимум 2x2 с тремя наблюдениями на пару";
	КонецЕсли;

	УзлыCPU = Новый Массив;
	УзлыПамяти = Новый Массив;
	Стенд = "";
	НаборДанных = "";
	ЧислоПотоков = 0;
	ОбъемБайт = 0;
	КонтрольнаяСумма = Неопределено;
	Для Индекс = 0 По Измерения.Количество() - 1 Цикл
		Измерение = Измерения[Индекс];
		ПроверитьИзмерение(Измерение);
		Если Индекс = 0 Тогда
			Стенд = Измерение.ИдентификаторСтенда;
			НаборДанных = Измерение.ИдентификаторНабораДанных;
			ЧислоПотоков = Измерение.ЧислоПотоков;
			ОбъемБайт = Измерение.ОбъемБайт;
			КонтрольнаяСумма = Измерение.КонтрольнаяСумма;
		ИначеЕсли Стенд <> Измерение.ИдентификаторСтенда
			Или НаборДанных <> Измерение.ИдентификаторНабораДанных
			Или ЧислоПотоков <> Измерение.ЧислоПотоков
			Или ОбъемБайт <> Измерение.ОбъемБайт
			Или КонтрольнаяСумма <> Измерение.КонтрольнаяСумма Тогда
			ВызватьИсключение "Все направления должны использовать одинаковую нагрузку, объём и число потоков";
		КонецЕсли;
		ДобавитьУникальноеЗначение(УзлыCPU, Строка(Измерение.УзелCPU));
		ДобавитьУникальноеЗначение(УзлыПамяти, Строка(Измерение.УзелПамяти));
	КонецЦикла;

	Если УзлыCPU.Количество() < 2 Или УзлыCPU.Количество() <> УзлыПамяти.Количество() Тогда
		ВызватьИсключение "Нужны одинаковые наборы как минимум из двух CPU-узлов и узлов памяти";
	КонецЕсли;
	Для Каждого УзелCPU Из УзлыCPU Цикл
		Если Не СодержитЗначение(УзлыПамяти, УзелCPU) Тогда
			ВызватьИсключение "Матрица не содержит локальную пару для CPU-узла " + УзелCPU;
		КонецЕсли;
		Для Каждого УзелПамяти Из УзлыПамяти Цикл
			Если ЧислоНаблюденийПары(Измерения, УзелCPU, УзелПамяти) < 3 Тогда
				ВызватьИсключение "Для каждого направления NUMA нужно не менее трёх измерений";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого УзелПамяти Из УзлыПамяти Цикл
		Если Не СодержитЗначение(УзлыCPU, УзелПамяти) Тогда
			ВызватьИсключение "Матрица должна содержать локальную диагональ";
		КонецЕсли;
	КонецЦикла;

	МатрицаРезультатов = Новый Массив;
	МинимальнаяПолоса = 0;
	МаксимальнаяПолоса = 0;
	ХудшаяПара = "";
	Для Каждого УзелCPU Из УзлыCPU Цикл
		Для Каждого УзелПамяти Из УзлыПамяти Цикл
			ПолосаГБВСек = МедианаПолосыГБВСек(Измерения, УзелCPU, УзелПамяти);
			СтрокаРезультата = Новый Структура;
			СтрокаРезультата.Вставить("УзелCPU", УзелCPU);
			СтрокаРезультата.Вставить("УзелПамяти", УзелПамяти);
			СтрокаРезультата.Вставить("ПолосаГБВСек", ПолосаГБВСек);
			СтрокаРезультата.Вставить("ПолосаГБВСекНаПоток", ПолосаГБВСек / ЧислоПотоков);
			МатрицаРезультатов.Добавить(СтрокаРезультата);
			Если МатрицаРезультатов.Количество() = 1 Или ПолосаГБВСек < МинимальнаяПолоса Тогда
				МинимальнаяПолоса = ПолосаГБВСек;
				ХудшаяПара = УзелCPU + "->" + УзелПамяти;
			КонецЕсли;
			Если МатрицаРезультатов.Количество() = 1 Или ПолосаГБВСек > МаксимальнаяПолоса Тогда
				МаксимальнаяПолоса = ПолосаГБВСек;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ЧислоNUMAУзлов", УзлыCPU.Количество());
	Результат.Вставить("ЧислоПотоков", ЧислоПотоков);
	Результат.Вставить("ОбъемБайтНаИзмерение", ОбъемБайт);
	Результат.Вставить("Матрица", МатрицаРезультатов);
	Результат.Вставить("МинимальнаяПолосаГБВСек", МинимальнаяПолоса);
	Результат.Вставить("МаксимальнаяПолосаГБВСек", МаксимальнаяПолоса);
	Результат.Вставить("ХудшаяПараУзлов", ХудшаяПара);
	Результат.Вставить("Детали", "Внешние замеры; проверка размещения потоков и резидентности обязательна");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьИзмерение(Измерение)

	Если Не Измерение.Свойство("ИдентификаторСтенда") Или ПустаяСтрока(Строка(Измерение.ИдентификаторСтенда))
		Или Не Измерение.Свойство("ИдентификаторНабораДанных") Или ПустаяСтрока(Строка(Измерение.ИдентификаторНабораДанных)) Тогда
		ВызватьИсключение "Не заданы стенд или набор данных";
	КонецЕсли;
	Если Не Измерение.Свойство("УзелCPU") Или ПустаяСтрока(Строка(Измерение.УзелCPU))
		Или Не Измерение.Свойство("УзелПамяти") Или ПустаяСтрока(Строка(Измерение.УзелПамяти)) Тогда
		ВызватьИсключение "Не заданы CPU-узел и узел памяти";
	КонецЕсли;
	Если Не Измерение.Свойство("ЧислоПотоков") Или Измерение.ЧислоПотоков <= 0
		Или Не Измерение.Свойство("ОбъемБайт") Или Измерение.ОбъемБайт <= 0
		Или Не Измерение.Свойство("ДлительностьМикросекунд") Или Измерение.ДлительностьМикросекунд <= 0 Тогда
		ВызватьИсключение "Число потоков, объём и длительность должны быть больше нуля";
	КонецЕсли;
	Если Не Измерение.Свойство("КонтрольнаяСумма") Тогда
		ВызватьИсключение "Измерение не содержит контрольную сумму";
	КонецЕсли;
	ПривязкаПодтверждена = Ложь;
	Если Не Измерение.Свойство("ПривязкаПодтверждена", ПривязкаПодтверждена) Или Не ПривязкаПодтверждена Тогда
		ВызватьИсключение "Для измерения не подтверждено размещение потоков";
	КонецЕсли;
	РезидентностьПодтверждена = Ложь;
	Если Не Измерение.Свойство("РезидентностьПодтверждена", РезидентностьПодтверждена) Или Не РезидентностьПодтверждена Тогда
		ВызватьИсключение "Для измерения не подтверждена резидентность страниц";
	КонецЕсли;
	РазмерБуфераПодтвержден = Ложь;
	Если Не Измерение.Свойство("БуферБольшеКешаПодтвержден", РазмерБуфераПодтвержден) Или Не РазмерБуфераПодтвержден Тогда
		ВызватьИсключение "Размер буфера должен превышать кэш";
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьУникальноеЗначение(Значения, Значение)

	Если Не СодержитЗначение(Значения, Значение) Тогда
		Значения.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

Функция СодержитЗначение(Значения, Значение)

	Для Каждого Элемент Из Значения Цикл
		Если Элемент = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЧислоНаблюденийПары(Измерения, УзелCPU, УзелПамяти)

	Количество = 0;
	Для Каждого Измерение Из Измерения Цикл
		Если Строка(Измерение.УзелCPU) = УзелCPU И Строка(Измерение.УзелПамяти) = УзелПамяти Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

Функция МедианаПолосыГБВСек(Измерения, УзелCPU, УзелПамяти)

	Значения = Новый СписокЗначений;
	Для Каждого Измерение Из Измерения Цикл
		Если Строка(Измерение.УзелCPU) = УзелCPU И Строка(Измерение.УзелПамяти) = УзелПамяти Тогда
			ПолосаГБВСек = Измерение.ОбъемБайт / (Измерение.ДлительностьМикросекунд * 1000);
			Значения.Добавить(ПолосаГБВСек);
		КонецЕсли;
	КонецЦикла;
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение) + Число(Значения[Количество / 2].Значение)) / 2;

КонецФункции

#КонецОбласти
