// Оркестратор калиброванных прогонов, расчёта баллов и локализации узких мест.

#Область ПрограммныйИнтерфейс

// Считает отношение бюджета к измеренной длительности. Значение 100 означает
// точное попадание в бюджет; больше 100 — запас, меньше 100 — превышение бюджета.
//
// Параметры:
//  Значение - Число - измеренное значение (>= 0, меньше - лучше).
//  ЦелевоеЗначение - Число - целевой порог (> 0).
//
// Возвращаемое значение:
//  Структура:
//      * Баллы - Число - неограниченный индекс, где 100 соответствует бюджету.
//      * Статус - Строка
//
Функция ОценитьПоказатель(Знач Значение, Знач ЦелевоеЗначение) Экспорт

	Если ЦелевоеЗначение <= 0 Тогда
		ВызватьИсключение "Целевое значение должно быть больше нуля";
	КонецЕсли;

	Если Значение <= 0 Тогда
		ВызватьИсключение "Измеренное значение должно быть больше нуля";
	КонецЕсли;

	Индекс = (ЦелевоеЗначение / Значение) * 100;
	Баллы = Окр(Индекс, 1);

	Если Индекс >= 100 Тогда
		Статус = "ОК";
	ИначеЕсли Индекс >= 50 Тогда
		Статус = "Замедление";
	Иначе
		Статус = "УзкоеМесто";
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Баллы", Баллы);
	Результат.Вставить("Индекс", Индекс);
	Результат.Вставить("Статус", Статус);
	Возврат Результат;

КонецФункции

// Выполняет калиброванный прогон базовых проб, сохраняет результаты в регистр сведений
// РезультатыПрогонов и определяет главное узкое место.
//
// Параметры:
//  ИдентификаторПрогона - Строка - идентификатор прогона (если пустой, создаётся новый).
//  Масштаб - Число - коэффициент объёма нагрузки (> 0, по умолчанию 1).
//
// Возвращаемое значение:
//  Структура:
//      * ИдентификаторПрогона - Строка
//      * ОбщийБалл - Число
//      * КоличествоОцениваемыхПроб - Число - количество проб, включённых в общий балл.
//      * ГлавноеУзкоеМесто - Строка
//      * Результаты - Массив Из Структура
//
Функция ВыполнитьПолныйПрогон(Знач ИдентификаторПрогона = "", Знач Масштаб = 1, Знач ЭталонНсДля3000МГц = 250) Экспорт

	Если Масштаб <= 0 Тогда
		ВызватьИсключение "Масштаб нагрузки должен быть больше нуля";
	КонецЕсли;

	Если ПустаяСтрока(ИдентификаторПрогона) Тогда
		ИдентификаторПрогона = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	ИдентификаторСерии = "RUN_" + Лев(ИдентификаторПрогона, 28);
	БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);

	СправочникиБазы = БенчмаркГенераторДанных.ОбеспечитьСправочники(20, 3, "БМ");
	ДатаПрогона = ТекущаяДатаСеанса();
	Результаты = Новый Массив;
	КонтекстПрогона = Новый Структура;
	КонтекстПрогона.Вставить("ИдентификаторПрогона", ИдентификаторПрогона);
	КонтекстПрогона.Вставить("ДатаПрогона", ДатаПрогона);

	ИтерацийCPU = Макс(100000, Цел(100000 * Масштаб));
	Фиксированный = БенчмаркПробы.Проба001_СкоростьОдногоЯдра(1, 3, ИтерацийCPU, ЭталонНсДля3000МГц);
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, СоздатьДанныеПроб(
		"001", "BSL: фиксированный пакет", Фиксированный.НсНаИтерацию, 500, "нс/итер",
		Фиксированный.КонтрольнаяСумма, КомментарийCPU(Фиксированный, ЭталонНсДля3000МГц)));

	Адаптивный = БенчмаркПроба026СкоростьBSL.ИзмеритьСкоростьBSL(ИтерацийCPU, ЭталонНсДля3000МГц);
	ДанныеПробы = СоздатьДанныеПроб("026", "BSL: адаптивный пакет", Адаптивный.НсНаИтерацию,
		500, "нс/итер", Адаптивный.КонтрольнаяСумма, КомментарийCPU(Адаптивный, ЭталонНсДля3000МГц));
	ДанныеПробы.КосвенныйСигнал = Ложь;
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, ДанныеПробы);

	// 2. Память: Рабочий набор коллекции
	РазмерНабора = Макс(200, Цел(5000 * Масштаб));
	ЧислоПоисков = Макс(100, Цел(2000 * Масштаб));
	РезПамять = БенчмаркПробы.ПробаРабочийНаборКоллекции(РазмерНабора, ЧислоПоисков);
	ВремяПамять = РезПамять.ВремяСозданияМс + РезПамять.ВремяОбходаМс + РезПамять.ВремяПоискаМс;
	ДанныеПробы = Новый Структура("КодПробы,НаименованиеПробы,ЗначениеМетрики",
		"MEM", "Память: Рабочий набор коллекции", ВремяПамять);
	ДанныеПробы.Вставить("ЦелевоеЗначение", Макс(10, 150 * Масштаб));
	ДанныеПробы.Вставить("ЕдиницаИзмерения", "мс");
	ДанныеПробы.Вставить("КонтрольнаяСумма", РезПамять.КонтрольнаяСумма);
	ДанныеПробы.Вставить("Детали", "Создание/Обход/Поиск: " + Строка(РезПамять.ВремяСозданияМс) + "/"
		+ Строка(РезПамять.ВремяОбходаМс) + "/" + Строка(РезПамять.ВремяПоискаМс) + " мс");
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, ДанныеПробы);

	// 3. БД: Точечный запрос по индексу
	ЧислоЗапросов = Макс(10, Цел(100 * Масштаб));
	РезТочка = БенчмаркПробы.ПробаТочечныйЗапросПоИндексу(СправочникиБазы.Товары, ЧислоЗапросов);
	ДанныеПробы = Новый Структура("КодПробы,НаименованиеПробы,ЗначениеМетрики",
		"DB_POINT", "БД: Точечный запрос по индексу", РезТочка.ДлительностьМс);
	ДанныеПробы.Вставить("ЦелевоеЗначение", Макс(10, 100 * Масштаб));
	ДанныеПробы.Вставить("ЕдиницаИзмерения", "мс");
	ДанныеПробы.Вставить("КонтрольнаяСумма", РезТочка.КонтрольнаяСумма);
	ДанныеПробы.Вставить("Детали", "Запросов: " + Строка(ЧислоЗапросов));
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, ДанныеПробы);

	// 4. Транзакции: Раздельная фиксация vs Пакетная
	ЧислоЗаписей = Макс(2, Цел(15 * Масштаб));
	РезРаздельно = БенчмаркПробы.ПробаФиксацияТранзакции(
		СправочникиБазы.Товары, СправочникиБазы.Склады[0], ЧислоЗаписей, Ложь, ИдентификаторСерии);
	ДанныеПробы = Новый Структура("КодПробы,НаименованиеПробы,ЗначениеМетрики",
		"TX_SPLIT", "Транзакции: Раздельная фиксация", РезРаздельно.ДлительностьМс);
	ДанныеПробы.Вставить("ЦелевоеЗначение", Макс(20, 250 * Масштаб));
	ДанныеПробы.Вставить("ЕдиницаИзмерения", "мс");
	ДанныеПробы.Вставить("КонтрольнаяСумма", РезРаздельно.КонтрольнаяСумма);
	ДанныеПробы.Вставить("Детали", "Документов: " + Строка(ЧислоЗаписей));
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, ДанныеПробы);

	РезПакет = БенчмаркПробы.ПробаФиксацияТранзакции(
		СправочникиБазы.Товары, СправочникиБазы.Склады[0], ЧислоЗаписей, Истина, ИдентификаторСерии);
	ДанныеПробы = Новый Структура("КодПробы,НаименованиеПробы,ЗначениеМетрики",
		"TX_BATCH", "Транзакции: Пакетная фиксация", РезПакет.ДлительностьМс);
	ДанныеПробы.Вставить("ЦелевоеЗначение", Макс(15, 150 * Масштаб));
	ДанныеПробы.Вставить("ЕдиницаИзмерения", "мс");
	ДанныеПробы.Вставить("КонтрольнаяСумма", РезПакет.КонтрольнаяСумма);
	ДанныеПробы.Вставить("Детали", "Документов: " + Строка(ЧислоЗаписей));
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, ДанныеПробы);

	// 5. БД: Выборка, соединение, группировка и сортировка по документам серии
	РезВыборка = БенчмаркПробы.ПробаВыборкаСоединениеСортировка(ИдентификаторСерии);
	ДанныеПробы = Новый Структура("КодПробы,НаименованиеПробы,ЗначениеМетрики",
		"DB_JOIN", "БД: Выборка, соединение и сортировка", РезВыборка.ДлительностьМс);
	ДанныеПробы.Вставить("ЦелевоеЗначение", Макс(10, 80 * Масштаб));
	ДанныеПробы.Вставить("ЕдиницаИзмерения", "мс");
	ДанныеПробы.Вставить("КонтрольнаяСумма", РезВыборка.ИтогоСумма);
	ДанныеПробы.Вставить("Детали", "Строк результата: " + Строка(РезВыборка.КоличествоСтрок)
		+ "; повторов для разрешения часов: " + Строка(РезВыборка.ЧислоПовторов));
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, ДанныеПробы);

	// 6. Прикладная операция: Проведение документа на 20/200 строк
	ЧислоСтрокДок = Макс(10, Цел(200 * Масштаб));
	ПараметрыДок = Новый Структура;
	ПараметрыДок.Вставить("Товары", СправочникиБазы.Товары);
	ПараметрыДок.Вставить("Склад", СправочникиБазы.Склады[0]);
	ПараметрыДок.Вставить("ЧислоСтрок", ЧислоСтрокДок);
	ПараметрыДок.Вставить("ИдентификаторСерии", ИдентификаторСерии);
	ПараметрыДок.Вставить("Проводить", Ложь);
	СозданныйДок = БенчмаркГенераторДанных.СоздатьДокументДвижения(ПараметрыДок);
	РезПроведение = БенчмаркПробы.ПробаПроведениеДокумента(СозданныйДок.Ссылка);
	ДанныеПробы = Новый Структура("КодПробы,НаименованиеПробы,ЗначениеМетрики",
		"DOC_POST", "Операция: Проведение документа", РезПроведение.ДлительностьМс);
	ДанныеПробы.Вставить("ЦелевоеЗначение", Макс(20, 200 * Масштаб));
	ДанныеПробы.Вставить("ЕдиницаИзмерения", "мс");
	ДанныеПробы.Вставить("КонтрольнаяСумма", РезПроведение.СуммаКоличество);
	ДанныеПробы.Вставить("Детали", "Движений: " + Строка(РезПроведение.КоличествоДвижений));
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, ДанныеПробы);

	// 7. CPU и планировщик: BSL-сигналы 002–010. Это сравнительные программные
	// замеры; они не подтверждают машинный код, affinity, IRQ или счётчики гипервизора.
	РазмерCPU = Макс(4000, Цел(40000 * Масштаб));
	Рез002 = БенчмаркПроба002НезависимыеИнструкции.Проба002_НезависимыеИнструкции(РазмерCPU);
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, СоздатьДанныеПроб(
		"002", "CPU: Независимые цепочки BSL", Рез002.НезависимаяНсНаОперацию, 1000,
		"нс/операцию", Рез002.КонтрольнаяСумма, Рез002.Детали));

	Рез003 = БенчмаркПроба003АктивноеОжидание.Проба003_АктивноеОжидание(5, 1);
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, СоздатьДанныеПроб(
		"003", "CPU: Запаздывание активного ожидания BSL", Рез003.МаксимальноеЗапаздываниеМс, 2,
		"мс", Рез003.СреднееЗапаздываниеМс, Рез003.Детали));

	Рез004 = БенчмаркПроба004СервисноеВремяКороткихЗадач.Проба004_СервисноеВремяКороткихЗадач(5, Макс(100, Цел(5000 * Масштаб)));
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, СоздатьДанныеПроб(
		"004", "CPU: Сервисное время коротких задач BSL", Рез004.МедианаСервисаМс, 25,
		"мс/задачу", Рез004.КонтрольнаяСумма, Рез004.Детали));

	Рез005 = БенчмаркПроба005ПропускнаяСпособностьОкна.Проба005_ПропускнаяСпособностьВременногоОкна(25, 1000);
	НсНаОперациюОкна = ?(Рез005.ОперацийВМиллисекунду = 0, 0, 1000000 / Рез005.ОперацийВМиллисекунду);
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, СоздатьДанныеПроб(
		"005", "CPU: Пропускная способность временного окна", НсНаОперациюОкна, 1000,
		"нс/операцию", Рез005.КонтрольнаяСумма, Рез005.Детали));

	Рез006 = БенчмаркПроба006ПараллельныеЦепочки.Проба006_ПараллельныеЦепочкиВОдномПотоке(РазмерCPU);
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, СоздатьДанныеПроб(
		"006", "CPU: Чередование независимых цепочек BSL", Рез006.ВремяДвухЦепочекМс, 100,
		"мс", Рез006.КонтрольнаяСумма, Рез006.Детали));

	Рез007 = БенчмаркПроба007РазбросВремениПорций.Проба007_РазбросВремениПорций(3, Макс(1000, Цел(10000 * Масштаб)));
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, СоздатьДанныеПроб(
		"007", "CPU: Разброс времени BSL-порций", Рез007.РазбросМс, 5,
		"мс", Рез007.КонтрольнаяСумма, Рез007.Детали));

	Рез008 = БенчмаркПроба008ПервыйБлок.Проба008_ПервыйБлокТекущегоВызова(Макс(1000, Цел(20000 * Масштаб)), 2);
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, СоздатьДанныеПроб(
		"008", "CPU: Первый блок относительно прогретых", Рез008.ПервыйБлокМс, 50,
		"мс", Рез008.КонтрольнаяСумма, Рез008.Детали));

	Рез009 = БенчмаркПроба009УстойчиваяСкорость.Проба009_УстойчиваяСкорость(3, Макс(1000, Цел(20000 * Масштаб)));
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, СоздатьДанныеПроб(
		"009", "CPU: Устойчивая скорость BSL", Рез009.МедианаМс, 50,
		"мс/серия", Рез009.КонтрольнаяСумма, Рез009.Детали));

	Рез010 = БенчмаркПроба010ВыбросыВремениПорций.Проба010_ВыбросыВремениПорций(5, Макс(1000, Цел(10000 * Масштаб)));
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, СоздатьДанныеПроб(
		"010", "CPU: Хвост задержки BSL-порций", Рез010.P95Мс, 50,
		"мс", Рез010.КонтрольнаяСумма, Рез010.Детали));

	Рез011 = БенчмаркПроба011РасчетнаяЭффективностьvCPU.Проба011_РасчетнаяЭффективностьvCPU(1, 3, Макс(10000, Цел(100000 * Масштаб)));
	ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, СоздатьДанныеПроб(
		"011", "CPU: Расчетная эффективность vCPU", Рез011.НсНаИтерацию, 250,
		"нс/итерацию", Рез011.КонтрольнаяСумма, Рез011.Детали));

	БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);

	СуммаЛогИндексов = 0;
	МинБалл = 101;
	КоличествоОцениваемыхПроб = 0;
	ГлавноеУзкоеМесто = "";
	Для Каждого Элемент Из Результаты Цикл
		Если Элемент.Статус <> "Косвенный сигнал" Тогда
			СуммаЛогИндексов = СуммаЛогИндексов + Log(Элемент.Индекс);
			КоличествоОцениваемыхПроб = КоличествоОцениваемыхПроб + 1;
			Если Элемент.Индекс < МинБалл Тогда
				МинБалл = Элемент.Индекс;
				ГлавноеУзкоеМесто = Строка(Элемент.КодПробы) + " ("
					+ Строка(Элемент.НаименованиеПробы) + ")";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоОцениваемыхПроб = 0 Тогда
		ВызватьИсключение "В прогоне нет прямых проб для расчёта индекса";
	КонецЕсли;

	Если МинБалл >= 100 Тогда
		ГлавноеУзкоеМесто = "Все прямые пробы в целевом бюджете";
	КонецЕсли;

	ОбщийБалл = Окр(Exp(СуммаЛогИндексов / КоличествоОцениваемыхПроб), 1);

	Итог = Новый Структура;
	Итог.Вставить("ИдентификаторПрогона", ИдентификаторПрогона);
	Итог.Вставить("ОбщийБалл", ОбщийБалл);
	Итог.Вставить("КоличествоОцениваемыхПроб", КоличествоОцениваемыхПроб);
	Итог.Вставить("ГлавноеУзкоеМесто", ГлавноеУзкоеМесто);
	Итог.Вставить("Результаты", Результаты);
	Возврат Итог;

КонецФункции

// Возвращает сохранённые записи регистра РезультатыПрогонов по идентификатору прогона.
//
// Параметры:
//  ИдентификаторПрогона - Строка - идентификатор прогона.
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки результатов прогона.
//
Функция ПолучитьРезультатыПрогона(Знач ИдентификаторПрогона) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РезультатыПрогонов.КодПробы КАК КодПробы,
	|	РезультатыПрогонов.НаименованиеПробы КАК НаименованиеПробы,
	|	РезультатыПрогонов.ЗначениеМетрики КАК ЗначениеМетрики,
	|	РезультатыПрогонов.ЦелевоеЗначение КАК ЦелевоеЗначение,
	|	РезультатыПрогонов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	РезультатыПрогонов.Баллы КАК Баллы,
	|	РезультатыПрогонов.Индекс КАК Индекс,
	|	РезультатыПрогонов.Статус КАК Статус,
	|	РезультатыПрогонов.КонтрольнаяСумма КАК КонтрольнаяСумма,
	|	РезультатыПрогонов.Детали КАК Детали
	|ИЗ
	|	РегистрСведений.РезультатыПрогонов КАК РезультатыПрогонов
	|ГДЕ
	|	РезультатыПрогонов.ИдентификаторПрогона = &ИдентификаторПрогона
	|
	|УПОРЯДОЧИТЬ ПО
	|	Индекс ВОЗР";
	Запрос.УстановитьПараметр("ИдентификаторПрогона", ИдентификаторПрогона);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Удаляет записи регистра РезультатыПрогонов для указанного прогона.
//
// Параметры:
//  ИдентификаторПрогона - Строка - идентификатор прогона.
//
Процедура ОчиститьРезультатыПрогона(Знач ИдентификаторПрогона) Экспорт

	НаборЗаписей = РегистрыСведений.РезультатыПрогонов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторПрогона.Установить(ИдентификаторПрогона);
	НаборЗаписей.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КомментарийCPU(Замер, БазаНс)
	Если Замер.ЭквивалентЭталонаМГц <> Неопределено Тогда
		Текст = Строка(Замер.ЭквивалентЭталонаМГц) + " усл. МГц BSL";
	ИначеЕсли БазаНс = Неопределено Тогда
		Текст = "Усл. МГц BSL: шкала отключена";
	Иначе
		Текст = "Усл. МГц BSL: серия короче 10 мс";
	КонецЕсли;
	Текст = Текст + "; медиана " + Строка(Замер.МедианаМс) + " мс; итераций " + Строка(Замер.ИтерацийВСерии);
	Если Замер.МлнИтерацийВСекунду <> Неопределено Тогда
		Текст = Текст + "; " + Строка(Окр(Замер.МлнИтерацийВСекунду, 3)) + " млн итер/с";
	КонецЕсли;
	Если БазаНс <> Неопределено Тогда
		Текст = Текст + "; база шкалы " + Строка(БазаНс) + " нс/итер при 3000 усл. МГц";
	КонецЕсли;
	Возврат Текст;
КонецФункции

Процедура ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, ДанныеПробы)

	КосвенныйСигнал = Ложь;
	Если ДанныеПробы.Свойство("КосвенныйСигнал", КосвенныйСигнал) И КосвенныйСигнал Тогда
		Оценка = Новый Структура("Баллы,Индекс,Статус", 0, 0, "Косвенный сигнал");
	Иначе
		Оценка = ОценитьПоказатель(ДанныеПробы.ЗначениеМетрики, ДанныеПробы.ЦелевоеЗначение);
	КонецЕсли;
	СтатусРезультата = Оценка.Статус;

	МенеджерЗаписи = РегистрыСведений.РезультатыПрогонов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторПрогона = КонтекстПрогона.ИдентификаторПрогона;
	МенеджерЗаписи.КодПробы = ДанныеПробы.КодПробы;
	МенеджерЗаписи.ДатаПрогона = КонтекстПрогона.ДатаПрогона;
	МенеджерЗаписи.НаименованиеПробы = ДанныеПробы.НаименованиеПробы;
	МенеджерЗаписи.ЗначениеМетрики = ДанныеПробы.ЗначениеМетрики;
	МенеджерЗаписи.ЦелевоеЗначение = ДанныеПробы.ЦелевоеЗначение;
	МенеджерЗаписи.ЕдиницаИзмерения = ДанныеПробы.ЕдиницаИзмерения;
	МенеджерЗаписи.Баллы = Оценка.Баллы;
	МенеджерЗаписи.Индекс = Оценка.Индекс;
	МенеджерЗаписи.Статус = СтатусРезультата;
	МенеджерЗаписи.КонтрольнаяСумма = ДанныеПробы.КонтрольнаяСумма;
	МенеджерЗаписи.Детали = ДанныеПробы.Детали;
	МенеджерЗаписи.Записать(Истина);

	СтрокаРезультата = Новый Структура;
	СтрокаРезультата.Вставить("КодПробы", ДанныеПробы.КодПробы);
	СтрокаРезультата.Вставить("НаименованиеПробы", ДанныеПробы.НаименованиеПробы);
	СтрокаРезультата.Вставить("ЗначениеМетрики", ДанныеПробы.ЗначениеМетрики);
	СтрокаРезультата.Вставить("ЦелевоеЗначение", ДанныеПробы.ЦелевоеЗначение);
	СтрокаРезультата.Вставить("ЕдиницаИзмерения", ДанныеПробы.ЕдиницаИзмерения);
	СтрокаРезультата.Вставить("Баллы", Оценка.Баллы);
	СтрокаРезультата.Вставить("Индекс", Оценка.Индекс);
	СтрокаРезультата.Вставить("Статус", СтатусРезультата);
	СтрокаРезультата.Вставить("Детали", ДанныеПробы.Детали);
	Результаты.Добавить(СтрокаРезультата);

КонецПроцедуры

Функция СоздатьДанныеПроб(КодПробы, НаименованиеПробы, ЗначениеМетрики, ЦелевоеЗначение,
	ЕдиницаИзмерения, КонтрольнаяСумма, Детали)

	ДанныеПробы = Новый Структура("КодПробы,НаименованиеПробы,ЗначениеМетрики",
		КодПробы, НаименованиеПробы, ЗначениеМетрики);
	ДанныеПробы.Вставить("ЦелевоеЗначение", ЦелевоеЗначение);
	ДанныеПробы.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);
	ДанныеПробы.Вставить("КонтрольнаяСумма", КонтрольнаяСумма);
	ДанныеПробы.Вставить("Детали", Детали);
	ДанныеПробы.Вставить("КосвенныйСигнал", Истина);
	Возврат ДанныеПробы;

КонецФункции

