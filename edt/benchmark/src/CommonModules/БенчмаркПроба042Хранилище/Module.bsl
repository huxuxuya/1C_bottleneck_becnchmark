		Результат.ДлительностьМс, "мс", СтатусХранилища, Причина,
		Результат.ДатаНачалаUTC, Результат.ДатаЗавершенияUTC, Результат.КонтрольнаяСумма,
		Параметры + "; " + Результат.Комментарий, Ряд, "сервер 1С",
		"BSL FileStream", "временный файл", 1,
		НомерПовтора, 1, "измерение", 1, Результат.ДлительностьМс, 1000);
	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
		СсылкаНаПрогон, Точка, "file.throughput_mib_s", "042", "042. Скорость файловой операции",
		Результат.МиБайтВСекунду, "МиБ/с", СтатусХранилища, Причина,
