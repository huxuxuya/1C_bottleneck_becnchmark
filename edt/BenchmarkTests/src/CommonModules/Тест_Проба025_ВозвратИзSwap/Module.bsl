#Область ПрограммныйИнтерфейс
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТестовыйНабор("Память и кэши CPU")
		.ДобавитьСерверныйТест("Тест_Проба025_ВозвратИзSwap");
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба025_ВозвратИзSwap() Экспорт
	До = СоздатьВариант("До", 10000000, 0, 0);
	После = СоздатьВариант("После", 30000000, 20971520, 40);
	Результат = БенчмаркПроба025ВозвратИзSwap.СравнитьВозвратИзSwap(До, После);
	ЮТест.ОжидаетЧто(Результат.ИзменениеВремениОбходаПроцентов).Равно(200);
	ЮТест.ОжидаетЧто(Результат.ВытеснениеПодтверждено).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.Классификация)
		.Равно("Возврат вытесненных страниц подтверждён swap-in/page fault и ростом задержки");

	После.Наблюдения[0].КонтрольнаяСумма = 99;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба025ВозвратИзSwap.СравнитьВозвратИзSwap(До, После);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);
КонецПроцедуры

Функция СоздатьВариант(Фаза, ВремяНс, SwapInБайт, MajorFaults)
	Наблюдения = Новый Массив;
	Для Индекс = 1 По 3 Цикл
		Наблюдения.Добавить(Новый Структура("ДлительностьОбходаНс,SwapInБайт,MajorFaults,ЧислоСтраниц,КонтрольнаяСумма",
			ВремяНс, SwapInБайт, MajorFaults, 8192, 1003));
	КонецЦикла;
	Возврат Новый Структура("Фаза,ИдентификаторСтенда,ИдентификаторРабочегоНабора,РабочийНаборБайт,ЧислоСтраниц,Наблюдения",
		Фаза, "swap-lab", "anonymous-set-A", 33554432, 8192, Наблюдения);
КонецФункции
#КонецОбласти
