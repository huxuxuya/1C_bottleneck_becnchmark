Процедура ДобавитьТочкуПлана(ДокументПрогона, ИдентификаторТочки, КодПробы,
	КодМетрики, Название, ЦелевоеЗначение, ЕдиницаИзмерения, ЧислоПовторов, Параметры)

	СтрокаПлана = ДокументПрогона.ТочкиПлана.Добавить();
	СтрокаПлана.ИдентификаторТочки = ИдентификаторТочки;
	СтрокаПлана.КодПробы = КодПробы;
	СтрокаПлана.ВерсияМетодики = "1";
	СтрокаПлана.ИдентификаторРеализации = "bsl-core-0.0.3";
	СтрокаПлана.Вариант = "A";
	СтрокаПлана.Фактор = "тип операции";
	СтрокаПлана.ЗаданноеЗначение = ЦелевоеЗначение;
	СтрокаПлана.ЕдиницаИзмерения = ЕдиницаИзмерения;
	СтрокаПлана.Параметры = "metric=" + КодМетрики + ";" + Параметры;
	СтрокаПлана.ЧислоПовторов = ЧислоПовторов;

КонецПроцедуры

