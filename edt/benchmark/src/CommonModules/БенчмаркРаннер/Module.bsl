	КонецПопытки;

	БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);

	Сводка = РассчитатьСводкуПоРезультатам(Результаты);
	ОбщийБалл = Сводка.ОбщийБалл;
	КоличествоОцениваемыхПроб = Сводка.КоличествоОцениваемыхПроб;
	ГлавноеУзкоеМесто = Сводка.ГлавноеУзкоеМесто;
	СтатусПрогона = ?(Сводка.КоличествоОцениваемыхПроб = Сводка.ОжидаемоеКоличествоПроб,
