// Базовый серверный модуль ядра конфигурации-бенчмарка.

#Область ПрограммныйИнтерфейс

// Выполняет простую детерминированную нагрузку на CPU (для smoke-проверки и калибровки).
//
// Параметры:
//  ЧислоИтераций - Число - количество итераций расчёта.
//
// Возвращаемое значение:
//  Структура - результат расчёта (Сумма, ДлительностьМс).
//
Функция ВыполнитьТестовыйРасчет(Знач ЧислоИтераций = 1000) Экспорт

	Если ЧислоИтераций < 0 Тогда
		ВызватьИсключение "Число итераций не может быть отрицательным";
	КонецЕсли;

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Аккумулятор = 0;

	Для Индекс = 1 По ЧислоИтераций Цикл
		Аккумулятор = Аккумулятор + (Индекс * 31) % 997;
	КонецЦикла;

	КонецМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Результат = Новый Структура;
	Результат.Вставить("Сумма", Аккумулятор);
	Результат.Вставить("ДлительностьМс", КонецМс - НачалоМс);
	Возврат Результат;

КонецФункции

#КонецОбласти
