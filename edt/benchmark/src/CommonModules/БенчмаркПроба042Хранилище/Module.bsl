// Серверная BSL-проба последовательного файлового ввода-вывода через FileStream.
// Измеряет время файлового API вместе с кэшированием ОС; не имитирует direct I/O/fsync.

#Область ПрограммныйИнтерфейс

// Выполняет три пары последовательных операций над временным файлом сервера.
// Результаты каждой операции сохраняются отдельно до возврата на клиент.
Функция ВыполнитьПрогон(Знач ИдентификаторПрогона = "") Экспорт

	РазмерФайлаБайт = 67108864; // 64 МиБ
	РазмерБлокаБайт = 1048576; // 1 МиБ
	КоличествоБлоков = РазмерФайлаБайт / РазмерБлокаБайт;
	КоличествоПовторов = 3;
	Если ПустаяСтрока(ИдентификаторПрогона) Тогда
		ИдентификаторПрогона = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	ПутьФайла = "";
	ПутиФайлов = Новый Массив;
	БуферЗаписи = БенчмаркЯдро.СоздатьБуферПробныхДанных(РазмерБлокаБайт);
	ОжидаемаяСуммаБлока = КонтрольнаяСуммаБлока(БуферЗаписи, РазмерБлокаБайт);
	Параметры = "Размер файла: 67108864 байт; блок: 1048576 байт; блоков: 64; повторов: 3; режим: последовательный; таймер: миллисекунды";
	КлючСопоставимости = "bsl-filestream-v1|67108864|1048576|sequential";
	ЧислоОшибок = 0;
	СсылкаНаПрогон = БенчмаркХранилищеПрогонов.СоздатьПрогон(
		ИдентификаторПрогона, 1, "server", "file042");

	Попытка
		Для НомерПовтора = 1 По КоличествоПовторов Цикл
			// Каждый повтор получает отдельное новое имя и не зависит от содержимого прошлого файла.
			ПутьФайла = ПолучитьИмяВременногоФайла("bin");
			ПутиФайлов.Добавить(ПутьФайла);
			РезультатЗаписи = ИзмеритьЗапись(ПутьФайла, БуферЗаписи,
				РазмерФайлаБайт, РазмерБлокаБайт, КоличествоБлоков,
				ОжидаемаяСуммаБлока);
			ЗаписатьТочку(ИдентификаторПрогона, СсылкаНаПрогон, НомерПовтора, "write", ПутьФайла,
				Параметры, КлючСопоставимости, РезультатЗаписи);
			Если РезультатЗаписи.Статус <> "успешно" Тогда
				ЧислоОшибок = ЧислоОшибок + 1;
				ЗаписатьТочку(ИдентификаторПрогона, СсылкаНаПрогон, НомерПовтора, "read", ПутьФайла,
					Параметры, КлючСопоставимости,
					Новый Структура("Статус,ОбъемБайт,ДлительностьМс,МиБайтВСекунду,КонтрольнаяСумма,Комментарий,ДатаНачалаUTC,ДатаЗавершенияUTC",
						"пропуск", 0, 0, 0, 0, "Чтение пропущено: запись завершилась с ошибкой",
						ТекущаяУниверсальнаяДата(), ТекущаяУниверсальнаяДата()));
			Иначе
				РезультатЧтения = ИзмеритьЧтение(ПутьФайла, РазмерБлокаБайт,
					РазмерФайлаБайт, КоличествоБлоков, ОжидаемаяСуммаБлока);
				ЗаписатьТочку(ИдентификаторПрогона, СсылкаНаПрогон, НомерПовтора, "read", ПутьФайла,
					Параметры, КлючСопоставимости, РезультатЧтения);
				Если РезультатЧтения.Статус <> "успешно" Тогда
					ЧислоОшибок = ЧислоОшибок + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ОписаниеСбоя = ОписаниеОшибки();
		БенчмаркХранилищеПрогонов.ЗавершитьПрогон(СсылкаНаПрогон,
			"Частично завершён", ОписаниеСбоя);
		ОшибкаОчистки = УдалитьВременныеФайлы(ПутиФайлов);
		Если Не ПустаяСтрока(ОшибкаОчистки) Тогда
			ОписаниеСбоя = ОписаниеСбоя + Символы.ПС
				+ "Ошибки очистки временных файлов:" + Символы.ПС + ОшибкаОчистки;
		КонецЕсли;
		ВызватьИсключение ОписаниеСбоя;
	КонецПопытки;

	ОшибкаОчистки = УдалитьВременныеФайлы(ПутиФайлов);
	БенчмаркХранилищеПрогонов.ЗавершитьПрогон(СсылкаНаПрогон,
		?(ЧислоОшибок = 0, "Завершён", "Частично завершён"),
		?(ЧислоОшибок = 0, ОшибкаОчистки, "Ошибки отдельных файловых операций"));

	Итог = Новый Структура;
	Итог.Вставить("ИдентификаторПрогона", ИдентификаторПрогона);
	Итог.Вставить("ПутьФайла", ПутьФайла);
	Итог.Вставить("КоличествоТочек", КоличествоПовторов * 2);
	Итог.Вставить("КоличествоОшибок", ЧислоОшибок);
	Итог.Вставить("ОшибкаОчистки", ОшибкаОчистки);
	Возврат Итог;

КонецФункции

// Возвращает сохранённые операции одного прогона в порядке повторов.
Функция ПолучитьТочкиПрогона(Знач ИдентификаторПрогона) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| Результаты.ИдентификаторТочки КАК ИдентификаторТочки,
	| Результаты.КлючСопоставимости КАК КлючСопоставимости,
	| Результаты.НомерПовтора КАК НомерПовтора,
	| Результаты.Операция КАК Операция,
	| Результаты.Статус КАК Статус,
	| Результаты.ОбъемБайт КАК ОбъемБайт,
	| Результаты.ДлительностьМс КАК ДлительностьМс,
	| Результаты.МиБайтВСекунду КАК МиБайтВСекунду,
	| Результаты.КонтрольнаяСумма КАК КонтрольнаяСумма,
	| Результаты.ПутьФайла КАК ПутьФайла,
	| Результаты.Параметры КАК Параметры,
	| Результаты.Комментарий КАК Комментарий
	|ИЗ
	| РегистрСведений.РезультатыФайловойПроб042 КАК Результаты
	|ГДЕ
	| Результаты.ИдентификаторПрогона = &ИдентификаторПрогона
	|УПОРЯДОЧИТЬ ПО
	| Результаты.НомерПовтора,
	| Результаты.Операция";
	Запрос.УстановитьПараметр("ИдентификаторПрогона", ИдентификаторПрогона);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Сравнивает одноимённые операции при совпадающей версии методики и параметрах.
Функция СравнитьПрогоны(Знач ИдентификаторПрогонаA, Знач ИдентификаторПрогонаB) Экспорт

	ТочкиA = ПолучитьТочкиПрогона(ИдентификаторПрогонаA);
	ТочкиB = ПолучитьТочкиПрогона(ИдентификаторПрогонаB);
	Если ТочкиA.Количество() = 0 Или ТочкиB.Количество() = 0 Тогда
		ВызватьИсключение "Для сравнения нужны сохранённые точки обоих прогонов";
	КонецЕсли;

	КлючA = ТочкиA[0].КлючСопоставимости;
	КлючB = ТочкиB[0].КлючСопоставимости;
	Если КлючA <> КлючB Тогда
		ВызватьИсключение "Параметры пробы различаются; сравнение отклонено";
	КонецЕсли;

	ИндексB = Новый Соответствие;
	Для Каждого ТочкаB Из ТочкиB Цикл
		ИндексB.Вставить(ТочкаB.ИдентификаторТочки, ТочкаB);
	КонецЦикла;

	Сравнение = Новый ТаблицаЗначений;
	Сравнение.Колонки.Добавить("ИдентификаторТочки");
	Сравнение.Колонки.Добавить("НомерПовтора");
	Сравнение.Колонки.Добавить("Операция");
	Сравнение.Колонки.Добавить("МиБайтВСекундуA");
	Сравнение.Колонки.Добавить("МиБайтВСекундуB");
	Сравнение.Колонки.Добавить("ИзменениеПроцентов");
	Сравнение.Колонки.Добавить("СтатусA");
	Сравнение.Колонки.Добавить("СтатусB");

	Для Каждого ТочкаA Из ТочкиA Цикл
		СтрокаСравнения = Сравнение.Добавить();
		СтрокаСравнения.ИдентификаторТочки = ТочкаA.ИдентификаторТочки;
		СтрокаСравнения.НомерПовтора = ТочкаA.НомерПовтора;
		СтрокаСравнения.Операция = ТочкаA.Операция;
		СтрокаСравнения.СтатусA = ТочкаA.Статус;
		Если ИндексB.Получить(ТочкаA.ИдентификаторТочки) = Неопределено Тогда
			СтрокаСравнения.СтатусB = "нет пары";
			Продолжить;
		КонецЕсли;

		ТочкаB = ИндексB.Получить(ТочкаA.ИдентификаторТочки);
		СтрокаСравнения.СтатусB = ТочкаB.Статус;
		СтрокаСравнения.МиБайтВСекундуA = ТочкаA.МиБайтВСекунду;
		СтрокаСравнения.МиБайтВСекундуB = ТочкаB.МиБайтВСекунду;
		Если ТочкаA.Статус = "успешно" И ТочкаB.Статус = "успешно"
			И ТочкаA.МиБайтВСекунду > 0 Тогда
			СтрокаСравнения.ИзменениеПроцентов = Окр(
				(ТочкаB.МиБайтВСекунду / ТочкаA.МиБайтВСекунду - 1) * 100, 2);
		КонецЕсли;
	КонецЦикла;

	Возврат Сравнение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УдалитьВременныеФайлы(Знач ПутиФайлов)

	Ошибки = "";
	Для Каждого Путь Из ПутиФайлов Цикл
		Попытка
			УдалитьФайлы(Путь);
		Исключение
			Если Не ПустаяСтрока(Ошибки) Тогда
				Ошибки = Ошибки + Символы.ПС;
			КонецЕсли;
			Ошибки = Ошибки + Путь + ": " + ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;

	Возврат Ошибки;

КонецФункции

Функция КонтрольнаяСуммаБлока(Знач Буфер, Знач РазмерБуфераБайт)

	СредняяПозиция = Цел(РазмерБуфераБайт / 2);
	ПоследняяПозиция = РазмерБуфераБайт - 1;
	Возврат Буфер[0] + Буфер[СредняяПозиция] + Буфер[ПоследняяПозиция];

КонецФункции

Функция ИзмеритьЗапись(Знач ПутьФайла, Знач Буфер, Знач РазмерФайлаБайт,
	Знач РазмерБлокаБайт, Знач КоличествоБлоков, Знач КонтрольнаяСуммаБлока)

	Поток = Неопределено;
	ЗаписьДанных = Неопределено;
	ОбъемБайт = 0;
	ДлительностьМс = 0;
	КонтрольнаяСумма = 0;
	Статус = "ошибка";
	Комментарий = "";

	Попытка
		НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ДатаНачалаUTC = ТекущаяУниверсальнаяДата();
		Поток = FileStreams.OpenForWrite(ПутьФайла);
		ЗаписьДанных = Новый DataWriter(Поток);
		Для НомерБлока = 1 По КоличествоБлоков Цикл
			ЗаписьДанных.WriteBinaryDataBuffer(Буфер);
			ОбъемБайт = ОбъемБайт + РазмерБлокаБайт;
			КонтрольнаяСумма = КонтрольнаяСумма + КонтрольнаяСуммаБлока;
		КонецЦикла;
		ЗаписьДанных.Close();
		Поток.Close();
		ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
		ДатаЗавершенияUTC = ТекущаяУниверсальнаяДата();
		Если ДлительностьМс > 0 Тогда
			Статус = "успешно";
		Иначе
			Статус = "недостаточное разрешение таймера";
			Комментарий = "Операция короче разрешения таймера 1С";
		КонецЕсли;
	Исключение
		Если ДатаНачалаUTC = Неопределено Тогда
			ДатаНачалаUTC = ТекущаяУниверсальнаяДата();
		КонецЕсли;
		ДатаЗавершенияUTC = ТекущаяУниверсальнаяДата();
		Комментарий = ОписаниеОшибки();
		ЗакрытьИзмерительныйПоток(ЗаписьДанных);
		ЗакрытьИзмерительныйПоток(Поток);
	КонецПопытки;

	Возврат СформироватьРезультатОперации(Статус, ОбъемБайт, ДлительностьМс,
		КонтрольнаяСумма, Комментарий, ДатаНачалаUTC, ДатаЗавершенияUTC);

КонецФункции

Функция ИзмеритьЧтение(Знач ПутьФайла, Знач РазмерБлокаБайт,
	Знач РазмерФайлаБайт, Знач КоличествоБлоков, Знач ОжидаемаяСуммаБлока)

	Поток = Неопределено;
	ЧтениеДанных = Неопределено;
	ОбъемБайт = 0;
	ДлительностьМс = 0;
	КонтрольнаяСумма = 0;
	Статус = "ошибка";
	Комментарий = "";

	Попытка
		НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ДатаНачалаUTC = ТекущаяУниверсальнаяДата();
		Поток = FileStreams.OpenForRead(ПутьФайла);
		ЧтениеДанных = Новый DataReader(Поток);
		Для НомерБлока = 1 По КоличествоБлоков Цикл
			Буфер = ЧтениеДанных.ReadIntoBinaryDataBuffer(РазмерБлокаБайт);
			Если ЧтениеДанных.ReadCompleted Тогда
				Статус = "ошибка данных";
				Комментарий = "Файл закончился раньше ожидаемого блока";
				Прервать;
			КонецЕсли;
			СуммаБлока = КонтрольнаяСуммаБлока(Буфер, РазмерБлокаБайт);
			КонтрольнаяСумма = КонтрольнаяСумма + СуммаБлока;
			ОбъемБайт = ОбъемБайт + РазмерБлокаБайт;
			Если СуммаБлока <> ОжидаемаяСуммаБлока Тогда
				Статус = "ошибка данных";
				Комментарий = "Размер блока или контрольная сумма не совпали";
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ЧтениеДанных.Close();
		Поток.Close();
		ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
		ДатаЗавершенияUTC = ТекущаяУниверсальнаяДата();
		Если Статус <> "ошибка данных" Тогда
			Если ОбъемБайт <> РазмерФайлаБайт Тогда
				Статус = "ошибка данных";
				Комментарий = "Объём прочитанных данных не совпал с ожидаемым";
			ИначеЕсли ДлительностьМс > 0 Тогда
				Статус = "успешно";
			Иначе
				Статус = "недостаточное разрешение таймера";
				Комментарий = "Операция короче разрешения таймера 1С";
			КонецЕсли;
		КонецЕсли;
	Исключение
		Если ДатаНачалаUTC = Неопределено Тогда
			ДатаНачалаUTC = ТекущаяУниверсальнаяДата();
		КонецЕсли;
		ДатаЗавершенияUTC = ТекущаяУниверсальнаяДата();
		Комментарий = ОписаниеОшибки();
		ЗакрытьИзмерительныйПоток(ЧтениеДанных);
		ЗакрытьИзмерительныйПоток(Поток);
	КонецПопытки;

	Возврат СформироватьРезультатОперации(Статус, ОбъемБайт, ДлительностьМс,
		КонтрольнаяСумма, Комментарий, ДатаНачалаUTC, ДатаЗавершенияUTC);

КонецФункции

Функция СформироватьРезультатОперации(Знач Статус, Знач ОбъемБайт,
	Знач ДлительностьМс, Знач КонтрольнаяСумма, Знач Комментарий,
	Знач ДатаНачалаUTC, Знач ДатаЗавершенияUTC)

	МиБайтВСекунду = 0;
	Если ДлительностьМс > 0 Тогда
		МиБайтВСекунду = Окр(ОбъемБайт * 1000 / ДлительностьМс / 1048576, 3);
	КонецЕсли;
	Если СтрДлина(Комментарий) > 500 Тогда
		Комментарий = Лев(Комментарий, 500);
	КонецЕсли;

	Возврат Новый Структура("Статус,ОбъемБайт,ДлительностьМс,МиБайтВСекунду,КонтрольнаяСумма,Комментарий,ДатаНачалаUTC,ДатаЗавершенияUTC",
		Статус, ОбъемБайт, ДлительностьМс, МиБайтВСекунду, КонтрольнаяСумма, Комментарий,
		ДатаНачалаUTC, ДатаЗавершенияUTC);

КонецФункции

Процедура ЗакрытьИзмерительныйПоток(Знач Объект)

	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Объект.Close();
	Исключение
		// Поток мог закрыться при возникновении исходной ошибки.
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьТочку(Знач ИдентификаторПрогона, Знач СсылкаНаПрогон, Знач НомерПовтора,
	Знач Операция, Знач ПутьФайла, Знач Параметры, Знач КлючСопоставимости, Знач Результат)

	Запись = РегистрыСведений.РезультатыФайловойПроб042.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторПрогона = ИдентификаторПрогона;
	Запись.ИдентификаторТочки = "R" + Строка(НомерПовтора) + "_" + Операция;
	Запись.НомерПовтора = НомерПовтора;
	Запись.Операция = Операция;
	Запись.Статус = Результат.Статус;
	Запись.ПутьФайла = Лев(ПутьФайла, 500);
	Запись.Параметры = Параметры;
	Запись.Комментарий = Результат.Комментарий;
	Если ПустаяСтрока(Запись.Комментарий) Тогда
		Запись.Комментарий = "Контрольная сумма выбранных байтов: "
			+ Строка(Результат.КонтрольнаяСумма);
	КонецЕсли;
	Запись.ИдентификаторРеализации = "bsl-filestream-v1";
	Запись.КлючСопоставимости = КлючСопоставимости;
