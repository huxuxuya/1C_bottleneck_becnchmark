#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	МасштабНагрузки = 1;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьПрогон(Команда) Экспорт

	ВыполнитьПрогонНаСервере();

КонецПроцедуры

#КонецОбласти


// Проба 027: измеряет пустые обращения к серверу без формы и SQL.
// ПИД процесса при необходимости передаёт внешний сборщик.
&НаКлиенте
Функция ИзмеритьБазовуюЦенуСерверногоВызова(Знач ЧислоПрогревов = 3,
	Знач ЧислоСерий = 5, Знач ВызововВСерии = 20, Знач ИдентификаторПроцесса = "") Экспорт

	Если ЧислоПрогревов < 0 Или ЧислоСерий < 3 Или ВызововВСерии <= 0 Тогда
		ВызватьИсключение "Для пробы 027 нужны прогревы >= 0, минимум три серии и положительное число вызовов";
	КонецЕсли;

	Для Индекс = 1 По ЧислоПрогревов Цикл
		БенчмаркПроба027БазоваяЦенаСерверногоВызова.ПустойОбработчикБезКонтекста();
	КонецЦикла;

	Наблюдения = Новый Массив;
	Для Серия = 1 По ЧислоСерий Цикл
		НачалоКлиентаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		СуммаОбработчикаМс = 0;
		Для Индекс = 1 По ВызововВСерии Цикл
			СуммаОбработчикаМс = СуммаОбработчикаМс
				+ БенчмаркПроба027БазоваяЦенаСерверногоВызова.ПустойОбработчикБезКонтекста();
		КонецЦикла;
		ДлительностьКлиентаМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоКлиентаМс;
		Наблюдения.Добавить(Новый Структура("ЧислоВызовов,RTTНс,ВремяОбработчикаНс",
			ВызововВСерии, ДлительностьКлиентаМс * 1000000 / ВызововВСерии,
			СуммаОбработчикаМс * 1000000 / ВызововВСерии));
	КонецЦикла;

	Возврат БенчмаркПроба027БазоваяЦенаСерверногоВызова.АнализироватьНаблюдения(
		Наблюдения, ИдентификаторПроцесса);

КонецФункции

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьПрогонНаСервере()

	МасштабЗапуска = ?(МасштабНагрузки > 0, МасштабНагрузки, 1);
	Итог = БенчмаркРаннер.ВыполнитьПолныйПрогон("", МасштабЗапуска);

	ОбщийБалл = Итог.ОбщийБалл;
	ГлавноеУзкоеМесто = Итог.ГлавноеУзкоеМесто;

	Результаты.Очистить();
	Для Каждого Элемент Из Итог.Результаты Цикл
		Строка = Результаты.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Элемент);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
