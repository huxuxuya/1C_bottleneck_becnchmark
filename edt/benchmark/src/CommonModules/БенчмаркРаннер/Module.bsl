Процедура СохранитьМетрики026(Знач КонтекстПрогона, Знач Результат026)

	НачалоUTC = КонтекстПрогона.ДатаНачалаТекущейПробы;
	КонецUTC = КонтекстПрогона.ДатаЗавершенияТекущейПробы;
	КоличествоНаблюдений = Результат026.ДлительностиМс.Количество();
	ОбщиеПараметры = "iterations=" + Строка(Результат026.ИтерацийВСерии)
		+ "; samples=" + Строка(КоличествоНаблюдений)
		+ "; timer=ТекущаяУниверсальнаяДатаВМиллисекундах; resolution=1ms";
	Для ИндексНаблюдения = 0 По КоличествоНаблюдений - 1 Цикл
		НомерПовтора = ИндексНаблюдения + 1;
		ДлительностьМс = Результат026.ДлительностиМс[ИндексНаблюдения];
		ВремяИтерацииНс = ДлительностьМс * 1000000 / Результат026.ИтерацийВСерии;
		ДеталиНаблюдения = ОбщиеПараметры + "; repeat=" + Строка(НомерПовтора);
		СтатусВремени = ?(ДлительностьМс > 0, "успешно", "Недостаточно разрешения таймера");
		ПричинаВремени = ?(ДлительностьМс > 0, "", "Измерительный интервал не превысил разрешение часов BSL");
		БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
			КонтекстПрогона.СсылкаНаПрогон, "BSL_ADAPTIVE_SPEED", "bsl.batch.wall_ms", "026",
			"026. Длительность BSL-пакета", ДлительностьМс, "мс/пакет",
			СтатусВремени, ПричинаВремени, НачалоUTC, КонецUTC, Результат026.КонтрольнаяСумма,
			ДеталиНаблюдения, "server.process", "сервер 1С", "BSL", "выполнение пакета", 1,
			НомерПовтора, 1, "измерение", 1, ДлительностьМс, 1);
		БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
			КонтекстПрогона.СсылкаНаПрогон, "BSL_ADAPTIVE_SPEED", "bsl.batch.iterations", "026",
			"026. Итерации в BSL-пакете", Результат026.ИтерацийВСерии, "итераций/пакет",
			"успешно", "", НачалоUTC, КонецUTC, Результат026.КонтрольнаяСумма,
			ДеталиНаблюдения, "server.process", "сервер 1С", "BSL", "выполнение пакета", 1,
			НомерПовтора, 1, "измерение", 1, Результат026.ИтерацийВСерии, 1);
		БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
			КонтекстПрогона.СсылкаНаПрогон, "BSL_ADAPTIVE_SPEED", "bsl.iteration.mean_ns", "026",
			"026. Время одной итерации", ВремяИтерацииНс, "нс/итерацию",
			СтатусВремени, ПричинаВремени, НачалоUTC, КонецUTC, Результат026.КонтрольнаяСумма,
			ДеталиНаблюдения, "server.process", "сервер 1С", "BSL", "итерация", 1,
			НомерПовтора, 1, "измерение", 1, ДлительностьМс * 1000000,
			Результат026.ИтерацийВСерии);
	КонецЦикла;

	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
		КонтекстПрогона.СсылкаНаПрогон, "BSL_ADAPTIVE_SPEED", "bsl.batch.wall_ms", "026",
		"026. Медианная длительность BSL-пакета", Результат026.МедианаМс, "мс/пакет",
		"успешно", "", НачалоUTC, КонецUTC, Результат026.КонтрольнаяСумма,
		ОбщиеПараметры, "server.process", "сервер 1С", "BSL", "выполнение пакета", 1,
		1, 1, "измерение", КоличествоНаблюдений, Результат026.МедианаМс, 1, "медиана");
	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
		КонтекстПрогона.СсылкаНаПрогон, "BSL_ADAPTIVE_SPEED", "bsl.batch.iterations", "026",
		"026. Число итераций в пакете", Результат026.ИтерацийВСерии, "итераций/пакет",
		"успешно", "", НачалоUTC, КонецUTC, Результат026.КонтрольнаяСумма,
		ОбщиеПараметры, "server.process", "сервер 1С", "BSL", "выполнение пакета", 1,
		1, 1, "измерение", КоличествоНаблюдений, Результат026.ИтерацийВСерии, 1, "фиксированное");
	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
		КонтекстПрогона.СсылкаНаПрогон, "BSL_ADAPTIVE_SPEED", "bsl.iteration.mean_ns", "026",
		"026. Медианное время итерации", Результат026.НсНаИтерацию, "нс/итерацию",
		"успешно", "", НачалоUTC, КонецUTC, Результат026.КонтрольнаяСумма,
		ОбщиеПараметры, "server.process", "сервер 1С", "BSL", "итерация", 1,
		1, 1, "измерение", КоличествоНаблюдений,
		Результат026.МедианаМс * 1000000, Результат026.ИтерацийВСерии, "медиана");

