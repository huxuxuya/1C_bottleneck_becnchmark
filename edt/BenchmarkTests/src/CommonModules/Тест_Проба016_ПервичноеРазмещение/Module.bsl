#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба016_ПервичноеРазмещение() Экспорт

	Однопоточно = СоздатьВариант("Однопоточно", 1, 1000, 900, 100, 100, 110, 90);
	ПоВладельцам = СоздатьВариант("ПоВладельцам", 2, 500, 480, 520, 80, 90, 100);
	Результат = БенчмаркПроба016ПервичноеРазмещение.СравнитьПервичноеРазмещение(Однопоточно, ПоВладельцам);
	ЮТест.ОжидаетЧто(Результат.ДоляЦелевыхСтраницОднопоточноПроцентов).Равно(90);
	ЮТест.ОжидаетЧто(Результат.ДоляЦелевыхСтраницПоВладельцамПроцентов).Равно(98);
	ЮТест.ОжидаетЧто(Результат.ИзменениеСоответствияПп).Равно(8);
	ЮТест.ОжидаетЧто(Результат.МедианаРасчетаОднопоточноМс).Равно(100);
	ЮТест.ОжидаетЧто(Результат.МедианаРасчетаПоВладельцамМс).Равно(90);
	ЮТест.ОжидаетЧто(Результат.ИзменениеДлительностиРасчетаПроцентов).Равно(-10);

	ПоВладельцам.РазмещениеПодтверждено = Ложь;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба016ПервичноеРазмещение.СравнитьПервичноеРазмещение(Однопоточно, ПоВладельцам);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);

КонецПроцедуры

Функция СоздатьВариант(СпособИнициализации, ЧислоВладельцев, ОжидаемыйУзел0, ФактическийУзел0, ФактическийУзел1, Время1, Время2, Время3)

	Распределение = Новый Массив;
	Распределение.Добавить(Новый Структура("УзелNUMA,ОжидаемыйОбъемБайт,ФактическийОбъемБайт", "0", ОжидаемыйУзел0, ФактическийУзел0));
	Распределение.Добавить(Новый Структура("УзелNUMA,ОжидаемыйОбъемБайт,ФактическийОбъемБайт", "1", 1000 - ОжидаемыйУзел0, ФактическийУзел1));
	Наблюдения = Новый Массив;
	Наблюдения.Добавить(Новый Структура("ДлительностьРасчетаМс,КонтрольнаяСумма", Время1, 444));
	Наблюдения.Добавить(Новый Структура("ДлительностьРасчетаМс,КонтрольнаяСумма", Время2, 444));
	Наблюдения.Добавить(Новый Структура("ДлительностьРасчетаМс,КонтрольнаяСумма", Время3, 444));
	Возврат Новый Структура("СпособИнициализации,ЧислоВладельцев,ИдентификаторСтенда,ИдентификаторНагрузки,ОбъемРабочегоНабораБайт,РазмещениеПодтверждено,РаспределениеСтраниц,Наблюдения,КонтрольнаяСумма",
		СпособИнициализации, ЧислоВладельцев, "numa-lab", "same-calculation", 1000, Истина, Распределение, Наблюдения, 444);

КонецФункции
#КонецОбласти
