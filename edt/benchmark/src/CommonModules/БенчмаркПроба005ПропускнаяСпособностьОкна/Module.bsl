#Область ПрограммныйИнтерфейс

// Измеряет число одинаковых BSL-порций, выполненных до истечения временного окна.
// Параметры:
//  ДлительностьОкнаМс - Число - размер окна в миллисекундах (> 0).
//  РазмерПорции - Число - итерации в одной порции (> 0).
// Возвращаемое значение:
//  Структура: число порций и операций, фактическое время, операций в миллисекунду,
//  контрольная сумма и пояснение методики.
Функция Проба005_ПропускнаяСпособностьВременногоОкна(Знач ДлительностьОкнаМс = 100, Знач РазмерПорции = 1000) Экспорт

	Если ДлительностьОкнаМс <= 0 Или РазмерПорции <= 0 Тогда
		ВызватьИсключение "Некорректные параметры Пробы 005";
	КонецЕсли;

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СрокМс = НачалоМс + ДлительностьОкнаМс;
	КоличествоПорций = 0;
	КонтрольнаяСумма = 0;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < СрокМс Цикл
		Замер = БенчмаркПробы.ПробаОдинПотокBSL(РазмерПорции);
		КоличествоПорций = КоличествоПорций + 1;
		КонтрольнаяСумма = КонтрольнаяСумма + Замер.КонтрольнаяСумма;
	КонецЦикла;
	ФактическоеВремяМс = Макс(1, ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс);

	Результат = Новый Структура;
	Результат.Вставить("КоличествоПорций", КоличествоПорций);
	Результат.Вставить("ЧислоОпераций", КоличествоПорций * РазмерПорции);
	Результат.Вставить("ФактическоеВремяМс", ФактическоеВремяМс);
	Результат.Вставить("ОперацийВМиллисекунду", (КоличествоПорций * РазмерПорции) / ФактическоеВремяМс);
	Результат.Вставить("КонтрольнаяСумма", КонтрольнаяСумма);
	Результат.Вставить("Детали", "BSL-пропускная способность в заданном окне; квота CPU отдельно не подтверждается");
	Возврат Результат;

КонецФункции

#КонецОбласти
