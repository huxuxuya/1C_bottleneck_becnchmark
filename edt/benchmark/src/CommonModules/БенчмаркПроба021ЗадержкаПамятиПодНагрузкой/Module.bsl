#Область ПрограммныйИнтерфейс

// Анализирует задержку зависимого чтения при измеренной фоновой полосе.
// Каждая точка содержит ЦелеваяФоноваяПолосаГБс и минимум три наблюдения с полями
// ФоноваяПолосаГБс, ЗадержкаНс, ЧислоДоступов и КонтрольнаяСумма.
Функция АнализироватьЗадержкуПодНагрузкой(Знач Точки) Экспорт

	Если Точки.Количество() < 2 Тогда
		ВызватьИсключение "Нужны минимум базовая точка и точка с фоновой нагрузкой";
	КонецЕсли;

	Результаты = Новый Массив;
	БазоваяЗадержка = 0;
	НулеваяПолосаЕсть = Ложь;
	ИдентификаторСтенда = "";
	ИдентификаторНабора = "";
	ОбъемНабора = 0;
	ИдентификаторАлгоритма = "";
	КонтрольнаяСуммаОбщая = Неопределено;
	ОбщееЧислоДоступов = 0;
	ПредыдущаяЦелеваяПолоса = -1;

	Для Каждого Точка Из Точки Цикл
		Если Точка.Наблюдения.Количество() < 3 Тогда
			ВызватьИсключение "Для каждой фоновой нагрузки нужны минимум три повтора";
		КонецЕсли;
		Если Точка.ЦелеваяФоноваяПолосаГБс < 0
			Или Точка.ЦелеваяФоноваяПолосаГБс <= ПредыдущаяЦелеваяПолоса Тогда
			ВызватьИсключение "Фоновая полоса не может быть отрицательной";
		КонецЕсли;
		Если ПустаяСтрока(ИдентификаторСтенда) Тогда
			ИдентификаторСтенда = Точка.ИдентификаторСтенда;
			ИдентификаторНабора = Точка.ИдентификаторНабора;
			ОбъемНабора = Точка.ОбъемРабочегоНабораБайт;
			ИдентификаторАлгоритма = Точка.ИдентификаторАлгоритма;
		ИначеЕсли ИдентификаторСтенда <> Точка.ИдентификаторСтенда
			Или ИдентификаторНабора <> Точка.ИдентификаторНабора
			Или ОбъемНабора <> Точка.ОбъемРабочегоНабораБайт
			Или ИдентификаторАлгоритма <> Точка.ИдентификаторАлгоритма Тогда
			ВызватьИсключение "Между точками должны совпадать стенд, набор и алгоритм";
		КонецЕсли;
		Если ПустаяСтрока(ИдентификаторСтенда) Или ПустаяСтрока(ИдентификаторНабора)
			Или ПустаяСтрока(ИдентификаторАлгоритма) Или ОбъемНабора <= 0 Тогда
			ВызватьИсключение "Укажите стенд, набор, алгоритм и положительный размер рабочего набора";
		КонецЕсли;

		ЗадержкиНс = Новый СписокЗначений;
		ПолосыГБс = Новый СписокЗначений;
		ЧислоДоступов = 0;
		КонтрольнаяСуммаТочки = Неопределено;
		Для Каждого Наблюдение Из Точка.Наблюдения Цикл
			Если Наблюдение.ЗадержкаНс <= 0 Или Наблюдение.ЧислоДоступов <= 0
				Или Наблюдение.ФоноваяПолосаГБс < 0 Тогда
				ВызватьИсключение "Задержка и число доступов должны быть положительными";
			КонецЕсли;
			Если ЧислоДоступов = 0 Тогда
				ЧислоДоступов = Наблюдение.ЧислоДоступов;
				КонтрольнаяСуммаТочки = Наблюдение.КонтрольнаяСумма;
			ИначеЕсли ЧислоДоступов <> Наблюдение.ЧислоДоступов
				Или КонтрольнаяСуммаТочки <> Наблюдение.КонтрольнаяСумма Тогда
				ВызватьИсключение "Повторы должны выполнять одинаковую зависимую работу";
			КонецЕсли;
			ЗадержкиНс.Добавить(Наблюдение.ЗадержкаНс);
			ПолосыГБс.Добавить(Наблюдение.ФоноваяПолосаГБс);
		КонецЦикла;
		Если ОбщееЧислоДоступов = 0 Тогда
			ОбщееЧислоДоступов = ЧислоДоступов;
		ИначеЕсли ОбщееЧислоДоступов <> ЧислоДоступов Тогда
			ВызватьИсключение "Число зависимых доступов должно совпадать между уровнями нагрузки";
		КонецЕсли;

		МедианаЗадержки = Медиана(ЗадержкиНс);
		МедианаПолосы = Медиана(ПолосыГБс);
		Если МедианаПолосы = 0 Тогда
			БазоваяЗадержка = МедианаЗадержки;
			НулеваяПолосаЕсть = Истина;
		КонецЕсли;
		Если КонтрольнаяСуммаОбщая = Неопределено Тогда
			КонтрольнаяСуммаОбщая = КонтрольнаяСуммаТочки;
		ИначеЕсли КонтрольнаяСуммаОбщая <> КонтрольнаяСуммаТочки Тогда
			ВызватьИсключение "Контрольная сумма зависимой цепочки должна совпадать между уровнями нагрузки";
		КонецЕсли;
		Результаты.Добавить(Новый Структура("ЦелеваяФоноваяПолосаГБс,МедианаФоновойПолосыГБс,ЧислоДоступов,МедианаЗадержкиНс,КонтрольнаяСумма",
			Точка.ЦелеваяФоноваяПолосаГБс, МедианаПолосы, ЧислоДоступов, МедианаЗадержки, КонтрольнаяСуммаТочки));
		ПредыдущаяЦелеваяПолоса = Точка.ЦелеваяФоноваяПолосаГБс;
	КонецЦикла;

	Если Не НулеваяПолосаЕсть Или БазоваяЗадержка <= 0 Тогда
		ВызватьИсключение "Нужна точка без фоновой полосы для сравнения задержки";
	КонецЕсли;
	Для Каждого РезультатТочки Из Результаты Цикл
		РезультатТочки.Вставить("ИзменениеЗадержкиКБазеПроцентов",
			(РезультатТочки.МедианаЗадержкиНс - БазоваяЗадержка) * 100 / БазоваяЗадержка);
	КонецЦикла;

	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторНабора,ОбъемРабочегоНабораБайт,ИдентификаторАлгоритма,КонтрольнаяСумма,БазоваяЗадержкаНс,Точки",
		ИдентификаторСтенда, ИдентификаторНабора, ОбъемНабора, ИдентификаторАлгоритма,
		КонтрольнаяСуммаОбщая, БазоваяЗадержка, Результаты);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Медиана(Значения)
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение)
		+ Число(Значения[Количество / 2].Значение)) / 2;
КонецФункции

#КонецОбласти
