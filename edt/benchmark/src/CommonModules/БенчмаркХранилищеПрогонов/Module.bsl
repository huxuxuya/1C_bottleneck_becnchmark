// Хранение запусков по схеме v1: документ прогона, точки плана,
// попытки, ряды измерений и скалярные итоги.

#Область ПрограммныйИнтерфейс

Функция СоздатьПрогон(Знач ИдентификаторПрогона, Знач МасштабНагрузки,
	Знач ТипКлиента = "Не определён", Знач ПрофильПлана = "baseline",
	Знач ПланПрогона = Неопределено) Экспорт

	ДокументПрогона = Документы.ПрогонИспытаний.СоздатьДокумент();
	ДокументПрогона.Номер = ИдентификаторПрогона;
	ДокументПрогона.Дата = ТекущаяУниверсальнаяДата();
	ДокументПрогона.ИдентификаторПрогона = ИдентификаторПрогона;
	ДокументПрогона.Статус = "Выполняется";
	ДокументПрогона.ДатаНачалаUTC = ТекущаяУниверсальнаяДата();
	ДокументПрогона.МасштабНагрузки = МасштабНагрузки;
	ДокументПрогона.ВерсияСхемы = "1.0";
	ДокументПрогона.ВерсияМетодики = "0.0.3";
	ДокументПрогона.ТипКлиента = ТипКлиента;
	ДокументПрогона.РежимИБ = "Не определён средствами BSL";
	ДокументПрогона.ТипСУБД = "Не определён средствами BSL";
	ДокументПрогона.ВерсияПлатформы = ПолучитьВерсиюПлатформы();
	ДокументПрогона.СнимокОкружения = "schema=1.0;platform="
		+ ДокументПрогона.ВерсияПлатформы + ";db_mode=" + ДокументПрогона.РежимИБ
		+ ";dbms=" + ДокументПрогона.ТипСУБД + ";client=" + ТипКлиента
		+ ";scale=" + Строка(МасштабНагрузки);
	ДокументПрогона.СнимокПлана = "schema=1.0;method=0.0.3;profile=" + ПрофильПлана + ";scale="
		+ Строка(МасштабНагрузки);
	ДокументПрогона.РевизияПриложения = "не зафиксирована";
	Если ПланПрогона <> Неопределено Тогда
		ДобавитьТочкиПланаИзМассива(ДокументПрогона, ПланПрогона);
	ИначеЕсли ПрофильПлана = "file042" Тогда
		ДобавитьТочкиПлана042(ДокументПрогона);
	Иначе
		ДобавитьТочкиБазовогоПлана(ДокументПрогона, МасштабНагрузки);
	КонецЕсли;
	ДокументПрогона.Записать();

	Возврат ДокументПрогона.Ссылка;

КонецФункции

Функция ПолучитьСсылкуПрогона(Знач ИдентификаторПрогона) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	| Прогоны.Ссылка КАК Ссылка
	|ИЗ
	| Документ.ПрогонИспытаний КАК Прогоны
	|ГДЕ
	| Прогоны.ИдентификаторПрогона = &ИдентификаторПрогона";
	Запрос.УстановитьПараметр("ИдентификаторПрогона", ИдентификаторПрогона);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Процедура ЗавершитьПрогон(Знач СсылкаНаПрогон, Знач Статус, Знач Причина = "") Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаПрогон) Тогда
		Возврат;
	КонецЕсли;

	ДокументПрогона = СсылкаНаПрогон.ПолучитьОбъект();
	Если ДокументПрогона = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДокументПрогона.Статус = Статус;
	ДокументПрогона.ДатаЗавершенияUTC = ТекущаяУниверсальнаяДата();
	Если Не ПустаяСтрока(Причина) Тогда
		ДокументПрогона.ПричинаЗавершения = Лев(Причина, 500);
	КонецЕсли;
	ДокументПрогона.Записать();

КонецПроцедуры

Процедура СохранитьИтогПоказателя(Знач СсылкаНаПрогон, Знач ИдентификаторТочки,
	Знач КодПоказателя, Знач КодПробы, Знач НаименованиеПробы, Знач Значение,
	Знач ЕдиницаИзмерения, Знач Статус, Знач Причина, Знач НачалоUTC,
	Знач КонецUTC, Знач КонтрольнаяСумма = 0, Знач Детали = "",
	Знач ИдентификаторРяда = "server.process", Знач РольИсполнителя = "сервер 1С",
	Знач ИсточникИзмерения = "BSL", Знач ИмяРесурса = "прикладная операция",
	Знач РазрешениеЧасовМс = 1, Знач НомерПовтора = 1,
	Знач НомерПопытки = 1, Знач Фаза = "измерение",
	Знач ЧислоНаблюдений = 1, Знач Числитель = 0,
	Знач Знаменатель = 0, Знач Статистика = "значение") Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаПрогон) Тогда
		Возврат;
	КонецЕсли;

	УспешноеИзмерение = Статус = "успешно" Или Статус = "Измерено"
		Или Статус = "ОК" Или Статус = "Замедление"
		Или Статус = "УзкоеМесто" Или Статус = "Косвенный сигнал";
	ПринимаетсяДляСравнения = УспешноеИзмерение И Статус <> "Косвенный сигнал";
	СостояниеПопытки = ?(УспешноеИзмерение, "Завершена",
		?(Статус = "Недоступно", "Недоступно",
			?(Статус = "Ошибка", "Ошибка", "Недействительна")));
	СтатусНаличия = ?(Статус = "Косвенный сигнал", "Контекст",
		?(УспешноеИзмерение, "Доступно",
			?(Статус = "Недоступно", "Недоступно", "Недействительно")));
	Если ПустаяСтрока(Причина) И Не УспешноеИзмерение Тогда
		Причина = Статус;
	КонецЕсли;

	НомерПовтораКлюча = НомерПовтора;
	НомерПопыткиКлюча = НомерПопытки;
	ИдентификаторРядаКлюча = ИдентификаторРяда;
	ЯвляетсяАгрегатом = Статистика = "медиана" Или Статистика = "фиксированное";
	Если ЯвляетсяАгрегатом Тогда
		// Сводное значение относится к прогону, а не к первой фактической попытке.
		НомерПовтораКлюча = 0;
		НомерПопыткиКлюча = 0;
		ИдентификаторРядаКлюча = ИдентификаторРяда + ".aggregate";
	Иначе
		ПопыткаЗаписи = РегистрыСведений.ПопыткиПроб.СоздатьМенеджерЗаписи();
		ПопыткаЗаписи.Прогон = СсылкаНаПрогон;
		ПопыткаЗаписи.ИдентификаторТочки = ИдентификаторТочки;
		ПопыткаЗаписи.НомерПовтора = НомерПовтораКлюча;
		ПопыткаЗаписи.НомерПопытки = НомерПопыткиКлюча;
		ПопыткаЗаписи.КодПробы = КодПробы;
		ПопыткаЗаписи.ИдентификаторРеализации = "bsl-core-0.0.3";
		ПопыткаЗаписи.Вариант = "A";
		ПопыткаЗаписи.Состояние = СостояниеПопытки;
		ПопыткаЗаписи.Причина = Лев(Причина, 500);
		ПопыткаЗаписи.Исполнитель = "сервер 1С";
		ПопыткаЗаписи.ФактическиеПараметры = Детали;
		ПопыткаЗаписи.ДатаНачалаUTC = НачалоUTC;
		ПопыткаЗаписи.ДатаЗавершенияUTC = КонецUTC;
		ПопыткаЗаписи.КонтрольнаяСумма = КонтрольнаяСумма;
		ПопыткаЗаписи.ПринятаДляСравнения = ПринимаетсяДляСравнения;
		ПопыткаЗаписи.Записать();
	КонецЕсли;

	Ряд = РегистрыСведений.РядыИзмерений.СоздатьМенеджерЗаписи();
	Ряд.Прогон = СсылкаНаПрогон;
	Ряд.ИдентификаторТочки = ИдентификаторТочки;
	Ряд.НомерПовтора = НомерПовтораКлюча;
	Ряд.НомерПопытки = НомерПопыткиКлюча;
	Ряд.ИдентификаторРяда = ИдентификаторРядаКлюча;
	Ряд.Фаза = Фаза;
	Ряд.Узел = "не определён";
	Ряд.Роль = РольИсполнителя;
	Ряд.Источник = ИсточникИзмерения;
	Ряд.Ресурс = ИмяРесурса;
	Ряд.ЕдиницаВремени = "мс";
	Ряд.РазрешениеЧасов = РазрешениеЧасовМс;
	Ряд.Записать();

	Показатель = РегистрыСведений.ПоказателиПопыток.СоздатьМенеджерЗаписи();
	Показатель.Прогон = СсылкаНаПрогон;
	Показатель.ИдентификаторТочки = ИдентификаторТочки;
	Показатель.НомерПовтора = НомерПовтораКлюча;
	Показатель.НомерПопытки = НомерПопыткиКлюча;
	Показатель.ИдентификаторРяда = ИдентификаторРядаКлюча;
	Показатель.КодМетрики = КодПоказателя;
	Показатель.ВерсияМетрики = "1";
	Показатель.Статистика = Статистика;
	Показатель.Значение = ?(УспешноеИзмерение, Значение, 0);
	Показатель.ЧислоНаблюдений = ?(УспешноеИзмерение, ЧислоНаблюдений, 0);
	Показатель.Числитель = Числитель;
	Показатель.Знаменатель = Знаменатель;
	Показатель.Наличие = СтатусНаличия;
	Показатель.ЕдиницаИзмерения = ЕдиницаИзмерения;
	Показатель.Причина = Лев(Причина, 500);
	Показатель.ВерсияАгрегатора = "1";
	Показатель.Записать();

КонецПроцедуры

Функция ПолучитьКодМетодикиДляПоказателя(Знач КодПоказателя) Экспорт

	Если КодПоказателя = "CPU_FIXED_PACKAGE" Тогда Возврат "001"; КонецЕсли;
	Если КодПоказателя = "BSL_ADAPTIVE_SPEED" Тогда Возврат "026"; КонецЕсли;
	Если КодПоказателя = "MEM_COLLECTION" Тогда Возврат "033"; КонецЕсли;
	Если КодПоказателя = "DB_POINT_QUERY" Тогда Возврат "047"; КонецЕсли;
	Если КодПоказателя = "TX_SPLIT_COMMIT" Тогда Возврат "059"; КонецЕсли;
	Если КодПоказателя = "TX_BATCH_COMMIT" Тогда Возврат "060"; КонецЕсли;
	Если КодПоказателя = "DB_JOIN_SORT" Тогда Возврат "054"; КонецЕсли;
	Если КодПоказателя = "DOC_POSTING" Тогда Возврат "080"; КонецЕсли;
	Если КодПоказателя = "CPU_INDEPENDENT" Тогда Возврат "002"; КонецЕсли;
	Если КодПоказателя = "CPU_ACTIVE_LAG" Тогда Возврат "003"; КонецЕсли;
	Если КодПоказателя = "CPU_SHORT_TASK" Тогда Возврат "004"; КонецЕсли;
	Если КодПоказателя = "CPU_WINDOW_RATE" Тогда Возврат "005"; КонецЕсли;
	Если КодПоказателя = "CPU_CHAIN_INTERLEAVE" Тогда Возврат "006"; КонецЕсли;
	Если КодПоказателя = "CPU_CHUNK_VARIANCE" Тогда Возврат "007"; КонецЕсли;
	Если КодПоказателя = "CPU_WARMUP_FIRST" Тогда Возврат "008"; КонецЕсли;
	Если КодПоказателя = "CPU_SUSTAIN_RATE" Тогда Возврат "009"; КонецЕсли;
	Если КодПоказателя = "CPU_TAIL_P95" Тогда Возврат "010"; КонецЕсли;
	Если КодПоказателя = "VCPU_EFFECTIVE_RATE" Тогда Возврат "011"; КонецЕсли;
	Если КодПоказателя = "net.small_rtt.mean_ns"
		Или КодПоказателя = "1c.empty_handler.mean_ns" Тогда Возврат "027"; КонецЕсли;
	Если КодПоказателя = "net.small_rtt.median_ns"
		Или КодПоказателя = "1c.empty_handler.median_ns" Тогда Возврат "027"; КонецЕсли;
	Если КодПоказателя = "net.small_rtt.series_mean_ns"
		Или КодПоказателя = "1c.empty_handler.series_mean_ns" Тогда Возврат "027"; КонецЕсли;
	Если Лев(КодПоказателя, 5) = "file." Тогда Возврат "042"; КонецЕсли;
	Если Лев(КодПоказателя, 11) = "diagnostic." Тогда
		Возврат Сред(КодПоказателя, 12, 3);
	КонецЕсли;
	Возврат "000";

КонецФункции

Функция ПолучитьКодМетрикиДляПоказателя(Знач КодПоказателя) Экспорт

	Если КодПоказателя = "CPU_FIXED_PACKAGE" Или КодПоказателя = "BSL_ADAPTIVE_SPEED" Тогда
		Возврат "bsl.iteration.mean_ns";
	КонецЕсли;
	Если КодПоказателя = "MEM_COLLECTION" Тогда Возврат "bsl.working_set.elapsed_ms"; КонецЕсли;
	Если КодПоказателя = "DB_POINT_QUERY" Тогда Возврат "db.point_query.elapsed_ms"; КонецЕсли;
	Если КодПоказателя = "TX_SPLIT_COMMIT" Тогда Возврат "db.transaction.split_ms"; КонецЕсли;
	Если КодПоказателя = "TX_BATCH_COMMIT" Тогда Возврат "db.transaction.batch_ms"; КонецЕсли;
	Если КодПоказателя = "DB_JOIN_SORT" Тогда Возврат "db.join_sort.elapsed_ms"; КонецЕсли;
	Если КодПоказателя = "DOC_POSTING" Тогда Возврат "db.document.posting_ms"; КонецЕсли;
	Если КодПоказателя = "net.small_rtt.median_ns"
		Или КодПоказателя = "1c.empty_handler.median_ns" Тогда Возврат КодПоказателя; КонецЕсли;
	Если Лев(КодПоказателя, 5) = "file." Или Лев(КодПоказателя, 11) = "diagnostic." Тогда
		Возврат КодПоказателя;
	КонецЕсли;
	Возврат КодПоказателя;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьВерсиюПлатформы()

	Результат = "Не определена";
	Попытка
		СведенияОПлатформе = Новый СистемнаяИнформация;
		Результат = Строка(СведенияОПлатформе.ВерсияПриложения);
	Исключение
		// Версия остаётся явно неизвестной, если API недоступен в окружении.
	КонецПопытки;
	Возврат Результат;

КонецФункции

Процедура ДобавитьТочкиБазовогоПлана(ДокументПрогона, Масштаб)

	Пункты = Новый Массив;
	Пункты.Добавить(Новый Структура("Точка,Код,Метрика,Название,Цель,Единица",
		"CPU_FIXED_PACKAGE", "001", "bsl.iteration.mean_ns", "Фиксированный BSL-пакет", 500, "нс/итер"));
	Пункты.Добавить(Новый Структура("Точка,Код,Метрика,Название,Цель,Единица",
		"BSL_ADAPTIVE_SPEED", "026", "bsl.iteration.mean_ns", "Адаптивная скорость BSL", 500, "нс/итер"));
	Пункты.Добавить(Новый Структура("Точка,Код,Метрика,Название,Цель,Единица",
		"MEM_COLLECTION", "033", "bsl.working_set.elapsed_ms", "Рабочий набор коллекции", Макс(10, 150 * Масштаб), "мс"));
	Пункты.Добавить(Новый Структура("Точка,Код,Метрика,Название,Цель,Единица",
		"DB_POINT_QUERY", "047", "db.point_query.elapsed_ms", "Точечный запрос по индексу", Макс(10, 100 * Масштаб), "мс"));
	Пункты.Добавить(Новый Структура("Точка,Код,Метрика,Название,Цель,Единица",
		"TX_SPLIT_COMMIT", "059", "db.transaction.split_ms", "Раздельная фиксация транзакций", Макс(20, 250 * Масштаб), "мс"));
	Пункты.Добавить(Новый Структура("Точка,Код,Метрика,Название,Цель,Единица",
		"TX_BATCH_COMMIT", "060", "db.transaction.batch_ms", "Пакетная фиксация транзакций", Макс(15, 150 * Масштаб), "мс"));
	Пункты.Добавить(Новый Структура("Точка,Код,Метрика,Название,Цель,Единица",
		"DB_JOIN_SORT", "054", "db.join_sort.elapsed_ms", "Соединение и сортировка", Макс(10, 80 * Масштаб), "мс"));
	Пункты.Добавить(Новый Структура("Точка,Код,Метрика,Название,Цель,Единица",
		"DOC_POSTING", "080", "db.document.posting_ms", "Проведение документа", Макс(20, 200 * Масштаб), "мс"));
	Пункты.Добавить(Новый Структура("Точка,Код,Метрика,Название,Цель,Единица",
		"CLIENT_SERVER_BASELINE", "027", "net.small_rtt.median_ns",
		"Базовая цена серверного вызова", 0, "нс/вызов"));

	Для НомерПроба = 2 По 11 Цикл
		Код = Прав("00" + Строка(НомерПроба), 3);
		Точка = "CPU_" + Код;
		Пункты.Добавить(Новый Структура("Точка,Код,Метрика,Название,Цель,Единица",
			Точка, Код, Точка, "CPU-сигнал " + Код, 0, "мс"));
	КонецЦикла;

	Для Каждого Пункт Из Пункты Цикл
		СтрокаПлана = ДокументПрогона.ТочкиПлана.Добавить();
		СтрокаПлана.ИдентификаторТочки = Пункт.Точка;
		СтрокаПлана.КодПробы = Пункт.Код;
		СтрокаПлана.ВерсияМетодики = "1";
		СтрокаПлана.ИдентификаторРеализации = "bsl-core-0.0.3";
		СтрокаПлана.Вариант = "A";
		СтрокаПлана.Фактор = "масштаб нагрузки";
		СтрокаПлана.ЗаданноеЗначение = Пункт.Цель;
		СтрокаПлана.ЕдиницаИзмерения = Пункт.Единица;
		СтрокаПлана.Параметры = "масштаб=" + Строка(Масштаб)
			+ ";metric=" + Пункт.Метрика;
		СтрокаПлана.ЧислоПовторов = 1;
		Если Пункт.Код = "026" Тогда
			СтрокаПлана.ЧислоПовторов = 7;
		ИначеЕсли Пункт.Код = "027" Тогда
			СтрокаПлана.ЧислоПовторов = 5;
			СтрокаПлана.Параметры = СтрокаПлана.Параметры
				+ "; warmup_calls=3; calls_per_series=20";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьТочкиПланаИзМассива(ДокументПрогона, ПланПрогона)

	Для Каждого Пункт Из ПланПрогона Цикл
		ДобавитьТочкуПлана(ДокументПрогона, Пункт.Точка, Пункт.Код,
			Пункт.Метрика, Пункт.Название, Пункт.Цель, Пункт.Единица,
			Пункт.ЧислоПовторов, Пункт.Параметры);
