#Область ПрограммныйИнтерфейс

// Оценивает разброс длительности одинаковых вычислительных порций BSL.
// Параметры:
//  ЧислоСерий - Число - число повторов (> 0).
//  ИтерацийВСерии - Число - итерации в одном повторе (> 0).
// Возвращаемое значение:
//  Структура: минимум, медиана, максимум, полный разброс, контрольная сумма и детали.
Функция Проба007_РазбросВремениПорций(Знач ЧислоСерий = 5, Знач ИтерацийВСерии = 10000) Экспорт

	Если ЧислоСерий <= 0 Или ИтерацийВСерии <= 0 Тогда
		ВызватьИсключение "Некорректные параметры Пробы 007";
	КонецЕсли;

	Длительности = Новый СписокЗначений;
	КонтрольнаяСумма = 0;
	Для НомерСерии = 1 По ЧислоСерий Цикл
		Замер = БенчмаркПробы.ПробаОдинПотокBSL(ИтерацийВСерии);
		Длительности.Добавить(Замер.ДлительностьМс);
		КонтрольнаяСумма = КонтрольнаяСумма + Замер.КонтрольнаяСумма;
	КонецЦикла;
	Длительности.СортироватьПоЗначению();

	Результат = Новый Структура;
	Результат.Вставить("МедианаМс", Число(Длительности[Цел((ЧислоСерий - 1) / 2)].Значение));
	Результат.Вставить("МинМс", Число(Длительности[0].Значение));
	Результат.Вставить("МаксМс", Число(Длительности[ЧислоСерий - 1].Значение));
	Результат.Вставить("РазбросМс", Число(Длительности[ЧислоСерий - 1].Значение) - Число(Длительности[0].Значение));
	Результат.Вставить("КонтрольнаяСумма", КонтрольнаяСумма);
	Результат.Вставить("Детали", "Разброс BSL-порций; миграции между ядрами не подтверждаются");
	Возврат Результат;

КонецФункции

#КонецОбласти
