Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты.ДобавитьТестовыйНабор("Ядро бенчмарка")
        .ДобавитьСерверныйТест("Тест_ВыполнитьТестовыйРасчет_ОтрицательныеИтерацииИсключение");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_ВыполнитьТестовыйРасчет_ОтрицательныеИтерацииИсключение() Экспорт

	ИсключениеВыброшено = Ложь;
	ТекстОшибки = "";
	Попытка
		БенчмаркЯдро.ВыполнитьТестовыйРасчет(-1);
	Исключение
		ИсключениеВыброшено = Истина;
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);
	ЮТест.ОжидаетЧто(ТекстОшибки).Содержит("Число итераций не может быть отрицательным");

КонецПроцедуры

#КонецОбласти
