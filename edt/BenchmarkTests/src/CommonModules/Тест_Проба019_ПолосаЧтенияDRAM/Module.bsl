#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба019_ПолосаЧтенияDRAM() Экспорт
	Точки = Новый Массив;
	Точки.Добавить(СоздатьТочку(1, 100000000));
	Точки.Добавить(СоздатьТочку(2, 50000000));
	Результат = БенчмаркПроба019ПолосаЧтенияDRAM.АнализироватьПолосуЧтения(Точки);
	ЮТест.ОжидаетЧто(Результат.Точки.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Результат.Точки[0].ГБВСекунду).Равно(5);
	ЮТест.ОжидаетЧто(Результат.Точки[1].ГБВСекунду).Равно(10);
	ЮТест.ОжидаетЧто(Результат.Точки[1].ГБВСекундуНаПоток).Равно(5);

	Точки[0].РазмерБуфераБайт = 1048576;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба019ПолосаЧтенияDRAM.АнализироватьПолосуЧтения(Точки);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);
КонецПроцедуры

Функция СоздатьТочку(Потоки, ВремяНс)
	Наблюдения = Новый Массив;
	Для Индекс = 1 По 3 Цикл
		Наблюдения.Добавить(Новый Структура("ОбъемПрочитанныхБайт,ДлительностьНс,КонтрольнаяСумма",
			500000000, ВремяНс, 910));
	КонецЦикла;
	Возврат Новый Структура("ЧислоПотоков,РазмерБуфераБайт,РазмерLLCБайт,РазмещениеЛокальноеПодтверждено,ИдентификаторСтенда,ИдентификаторНабора,Наблюдения",
		Потоки, 67108864, 16777216, Истина, "mem-lab", "read-buffer-64m", Наблюдения);
КонецФункции
#КонецОбласти
