#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба023_ЛожноеСовместноеИспользование() Экспорт
	Смежные = СоздатьВариант(8, 80000000);
	Разнесенные = СоздатьВариант(64, 40000000);
	Результат = БенчмаркПроба023ЛожноеСовместноеИспользование.СравнитьРазмещениеСчетчиков(
		Смежные, Разнесенные);
	ЮТест.ОжидаетЧто(Результат.Смежные.МедианаОбновленийВСекунду).Равно(25000000);
	ЮТест.ОжидаетЧто(Результат.Разнесенные.МедианаОбновленийВСекунду).Равно(50000000);
	ЮТест.ОжидаетЧто(Результат.УскорениеПослеРазнесения).Равно(2);
	ЮТест.ОжидаетЧто(Результат.СобытияКогерентностиДоступны).Равно(Истина);

	Разнесенные.СмещениеСчетчика1Байт = 8;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба023ЛожноеСовместноеИспользование.СравнитьРазмещениеСчетчиков(
			Смежные, Разнесенные);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);
КонецПроцедуры

Функция СоздатьВариант(Смещение1, ВремяНс)
	Наблюдения = Новый Массив;
	Для Индекс = 1 По 3 Цикл
		Наблюдения.Добавить(Новый Структура("ДлительностьНс,ЧислоОбновлений,КонтрольнаяСумма,СобытияКогерентности",
			ВремяНс, 2000000, 1000001, 3000 / Индекс));
	КонецЦикла;
	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторCPU0,ИдентификаторCPU1,ЧислоПотоков,ОбновленийНаПоток,РазмерЛинииБайт,ПривязкаПодтверждена,СмещениеСчетчика0Байт,СмещениеСчетчика1Байт,Наблюдения",
		"coherence-lab", "cpu-0", "cpu-1", 2, 1000000, 64, Истина, 0, Смещение1, Наблюдения);
КонецФункции
#КонецОбласти
