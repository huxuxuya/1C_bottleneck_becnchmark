#Область ПрограммныйИнтерфейс

// Сравнивает обход одного анонимного набора до давления и после него.
// Вариант: ИдентификаторСтенда, ИдентификаторРабочегоНабора, РабочийНаборБайт,
// ЧислоСтраниц, Наблюдения. Наблюдение: ДлительностьОбходаНс, SwapInБайт,
// MajorFaults, ЧислоСтраниц, КонтрольнаяСумма.
Функция СравнитьВозвратИзSwap(Знач ДоДавления, Знач ПослеДавления) Экспорт

	До = РассчитатьВариант(ДоДавления);
	После = РассчитатьВариант(ПослеДавления);
	Если До.ИдентификаторСтенда <> После.ИдентификаторСтенда
		Или До.ИдентификаторРабочегоНабора <> После.ИдентификаторРабочегоНабора
		Или До.РабочийНаборБайт <> После.РабочийНаборБайт
		Или До.ЧислоСтраниц <> После.ЧислоСтраниц
		Или До.КонтрольнаяСумма <> После.КонтрольнаяСумма Тогда
		ВызватьИсключение "До и после должны обходить один и тот же набор";
	КонецЕсли;

	ИзменениеВремениПроцентов = (После.МедианаДлительностиНс - До.МедианаДлительностиНс)
		* 100 / До.МедианаДлительностиНс;
		ВытеснениеПодтверждено = После.МедианаSwapInБайт > 0 Или После.МедианаMajorFaults > 0;
	Классификация = "Swap-in и рост задержки не обнаружены";
	Если ВытеснениеПодтверждено И ИзменениеВремениПроцентов > 0 Тогда
		Классификация = "Возврат вытесненных страниц подтверждён swap-in/page fault и ростом задержки";
	ИначеЕсли ВытеснениеПодтверждено Тогда
		Классификация = "Swap-in/page fault подтверждён, роста задержки нет";
	ИначеЕсли ИзменениеВремениПроцентов > 0 Тогда
		Классификация = "Задержка выросла без подтверждённого swap-in";
	КонецЕсли;

	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторРабочегоНабора,РабочийНаборБайт,ЧислоСтраниц,КонтрольнаяСумма,ДоДавления,ПослеДавления,ИзменениеВремениОбходаПроцентов,ВытеснениеПодтверждено,Классификация",
		До.ИдентификаторСтенда, До.ИдентификаторРабочегоНабора, До.РабочийНаборБайт,
		До.ЧислоСтраниц, До.КонтрольнаяСумма, До, После,
		ИзменениеВремениПроцентов, ВытеснениеПодтверждено, Классификация);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РассчитатьВариант(Вариант)
	Если Вариант.РабочийНаборБайт <= 0 Или Вариант.ЧислоСтраниц <= 0
		Или ПустаяСтрока(Вариант.ИдентификаторРабочегоНабора)
		Или ПустаяСтрока(Вариант.ИдентификаторСтенда) Тогда
		ВызватьИсключение "Нужны рабочий набор и число страниц";
	КонецЕсли;
	Если Вариант.Наблюдения.Количество() < 3 Тогда
		ВызватьИсключение "Для каждого состояния нужны минимум три повтора";
	КонецЕсли;
	Времена = Новый СписокЗначений;
	SwapIn = Новый СписокЗначений;
	MajorFaults = Новый СписокЗначений;
	КонтрольнаяСумма = Неопределено;
	Для Каждого Наблюдение Из Вариант.Наблюдения Цикл
		Если Наблюдение.ДлительностьОбходаНс <= 0 Или Наблюдение.SwapInБайт < 0
			Или Наблюдение.MajorFaults < 0
			Или Наблюдение.ЧислоСтраниц <> Вариант.ЧислоСтраниц Тогда
			ВызватьИсключение "Длительность должна быть положительной, swap/fault неотрицательны, размер набора неизменен";
		КонецЕсли;
		Если КонтрольнаяСумма = Неопределено Тогда
			КонтрольнаяСумма = Наблюдение.КонтрольнаяСумма;
		ИначеЕсли КонтрольнаяСумма <> Наблюдение.КонтрольнаяСумма Тогда
			ВызватьИсключение "Повторы должны обходить один детерминированный набор";
		КонецЕсли;
		Времена.Добавить(Наблюдение.ДлительностьОбходаНс);
		SwapIn.Добавить(Наблюдение.SwapInБайт);
		MajorFaults.Добавить(Наблюдение.MajorFaults);
	КонецЦикла;
	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторРабочегоНабора,РабочийНаборБайт,ЧислоСтраниц,КонтрольнаяСумма,МедианаДлительностиНс,МедианаSwapInБайт,МедианаMajorFaults",
		Вариант.ИдентификаторСтенда, Вариант.ИдентификаторРабочегоНабора,
		Вариант.РабочийНаборБайт, Вариант.ЧислоСтраниц, КонтрольнаяСумма,
		Медиана(Времена), Медиана(SwapIn), Медиана(MajorFaults));
КонецФункции

Функция Медиана(Значения)
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение)
		+ Число(Значения[Количество / 2].Значение)) / 2;
КонецФункции

#КонецОбласти
