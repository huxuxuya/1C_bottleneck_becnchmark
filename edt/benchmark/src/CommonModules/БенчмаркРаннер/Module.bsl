		ДобавитьОшибкуПробе(Результаты, КонтекстПрогона, "CPU_SUSTAIN_RATE",
			"009. CPU: Устойчивая скорость BSL", 50, "мс/серия", ОписаниеОшибки());
	КонецПопытки;

	КонтекстПрогона.ДатаНачалаТекущейПробы = ТекущаяУниверсальнаяДата();
	Попытка
		Рез010 = БенчмаркПроба010ВыбросыВремениПорций.Проба010_ВыбросыВремениПорций(5, Макс(1000, Цел(10000 * Масштаб)));
		КонтекстПрогона.ДатаЗавершенияТекущейПробы = ТекущаяУниверсальнаяДата();
		ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, СоздатьДанныеПроб(
			"CPU_TAIL_P95", "010. CPU: Хвост задержки BSL-порций", Рез010.P95Мс, 50,
