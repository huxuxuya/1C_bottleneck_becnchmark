#Область ПеременныеФормы

&НаКлиенте
Перем ОбъектНативнойПробыCPU;

&НаКлиенте
Перем НативнаяПробаCPUВыполняется;

&НаКлиенте
Перем РежимНативнойПробыCPU;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	МасштабНагрузки = 1;
	ТочкиПроб042.Очистить();
	Результаты.Очистить();
	ИдентификаторПрогона = "";

	Попытка
		ИдентификаторПрогона = БенчмаркРаннер.ПолучитьПоследнийИдентификаторПрогона();
		Если Не ПустаяСтрока(ИдентификаторПрогона) Тогда
			ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);
			ОбновитьСводкуПоРезультатамНаСервере();
		КонецЕсли;
	Исключение
		Сообщить("Не удалось загрузить сохранённые результаты: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьПрогон(Команда) Экспорт

	Попытка
		ВыполнитьПрогонНаСервере();
	Исключение
		Сообщить("Не удалось выполнить бенчмарк: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВсеДиагностикиBSL(Команда) Экспорт

	Попытка
		ИтогДиагностик = ВыполнитьВсеДиагностикиBSLНаСервере();
		ИдентификаторПрогона = ИтогДиагностик.ИдентификаторПрогона;
		Сообщить("Диагностик: " + Строка(ИтогДиагностик.КоличествоПроверок)
			+ "; измерено: " + Строка(ИтогДиагностик.КоличествоИзмерений)
			+ "; недоступно в BSL: " + Строка(ИтогДиагностик.КоличествоНедоступных)
			+ "; ошибок: " + Строка(ИтогДиагностик.КоличествоОшибок));
	Исключение
		Сообщить("Пакет диагностик завершился ошибкой: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПробу042(Команда) Экспорт

	Попытка
		ИтогПроб = ВыполнитьПробу042НаСервере();
		ИдентификаторПрогона042 = ИтогПроб.ИдентификаторПрогона;
		ПутьВременногоФайла042 = ИтогПроб.ПутьФайла;
		ЗагрузитьТочкиПроб042НаСервере(ИдентификаторПрогона042);
		ТекстИтога = "Сохранено результатов: " + Строка(ИтогПроб.КоличествоТочек)
			+ "; ошибок измерения: " + Строка(ИтогПроб.КоличествоОшибок);
		Если Не ПустаяСтрока(ИтогПроб.ОшибкаОчистки) Тогда
			ТекстИтога = ТекстИтога + "; не удалось удалить временный файл: " + ИтогПроб.ОшибкаОчистки;
		КонецЕсли;
		Сообщить(ТекстИтога);
	Исключение
		Сообщить("Проба 042 завершилась ошибкой: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьНативнуюПробуCPU(Команда) Экспорт

	Если НативнаяПробаCPUВыполняется = Истина Тогда
		Возврат;
	КонецЕсли;

	РежимНативнойПробыCPU = "частота";
	НативнаяПробаCPUВыполняется = Истина;
	Элементы.КнопкаВыполнитьНативнуюПробуCPU.Доступность = Ложь;
	Элементы.КнопкаВыполнитьНативныеДиагностикиCPU.Доступность = Ложь;

	Если ОбъектНативнойПробыCPU <> Неопределено Тогда
		Если РежимНативнойПробыCPU = "диагностики" Тогда
			НачатьВыполнениеНативныхДиагностикCPU();
		Иначе
			НачатьИзмерениеНативнойПробыCPU();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	НачатьПодключениеНативнойПробыCPU(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьНативныеДиагностикиCPU(Команда) Экспорт

	Если НативнаяПробаCPUВыполняется = Истина Тогда
		Возврат;
	КонецЕсли;

	РежимНативнойПробыCPU = "диагностики";
	НативнаяПробаCPUВыполняется = Истина;
	Элементы.КнопкаВыполнитьНативнуюПробуCPU.Доступность = Ложь;
	Элементы.КнопкаВыполнитьНативныеДиагностикиCPU.Доступность = Ложь;

	Если ОбъектНативнойПробыCPU <> Неопределено Тогда
		НачатьВыполнениеНативныхДиагностикCPU();
	Иначе
		НачатьПодключениеНативнойПробыCPU(Ложь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


// Проба 027: измеряет пустые обращения к серверу без формы и SQL.
&НаКлиенте
Функция ИзмеритьБазовуюЦенуСерверногоВызова(Знач ЧислоПрогревов = 3,
	Знач ЧислоСерий = 5, Знач ВызововВСерии = 20) Экспорт

	Если ЧислоПрогревов < 0 Или ЧислоСерий < 3 Или ВызововВСерии <= 0 Тогда
		ВызватьИсключение "Для пробы 027 нужны прогревы >= 0, минимум три серии и положительное число вызовов";
	КонецЕсли;

	Для Индекс = 1 По ЧислоПрогревов Цикл
		БенчмаркПроба027БазоваяЦенаСерверногоВызова.ПустойОбработчикБезКонтекста();
	КонецЦикла;

	Наблюдения = Новый Массив;
	Для Серия = 1 По ЧислоСерий Цикл
		НачалоКлиентаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		СуммаОбработчикаМс = 0;
		Для Индекс = 1 По ВызововВСерии Цикл
			СуммаОбработчикаМс = СуммаОбработчикаМс
				+ БенчмаркПроба027БазоваяЦенаСерверногоВызова.ПустойОбработчикБезКонтекста();
		КонецЦикла;
		ДлительностьКлиентаМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоКлиентаМс;
		Наблюдения.Добавить(Новый Структура("ЧислоВызовов,RTTНс,ВремяОбработчикаНс",
			ВызововВСерии, ДлительностьКлиентаМс * 1000000 / ВызововВСерии,
			СуммаОбработчикаМс * 1000000 / ВызововВСерии));
	КонецЦикла;

	Возврат БенчмаркПроба027БазоваяЦенаСерверногоВызова.АнализироватьНаблюдения(Наблюдения);

КонецФункции

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьПрогонНаСервере()

	МасштабЗапуска = ?(МасштабНагрузки > 0, МасштабНагрузки, 1);
	ИдентификаторПрогона = Строка(Новый УникальныйИдентификатор);

	Попытка
		Итог = БенчмаркРаннер.ВыполнитьПолныйПрогон(ИдентификаторПрогона, МасштабЗапуска);
		ОбщийБалл = Итог.ОбщийБалл;
		ГлавноеУзкоеМесто = Итог.ГлавноеУзкоеМесто;
		ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);
		Если Результаты.Количество() = 0 Тогда
			ВызватьИсключение "Прогон завершился, но записи не найдены в регистре РезультатыПрогонов";
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		КоличествоСохраненныхСтрок = 0;
		Попытка
			ТаблицаЧастичныхРезультатов = БенчмаркРаннер.ПолучитьРезультатыПрогона(ИдентификаторПрогона);
			КоличествоСохраненныхСтрок = ТаблицаЧастичныхРезультатов.Количество();
			Если КоличествоСохраненныхСтрок > 0 Тогда
				ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);
				ОбщийБалл = 0;
				ГлавноеУзкоеМесто = "Прогон прерван; сводный индекс не рассчитан";
			КонецЕсли;
		Исключение
			// Сохраняем исходную ошибку прогона, даже если не удалось прочитать частичный результат.
		КонецПопытки;
		Сообщить("Прогон прерван: " + ТекстОшибки
			+ "; сохранено строк результатов: " + Строка(КоличествоСохраненныхСтрок));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ВыполнитьВсеДиагностикиBSLНаСервере()

	ИтогДиагностик = БенчмаркДиагностикиBSL.ВыполнитьПрогон();
	ИдентификаторПрогона = ИтогДиагностик.ИдентификаторПрогона;
	ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);
	ОбщийБалл = 0;
	ГлавноеУзкоеМесто = "Отдельный диагностический пакет; баллы оборудования не рассчитываются";
	Возврат Новый Структура(
		"ИдентификаторПрогона,КоличествоПроверок,КоличествоИзмерений,КоличествоНедоступных,КоличествоОшибок",
		ИдентификаторПрогона, ИтогДиагностик.КоличествоПроверок,
		ИтогДиагностик.КоличествоИзмерений, ИтогДиагностик.КоличествоНедоступных,
		ИтогДиагностик.КоличествоОшибок);

КонецФункции

&НаСервере
Процедура ОчиститьРезультатыПрогонаНаСервере(ИдентификаторПрогона) Экспорт

	БенчмаркРаннер.ОчиститьРезультатыПрогона(ИдентификаторПрогона);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона) Экспорт

	ТаблицаРезультатов = БенчмаркРаннер.ПолучитьРезультатыПрогона(ИдентификаторПрогона);
	Результаты.Очистить();
	Для Каждого РезультатИзРегистра Из ТаблицаРезультатов Цикл
		НоваяСтрока = Результаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, РезультатИзРегистра);
	КонецЦикла;
	Элементы.ТаблицаРезультатов.Видимость = Результаты.Количество() > 0;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСводкуПоРезультатамНаСервере()

	ИндексыДляОбщегоБалла = Новый Массив;
	КоличествоОцениваемыхПроб = 0;
	МинимальныйИндекс = 101;
	ГлавноеУзкоеМесто = "";

	Для Каждого СтрокаРезультата Из Результаты Цикл
		Если СтрокаРезультата.Статус <> "Косвенный сигнал" И СтрокаРезультата.Индекс > 0 Тогда
			ИндексыДляОбщегоБалла.Добавить(СтрокаРезультата.Индекс);
			КоличествоОцениваемыхПроб = КоличествоОцениваемыхПроб + 1;
			Если СтрокаРезультата.Индекс < МинимальныйИндекс Тогда
				МинимальныйИндекс = СтрокаРезультата.Индекс;
				ГлавноеУзкоеМесто = СтрокаРезультата.КодПробы + " ("
					+ СтрокаРезультата.НаименованиеПробы + ")";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоОцениваемыхПроб = 0 Тогда
		ОбщийБалл = 0;
		ГлавноеУзкоеМесто = "Нет оцениваемых проб";
		Возврат;
	КонецЕсли;
	Если КоличествоОцениваемыхПроб < 7 Тогда
		ОбщийБалл = 0;
		ГлавноеУзкоеМесто = "Неполный прогон: " + Строка(КоличествоОцениваемыхПроб)
			+ " из 7 оцениваемых проб";
		Возврат;
	КонецЕсли;

	ОбщийБалл = Окр(
		БенчмаркРаннер.СреднееГеометрическоеИндексов(ИндексыДляОбщегоБалла), 1);
	Если МинимальныйИндекс >= 100 Тогда
		ГлавноеУзкоеМесто = "Все прямые пробы в целевом бюджете";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВыполнитьПробу042НаСервере()

	Возврат БенчмаркПроба042Хранилище.ВыполнитьПрогон();

КонецФункции

&НаСервере
Процедура ЗагрузитьТочкиПроб042НаСервере(ИдентификаторПрогона)

	ТаблицаТочек = БенчмаркПроба042Хранилище.ПолучитьТочкиПрогона(ИдентификаторПрогона);
	ТочкиПроб042.Очистить();
	Для Каждого Точка Из ТаблицаТочек Цикл
		НоваяСтрока = ТочкиПроб042.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Точка);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура НачатьПодключениеНативнойПробыCPU(УстановкаУжеВыполнялась)

	Попытка
		Оповещение = Новый ОписаниеОповещения(
			"ПослеПодключенияНативнойПробыCPU",
			ЭтаФорма,
			УстановкаУжеВыполнялась,
			"ПриОшибкеПодключенияНативнойПробыCPU",
			ЭтаФорма);
		НачатьПодключениеВнешнейКомпоненты(
			Оповещение,
			"ОбщийМакет.CpuFrequencyProbe",
			"CpuFrequencyProbe",
			ТипВнешнейКомпоненты.Native);
	Исключение
		Если УстановкаУжеВыполнялась Тогда
			Сообщить("Не удалось подключить нативную пробу CPU: " + ОписаниеОшибки());
			ЗавершитьНативнуюПробуCPU();
		Иначе
			НачатьУстановкуНативнойПробыCPU();
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияНативнойПробыCPU(Подключена, УстановкаУжеВыполнялась) Экспорт

	Если Не Подключена Тогда
		Если УстановкаУжеВыполнялась Тогда
			Сообщить("Нативная проба CPU не поддерживается этой платформой или разрядностью клиента.");
			ЗавершитьНативнуюПробуCPU();
		Иначе
			НачатьУстановкуНативнойПробыCPU();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Попытка
		ОбъектНативнойПробыCPU = Новый("AddIn.CpuFrequencyProbe.CpuProbe");
		Если РежимНативнойПробыCPU = "диагностики" Тогда
			НачатьВыполнениеНативныхДиагностикCPU();
		Иначе
			НачатьИзмерениеНативнойПробыCPU();
		КонецЕсли;
	Исключение
		ОбъектНативнойПробыCPU = Неопределено;
		Сообщить("Не удалось создать нативную пробу CPU: " + ОписаниеОшибки());
		ЗавершитьНативнуюПробуCPU();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура НачатьВыполнениеНативныхДиагностикCPU()

	Попытка
		Оповещение = Новый ОписаниеОповещения(
			"ПослеВыполненияНативныхДиагностикCPU",
			ЭтаФорма,
			Неопределено,
			"ПриОшибкеВызоваНативнойПробыCPU",
			ЭтаФорма);
		ОбъектНативнойПробыCPU.НачатьВызовMeasure(Оповещение, -1, 0, 0);
	Исключение
		Сообщить("Ошибка запуска нативных CPU-диагностик: " + ОписаниеОшибки());
		ЗавершитьНативнуюПробуCPU();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыполненияНативныхДиагностикCPU(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт

	Попытка
		Если ТипЗнч(РезультатВызова) <> Тип("Строка") Тогда
			ВызватьИсключение "Нативная компонента вернула результат неожиданного типа";
		КонецЕсли;

		Диагностики = РазобратьНативныеДиагностикиCPU(РезультатВызова);
		ИдентификаторПрогона = Строка(Новый УникальныйИдентификатор);
		РезультатЗапускаСервера = ВыполнитьИЗаписатьНативныеДиагностикиCPUНаСервере(
			ИдентификаторПрогона,
			Диагностики);
		ОбщийБалл = 0;
		ГлавноеУзкоеМесто = "Нативные CPU-диагностики клиента и сервера; не входят в общий балл";
		ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);

		ТекстИтога = "Нативных CPU-диагностик: " + Строка(РезультатЗапускаСервера.Количество)
			+ "; доступно: " + Строка(РезультатЗапускаСервера.Доступно)
			+ "; недоступно: " + Строка(РезультатЗапускаСервера.Недоступно)
			+ "; ID: " + ИдентификаторПрогона;
		Если Не РезультатЗапускаСервера.СерверУспешен Тогда
			ТекстИтога = ТекстИтога + "; ошибка серверного контекста: " + РезультатЗапускаСервера.ОшибкаСервера;
		КонецЕсли;
		Сообщить(ТекстИтога);
	Исключение
		Сообщить("Нативные CPU-диагностики завершились ошибкой: " + ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьНативнуюПробуCPU();

КонецПроцедуры

&НаКлиенте
Процедура НачатьУстановкуНативнойПробыCPU()

	Попытка
		Оповещение = Новый ОписаниеОповещения(
			"ПослеУстановкиНативнойПробыCPU",
			ЭтаФорма,
			Неопределено,
			"ПриОшибкеУстановкиНативнойПробыCPU",
			ЭтаФорма);
		НачатьУстановкуВнешнейКомпоненты(Оповещение, "ОбщийМакет.CpuFrequencyProbe");
	Исключение
		Сообщить("Не удалось установить нативную пробу CPU: " + ОписаниеОшибки());
		ЗавершитьНативнуюПробуCPU();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеУстановкиНативнойПробыCPU(ДополнительныеПараметры) Экспорт

	НачатьПодключениеНативнойПробыCPU(Истина);

КонецПроцедуры

&НаКлиенте
Процедура НачатьИзмерениеНативнойПробыCPU()

	Попытка
		Оповещение = Новый ОписаниеОповещения(
			"ПослеИзмеренияНативнойПробыCPU",
			ЭтаФорма,
			Неопределено,
			"ПриОшибкеВызоваНативнойПробыCPU",
			ЭтаФорма);
		ОбъектНативнойПробыCPU.НачатьВызовMeasure(Оповещение, 1000000, 1, 7);
	Исключение
		Сообщить("Ошибка запуска нативной CPU-пробы: " + ОписаниеОшибки());
		ЗавершитьНативнуюПробуCPU();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмеренияНативнойПробыCPU(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт

	Попытка
		Если ТипЗнч(РезультатВызова) <> Тип("Строка") Тогда
			ВызватьИсключение "Нативная компонента вернула результат неожиданного типа";
		КонецЕсли;

		ДанныеИзмерения = РазобратьРезультатНативнойПробыCPU(РезультатВызова);
		ИдентификаторНативногоПрогона = Строка(Новый УникальныйИдентификатор);
		ДеталиИзмерения = СформироватьДеталиНативнойПробыCPU(ДанныеИзмерения);
		СохранитьНативнуюПробуCPUНаСервере(
			ИдентификаторНативногоПрогона,
			ДанныеИзмерения.estimatedMHz,
			ДанныеИзмерения.checksum,
			ДеталиИзмерения);

		РезультатЗамераСервера = ВыполнитьНативнуюПробуCPUНаСервере(
			ИдентификаторНативногоПрогона, 1000000, 1, 7);

		ИдентификаторПрогона = ИдентификаторНативногоПрогона;
		ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);
		ОбщийБалл = 0;
		ГлавноеУзкоеМесто = "Отдельные оценки CPU клиента и сервера; общий балл конфигурации не рассчитывается";
		ТекстРезультатаСервера = "серверный замер недоступен; см. детали строки CPU_NATIVE_SERVER";
		Если РезультатЗамераСервера.Успешно Тогда
			ТекстРезультатаСервера = "сервер "
				+ Формат(РезультатЗамераСервера.ЗначениеМетрики, "ЧДЦ=1") + " экв. МГц";
		КонецЕсли;
		Сообщить("Нативные CPU-пробы сохранены: клиент "
			+ Формат(ДанныеИзмерения.estimatedMHz, "ЧДЦ=1")
			+ " экв. МГц; " + ТекстРезультатаСервера
			+ ". Результаты доступны в таблице прогонов.");
	Исключение
		Сообщить("Ошибка измерения или сохранения нативной CPU-пробы: " + ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьНативнуюПробуCPU();

КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеПодключенияНативнойПробыCPU(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	СтандартнаяОбработка = Ложь;
	Сообщить("Ошибка подключения нативной пробы CPU: " + ИнформацияОбОшибке.Описание);
	ЗавершитьНативнуюПробуCPU();

КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеУстановкиНативнойПробыCPU(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	СтандартнаяОбработка = Ложь;
	Сообщить("Ошибка установки нативной пробы CPU: " + ИнформацияОбОшибке.Описание);
	ЗавершитьНативнуюПробуCPU();

КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеВызоваНативнойПробыCPU(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	СтандартнаяОбработка = Ложь;
	Сообщить("Ошибка выполнения нативной CPU-пробы: " + ИнформацияОбОшибке.Описание);
	ЗавершитьНативнуюПробуCPU();

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьНативнуюПробуCPU()

	НативнаяПробаCPUВыполняется = Ложь;
	ОбъектНативнойПробыCPU = Неопределено;
	Элементы.КнопкаВыполнитьНативнуюПробуCPU.Доступность = Истина;
	Элементы.КнопкаВыполнитьНативныеДиагностикиCPU.Доступность = Истина;

КонецПроцедуры

&НаКлиенте
Функция РазобратьРезультатНативнойПробыCPU(Знач JSONРезультата) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONРезультата);
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		ВызватьИсключение "Ответ нативной пробы должен быть JSON-объектом";
	КонецЕсли;
	Если Результат.schemaVersion <> 1
		Или Результат.physicalClockRead <> Ложь
		Или Результат.estimatedMHz <= 0
		Или Результат.operationsPerSecond <= 0
		Или Результат.medianElapsedNs <= 0
		Или Результат.sampleCount < 3
		Или ТипЗнч(Результат.sampleElapsedNs) <> Тип("Массив")
		Или Результат.sampleElapsedNs.Количество() <> Результат.sampleCount Тогда
		ВызватьИсключение "В JSON нативной пробы отсутствуют корректные измерения";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция РазобратьНативнуюДиагностикуCPU(Знач JSONРезультата) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONРезультата);
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();
	Возврат ПроверитьСтруктуруНативнойДиагностикиCPU(Результат);

КонецФункции

&НаКлиенте
Функция ПроверитьСтруктуруНативнойДиагностикиCPU(Знач Результат)

	Если ТипЗнч(Результат) <> Тип("Структура")
		Или Результат.schemaVersion <> 1
		Или ПустаяСтрока(Результат.probeCode)
		Или ПустаяСтрока(Результат.probeName)
		Или ПустаяСтрока(Результат.primaryMetric)
		Или ПустаяСтрока(Результат.primaryUnit)
		Или ПустаяСтрока(Результат.details)
		Или ТипЗнч(Результат.available) <> Тип("Булево")
		Или ТипЗнч(Результат.primaryValue) <> Тип("Число")
		Или ТипЗнч(Результат.measurements) <> Тип("Структура") Тогда
		ВызватьИсключение "JSON нативной диагностики не содержит обязательных полей";
	КонецЕсли;

	Если Результат.available Тогда
		Если Результат.status <> "Косвенный сигнал" Или Результат.primaryUnit = "н/д" Тогда
			ВызватьИсключение "Доступная нативная диагностика имеет некорректный статус или единицу";
		КонецЕсли;
	ИначеЕсли Результат.status <> "Недоступно" Или Результат.primaryValue <> 0 Тогда
		ВызватьИсключение "Недоступная нативная диагностика не должна содержать измеренное значение";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция РазобратьНативныеДиагностикиCPU(Знач JSONРезультата) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONРезультата);
	Диагностики = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Диагностики) <> Тип("Массив") Или Диагностики.Количество() <> 8 Тогда
		ВызватьИсключение "Пакет нативных диагностик должен вернуть ровно восемь результатов";
	КонецЕсли;

	ОжидаемыеКоды = Новый Массив;
	ОжидаемыеКоды.Добавить("CPU_002_INDEPENDENT_INSTRUCTIONS");
	ОжидаемыеКоды.Добавить("CPU_003_WAKE_LATENCY");
	ОжидаемыеКоды.Добавить("CPU_004_READY_QUEUE");
	ОжидаемыеКоды.Добавить("CPU_005_CPU_QUOTA");
	ОжидаемыеКоды.Добавить("CPU_006_SMT_COMPETITION");
	ОжидаемыеКоды.Добавить("CPU_007_CORE_MIGRATION");
	ОжидаемыеКоды.Добавить("CPU_008_IDLE_RECOVERY");
	ОжидаемыеКоды.Добавить("CPU_009_SUSTAINED_SPEED");

	Для Каждого СырыеДанные Из Диагностики Цикл
		Результат = ПроверитьСтруктуруНативнойДиагностикиCPU(СырыеДанные);
		Если ОжидаемыеКоды.Найти(Результат.probeCode) = Неопределено Тогда
			ВызватьИсключение "Пакет содержит неизвестный код нативной диагностики: " + Результат.probeCode;
		КонецЕсли;
		ОжидаемыеКоды.Удалить(ОжидаемыеКоды.Найти(Результат.probeCode));
	КонецЦикла;
	Если ОжидаемыеКоды.Количество() <> 0 Тогда
		ВызватьИсключение "Пакет нативных диагностик пропустил одну или несколько проверок";
	КонецЕсли;

	Возврат Диагностики;

КонецФункции

&НаКлиенте
Функция СформироватьДеталиНативнойПробыCPU(Знач РезультатИзмерения) Экспорт

	ДлительностиСерий = "";
	Для Каждого Длительность Из РезультатИзмерения.sampleElapsedNs Цикл
		Если Не ПустаяСтрока(ДлительностиСерий) Тогда
			ДлительностиСерий = ДлительностиСерий + ",";
		КонецЕсли;
		ДлительностиСерий = ДлительностиСерий + Строка(Длительность);
	КонецЦикла;

	Детали = "Native API " + РезультатИзмерения.componentVersion
		+ "; arch=" + РезультатИзмерения.architecture
		+ "; compiler=" + РезультатИзмерения.compiler
		+ "; algorithm=" + РезультатИзмерения.algorithm
		+ "; blocks=" + Строка(РезультатИзмерения.blocksPerSample)
		+ "; warmups=" + Строка(РезультатИзмерения.warmups)
		+ "; samples=" + Строка(РезультатИзмерения.sampleCount)
		+ "; median_ns=" + Строка(РезультатИзмерения.medianElapsedNs)
		+ "; ops/s=" + Строка(РезультатИзмерения.operationsPerSecond)
		+ "; sample_ns=" + ДлительностиСерий
		+ "; checksum=" + Строка(РезультатИзмерения.checksum)
		+ "; экв. МГц=ops/s/1e6, не физическая частота";
	Возврат Лев(Детали, 500);

КонецФункции

&НаСервере
Процедура СохранитьНативнуюПробуCPUНаСервере(ИдентификаторПрогона, ЗначениеЭквивалентнойЧастоты, КонтрольнаяСумма, Детали) Экспорт

	БенчмаркРаннер.СохранитьНативныйРезультатCPU(
		ИдентификаторПрогона,
		ЗначениеЭквивалентнойЧастоты,
		КонтрольнаяСумма,
		Детали);

КонецПроцедуры

&НаСервере
Функция ВыполнитьИЗаписатьНативныеДиагностикиCPUНаСервере(ИдентификаторПрогона,
	ДиагностикиКлиента) Экспорт

	КоличествоДоступных = 0;
	Для Каждого Диагностика Из ДиагностикиКлиента Цикл
		Если Диагностика.available Тогда
			КоличествоДоступных = КоличествоДоступных + 1;
		КонецЕсли;
	КонецЦикла;
	СохранитьМассивНативныхДиагностикCPU(ИдентификаторПрогона, ДиагностикиКлиента, "client");

	СерверУспешен = Истина;
	ОшибкаСервера = "";
	КоличествоДоступныхСервера = 0;
	Попытка
		ПодключитьВнешнююКомпоненту(
			"ОбщийМакет.CpuFrequencyProbe",
			"CpuFrequencyProbe",
			ТипВнешнейКомпоненты.Native);
		ИзмерительCPUСервера = Новый("AddIn.CpuFrequencyProbe.CpuProbe");
		JSONДиагностикСервера = ИзмерительCPUСервера.Measure(-1, 0, 0);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(JSONДиагностикСервера);
		ДиагностикиСервера = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
		Если ТипЗнч(ДиагностикиСервера) <> Тип("Массив")
			Или ДиагностикиСервера.Количество() <> 8 Тогда
			ВызватьИсключение "Серверная Native API-компонента должна вернуть восемь диагностик";
		КонецЕсли;
		Для Каждого Диагностика Из ДиагностикиСервера Цикл
			Если ТипЗнч(Диагностика) <> Тип("Структура")
				Или Диагностика.schemaVersion <> 1
				Или ТипЗнч(Диагностика.available) <> Тип("Булево")
				Или ТипЗнч(Диагностика.measurements) <> Тип("Структура") Тогда
				ВызватьИсключение "Серверная Native API-компонента вернула некорректную диагностику";
			КонецЕсли;
			Если Диагностика.available Тогда
				КоличествоДоступныхСервера = КоличествоДоступныхСервера + 1;
			КонецЕсли;
		КонецЦикла;
		СохранитьМассивНативныхДиагностикCPU(ИдентификаторПрогона, ДиагностикиСервера, "server");
	Исключение
		СерверУспешен = Ложь;
		ОшибкаСервера = ОписаниеОшибки();
		СохранитьНедоступныеНативныеДиагностикиCPU(ИдентификаторПрогона, "server", ОшибкаСервера);
	КонецПопытки;

	Возврат Новый Структура(
		"Количество,Доступно,Недоступно,СерверУспешен,ОшибкаСервера",
		16,
		КоличествоДоступных + КоличествоДоступныхСервера,
		16 - КоличествоДоступных - КоличествоДоступныхСервера,
		СерверУспешен,
		ОшибкаСервера);

КонецФункции

&НаСервере
Процедура СохранитьМассивНативныхДиагностикCPU(ИдентификаторПрогона, Диагностики, КонтекстИсполнения)

	СуффиксКонтекста = ?(КонтекстИсполнения = "client", "C", "S");
	Для Каждого Диагностика Из Диагностики Цикл
		НомерПробы = Сред(Диагностика.probeCode, 5, 3);
		КодПробыРегистра = "NCPU" + НомерПробы + СуффиксКонтекста;
		НаименованиеПробы = Диагностика.probeName + " / " + КонтекстИсполнения;
		Детали = "execution_context=" + КонтекстИсполнения
			+ "; source_code=" + Диагностика.probeCode
			+ "; primary_metric=" + Диагностика.primaryMetric
			+ "; primary_value=" + Строка(Диагностика.primaryValue)
			+ " " + Диагностика.primaryUnit
			+ "; " + Диагностика.details;

		КлючиИзмерений = Новый Массив;
		Если НомерПробы = "002" Тогда
			КлючиИзмерений.Добавить("singleChainOpsPerSecond");
			КлючиИзмерений.Добавить("twoChainOpsPerSecond");
			КлючиИзмерений.Добавить("fourChainOpsPerSecond");
			КлючиИзмерений.Добавить("eightChainOpsPerSecond");
			КлючиИзмерений.Добавить("bestIndependentSpeedup");
		ИначеЕсли НомерПробы = "003" Тогда
			КлючиИзмерений.Добавить("p50WakeLatenessNs");
			КлючиИзмерений.Добавить("p95WakeLatenessNs");
			КлючиИзмерений.Добавить("p99WakeLatenessNs");
			КлючиИзмерений.Добавить("maxWakeLatenessNs");
		ИначеЕсли НомерПробы = "004" Тогда
			КлючиИзмерений.Добавить("competingWorkers");
			КлючиИзмерений.Добавить("p95ScheduledStartLatenessNs");
			КлючиИзмерений.Добавить("p95ControlWorkNs");
			КлючиИзмерений.Добавить("p95ControlResponseNs");
		ИначеЕсли НомерПробы = "005" Тогда
			КлючиИзмерений.Добавить("quota");
			КлючиИзмерений.Добавить("quotaCores");
			КлючиИзмерений.Добавить("nrThrottledDelta");
			КлючиИзмерений.Добавить("throttledUsecDelta");
		ИначеЕсли НомерПробы = "006" Тогда
			КлючиИзмерений.Добавить("baselineOpsPerSecond");
			КлючиИзмерений.Добавить("smtNeighborOpsPerSecond");
			КлючиИзмерений.Добавить("separateCoreOpsPerSecond");
			КлючиИзмерений.Добавить("smtThroughputPercentOfBaseline");
		ИначеЕсли НомерПробы = "007" Тогда
			КлючиИзмерений.Добавить("chunks");
			КлючиИзмерений.Добавить("migrationCount");
			КлючиИзмерений.Добавить("medianChunkNs");
			КлючиИзмерений.Добавить("medianPostMigrationChunkNs");
		ИначеЕсли НомерПробы = "008" Тогда
			КлючиИзмерений.Добавить("firstAfterIdleNsPerUpdate");
			КлючиИзмерений.Добавить("warmMedianNsPerUpdate");
			КлючиИзмерений.Добавить("firstToWarmRatio");
		ИначеЕсли НомерПробы = "009" Тогда
			КлючиИзмерений.Добавить("windowCount");
			КлючиИзмерений.Добавить("medianOpsPerSecond");
			КлючиИзмерений.Добавить("minOpsPerSecond");
			КлючиИзмерений.Добавить("maxOpsPerSecond");
		КонецЕсли;

		Для Каждого Ключ Из КлючиИзмерений Цикл
			ЗначениеИзмерения = Неопределено;
			Если Диагностика.measurements.Свойство(Ключ, ЗначениеИзмерения) Тогда
				Детали = Детали + "; " + Ключ + "=" + Строка(ЗначениеИзмерения);
			КонецЕсли;
		КонецЦикла;

		БенчмаркРаннер.СохранитьНативнуюДиагностику(
			ИдентификаторПрогона,
			КодПробыРегистра,
			НаименованиеПробы,
			Диагностика.primaryValue,
			Диагностика.primaryUnit,
			Диагностика.checksum,
			Детали,
			Диагностика.status);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СохранитьНедоступныеНативныеДиагностикиCPU(ИдентификаторПрогона, КонтекстИсполнения, Причина)

	Пробники = Новый Массив;
	Пробники.Добавить(Новый Структура("Номер,Название", "002", "Независимые инструкции"));
	Пробники.Добавить(Новый Структура("Номер,Название", "003", "Задержка пробуждения"));
	Пробники.Добавить(Новый Структура("Номер,Название", "004", "Очередь готовых потоков"));
	Пробники.Добавить(Новый Структура("Номер,Название", "005", "Квота CPU"));
	Пробники.Добавить(Новый Структура("Номер,Название", "006", "Конкуренция SMT"));
	Пробники.Добавить(Новый Структура("Номер,Название", "007", "Миграция между ядрами"));
	Пробники.Добавить(Новый Структура("Номер,Название", "008", "Восстановление после простоя"));
	Пробники.Добавить(Новый Структура("Номер,Название", "009", "Устойчивая скорость CPU"));
	СуффиксКонтекста = ?(КонтекстИсполнения = "client", "C", "S");
	Для Каждого Проба Из Пробники Цикл
		БенчмаркРаннер.СохранитьНативнуюДиагностику(
			ИдентификаторПрогона,
			"NCPU" + Проба.Номер + СуффиксКонтекста,
			"" + Проба.Номер + ". " + Проба.Название + " / " + КонтекстИсполнения,
			0,
			"н/д",
			0,
			"execution_context=" + КонтекстИсполнения + "; компонент недоступен: " + Причина,
			"Недоступно");
	КонецЦикла;

КонецПроцедуры

// В клиент-серверной ИБ выполняется в rphost. Подключение и создание компоненты
// происходят заново при каждом вызове: кластер может направить вызов на другой узел.
&НаСервере
Функция ВыполнитьНативнуюПробуCPUНаСервере(ИдентификаторПрогона,
	КоличествоБлоков, КоличествоПрогревов, КоличествоСерий) Экспорт

	Попытка
		ПодключитьВнешнююКомпоненту(
			"ОбщийМакет.CpuFrequencyProbe",
			"CpuFrequencyProbe",
			ТипВнешнейКомпоненты.Native);
		ИзмерительCPUСервера = Новый("AddIn.CpuFrequencyProbe.CpuProbe");
		JSONРезультата = ИзмерительCPUСервера.Measure(
			КоличествоБлоков, КоличествоПрогревов, КоличествоСерий);
		РезультатИзмерения = РазобратьРезультатНативнойПробыCPUНаСервере(JSONРезультата);
		ДеталиИзмерения = СформироватьДеталиСервернойНативнойПробыCPU(РезультатИзмерения);

		БенчмаркРаннер.СохранитьНативныйРезультатCPUДляКонтекста(
			ИдентификаторПрогона,
			"CPU_NATIVE_SERVER",
			"Нативная скорость CPU сервера",
			РезультатИзмерения.estimatedMHz,
			РезультатИзмерения.checksum,
			ДеталиИзмерения,
			"Косвенный сигнал");

		Возврат Новый Структура("Успешно,ЗначениеМетрики,Ошибка",
			Истина, РезультатИзмерения.estimatedMHz, "");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ДеталиОшибки = "execution_context=server; ошибка подключения или замера: " + ТекстОшибки;
		Попытка
			БенчмаркРаннер.СохранитьНативныйРезультатCPUДляКонтекста(
				ИдентификаторПрогона,
				"CPU_NATIVE_SERVER",
				"Нативная скорость CPU сервера",
				0,
				0,
				ДеталиОшибки,
				"Недоступно");
		Исключение
			ТекстОшибки = ТекстОшибки + "; запись статуса не выполнена: " + ОписаниеОшибки();
		КонецПопытки;
		Возврат Новый Структура("Успешно,ЗначениеМетрики,Ошибка", Ложь, 0, ТекстОшибки);
	КонецПопытки;

КонецФункции

&НаСервере
Функция РазобратьРезультатНативнойПробыCPUНаСервере(Знач JSONРезультата)

	Если ТипЗнч(JSONРезультата) <> Тип("Строка") Тогда
		ВызватьИсключение "Серверная Native API-проба вернула результат неожиданного типа";
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONРезультата);
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Результат) <> Тип("Структура")
		Или Результат.schemaVersion <> 1
		Или Результат.physicalClockRead <> Ложь
		Или Результат.estimatedMHz <= 0
		Или Результат.operationsPerSecond <= 0
		Или Результат.medianElapsedNs <= 0
		Или Результат.sampleCount < 3
		Или ТипЗнч(Результат.sampleElapsedNs) <> Тип("Массив")
		Или Результат.sampleElapsedNs.Количество() <> Результат.sampleCount Тогда
		ВызватьИсключение "В JSON серверной Native API-пробы нет корректных измерений";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция СформироватьДеталиСервернойНативнойПробыCPU(Знач РезультатИзмерения)

	ДлительностиСерий = "";
	Для Каждого Длительность Из РезультатИзмерения.sampleElapsedNs Цикл
		Если Не ПустаяСтрока(ДлительностиСерий) Тогда
			ДлительностиСерий = ДлительностиСерий + ",";
		КонецЕсли;
		ДлительностиСерий = ДлительностиСерий + Строка(Длительность);
	КонецЦикла;

	Детали = "execution_context=server; Native API " + РезультатИзмерения.componentVersion
		+ "; arch=" + РезультатИзмерения.architecture
		+ "; compiler=" + РезультатИзмерения.compiler
		+ "; algorithm=" + РезультатИзмерения.algorithm
		+ "; blocks=" + Строка(РезультатИзмерения.blocksPerSample)
		+ "; warmups=" + Строка(РезультатИзмерения.warmups)
		+ "; samples=" + Строка(РезультатИзмерения.sampleCount)
		+ "; median_ns=" + Строка(РезультатИзмерения.medianElapsedNs)
		+ "; ops/s=" + Строка(РезультатИзмерения.operationsPerSecond)
		+ "; sample_ns=" + ДлительностиСерий
		+ "; checksum=" + Строка(РезультатИзмерения.checksum)
		+ "; экв. МГц=ops/s/1e6, не физическая частота";
	Возврат Лев(Детали, 500);

КонецФункции

#КонецОбласти
