#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	МасштабНагрузки = 1;
	ТочкиПроб042.Очистить();
	Результаты.Очистить();
	ИдентификаторПрогона = "";

	Попытка
		ИдентификаторПрогона = БенчмаркРаннер.ПолучитьПоследнийИдентификаторПрогона();
		Если Не ПустаяСтрока(ИдентификаторПрогона) Тогда
			ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);
			ОбновитьСводкуПоРезультатамНаСервере();
		КонецЕсли;
	Исключение
		Сообщить("Не удалось загрузить сохранённые результаты: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьПрогон(Команда) Экспорт

	Попытка
		ВыполнитьПрогонНаСервере();
	Исключение
		Сообщить("Не удалось выполнить бенчмарк: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПробу042(Команда) Экспорт

	Попытка
		ИтогПроб = ВыполнитьПробу042НаСервере();
		ИдентификаторПрогона042 = ИтогПроб.ИдентификаторПрогона;
		ПутьВременногоФайла042 = ИтогПроб.ПутьФайла;
		ЗагрузитьТочкиПроб042НаСервере(ИдентификаторПрогона042);
		ТекстИтога = "Сохранено результатов: " + Строка(ИтогПроб.КоличествоТочек)
			+ "; ошибок измерения: " + Строка(ИтогПроб.КоличествоОшибок);
		Если Не ПустаяСтрока(ИтогПроб.ОшибкаОчистки) Тогда
			ТекстИтога = ТекстИтога + "; не удалось удалить временный файл: " + ИтогПроб.ОшибкаОчистки;
		КонецЕсли;
		Сообщить(ТекстИтога);
	Исключение
		Сообщить("Проба 042 завершилась ошибкой: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти


// Проба 027: измеряет пустые обращения к серверу без формы и SQL.
&НаКлиенте
Функция ИзмеритьБазовуюЦенуСерверногоВызова(Знач ЧислоПрогревов = 3,
	Знач ЧислоСерий = 5, Знач ВызововВСерии = 20) Экспорт

	Если ЧислоПрогревов < 0 Или ЧислоСерий < 3 Или ВызововВСерии <= 0 Тогда
		ВызватьИсключение "Для пробы 027 нужны прогревы >= 0, минимум три серии и положительное число вызовов";
	КонецЕсли;

	Для Индекс = 1 По ЧислоПрогревов Цикл
		БенчмаркПроба027БазоваяЦенаСерверногоВызова.ПустойОбработчикБезКонтекста();
	КонецЦикла;

	Наблюдения = Новый Массив;
	Для Серия = 1 По ЧислоСерий Цикл
		НачалоКлиентаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		СуммаОбработчикаМс = 0;
		Для Индекс = 1 По ВызововВСерии Цикл
			СуммаОбработчикаМс = СуммаОбработчикаМс
				+ БенчмаркПроба027БазоваяЦенаСерверногоВызова.ПустойОбработчикБезКонтекста();
		КонецЦикла;
		ДлительностьКлиентаМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоКлиентаМс;
		Наблюдения.Добавить(Новый Структура("ЧислоВызовов,RTTНс,ВремяОбработчикаНс",
			ВызововВСерии, ДлительностьКлиентаМс * 1000000 / ВызововВСерии,
			СуммаОбработчикаМс * 1000000 / ВызововВСерии));
	КонецЦикла;

	Возврат БенчмаркПроба027БазоваяЦенаСерверногоВызова.АнализироватьНаблюдения(Наблюдения);

КонецФункции

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьПрогонНаСервере()

	МасштабЗапуска = ?(МасштабНагрузки > 0, МасштабНагрузки, 1);
	ИдентификаторПрогона = Строка(Новый УникальныйИдентификатор);

	Попытка
		Итог = БенчмаркРаннер.ВыполнитьПолныйПрогон(ИдентификаторПрогона, МасштабЗапуска);
		ОбщийБалл = Итог.ОбщийБалл;
		ГлавноеУзкоеМесто = Итог.ГлавноеУзкоеМесто;
		ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);
		Если Результаты.Количество() = 0 Тогда
			ВызватьИсключение "Прогон завершился, но записи не найдены в регистре РезультатыПрогонов";
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		КоличествоСохраненныхСтрок = 0;
		Попытка
			ТаблицаЧастичныхРезультатов = БенчмаркРаннер.ПолучитьРезультатыПрогона(ИдентификаторПрогона);
			КоличествоСохраненныхСтрок = ТаблицаЧастичныхРезультатов.Количество();
			Если КоличествоСохраненныхСтрок > 0 Тогда
				ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);
				ОбщийБалл = 0;
				ГлавноеУзкоеМесто = "Прогон прерван; сводный индекс не рассчитан";
			КонецЕсли;
		Исключение
			// Сохраняем исходную ошибку прогона, даже если не удалось прочитать частичный результат.
		КонецПопытки;
		Сообщить("Прогон прерван: " + ТекстОшибки
			+ "; сохранено строк результатов: " + Строка(КоличествоСохраненныхСтрок));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона)

	ТаблицаРезультатов = БенчмаркРаннер.ПолучитьРезультатыПрогона(ИдентификаторПрогона);
	Результаты.Очистить();
	Для Каждого РезультатИзРегистра Из ТаблицаРезультатов Цикл
		НоваяСтрока = Результаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, РезультатИзРегистра);
	КонецЦикла;
	Элементы.ТаблицаРезультатов.Видимость = Результаты.Количество() > 0;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСводкуПоРезультатамНаСервере()

	ИндексыДляОбщегоБалла = Новый Массив;
	КоличествоОцениваемыхПроб = 0;
	МинимальныйИндекс = 101;
	ГлавноеУзкоеМесто = "";

	Для Каждого СтрокаРезультата Из Результаты Цикл
		Если СтрокаРезультата.Статус <> "Косвенный сигнал" И СтрокаРезультата.Индекс > 0 Тогда
			ИндексыДляОбщегоБалла.Добавить(СтрокаРезультата.Индекс);
			КоличествоОцениваемыхПроб = КоличествоОцениваемыхПроб + 1;
			Если СтрокаРезультата.Индекс < МинимальныйИндекс Тогда
				МинимальныйИндекс = СтрокаРезультата.Индекс;
				ГлавноеУзкоеМесто = СтрокаРезультата.КодПробы + " ("
					+ СтрокаРезультата.НаименованиеПробы + ")";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоОцениваемыхПроб = 0 Тогда
		ОбщийБалл = 0;
		ГлавноеУзкоеМесто = "Нет оцениваемых проб";
		Возврат;
	КонецЕсли;
	Если КоличествоОцениваемыхПроб < 7 Тогда
		ОбщийБалл = 0;
		ГлавноеУзкоеМесто = "Неполный прогон: " + Строка(КоличествоОцениваемыхПроб)
			+ " из 7 оцениваемых проб";
		Возврат;
	КонецЕсли;

	ОбщийБалл = Окр(
		БенчмаркРаннер.СреднееГеометрическоеИндексов(ИндексыДляОбщегоБалла), 1);
	Если МинимальныйИндекс >= 100 Тогда
		ГлавноеУзкоеМесто = "Все прямые пробы в целевом бюджете";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВыполнитьПробу042НаСервере()

	Возврат БенчмаркПроба042Хранилище.ВыполнитьПрогон();

КонецФункции

&НаСервере
Процедура ЗагрузитьТочкиПроб042НаСервере(ИдентификаторПрогона)

	ТаблицаТочек = БенчмаркПроба042Хранилище.ПолучитьТочкиПрогона(ИдентификаторПрогона);
	ТочкиПроб042.Очистить();
	Для Каждого Точка Из ТаблицаТочек Цикл
		НоваяСтрока = ТочкиПроб042.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Точка);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
