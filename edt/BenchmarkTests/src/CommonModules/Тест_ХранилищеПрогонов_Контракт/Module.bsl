#Область ПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("Нормализованное хранение прогонов")
		.ДобавитьСерверныйТест("Тест_ХранилищеПрогонов_Контракт");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_ХранилищеПрогонов_Контракт() Экспорт

	ИдентификаторПрогона = Строка(Новый УникальныйИдентификатор);
	СсылкаНаПрогон = БенчмаркХранилищеПрогонов.СоздатьПрогон(
		ИдентификаторПрогона, 1, "server", "storage-contract-test");
	ДатаИзмерения = ТекущаяУниверсальнаяДата();

	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
		СсылкаНаПрогон, "TEST_DIRECT", "test.sample.count", "990",
		"Тестовый прямой показатель", 17, "операций", "успешно", "",
		ДатаИзмерения, ДатаИзмерения, 0, "sample=17",
		"server.test", "сервер 1С", "BSL", "тестовый ресурс", 1,
		1, 1, "измерение", 1, 17, 1, "значение");
	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
		СсылкаНаПрогон, "TEST_DIRECT", "test.sample.count", "990",
		"Медианный тестовый показатель", 17, "операций", "успешно", "",
		ДатаИзмерения, ДатаИзмерения, 0, "samples=3",
		"server.test", "сервер 1С", "BSL", "тестовый ресурс", 1,
		1, 1, "измерение", 3, 17, 1, "медиана");
	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
		СсылкаНаПрогон, "TEST_CONTEXT", "test.proxy.value", "990",
		"Тестовый косвенный сигнал", 5, "условных единиц", "Косвенный сигнал",
		"BSL не измеряет целевой системный счётчик",
		ДатаИзмерения, ДатаИзмерения, 0, "proxy=true",
		"server.test", "сервер 1С", "BSL", "тестовый ресурс", 1,
		1, 1, "измерение", 1, 0, 0, "значение");

	РезультатПопытки = ПолучитьПопытку(СсылкаНаПрогон, "TEST_DIRECT", 1);
	ЮТест.ОжидаетЧто(РезультатПопытки.Найдена).Равно(Истина);
	Если РезультатПопытки.Найдена Тогда
		ЮТест.ОжидаетЧто(РезультатПопытки.ПринятаДляСравнения).Равно(Истина);
	КонецЕсли;

	СыройПоказатель = ПолучитьПоказатель(СсылкаНаПрогон,
		"TEST_DIRECT", "test.sample.count", "server.test", 1, "значение");
	ЮТест.ОжидаетЧто(СыройПоказатель.Найден).Равно(Истина);
	Если СыройПоказатель.Найден Тогда
		ЮТест.ОжидаетЧто(СыройПоказатель.Наличие).Равно("Доступно");
		ЮТест.ОжидаетЧто(СыройПоказатель.Значение).Равно(17);
	КонецЕсли;

	СводныйПоказатель = ПолучитьПоказатель(СсылкаНаПрогон,
		"TEST_DIRECT", "test.sample.count", "server.test.aggregate", 0, "медиана");
	ЮТест.ОжидаетЧто(СводныйПоказатель.Найден).Равно(Истина);
	Если СводныйПоказатель.Найден Тогда
		ЮТест.ОжидаетЧто(СводныйПоказатель.Значение).Равно(17);
		ЮТест.ОжидаетЧто(СводныйПоказатель.ЧислоНаблюдений).Равно(3);
	КонецЕсли;
	ЮТест.ОжидаетЧто(КоличествоПопыток(СсылкаНаПрогон, "TEST_DIRECT", 0)).Равно(0);

	КосвенныйПоказатель = ПолучитьПоказатель(СсылкаНаПрогон,
		"TEST_CONTEXT", "test.proxy.value", "server.test", 1, "значение");
	ЮТест.ОжидаетЧто(КосвенныйПоказатель.Найден).Равно(Истина);
	Если КосвенныйПоказатель.Найден Тогда
		ЮТест.ОжидаетЧто(КосвенныйПоказатель.Наличие).Равно("Контекст");
	КонецЕсли;
	КосвеннаяПопытка = ПолучитьПопытку(СсылкаНаПрогон, "TEST_CONTEXT", 1);
	ЮТест.ОжидаетЧто(КосвеннаяПопытка.Найдена).Равно(Истина);
	Если КосвеннаяПопытка.Найдена Тогда
		ЮТест.ОжидаетЧто(КосвеннаяПопытка.ПринятаДляСравнения).Равно(Ложь);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьПоказатель(Знач СсылкаНаПрогон, Знач ИдентификаторТочки,
	Знач КодМетрики, Знач ИдентификаторРяда, Знач НомерПовтора, Знач Статистика)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	| Показатели.Наличие КАК Наличие,
	| Показатели.Значение КАК Значение,
	| Показатели.ЧислоНаблюдений КАК ЧислоНаблюдений
	|ИЗ
	| РегистрСведений.ПоказателиПопыток КАК Показатели
	|ГДЕ
	| Показатели.Прогон = &Прогон
	| И Показатели.ИдентификаторТочки = &ИдентификаторТочки
	| И Показатели.КодМетрики = &КодМетрики
	| И Показатели.ИдентификаторРяда = &ИдентификаторРяда
	| И Показатели.НомерПовтора = &НомерПовтора
	| И Показатели.Статистика = &Статистика";
	Запрос.УстановитьПараметр("Прогон", СсылкаНаПрогон);
	Запрос.УстановитьПараметр("ИдентификаторТочки", ИдентификаторТочки);
	Запрос.УстановитьПараметр("КодМетрики", КодМетрики);
	Запрос.УстановитьПараметр("ИдентификаторРяда", ИдентификаторРяда);
	Запрос.УстановитьПараметр("НомерПовтора", НомерПовтора);
	Запрос.УстановитьПараметр("Статистика", Статистика);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Найден,Наличие,Значение,ЧислоНаблюдений",
			Истина, Выборка.Наличие, Выборка.Значение, Выборка.ЧислоНаблюдений);
	КонецЕсли;
	Возврат Новый Структура("Найден,Наличие,Значение,ЧислоНаблюдений",
		Ложь, "", 0, 0);

КонецФункции

Функция ПолучитьПопытку(Знач СсылкаНаПрогон, Знач ИдентификаторТочки, Знач НомерПовтора)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	| Попытки.ПринятаДляСравнения КАК ПринятаДляСравнения
	|ИЗ
	| РегистрСведений.ПопыткиПроб КАК Попытки
	|ГДЕ
	| Попытки.Прогон = &Прогон
	| И Попытки.ИдентификаторТочки = &ИдентификаторТочки
	| И Попытки.НомерПовтора = &НомерПовтора
	| И Попытки.НомерПопытки = 1";
	Запрос.УстановитьПараметр("Прогон", СсылкаНаПрогон);
	Запрос.УстановитьПараметр("ИдентификаторТочки", ИдентификаторТочки);
	Запрос.УстановитьПараметр("НомерПовтора", НомерПовтора);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Найдена,ПринятаДляСравнения",
			Истина, Выборка.ПринятаДляСравнения);
	КонецЕсли;
	Возврат Новый Структура("Найдена,ПринятаДляСравнения", Ложь, Ложь);

КонецФункции

Функция КоличествоПопыток(Знач СсылкаНаПрогон, Знач ИдентификаторТочки, Знач НомерПовтора)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	| РегистрСведений.ПопыткиПроб КАК Попытки
	|ГДЕ
	| Попытки.Прогон = &Прогон
	| И Попытки.ИдентификаторТочки = &ИдентификаторТочки
	| И Попытки.НомерПовтора = &НомерПовтора";
	Запрос.УстановитьПараметр("Прогон", СсылкаНаПрогон);
	Запрос.УстановитьПараметр("ИдентификаторТочки", ИдентификаторТочки);
	Запрос.УстановитьПараметр("НомерПовтора", НомерПовтора);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

#КонецОбласти
