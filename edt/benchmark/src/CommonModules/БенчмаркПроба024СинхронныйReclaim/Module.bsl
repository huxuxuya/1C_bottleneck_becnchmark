#Область ПрограммныйИнтерфейс

// Анализирует внешние точки размера набора в cgroup.
// Наблюдение: ВремяВыделенияНс, ВремяПервогоКасанияНс, DirectReclaimСтраниц,
// MemoryPSIНекоторыеМкс, MemoryPSIПолныеМкс, КонтрольнаяСумма.
Функция АнализироватьReclaim(Знач Точки) Экспорт

	Если Точки.Количество() < 2 Тогда
		ВызватьИсключение "Нужны минимум две точки размера рабочего набора";
	КонецЕсли;

	Результаты = Новый Массив;
	ПредыдущийРазмер = 0;
	ПорогReclaimБайт = 0;
	ИдентификаторСтенда = "";
	ИдентификаторОграничения = "";
	БазовоеВремяКасанияНс = 0;

	Для Каждого Точка Из Точки Цикл
		Если Точка.РазмерРабочегоНабораБайт <= ПредыдущийРазмер
			Или Точка.СтраницВНаборе <= 0 Тогда
			ВызватьИсключение "Размер набора должен возрастать, число страниц должно быть положительным";
		КонецЕсли;
		Если Точка.Наблюдения.Количество() < 3 Тогда
			ВызватьИсключение "Для каждой точки нужны минимум три повтора";
		КонецЕсли;
		Если ПредыдущийРазмер = 0 Тогда
			ИдентификаторСтенда = Точка.ИдентификаторСтенда;
			ИдентификаторОграничения = Точка.ИдентификаторОграничения;
		ИначеЕсли ИдентификаторСтенда <> Точка.ИдентификаторСтенда
			Или ИдентификаторОграничения <> Точка.ИдентификаторОграничения Тогда
			ВызватьИсключение "Стенд и ограничение памяти должны быть неизменны";
		КонецЕсли;

		ВыделениеНс = Новый СписокЗначений;
		КасаниеНс = Новый СписокЗначений;
		ReclaimСтраниц = Новый СписокЗначений;
		PSIНекоторыеМкс = Новый СписокЗначений;
		PSIПолныеМкс = Новый СписокЗначений;
		КонтрольнаяСумма = Неопределено;
		Для Каждого Наблюдение Из Точка.Наблюдения Цикл
			Если Наблюдение.ВремяВыделенияНс <= 0 Или Наблюдение.ВремяПервогоКасанияНс <= 0
				Или Наблюдение.DirectReclaimСтраниц < 0
				Или Наблюдение.MemoryPSIНекоторыеМкс < 0
				Или Наблюдение.MemoryPSIПолныеМкс < 0 Тогда
				ВызватьИсключение "Время должно быть положительным, а reclaim и PSI неотрицательными";
			КонецЕсли;
			Если КонтрольнаяСумма = Неопределено Тогда
				КонтрольнаяСумма = Наблюдение.КонтрольнаяСумма;
			ИначеЕсли КонтрольнаяСумма <> Наблюдение.КонтрольнаяСумма Тогда
				ВызватьИсключение "Повторы должны касаться одного детерминированного набора";
			КонецЕсли;
			ВыделениеНс.Добавить(Наблюдение.ВремяВыделенияНс);
			КасаниеНс.Добавить(Наблюдение.ВремяПервогоКасанияНс);
			ReclaimСтраниц.Добавить(Наблюдение.DirectReclaimСтраниц);
			PSIНекоторыеМкс.Добавить(Наблюдение.MemoryPSIНекоторыеМкс);
			PSIПолныеМкс.Добавить(Наблюдение.MemoryPSIПолныеМкс);
		КонецЦикла;

		МедианаReclaim = Медиана(ReclaimСтраниц);
		МедианаPSIНекоторые = Медиана(PSIНекоторыеМкс);
		МедианаPSIПолные = Медиана(PSIПолныеМкс);
		МедианаКасания = Медиана(КасаниеНс);
		Если ПредыдущийРазмер = 0 Тогда
			БазовоеВремяКасанияНс = МедианаКасания;
		КонецЕсли;
		ЕстьСигнал = МедианаReclaim > 0 Или МедианаPSIНекоторые > 0 Или МедианаPSIПолные > 0;
		Если ЕстьСигнал И ПорогReclaimБайт = 0 Тогда
			ПорогReclaimБайт = Точка.РазмерРабочегоНабораБайт;
		КонецЕсли;
		Результаты.Добавить(Новый Структура("РазмерРабочегоНабораБайт,СтраницВНаборе,МедианаВремениВыделенияНс,МедианаВремениПервогоКасанияНс,МедианаDirectReclaimСтраниц,МедианаMemoryPSIНекоторыеМкс,МедианаMemoryPSIПолныеМкс,ЕстьСигналReclaimИлиPSI,ЗамедлениеКасанияКБазеПроцентов,КонтрольнаяСумма",
			Точка.РазмерРабочегоНабораБайт, Точка.СтраницВНаборе,
			Медиана(ВыделениеНс), МедианаКасания, МедианаReclaim, МедианаPSIНекоторые,
			МедианаPSIПолные, ЕстьСигнал,
			(МедианаКасания - БазовоеВремяКасанияНс) * 100 / БазовоеВремяКасанияНс,
			КонтрольнаяСумма));
		ПредыдущийРазмер = Точка.РазмерРабочегоНабораБайт;
	КонецЦикла;

	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторОграничения,ПорогReclaimНабораБайт,Точки",
		ИдентификаторСтенда, ИдентификаторОграничения, ПорогReclaimБайт, Результаты);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Медиана(Значения)
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение)
		+ Число(Значения[Количество / 2].Значение)) / 2;
КонецФункции

#КонецОбласти
