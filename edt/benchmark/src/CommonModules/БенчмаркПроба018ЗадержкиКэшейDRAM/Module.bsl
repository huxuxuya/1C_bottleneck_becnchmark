#Область ПрограммныйИнтерфейс

// Анализирует внешние замеры зависимого случайного обхода по размерам рабочего набора.
// Точка: РазмерНабораБайт, РазмерLLCБайт, ИдентификаторСтенда, ИдентификаторАлгоритма,
// ЗависимаяЦепочка, ПорядокСлучайный, Наблюдения.
// Наблюдение: ЧислоДоступов, ДлительностьНс, КонтрольнаяСумма;
// необязательное поле ПромахиLLC.
Функция АнализироватьКривуюЗадержки(Знач Точки) Экспорт

	Если Точки.Количество() < 3 Тогда
		ВызватьИсключение "Для кривой кэш/DRAM нужны минимум три размера рабочего набора";
	КонецЕсли;

	Результаты = Новый Массив;
	ПредыдущийРазмер = 0;
	ПредыдущаяМедиана = 0;
	ОбщееЧислоДоступов = 0;
	РазмерLLC = 0;
	ИдентификаторСтенда = "";
	ИдентификаторАлгоритма = "";

	Для Каждого Точка Из Точки Цикл
		Если Точка.РазмерНабораБайт <= ПредыдущийРазмер Или Точка.РазмерLLCБайт <= 0 Тогда
			ВызватьИсключение "Размеры рабочего набора должны строго возрастать";
		КонецЕсли;
		Если Не Точка.ЗависимаяЦепочка Или Не Точка.ПорядокСлучайный Тогда
			ВызватьИсключение "Нужны зависимая цепочка и случайный порядок доступа";
		КонецЕсли;
		Если Точка.Наблюдения.Количество() < 3 Тогда
			ВызватьИсключение "Для каждого размера нужны минимум три повтора";
		КонецЕсли;
		Если ПустаяСтрока(Точка.ИдентификаторСтенда)
			Или ПустаяСтрока(Точка.ИдентификаторАлгоритма) Тогда
			ВызватьИсключение "Укажите стенд и версию алгоритма";
		КонецЕсли;

		Если ПустаяСтрока(ИдентификаторСтенда) Тогда
			ИдентификаторСтенда = Точка.ИдентификаторСтенда;
			ИдентификаторАлгоритма = Точка.ИдентификаторАлгоритма;
			РазмерLLC = Точка.РазмерLLCБайт;
		ИначеЕсли ИдентификаторСтенда <> Точка.ИдентификаторСтенда
			Или ИдентификаторАлгоритма <> Точка.ИдентификаторАлгоритма
			Или РазмерLLC <> Точка.РазмерLLCБайт Тогда
			ВызватьИсключение "Стенд, алгоритм и размер LLC должны быть одинаковыми для всех размеров";
		КонецЕсли;

		ЗначенияНс = Новый СписокЗначений;
		КонтрольнаяСумма = Неопределено;
		ЧислоДоступов = 0;
		ПромахиДоступны = Истина;
		ПромахиНаДоступ = Новый СписокЗначений;
		Для Каждого Наблюдение Из Точка.Наблюдения Цикл
			Если Наблюдение.ЧислоДоступов <= 0 Или Наблюдение.ДлительностьНс <= 0 Тогда
				ВызватьИсключение "Число доступов и длительность должны быть положительными";
			КонецЕсли;
			Если ЧислоДоступов = 0 Тогда
				ЧислоДоступов = Наблюдение.ЧислоДоступов;
				КонтрольнаяСумма = Наблюдение.КонтрольнаяСумма;
			ИначеЕсли ЧислоДоступов <> Наблюдение.ЧислоДоступов
				Или КонтрольнаяСумма <> Наблюдение.КонтрольнаяСумма Тогда
				ВызватьИсключение "Повторы должны выполнять одинаковую работу с одной контрольной суммой";
			КонецЕсли;
			ЗначенияНс.Добавить(Наблюдение.ДлительностьНс / Наблюдение.ЧислоДоступов);
			Промахи = 0;
			Если Наблюдение.Свойство("ПромахиLLC", Промахи) Тогда
				Если Промахи < 0 Тогда
					ВызватьИсключение "Число промахов LLC не может быть отрицательным";
				КонецЕсли;
				ПромахиНаДоступ.Добавить(Промахи / Наблюдение.ЧислоДоступов);
			Иначе
				ПромахиДоступны = Ложь;
			КонецЕсли;
		КонецЦикла;
		Если ОбщееЧислоДоступов = 0 Тогда
			ОбщееЧислоДоступов = ЧислоДоступов;
		ИначеЕсли ОбщееЧислоДоступов <> ЧислоДоступов Тогда
			ВызватьИсключение "Число доступов должно совпадать для всех размеров набора";
		КонецЕсли;

		МедианаНс = Медиана(ЗначенияНс);
		ПриростПроцентов = 0;
		Если ПредыдущаяМедиана > 0 Тогда
			ПриростПроцентов = (МедианаНс - ПредыдущаяМедиана) * 100 / ПредыдущаяМедиана;
		КонецЕсли;
		ПромахиНаДоступМедиана = 0;
		Если ПромахиДоступны Тогда
			ПромахиНаДоступМедиана = Медиана(ПромахиНаДоступ);
		КонецЕсли;

		РезультатТочки = Новый Структура("РазмерНабораБайт,ЧислоДоступов,МедианаНсНаДоступ,ПриростКПредыдущемуПроцентов,КонтрольнаяСумма,ПромахиLLCДоступны,ПромахиLLCНаДоступ",
			Точка.РазмерНабораБайт, ЧислоДоступов, МедианаНс, ПриростПроцентов, КонтрольнаяСумма, ПромахиДоступны, ПромахиНаДоступМедиана);
		Результаты.Добавить(РезультатТочки);
		ПредыдущийРазмер = Точка.РазмерНабораБайт;
		ПредыдущаяМедиана = МедианаНс;
	КонецЦикла;
	Если ПредыдущийРазмер <= РазмерLLC Тогда
		ВызватьИсключение "Верхняя точка кривой должна превышать размер LLC";
	КонецЕсли;

	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторАлгоритма,Кривая",
		ИдентификаторСтенда, ИдентификаторАлгоритма, Результаты);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Медиана(Значения)
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение)
		+ Число(Значения[Количество / 2].Значение)) / 2;
КонецФункции

#КонецОбласти
