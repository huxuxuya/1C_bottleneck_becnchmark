Процедура СохранитьСтрокуПрогона(Знач Контекст, Знач Результат)

	Менеджер = РегистрыСведений.РезультатыПрогонов.СоздатьМенеджерЗаписи();
	Менеджер.ИдентификаторПрогона = Контекст.ИдентификаторПрогона;
	Менеджер.КодПробы = Результат.Код;
	Менеджер.ДатаПрогона = Контекст.ДатаПрогона;
	Менеджер.НаименованиеПробы = Результат.Наименование;
	Менеджер.ЗначениеМетрики = Результат.ЗначениеМетрики;
	Менеджер.ЦелевоеЗначение = 0;
	Менеджер.ЕдиницаИзмерения = Результат.ЕдиницаИзмерения;
	Менеджер.Баллы = 0;
	Менеджер.Индекс = 0;
	Менеджер.Статус = Результат.Статус;
	Менеджер.КонтрольнаяСумма = Результат.КонтрольнаяСумма;
	Менеджер.Детали = Лев("Длительность: " + Строка(Результат.ДлительностьМс)
		+ " мс; " + Результат.Детали, 500);
	Менеджер.Записать(Истина);

	СтатусХранилища = ?(Результат.Статус = "Ошибка", "Ошибка",
		?(Результат.Статус = "Недоступно в BSL", "Недоступно",
			?(Результат.Статус = "BSL-прокси", "Косвенный сигнал", "успешно")));
	ПричинаХранилища = ?(СтатусХранилища = "успешно", "", Результат.Детали);
	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
		Контекст.СсылкаНаПрогон, "DIAG_" + Результат.Номер,
		"diagnostic." + Результат.Номер + ".value", Результат.Номер,
		Результат.Наименование, Результат.ЗначениеМетрики,
		Результат.ЕдиницаИзмерения, СтатусХранилища, ПричинаХранилища,
		Результат.ДатаНачалаUTC, Результат.ДатаЗавершенияUTC,
		Результат.КонтрольнаяСумма, Результат.Детали,
		"server.diagnostics", "сервер 1С", "BSL", Результат.Код, 1,
		1, 1, "измерение", ?(СтатусХранилища = "успешно", 1, 0), 0, 0);

КонецПроцедуры

Функция ИзмеритьФайловыйПрофиль(Знач Профиль, Знач Код)

	РазмерБлока = 65536;
	ЧислоБлоков = 64;
	Если Профиль = "FILE_WARM_READ" Тогда
		ЧислоБлоков = 1024;
	КонецЕсли;
	РазмерВсего = РазмерБлока * ЧислоБлоков;
	Буфер = БенчмаркЯдро.СоздатьБуферПробныхДанных(РазмерБлока);
	ОжидаемыйПервыйБайт = Буфер[0];
	ОжидаемыйСреднийБайт = Буфер[Цел(РазмерБлока / 2)];
	ОжидаемыйПоследнийБайт = Буфер[РазмерБлока - 1];
	Путь = ПолучитьИмяВременногоФайла("bin");
	ПутьВторогоФайла = "";
	КонтрольнаяСумма = 0;
	ДлительностьМс = 0;
	ДлительностьПервогоПроходаМс = 0;
	ДлительностьПовторногоПроходаМс = 0;
	ПовторовПервогоПрохода = 0;
	ПовторовВторогоПрохода = 0;
	ОбъемБайт = 0;
	Поток = Неопределено;
	ЗаписьДанных = Неопределено;
	ЧтениеДанных = Неопределено;

	Попытка
		НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Поток = FileStreams.OpenForWrite(Путь);
		Если Профиль = "FILE_RANDOM_WRITE" Тогда
			// Подготавливаем длину файла до измерения. В окне измеряется только QD=1
			// перезапись полного набора блоков в переставленном порядке.
			Для Блок = 1 По ЧислоБлоков Цикл
				Поток.Write(Буфер, 0, РазмерБлока);
			КонецЦикла;
			Поток.Close();
			ПорядокБлоков = Новый Массив;
			Для ИндексБлока = 0 По ЧислоБлоков - 1 Цикл
				ПорядокБлоков.Добавить(ИндексБлока);
			КонецЦикла;
			СостояниеГенератора = 17;
			Для Шаг = 0 По ЧислоБлоков - 1 Цикл
				СостояниеГенератора = (СостояниеГенератора * 48271) % 2147483647;
				ИндексДляОбмена = Шаг + (СостояниеГенератора % (ЧислоБлоков - Шаг));
				ВременныйИндекс = ПорядокБлоков[Шаг];
				ПорядокБлоков[Шаг] = ПорядокБлоков[ИндексДляОбмена];
				ПорядокБлоков[ИндексДляОбмена] = ВременныйИндекс;
			КонецЦикла;
			ОбъемБайт = 0;
			НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Поток = FileStreams.OpenForWrite(Путь);
			Для Шаг = 0 По ЧислоБлоков - 1 Цикл
				ИндексБлока = ПорядокБлоков[Шаг];
				Поток.Seek(ИндексБлока * РазмерБлока, ПозицияВПотоке.Начало);
				Поток.Write(Буфер, 0, РазмерБлока);
				ОбъемБайт = ОбъемБайт + РазмерБлока;
			КонецЦикла;
		ИначеЕсли Профиль = "FILE_FLUSH" Или Профиль = "FILE_GROWTH" Тогда
			Для Блок = 1 По ЧислоБлоков Цикл
				Поток.Write(Буфер, 0, РазмерБлока);
				ОбъемБайт = ОбъемБайт + РазмерБлока;
			КонецЦикла;
			Если Профиль = "FILE_FLUSH" Тогда
				Поток.Flush();
			КонецЕсли;
		Иначе
			ЗаписьДанных = Новый DataWriter(Поток);
			Для Блок = 1 По ЧислоБлоков Цикл
				ЗаписьДанных.WriteBinaryDataBuffer(Буфер);
				ОбъемБайт = ОбъемБайт + РазмерБлока;
			КонецЦикла;
			ЗаписьДанных.Close();
			ЗаписьДанных = Неопределено;
		КонецЕсли;
		Поток.Close();
		Поток = Неопределено;
		Если Профиль = "FILE_RANDOM_WRITE" Тогда
			ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
		КонецЕсли;

		Если Профиль = "FILE_PATH" Тогда
			ПутьВторогоФайла = ПолучитьИмяВременногоФайла("bin");
			Поток = FileStreams.OpenForWrite(ПутьВторогоФайла);
			ЗаписьДанных = Новый DataWriter(Поток);
			Для Блок = 1 По ЧислоБлоков Цикл
				ЗаписьДанных.WriteBinaryDataBuffer(Буфер);
			КонецЦикла;
			ЗаписьДанных.Close();
			ЗаписьДанных = Неопределено;
			Поток.Close();
			Поток = Неопределено;
		КонецЕсли;

		Если Профиль = "FILE_RANDOM_WRITE" Тогда
			Поток = FileStreams.OpenForRead(Путь);
			ЧтениеДанных = Новый DataReader(Поток);
			Для Блок = 1 По ЧислоБлоков Цикл
				БуферПроверки = ЧтениеДанных.ReadIntoBinaryDataBuffer(РазмерБлока);
				Если ЧтениеДанных.ReadCompleted Или БуферПроверки[0] <> ОжидаемыйПервыйБайт
					Или БуферПроверки[РазмерБлока - 1] <> ОжидаемыйПоследнийБайт Тогда
					ВызватьИсключение "Случайная запись не создала ожидаемый файл";
				КонецЕсли;
				Если БуферПроверки[Цел(РазмерБлока / 2)] <> ОжидаемыйСреднийБайт Тогда
					ВызватьИсключение "Контрольный байт случайной записи не совпал";
				КонецЕсли;
				КонтрольнаяСумма = КонтрольнаяСумма + БуферПроверки[0]
					+ БуферПроверки[Цел(РазмерБлока / 2)] + БуферПроверки[РазмерБлока - 1];
			КонецЦикла;
			ЧтениеДанных.Close();
			ЧтениеДанных = Неопределено;
			Поток.Close();
			Поток = Неопределено;
		КонецЕсли;

		Если Профиль = "FILE_RANDOM_READ" Или Профиль = "FILE_SEQUENTIAL_READ"
			Или Профиль = "FILE_WARM_READ" Или Профиль = "FILE_PATH" Тогда
			НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЧислоПроходов = ?(Профиль = "FILE_WARM_READ" Или Профиль = "FILE_PATH", 2, 1);
			Для Проход = 1 По ЧислоПроходов Цикл
				Если Профиль = "FILE_PATH" И Проход = 2 Тогда
					ПутьЧтения = ПутьВторогоФайла;
				Иначе
					ПутьЧтения = Путь;
				КонецЕсли;
				ЧислоПовторовПрохода = 1;
				Пока Истина Цикл
					ОбъемДоПовтора = ОбъемБайт;
					КонтрольнаяСуммаДоПовтора = КонтрольнаяСумма;
					НачалоПроходаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
					Для ПовторЧтения = 1 По ЧислоПовторовПрохода Цикл
						Поток = FileStreams.OpenForRead(ПутьЧтения);
						Если Профиль = "FILE_RANDOM_READ" Тогда
							Для Блок = 1 По ЧислоБлоков Цикл
								ИндексБлока = (Блок * 37) % ЧислоБлоков;
								Поток.Seek(ИндексБлока * РазмерБлока, ПозицияВПотоке.Начало);
								Прочитано = Поток.Read(Буфер, 0, РазмерБлока);
								Если Прочитано <> РазмерБлока Тогда
									ВызватьИсключение "Не удалось прочитать полный случайный блок";
								КонецЕсли;
								Если Буфер[0] <> ОжидаемыйПервыйБайт
									Или Буфер[Цел(РазмерБлока / 2)] <> ОжидаемыйСреднийБайт
									Или Буфер[РазмерБлока - 1] <> ОжидаемыйПоследнийБайт Тогда
									ВызватьИсключение "Случайное чтение вернуло повреждённый блок";
								КонецЕсли;
								КонтрольнаяСумма = КонтрольнаяСумма + Буфер[0]
									+ Буфер[Цел(РазмерБлока / 2)] + Буфер[РазмерБлока - 1];
							КонецЦикла;
						Иначе
							ЧтениеДанных = Новый DataReader(Поток);
							Для Блок = 1 По ЧислоБлоков Цикл
								БуферЧтения = ЧтениеДанных.ReadIntoBinaryDataBuffer(РазмерБлока);
								Если ЧтениеДанных.ReadCompleted Тогда
									ВызватьИсключение "Файл закончился раньше ожидаемого блока";
								КонецЕсли;
								Если БуферЧтения[0] <> ОжидаемыйПервыйБайт
									Или БуферЧтения[РазмерБлока - 1] <> ОжидаемыйПоследнийБайт Тогда
									ВызватьИсключение "Прочитанный блок не совпал с записанным образцом";
								КонецЕсли;
								Если БуферЧтения[Цел(РазмерБлока / 2)] <> ОжидаемыйСреднийБайт Тогда
									ВызватьИсключение "Средний контрольный байт не совпал";
								КонецЕсли;
								КонтрольнаяСумма = КонтрольнаяСумма + БуферЧтения[0]
									+ БуферЧтения[Цел(РазмерБлока / 2)] + БуферЧтения[РазмерБлока - 1];
							КонецЦикла;
							ЧтениеДанных.Close();
							ЧтениеДанных = Неопределено;
						КонецЕсли;
						Поток.Close();
						Поток = Неопределено;
						ОбъемБайт = ОбъемБайт + РазмерВсего;
					КонецЦикла;
					ДлительностьПроходаМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПроходаМс;
					Если Профиль <> "FILE_WARM_READ" Или ДлительностьПроходаМс >= 10
						Или ЧислоПовторовПрохода >= 64 Тогда
						Прервать;
					КонецЕсли;
					ОбъемБайт = ОбъемДоПовтора;
					КонтрольнаяСумма = КонтрольнаяСуммаДоПовтора;
					ЧислоПовторовПрохода = Мин(64, ЧислоПовторовПрохода * 2);
				КонецЦикла;
				Если Проход = 1 Тогда
					ДлительностьПервогоПроходаМс = ДлительностьПроходаМс;
					ПовторовПервогоПрохода = ЧислоПовторовПрохода;
				Иначе
					ДлительностьПовторногоПроходаМс = ДлительностьПроходаМс;
					ПовторовВторогоПрохода = ЧислоПовторовПрохода;
				КонецЕсли;
			КонецЦикла;
			ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
		Иначе
			Если Профиль <> "FILE_RANDOM_WRITE" Тогда
				ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ОписаниеСбоя = ОписаниеОшибки();
		ЗакрытьИзмерительныйПоток(ЧтениеДанных);
		ЗакрытьИзмерительныйПоток(ЗаписьДанных);
		ЗакрытьИзмерительныйПоток(Поток);
		УдалитьФайлы(Путь);
		Если Не ПустаяСтрока(ПутьВторогоФайла) Тогда
			УдалитьФайлы(ПутьВторогоФайла);
		КонецЕсли;
		ВызватьИсключение ОписаниеСбоя;
	КонецПопытки;

	УдалитьФайлы(Путь);
	Если Не ПустаяСтрока(ПутьВторогоФайла) Тогда
		УдалитьФайлы(ПутьВторогоФайла);
	КонецЕсли;
	Если ДлительностьМс <= 0 Тогда
		ВызватьИсключение "Файловая операция короче разрешения BSL-таймера";
	КонецЕсли;

	Если Профиль = "FILE_RANDOM_READ" Тогда
		Детали = "64 случайных чтения по 64 КиБ, QD=1; кэш ОС участвует";
	ИначеЕсли Профиль = "FILE_RANDOM_WRITE" Тогда
			Детали = "64 псевдослучайные перезаписи по 64 КиБ, seed=17, QD=1; подготовка и проверка вне замера; кэш ОС участвует";
	ИначеЕсли Профиль = "FILE_FLUSH" Тогда
		Детали = "запись 4 МиБ и FileStream.Flush; fsync не гарантируется";
	ИначеЕсли Профиль = "FILE_WARM_READ" Тогда
			Детали = "64 МиБ на проход; повторы до 10 мс: первый=" + Строка(ПовторовПервогоПрохода)
				+ ", второй=" + Строка(ПовторовВторогоПрохода)
				+ "; кэш ОС участвует, direct I/O нет";
	ИначеЕсли Профиль = "FILE_PATH" Тогда
		Детали = "последовательное чтение двух файлов одного temp-каталога; тома не разделены";
	ИначеЕсли Профиль = "FILE_GROWTH" Тогда
		Детали = "создание файла последовательными блоками; среднее время на 64 КиБ, пики не различаются";
	ИначеЕсли Профиль = "FILE_SEQUENTIAL_READ" Тогда
		Детали = "последовательное чтение 4 МиБ через DataReader";
	Иначе
		Детали = "последовательная запись 4 МиБ через DataWriter";
	КонецЕсли;

	Если Код = "FILE_RANDOM_IOPS" Тогда
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			ЧислоБлоков * 1000 / ДлительностьМс, "операций/с", ДлительностьМс,
			КонтрольнаяСумма, Детали);
	КонецЕсли;

	Если Профиль = "FILE_WARM_READ" Тогда
		Если ДлительностьПервогоПроходаМс < 10 Или ДлительностьПовторногоПроходаМс < 10 Тогда
			ВызватьИсключение "Оба последовательных чтения должны достигать 10 мс даже после увеличения повторов";
		КонецЕсли;
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			ДлительностьПервогоПроходаМс / ДлительностьПовторногоПроходаМс,
			"проход 1/2", ДлительностьМс, КонтрольнаяСумма, Детали);
	КонецЕсли;

	Если Профиль = "FILE_GROWTH" Тогда
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			ДлительностьМс / ЧислоБлоков, "мс/64 КиБ", ДлительностьМс,
			КонтрольнаяСумма, Детали);
	КонецЕсли;

	Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
		ОбъемБайт * 1000 / ДлительностьМс / 1048576, "МиБ/с", ДлительностьМс,
		КонтрольнаяСумма, Детали);

КонецФункции

Процедура ЗакрытьИзмерительныйПоток(Знач Поток)
	Если Поток = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Поток.Close();
	Исключение
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
