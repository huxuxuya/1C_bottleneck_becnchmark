// Анализирует матрицу задержек удалённого NUMA-доступа по внешним замерам гостевой ОС.
// Привязка CPU и резидентность страниц должны быть подтверждены измерителем.

#Область ПрограммныйИнтерфейс

// Измерение содержит идентификаторы стенда, набора данных, CPU и NUMA-узлов,
// ЧислоЧтений, ДлительностьНс, контрольную сумму и подтверждения привязки/резидентности.
// Для каждой пары CPU-узел/узел-памяти требуется минимум три повторения.
Функция АнализироватьМатрицу(Знач Измерения) Экспорт

	Если Измерения.Количество() < 12 Тогда
		ВызватьИсключение "Нужна полная матрица минимум 2x2 с тремя наблюдениями на пару";
	КонецЕсли;

	УзлыCPU = Новый Массив;
	УзлыПамяти = Новый Массив;
	Стенд = "";
	НаборДанных = "";
	КонтрольнаяСумма = Неопределено;
	Для Индекс = 0 По Измерения.Количество() - 1 Цикл
		Измерение = Измерения[Индекс];
		ПроверитьИзмерение(Измерение);
		Если Индекс = 0 Тогда
			Стенд = Измерение.ИдентификаторСтенда;
			НаборДанных = Измерение.ИдентификаторНабораДанных;
			КонтрольнаяСумма = Измерение.КонтрольнаяСумма;
		ИначеЕсли Стенд <> Измерение.ИдентификаторСтенда
			Или НаборДанных <> Измерение.ИдентификаторНабораДанных
			Или КонтрольнаяСумма <> Измерение.КонтрольнаяСумма Тогда
			ВызватьИсключение "Наблюдения должны относиться к одному стенду и одинаковому набору данных";
		КонецЕсли;
		ДобавитьУникальноеЗначение(УзлыCPU, Строка(Измерение.УзелCPU));
		ДобавитьУникальноеЗначение(УзлыПамяти, Строка(Измерение.УзелПамяти));
	КонецЦикла;

	Если УзлыCPU.Количество() < 2 Или УзлыCPU.Количество() <> УзлыПамяти.Количество() Тогда
		ВызватьИсключение "Нужны одинаковые наборы как минимум из двух CPU-узлов и узлов памяти";
	КонецЕсли;
	ПроверитьФиксациюCPU(Измерения);

	Для Каждого УзелCPU Из УзлыCPU Цикл
		Если Не СодержитЗначение(УзлыПамяти, УзелCPU) Тогда
			ВызватьИсключение "Матрица не содержит локальный узел памяти для CPU-узла " + УзелCPU;
		КонецЕсли;
		Для Каждого УзелПамяти Из УзлыПамяти Цикл
			Если ЧислоНаблюденийПары(Измерения, УзелCPU, УзелПамяти) < 3 Тогда
				ВызватьИсключение "Для каждой пары NUMA-узлов нужно не менее трёх наблюдений";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого УзелПамяти Из УзлыПамяти Цикл
		Если Не СодержитЗначение(УзлыCPU, УзелПамяти) Тогда
			ВызватьИсключение "Матрица CPU/памяти должна содержать локальную диагональ";
		КонецЕсли;
	КонецЦикла;

	МатрицаРезультатов = Новый Массив;
	Для Каждого УзелCPU Из УзлыCPU Цикл
		ЛокальнаяМедиана = МедианаНсНаЧтение(Измерения, УзелCPU, УзелCPU);
		Для Каждого УзелПамяти Из УзлыПамяти Цикл
			МедианаНсНаЧтение = МедианаНсНаЧтение(Измерения, УзелCPU, УзелПамяти);
			СтрокаРезультата = Новый Структура;
			СтрокаРезультата.Вставить("УзелCPU", УзелCPU);
			СтрокаРезультата.Вставить("УзелПамяти", УзелПамяти);
			СтрокаРезультата.Вставить("МедианаНсНаЧтение", МедианаНсНаЧтение);
			СтрокаРезультата.Вставить("ЛокальнаяМедианаНсНаЧтение", ЛокальнаяМедиана);
			СтрокаРезультата.Вставить("ШтрафНсНаЧтение", Окр(МедианаНсНаЧтение - ЛокальнаяМедиана, 2));
			СтрокаРезультата.Вставить("ШтрафПроцентов", Окр((МедианаНсНаЧтение / ЛокальнаяМедиана - 1) * 100, 2));
			МатрицаРезультатов.Добавить(СтрокаРезультата);
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ЧислоNUMAУзлов", УзлыCPU.Количество());
	Результат.Вставить("КоличествоИзмерений", Измерения.Количество());
	Результат.Вставить("Матрица", МатрицаРезультатов);
	Результат.Вставить("Детали", "Внешние замеры; нужны подтверждённые привязка CPU и резидентность страниц");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьИзмерение(Измерение)

	Если Не Измерение.Свойство("ИдентификаторСтенда") Или ПустаяСтрока(Строка(Измерение.ИдентификаторСтенда)) Тогда
		ВызватьИсключение "Не задан идентификатор стенда";
	КонецЕсли;
	Если Не Измерение.Свойство("ИдентификаторНабораДанных") Или ПустаяСтрока(Строка(Измерение.ИдентификаторНабораДанных)) Тогда
		ВызватьИсключение "Не задан набор страниц";
	КонецЕсли;
	Если Не Измерение.Свойство("ИдентификаторCPU") Или ПустаяСтрока(Строка(Измерение.ИдентификаторCPU)) Тогда
		ВызватьИсключение "Не задан закреплённый CPU";
	КонецЕсли;
	Если Не Измерение.Свойство("УзелCPU") Или ПустаяСтрока(Строка(Измерение.УзелCPU))
		Или Не Измерение.Свойство("УзелПамяти") Или ПустаяСтрока(Строка(Измерение.УзелПамяти)) Тогда
		ВызватьИсключение "Не заданы CPU-узел и узел памяти";
	КонецЕсли;
	Если Не Измерение.Свойство("ЧислоЧтений") Или Измерение.ЧислоЧтений <= 0
		Или Не Измерение.Свойство("ДлительностьНс") Или Измерение.ДлительностьНс <= 0 Тогда
		ВызватьИсключение "Число чтений и длительность должны быть больше нуля";
	КонецЕсли;
	Если Не Измерение.Свойство("КонтрольнаяСумма") Тогда
		ВызватьИсключение "Измерение не содержит контрольную сумму";
	КонецЕсли;
	ПривязкаПодтверждена = Ложь;
	Если Не Измерение.Свойство("ПривязкаCPUПодтверждена", ПривязкаПодтверждена) Или Не ПривязкаПодтверждена Тогда
		ВызватьИсключение "Для замера не подтверждена фиксация CPU";
	КонецЕсли;
	РезидентностьПодтверждена = Ложь;
	Если Не Измерение.Свойство("РезидентностьПодтверждена", РезидентностьПодтверждена) Или Не РезидентностьПодтверждена Тогда
		ВызватьИсключение "Для замера не подтверждена резидентность страниц";
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьУникальноеЗначение(Значения, Значение)

	Если Не СодержитЗначение(Значения, Значение) Тогда
		Значения.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

Функция СодержитЗначение(Значения, Значение)

	Для Каждого Элемент Из Значения Цикл
		Если Элемент = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ПроверитьФиксациюCPU(Измерения)

	Для ИндексПервого = 0 По Измерения.Количество() - 1 Цикл
		Первое = Измерения[ИндексПервого];
		Для ИндексВторого = ИндексПервого + 1 По Измерения.Количество() - 1 Цикл
			Второе = Измерения[ИндексВторого];
			Если Строка(Первое.УзелCPU) = Строка(Второе.УзелCPU)
				И Строка(Первое.ИдентификаторCPU) <> Строка(Второе.ИдентификаторCPU) Тогда
				ВызватьИсключение "Для одного CPU-узла требуется один закреплённый CPU во всех замерах";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ЧислоНаблюденийПары(Измерения, УзелCPU, УзелПамяти)

	Количество = 0;
	Для Каждого Измерение Из Измерения Цикл
		Если Строка(Измерение.УзелCPU) = УзелCPU И Строка(Измерение.УзелПамяти) = УзелПамяти Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

Функция МедианаНсНаЧтение(Измерения, УзелCPU, УзелПамяти)

	Значения = Новый СписокЗначений;
	Для Каждого Измерение Из Измерения Цикл
		Если Строка(Измерение.УзелCPU) = УзелCPU И Строка(Измерение.УзелПамяти) = УзелПамяти Тогда
			Значения.Добавить(Измерение.ДлительностьНс / Измерение.ЧислоЧтений);
		КонецЕсли;
	КонецЦикла;
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение) + Число(Значения[Количество / 2].Значение)) / 2;

КонецФункции

#КонецОбласти
