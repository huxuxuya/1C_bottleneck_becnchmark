#Область ПрограммныйИнтерфейс

// Регистрирует один серверный YAxUnit-тест.
Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты.ДобавитьТестовыйНабор("Пробы и генератор")
        .ДобавитьСерверныйТест("Тест_ПробаРабочийНаборКоллекции_КорректныеМетрики");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_ПробаРабочийНаборКоллекции_КорректныеМетрики() Экспорт

	Результат = БенчмаркПробы.ПробаРабочийНаборКоллекции(200, 50);

	ЮТест.ОжидаетЧто(Результат.КонтрольнаяСумма).Больше(0);
	ЮТест.ОжидаетЧто(Результат.ВремяСозданияМс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.ВремяОбходаМс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.ВремяПоискаМс).БольшеИлиРавно(0);

КонецПроцедуры

#КонецОбласти
