#Область ПрограммныйИнтерфейс

// Возвращает оценку эффективной частоты, рассчитанную по BSL-нагрузке пробы 001.
// Параметры:
//  ЧислоПрогревов - Число - число прогревочных запусков (>= 0).
//  ЧислоСерий - Число - число измеряемых повторов (> 0).
//  ИтерацийВСерии - Число - итерации в одном повторе (> 0).
// Возвращаемое значение:
//  Структура: расчётная частота, нс на итерацию, медианная длительность,
//  контрольная сумма и детали.
Функция Проба011_РасчетнаяЭффективностьvCPU(Знач ЧислоПрогревов = 1, Знач ЧислоСерий = 5, Знач ИтерацийВСерии = 100000) Экспорт

	Замер = БенчмаркПробы.Проба001_СкоростьОдногоЯдра(ЧислоПрогревов, ЧислоСерий, ИтерацийВСерии);
	Результат = Новый Структура;
	Результат.Вставить("РасчетнаяЧастотаМГц", Замер.РасчетнаяЧастотаМГц);
	Результат.Вставить("НсНаИтерацию", Замер.НсНаИтерацию);
	Результат.Вставить("МедианаМс", Замер.МедианаМс);
	Результат.Вставить("КонтрольнаяСумма", Замер.КонтрольнаяСумма);
	Результат.Вставить("Детали", "Частота вычислена по калибровке BSL; CPU Ready гипервизора не измеряется");
	Возврат Результат;

КонецФункции

#КонецОбласти
