		ИдентификаторПрогона, ИтогДиагностик.КоличествоПроверок,
		ИтогДиагностик.КоличествоИзмерений, ИтогДиагностик.КоличествоНедоступных,
		ИтогДиагностик.КоличествоОшибок);

КонецФункции

&НаСервере
Процедура ОчиститьРезультатыПрогонаНаСервере(ИдентификаторПрогона) Экспорт

	БенчмаркРаннер.ОчиститьРезультатыПрогона(ИдентификаторПрогона);
	МенеджерЗаписи = РегистрыСведений.ПаспортаСистем.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторПрогона = ИдентификаторПрогона;
	МенеджерЗаписи.Контекст = "client";
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Удалить();
	КонецЕсли;
	МенеджерЗаписи = РегистрыСведений.ПаспортаСистем.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторПрогона = ИдентификаторПрогона;
	МенеджерЗаписи.Контекст = "server";
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Удалить();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона) Экспорт

	ТаблицаРезультатов = БенчмаркРаннер.ПолучитьРезультатыПрогона(ИдентификаторПрогона);
	Результаты.Очистить();
	Для Каждого РезультатИзРегистра Из ТаблицаРезультатов Цикл
		НоваяСтрока = Результаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, РезультатИзРегистра);
		Классификация = КлассифицироватьРезультат(
			НоваяСтрока.КодПробы, НоваяСтрока.Статус);
		НоваяСтрока.Звено = Классификация.Звено;
		НоваяСтрока.Ресурс = Классификация.Ресурс;
		НоваяСтрока.ТипСвидетельства = Классификация.ТипСвидетельства;
	КонецЦикла;
	ОбновитьПокрытиеНаСервере();
	Элементы.ТаблицаРезультатов.Видимость = Результаты.Количество() > 0;

КонецПроцедуры

