#Область ПрограммныйИнтерфейс
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТестовыйНабор("Память и кэши CPU")
		.ДобавитьСерверныйТест("Тест_Проба024_СинхронныйReclaim");
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба024_СинхронныйReclaim() Экспорт
	Точки = Новый Массив;
	Точки.Добавить(СоздатьТочку(16777216, 1000000, 0, 0, 0));
	Точки.Добавить(СоздатьТочку(67108864, 1500000, 40, 1000, 0));
	Точки.Добавить(СоздатьТочку(134217728, 2200000, 500, 3000, 500));
	Результат = БенчмаркПроба024СинхронныйReclaim.АнализироватьReclaim(Точки);
	ЮТест.ОжидаетЧто(Результат.ПорогReclaimНабораБайт).Равно(67108864);
	ЮТест.ОжидаетЧто(Результат.Точки[1].ЕстьСигналReclaimИлиPSI).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.Точки[2].МедианаDirectReclaimСтраниц).Равно(500);
	ЮТест.ОжидаетЧто(Результат.Точки[2].МедианаMemoryPSIПолныеМкс).Равно(500);

	Точки[1].РазмерРабочегоНабораБайт = 16777216;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба024СинхронныйReclaim.АнализироватьReclaim(Точки);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);
КонецПроцедуры

Функция СоздатьТочку(Размер, КасаниеНс, Reclaim, PSIНекоторые, PSIПолные)
	Наблюдения = Новый Массив;
	Для Индекс = 1 По 3 Цикл
		Наблюдения.Добавить(Новый Структура("ВремяВыделенияНс,ВремяПервогоКасанияНс,DirectReclaimСтраниц,MemoryPSIНекоторыеМкс,MemoryPSIПолныеМкс,КонтрольнаяСумма",
			500000, КасаниеНс, Reclaim, PSIНекоторые, PSIПолные, 1002));
	КонецЦикла;
	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторОграничения,РазмерРабочегоНабораБайт,СтраницВНаборе,Наблюдения",
		"cgroup-lab", "memory.max=256m", Размер, Размер / 4096, Наблюдения);
КонецФункции
#КонецОбласти
