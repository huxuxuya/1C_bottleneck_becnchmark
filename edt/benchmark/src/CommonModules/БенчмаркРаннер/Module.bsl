// Сохраняет отдельную нативную оценку CPU клиента или сервера.
Процедура СохранитьНативныйРезультатCPUДляКонтекста(Знач ИдентификаторПрогона,
	Знач КодПробы, Знач НаименованиеПробы, Знач ЗначениеЭквивалентнойЧастоты,
	Знач КонтрольнаяСумма, Знач Детали, Знач Статус) Экспорт

	Если ПустаяСтрока(ИдентификаторПрогона)
		Или ПустаяСтрока(КодПробы)
		Или СтрДлина(КодПробы) > 20
		Или ПустаяСтрока(НаименованиеПробы)
		Или СтрДлина(НаименованиеПробы) > 150 Тогда
		ВызватьИсключение "Для сохранения нативного результата нужны корректные ID, код и название пробы";
	КонецЕсли;

	Если Статус = "Косвенный сигнал" Тогда
		Если ЗначениеЭквивалентнойЧастоты <= 0 Или КонтрольнаяСумма <= 0 Тогда
			ВызватьИсключение "Для успешной нативной пробы нужны положительная оценка и контрольная сумма";
		КонецЕсли;
	ИначеЕсли Статус = "Недоступно" Тогда
		Если ЗначениеЭквивалентнойЧастоты <> 0 Тогда
			ВызватьИсключение "Для недоступной пробы значение метрики должно быть равно нулю";
		КонецЕсли;
	Иначе
		ВызватьИсключение "Для нативного результата указан недопустимый статус";
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.РезультатыПрогонов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторПрогона = ИдентификаторПрогона;
	МенеджерЗаписи.КодПробы = КодПробы;
	МенеджерЗаписи.ДатаПрогона = ТекущаяДатаСеанса();
	МенеджерЗаписи.НаименованиеПробы = НаименованиеПробы;
	МенеджерЗаписи.ЗначениеМетрики = ЗначениеЭквивалентнойЧастоты;
	МенеджерЗаписи.ЦелевоеЗначение = 0;
	МенеджерЗаписи.ЕдиницаИзмерения = "экв. МГц";
	МенеджерЗаписи.Баллы = 0;
	МенеджерЗаписи.Индекс = 0;
	МенеджерЗаписи.Статус = Статус;
	МенеджерЗаписи.КонтрольнаяСумма = КонтрольнаяСумма;
	МенеджерЗаписи.Детали = Лев(Детали, 500);
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

