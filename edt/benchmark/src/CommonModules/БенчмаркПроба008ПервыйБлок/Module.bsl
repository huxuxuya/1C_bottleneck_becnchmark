#Область ПрограммныйИнтерфейс

// Сравнивает первый блок текущего вызова с медианой следующих прогретых блоков.
// Пауза до вызова не создаётся и не измеряется.
// Параметры:
//  ИтерацийВСерии - Число - итерации в одном блоке (> 0).
//  ЧислоПрогревов - Число - число блоков после первого (> 0).
// Возвращаемое значение:
//  Структура: длительность первого блока, медиана прогретых, их отношение,
//  контрольная сумма и пояснение методики.
Функция Проба008_ПервыйБлокТекущегоВызова(Знач ИтерацийВСерии = 20000, Знач ЧислоПрогревов = 3) Экспорт

	Если ИтерацийВСерии <= 0 Или ЧислоПрогревов < 1 Тогда
		ВызватьИсключение "Некорректные параметры Пробы 008";
	КонецЕсли;

	ПервыйЗамер = БенчмаркПробы.ПробаОдинПотокBSL(ИтерацийВСерии);
	ПрогретыеДлительности = Новый СписокЗначений;
	Для Номер = 1 По ЧислоПрогревов Цикл
		Замер = БенчмаркПробы.ПробаОдинПотокBSL(ИтерацийВСерии);
		ПрогретыеДлительности.Добавить(Замер.ДлительностьМс);
	КонецЦикла;
	ПрогретыеДлительности.СортироватьПоЗначению();

	МедианаПрогретых = Число(ПрогретыеДлительности[Цел((ЧислоПрогревов - 1) / 2)].Значение);
	Результат = Новый Структура;
	Результат.Вставить("ПервыйБлокМс", ПервыйЗамер.ДлительностьМс);
	Результат.Вставить("МедианаПрогретыхМс", МедианаПрогретых);
	Результат.Вставить("ОтношениеПервогоКПрогретому", БенчмаркПробыВычисления.ОтношениеПроизводительности(
		МедианаПрогретых, ПервыйЗамер.ДлительностьМс));
	Результат.Вставить("КонтрольнаяСумма", ПервыйЗамер.КонтрольнаяСумма);
	Результат.Вставить("Детали", "Первый блок текущего вызова; состояние простоя перед вызовом не задается");
	Возврат Результат;

КонецФункции

#КонецОбласти
