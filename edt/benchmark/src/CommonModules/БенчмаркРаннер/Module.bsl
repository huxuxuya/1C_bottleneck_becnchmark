	Возврат Итог;

КонецФункции

// Одинаково рассчитывает сводку как после живого прогона, так и при повторной
// загрузке строк из регистра. Набор обязательных проб хранится только здесь.
Функция РассчитатьСводкуПоРезультатам(Знач Результаты) Экспорт

	ОбязательныеКоды = Новый Массив;
	// Фиксированный пакет служит контекстным эталоном и намеренно не входит в балл.
	ОбязательныеКоды.Добавить("BSL_ADAPTIVE_SPEED");
	ОбязательныеКоды.Добавить("MEM_COLLECTION");
	ОбязательныеКоды.Добавить("DB_POINT_QUERY");
	ОбязательныеКоды.Добавить("TX_SPLIT_COMMIT");
	ОбязательныеКоды.Добавить("TX_BATCH_COMMIT");
	ОбязательныеКоды.Добавить("DB_JOIN_SORT");
	ОбязательныеКоды.Добавить("DOC_POSTING");

	ИндексыДляОбщегоБалла = Новый Массив;
	МинБалл = 101;
	КоличествоОцениваемыхПроб = 0;
	ГлавноеУзкоеМесто = "";
	Для Каждого Код Из ОбязательныеКоды Цикл
		Для Каждого Элемент Из Результаты Цикл
			Если Элемент.КодПробы = Код И Элемент.Индекс > 0
				И Элемент.Статус <> "Косвенный сигнал"
				И Элемент.Статус <> "Ошибка"
				И Элемент.Статус <> "Недостаточно разрешения таймера" Тогда
				ИндексыДляОбщегоБалла.Добавить(Элемент.Индекс);
				КоличествоОцениваемыхПроб = КоличествоОцениваемыхПроб + 1;
				Если Элемент.Индекс < МинБалл Тогда
					МинБалл = Элемент.Индекс;
					ГлавноеУзкоеМесто = Строка(Элемент.КодПробы) + " ("
						+ Строка(Элемент.НаименованиеПробы) + ")";
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ОбщийБалл = 0;
	Если КоличествоОцениваемыхПроб = ОбязательныеКоды.Количество() Тогда
		ОбщийБалл = Окр(СреднееГеометрическоеИндексов(ИндексыДляОбщегоБалла), 1);
		Если МинБалл >= 100 Тогда
			ГлавноеУзкоеМесто = "Все прямые пробы в целевом бюджете";
		КонецЕсли;
	Иначе
		ГлавноеУзкоеМесто = "Неполный прогон: "
			+ Строка(КоличествоОцениваемыхПроб) + " из "
			+ Строка(ОбязательныеКоды.Количество()) + " обязательных проб";
	КонецЕсли;

	Возврат Новый Структура(
		"ОбщийБалл,КоличествоОцениваемыхПроб,ОжидаемоеКоличествоПроб,ГлавноеУзкоеМесто",
		ОбщийБалл, КоличествоОцениваемыхПроб, ОбязательныеКоды.Количество(), ГлавноеУзкоеМесто);

КонецФункции

// Возвращает сохранённые записи регистра РезультатыПрогонов по идентификатору прогона.
//
// Параметры:
//  ИдентификаторПрогона - Строка - идентификатор прогона.
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки результатов прогона.
//
Функция ПолучитьРезультатыПрогона(Знач ИдентификаторПрогона) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РезультатыПрогонов.КодПробы КАК КодПробы,
	|	РезультатыПрогонов.НаименованиеПробы КАК НаименованиеПробы,
	|	РезультатыПрогонов.ЗначениеМетрики КАК ЗначениеМетрики,
	|	РезультатыПрогонов.ЦелевоеЗначение КАК ЦелевоеЗначение,
	|	РезультатыПрогонов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	РезультатыПрогонов.Баллы КАК Баллы,
	|	РезультатыПрогонов.Индекс КАК Индекс,
	|	РезультатыПрогонов.Статус КАК Статус,
	|	РезультатыПрогонов.КонтрольнаяСумма КАК КонтрольнаяСумма,
	|	РезультатыПрогонов.Детали КАК Детали
	|ИЗ
	|	РегистрСведений.РезультатыПрогонов КАК РезультатыПрогонов
	|ГДЕ
	|	РезультатыПрогонов.ИдентификаторПрогона = &ИдентификаторПрогона
	|
	|УПОРЯДОЧИТЬ ПО
	|	Индекс ВОЗР";
	Запрос.УстановитьПараметр("ИдентификаторПрогона", ИдентификаторПрогона);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает идентификатор последнего прогона, сохранённого в регистре.
Функция ПолучитьПоследнийИдентификаторПрогона() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   РезультатыПрогонов.ИдентификаторПрогона КАК ИдентификаторПрогона
	|ИЗ
	|   РегистрСведений.РезультатыПрогонов КАК РезультатыПрогонов
	|УПОРЯДОЧИТЬ ПО
	|   РезультатыПрогонов.ДатаПрогона УБЫВ,
	|   РезультатыПрогонов.ИдентификаторПрогона УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИдентификаторПрогона;
	КонецЕсли;

	Возврат "";

