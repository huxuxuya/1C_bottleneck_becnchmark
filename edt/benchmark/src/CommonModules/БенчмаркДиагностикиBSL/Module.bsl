Функция ИзмеритьРаботуВТранзакции(Знач Товары, Знач Склад, Знач Серия)

	НачалоТранзакцииМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НачатьТранзакцию();
	Попытка
		ПараметрыДок = Новый Структура;
		ПараметрыДок.Вставить("Товары", Товары);
		ПараметрыДок.Вставить("Склад", Склад);
		ПараметрыДок.Вставить("ЧислоСтрок", 1);
		ПараметрыДок.Вставить("ИдентификаторСерии", Серия);
		ПараметрыДок.Вставить("Проводить", Ложь);
		Запись = БенчмаркГенераторДанных.СоздатьДокументДвижения(ПараметрыДок);
		КонтрольнаяСумма = 0;
		Для Индекс = 1 По 100000 Цикл
			КонтрольнаяСумма = КонтрольнаяСумма + ((Индекс * 97) % 65521);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
		ДлительностьРаботыМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоТранзакцииМс;
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Новый Структура("ДлительностьМс,КонтрольнаяСумма",
		ДлительностьРаботыМс, КонтрольнаяСумма + Запись.СуммаКоличество);

