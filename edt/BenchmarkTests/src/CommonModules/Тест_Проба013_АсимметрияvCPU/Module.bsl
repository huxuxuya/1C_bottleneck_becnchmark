Процедура Тест_Проба013_АсимметрияvCPU() Экспорт

	ИзмеренияvCPU = СоздатьМатрицуИзмерений(120, 60, 120, 60);
	РезультатvCPU = БенчмаркПроба013АсимметрияvCPU.ОценитьАсимметрию(ИзмеренияvCPU, 5);
	ЮТест.ОжидаетЧто(РезультатvCPU.Классификация).Равно("Задержка следует за vCPU");
	ЮТест.ОжидаетЧто(РезультатvCPU.РазбросvCPUПроцентов).Больше(50);
	ЮТест.ОжидаетЧто(РезультатvCPU.РазбросИсполнителейПроцентов).Меньше(5);

	ИзмеренияИсполнителя = СоздатьМатрицуИзмерений(120, 120, 60, 60);
	РезультатИсполнителя = БенчмаркПроба013АсимметрияvCPU.ОценитьАсимметрию(ИзмеренияИсполнителя, 5);
	ЮТест.ОжидаетЧто(РезультатИсполнителя.Классификация).Равно("Задержка следует за исполнителем");
	ЮТест.ОжидаетЧто(РезультатИсполнителя.РазбросИсполнителейПроцентов).Больше(50);
	ЮТест.ОжидаетЧто(РезультатИсполнителя.РазбросvCPUПроцентов).Меньше(5);

	НеполнаяМатрица = Новый Массив;
	НеполнаяМатрица.Добавить(Новый Структура("ИдентификаторПрохода,ИдентификаторvCPU,ИдентификаторИсполнителя,ЧислоОпераций,ДлительностьМикросекунд,КонтрольнаяСумма", "1", "0", "A", 1000, 120000, 123));
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба013АсимметрияvCPU.ОценитьАсимметрию(НеполнаяМатрица);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);

КонецПроцедуры

Функция СоздатьМатрицуИзмерений(ВремяAНаCpu0, ВремяAНаCpu1, ВремяBНаCpu0, ВремяBНаCpu1)

	Измерения = Новый Массив;
	ДобавитьТриИзмерения(Измерения, "1", "0", "A", ВремяAНаCpu0);
	ДобавитьТриИзмерения(Измерения, "1", "1", "B", ВремяBНаCpu1);
	ДобавитьТриИзмерения(Измерения, "2", "1", "A", ВремяAНаCpu1);
	ДобавитьТриИзмерения(Измерения, "2", "0", "B", ВремяBНаCpu0);
	Возврат Измерения;

КонецФункции

Процедура ДобавитьТриИзмерения(Измерения, ИдентификаторПрохода, ИдентификаторvCPU, ИдентификаторИсполнителя, БазовоеВремя)

	Для Индекс = 0 По 2 Цикл
		Измерения.Добавить(Новый Структура("ИдентификаторПрохода,ИдентификаторvCPU,ИдентификаторИсполнителя,ЧислоОпераций,ДлительностьМикросекунд,КонтрольнаяСумма",
			ИдентификаторПрохода, ИдентификаторvCPU, ИдентификаторИсполнителя, 1000, БазовоеВремя * 1000 + Индекс * 100, 123));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
