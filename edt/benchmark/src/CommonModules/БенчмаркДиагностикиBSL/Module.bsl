КонецФункции

Функция ВыполнитьПоКоду(Знач КодДиагностики) Экспорт

	Для Каждого Определение Из ПолучитьКаталог() Цикл
		Если Определение.Код = КодДиагностики Тогда
			Возврат ВыполнитьОпределение(Определение);
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Неизвестный код BSL-диагностики: " + КодДиагностики;

КонецФункции

Функция ВыполнитьПакет() Экспорт

	Результаты = Новый Массив;
	Для Каждого Определение Из ПолучитьКаталог() Цикл
		Результаты.Добавить(ВыполнитьОпределение(Определение));
	КонецЦикла;
	Возврат Результаты;

КонецФункции

// Выполняет весь каталог и сохраняет каждую проверку как отдельную строку.
// Недоступные в BSL источники сохраняются явно и не получают баллов.
Функция ВыполнитьПрогон(Знач ИдентификаторПрогона = "") Экспорт

	Если ПустаяСтрока(ИдентификаторПрогона) Тогда
		ИдентификаторПрогона = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	Контекст = Новый Структура("ИдентификаторПрогона,ДатаПрогона",
		ИдентификаторПрогона, ТекущаяУниверсальнаяДата());
	ПланПрогона = Новый Массив;
	Для Каждого Определение Из ПолучитьКаталог() Цикл
		КодМетрики = "diagnostic." + Определение.Номер + ".value";
		ПланПрогона.Добавить(Новый Структура(
			"Точка,Код,Метрика,Название,Цель,Единица,ЧислоПовторов,Параметры",
			"DIAG_" + Определение.Номер, Определение.Номер, КодМетрики,
			Определение.Наименование, 0, "по методике", 1,
			"profile=" + Определение.Профиль + ";source=" + Определение.Статус));
	КонецЦикла;
	Контекст.Вставить("СсылкаНаПрогон", БенчмаркХранилищеПрогонов.СоздатьПрогон(
		ИдентификаторПрогона, 1, "server", "diagnostics", ПланПрогона));
	БенчмаркРаннер.ОчиститьРезультатыПрогона(ИдентификаторПрогона);
	Результаты = Новый Массив;
	КоличествоОшибок = 0;
	КоличествоНедоступных = 0;
	КоличествоИзмерений = 0;
	ДанныеСправочников = БенчмаркГенераторДанных.ОбеспечитьСправочники(20, 3, "DG");

	Для Каждого Определение Из ПолучитьКаталог() Цикл
		Результат = ВыполнитьОпределение(Определение, ДанныеСправочников);
		СохранитьСтрокуПрогона(Контекст, Результат);
		Результаты.Добавить(Результат);
		Если Результат.Статус = "Ошибка" Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
		ИначеЕсли Результат.Статус = "Недоступно в BSL" Тогда
			КоличествоНедоступных = КоличествоНедоступных + 1;
		Иначе
			КоличествоИзмерений = КоличествоИзмерений + 1;
		КонецЕсли;
	КонецЦикла;
	СтатусПрогона = ?(КоличествоОшибок = 0, "Завершён", "Частично завершён");
	БенчмаркХранилищеПрогонов.ЗавершитьПрогон(Контекст.СсылкаНаПрогон,
		СтатусПрогона, ?(КоличествоОшибок = 0, "", "Ошибки отдельных диагностик"));

	Возврат Новый Структура(
		"ИдентификаторПрогона,КоличествоПроверок,КоличествоИзмерений,КоличествоНедоступных,КоличествоОшибок,Результаты",
		ИдентификаторПрогона, Результаты.Количество(), КоличествоИзмерений,
		КоличествоНедоступных, КоличествоОшибок, Результаты);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьОпределение(Знач Определение, Знач ДанныеСправочников = Неопределено)

	Результат = Новый Структура(
		"Номер,Код,Наименование,Статус,ЗначениеМетрики,ЕдиницаИзмерения,ДлительностьМс,КонтрольнаяСумма,Детали,ДатаНачалаUTC,ДатаЗавершенияUTC",
		Определение.Номер, Определение.Код, Определение.Наименование,
		Определение.Статус, 0, "нет", 0, 0, Определение.Ограничение,
		ТекущаяУниверсальнаяДата(), ТекущаяУниверсальнаяДата());

	Если Определение.Профиль = "UNAVAILABLE" Тогда
		Результат.Детали = "Недоступно в BSL: " + Определение.Ограничение;
		Результат.ДатаЗавершенияUTC = ТекущаяУниверсальнаяДата();
		Возврат Результат;
	КонецЕсли;

	Серия = "";
	НужныСправочники = Лев(Определение.Профиль, 3) = "DB_"
		Или Лев(Определение.Профиль, 3) = "TX_"
		Или Определение.Профиль = "DOC_POST";
	НужнаОчисткаСерии = НужныСправочники;
	Попытка
		Данные = ДанныеСправочников;
		Если НужныСправочники И Данные = Неопределено Тогда
			Данные = БенчмаркГенераторДанных.ОбеспечитьСправочники(20, 3, "DG");
		КонецЕсли;
		Если НужныСправочники Тогда
			Серия = "DG_" + Определение.Код + "_" + Лев(Строка(Новый УникальныйИдентификатор), 8);
		КонецЕсли;
		Измерение = ВыполнитьИзмеряемыйПрофиль(Определение.Профиль, Данные, Серия, Определение.Код);
		Результат.ЗначениеМетрики = Измерение.Значение;
		Результат.ЕдиницаИзмерения = Измерение.Единица;
		Результат.ДлительностьМс = Измерение.ДлительностьМс;
		Результат.КонтрольнаяСумма = Измерение.КонтрольнаяСумма;
		Результат.Детали = Определение.Ограничение + "; " + Измерение.Детали;
		Если Измерение.ДлительностьМс <= 0 Тогда
			Результат.Статус = "Ошибка";
			Результат.Детали = Результат.Детали + "; таймер не зарегистрировал интервал";
		КонецЕсли;
		Если НужнаОчисткаСерии Тогда
			БенчмаркГенераторДанных.ОчиститьДанныеСерии(Серия);
		КонецЕсли;
	Исключение
		Результат.Статус = "Ошибка";
		Результат.Детали = Определение.Ограничение + "; " + ОписаниеОшибки();
		Если НужнаОчисткаСерии И Не ПустаяСтрока(Серия) Тогда
			Попытка
				БенчмаркГенераторДанных.ОчиститьДанныеСерии(Серия);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецПопытки;
	Результат.ДатаЗавершенияUTC = ТекущаяУниверсальнаяДата();

	Возврат Результат;

КонецФункции

Функция ВыполнитьИзмеряемыйПрофиль(Знач Профиль, Знач Данные, Знач Серия, Знач Код)

	Если Профиль = "CPU_SATURATION" Тогда
		Рез = БенчмаркПробы.ПробаОдинПотокBSL(600000);
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			600000 * 1000 / Рез.ДлительностьМс, "итераций/с", Рез.ДлительностьМс,
			Рез.КонтрольнаяСумма,
			"один последовательный пакет в текущем серверном вызове; PID и число потоков недоступны");
	ИначеЕсли Профиль = "CPU_COLD_WARM" Тогда
		ПерваяПорция = БенчмаркПробы.ПробаОдинПотокBSL(600000);
		ТеплыеПорции = Новый Массив;
		СуммаТеплыхМс = 0;
		Для Повтор = 1 По 3 Цикл
			ТеплаяПорция = БенчмаркПробы.ПробаОдинПотокBSL(600000);
			ТеплыеПорции.Добавить(ТеплаяПорция.ДлительностьМс);
			СуммаТеплыхМс = СуммаТеплыхМс + ТеплаяПорция.ДлительностьМс;
		КонецЦикла;
		СреднееТеплоеМс = СуммаТеплыхМс / ТеплыеПорции.Количество();
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			ПерваяПорция.ДлительностьМс / СреднееТеплоеМс, "первый/тёплый x",
			ПерваяПорция.ДлительностьМс + СуммаТеплыхМс, ПерваяПорция.КонтрольнаяСумма,
			"первая порция сравнена со средним трёх повторов того же BSL-пакета");
	ИначеЕсли Профиль = "MEMORY_GROWTH" Тогда
		Возврат ИзмеритьРостКоллекции(5000, 4);
	ИначеЕсли Профиль = "MEMORY_SESSION" Тогда
		Возврат ИзмеритьРабочийНаборСеанса(20000);
	ИначеЕсли Профиль = "MEMORY" Тогда
		СуммаМс = 0;
		КонтрольнаяСумма = 0;
		Для Повтор = 1 По 3 Цикл
			Рез = БенчмаркПробы.ПробаРабочийНаборКоллекции(2500, 1500);
			СуммаМс = СуммаМс + Рез.ВремяСозданияМс + Рез.ВремяОбходаМс + Рез.ВремяПоискаМс;
			КонтрольнаяСумма = КонтрольнаяСумма + Рез.КонтрольнаяСумма;
		КонецЦикла;
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			СуммаМс, "мс/3 набора", СуммаМс, КонтрольнаяСумма,
			"три создания, обхода и поиска в BSL-коллекции; RSS не измеряется");
	ИначеЕсли Профиль = "FILE_RANDOM_READ" Или Профиль = "FILE_RANDOM_WRITE"
		Или Профиль = "FILE_SEQUENTIAL_READ" Или Профиль = "FILE_SEQUENTIAL_WRITE"
		Или Профиль = "FILE_FLUSH" Или Профиль = "FILE_WARM_READ"
		Или Профиль = "FILE_PATH" Или Профиль = "FILE_GROWTH" Тогда
		Возврат ИзмеритьФайловыйПрофиль(Профиль, Код);
	ИначеЕсли Профиль = "DB_POINT" Тогда
		ЧислоЗапросов = ?(Код = "DB_WARM_INDEX_LOOKUP", 80, 50);
		Рез = БенчмаркПробы.ПробаТочечныйЗапросПоИндексу(Данные.Товары, ЧислоЗапросов);
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			Рез.ДлительностьМс, "мс/запросы", Рез.ДлительностьМс, Рез.КонтрольнаяСумма,
			Строка(ЧислоЗапросов) + " повторных точечных запросов по ссылке товара");
	ИначеЕсли Профиль = "DB_SCAN" Или Профиль = "DB_SORT" Или Профиль = "DB_HASH"
		Или Профиль = "DB_CARDINALITY" Или Профиль = "DB_INDEX_COVER"
		Или Профиль = "DB_VIRTUAL_FILTER" Тогда
		Если Профиль = "DB_SCAN" Или Профиль = "DB_SORT" Или Профиль = "DB_HASH"
			Или Профиль = "DB_VIRTUAL_FILTER" Тогда
			ПараметрыДок = Новый Структура;
			ПараметрыДок.Вставить("Товары", Данные.Товары);
			ПараметрыДок.Вставить("Склад", Данные.Склады[0]);
			ПараметрыДок.Вставить("ЧислоСтрок", 300);
			ПараметрыДок.Вставить("ИдентификаторСерии", Серия);
			ПараметрыДок.Вставить("Проводить", Профиль = "DB_VIRTUAL_FILTER");
			БенчмаркГенераторДанных.СоздатьДокументДвижения(ПараметрыДок);
		КонецЕсли;
		Если Профиль = "DB_SORT" Тогда
			Рез = ИзмеритьСортировкуДокументныхСтрок(Серия);
			ДеталиПрофиля = "один набор строк табличной части; сортировка без плана оператора";
		ИначеЕсли Профиль = "DB_HASH" Тогда
			Рез = ИзмеритьГруппировкуДокументныхСтрок(Серия);
			ДеталиПрофиля = "группировка строк табличной части; spill hash не раскрывается";
		ИначеЕсли Профиль = "DB_CARDINALITY" Тогда
			Рез = ИзмеритьСелективность(Данные.Товары);
			ДеталиПрофиля = "параметры с одной и всеми 20 ссылками; фактическая оценка плана недоступна";
		ИначеЕсли Профиль = "DB_INDEX_COVER" Тогда
			Рез = ИзмеритьДоступИОбход(Данные.Товары);
			ДеталиПрофиля = "поиск одной ссылки и обход тех же записей; фактический план недоступен";
		ИначеЕсли Профиль = "DB_VIRTUAL_FILTER" Тогда
			Рез = ИзмеритьВиртуальнуюТаблицуОстатков(Данные.Склады[0]);
			ДеталиПрофиля = "виртуальная таблица Остатки с отбором по складу; данные тестового регистра";
		Иначе
			Рез = БенчмаркПробы.ПробаВыборкаСоединениеСортировка(Серия);
			ДеталиПрофиля = "сканирование, соединение, группировка и сортировка; план и spill не раскрываются";
		КонецЕсли;
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			Рез.ДлительностьМс, "мс/пакет", Рез.ДлительностьМс, Рез.ИтогоСумма,
			ДеталиПрофиля);
	ИначеЕсли Профиль = "DB_PLAN_REUSE" Тогда
		ПервыйЗапуск = БенчмаркПробы.ПробаТочечныйЗапросПоИндексу(Данные.Товары, 1);
		ПовторныеЗапуски = БенчмаркПробы.ПробаТочечныйЗапросПоИндексу(Данные.Товары, 100);
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			ПервыйЗапуск.ДлительностьМс + ПовторныеЗапуски.ДлительностьМс,
			"мс", ПервыйЗапуск.ДлительностьМс + ПовторныеЗапуски.ДлительностьМс,
			ПервыйЗапуск.КонтрольнаяСумма + ПовторныеЗапуски.КонтрольнаяСумма,
			"один объект запроса, первый вызов и повторная серия; SQL-план не читается");
	ИначеЕсли Профиль = "DB_QUERY_BUILD" Тогда
		Рез = ИзмеритьСозданиеИИсполнениеЗапроса(Данные.Товары[0]);
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			Рез.ДлительностьМс, "мс/100 вызовов", Рез.ДлительностьМс,
			Рез.КонтрольнаяСумма,
			"50 созданий объекта запроса с исполнением и 50 повторов одного объекта; SQL compile не виден");
	ИначеЕсли Профиль = "DB_WRITE" Или Профиль = "DB_HOTKEY" Тогда
		Если Профиль = "DB_HOTKEY" Тогда
			ОдинТовар = Новый Массив;
			ОдинТовар.Добавить(Данные.Товары[0]);
			Рез = БенчмаркПробы.ПробаФиксацияТранзакции(ОдинТовар, Данные.Склады[0], 40, Ложь, Серия);
			ДеталиЗаписи = "40 последовательных документов с повторным ключом; конкуренция не создаётся";
		Иначе
			Рез = БенчмаркПробы.ПробаФиксацияТранзакции(Данные.Товары, Данные.Склады[0], 10, Ложь, Серия);
			ДеталиЗаписи = "10 тестовых документов; отдельная цена индекса не выделяется";
		КонецЕсли;
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			Рез.ДлительностьМс, "мс/записи", Рез.ДлительностьМс, Рез.КонтрольнаяСумма,
			ДеталиЗаписи);
	ИначеЕсли Профиль = "TX_SINGLE" Тогда
		Рез = БенчмаркПробы.ПробаФиксацияТранзакции(Данные.Товары, Данные.Склады[0], 10, Ложь, Серия);
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			Рез.ДлительностьМс, "мс/10 записей", Рез.ДлительностьМс, Рез.КонтрольнаяСумма,
			"10 фиксаций; время ожидания конкурента не измеряется");
	ИначеЕсли Профиль = "TX_HOLD" Тогда
		Рез = ИзмеритьРаботуВТранзакции(Данные.Товары, Данные.Склады[0], Серия);
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			Рез.ДлительностьМс, "мс в транзакции", Рез.ДлительностьМс,
			Рез.КонтрольнаяСумма, "запись и фиксированная BSL-нагрузка внутри транзакции; конкуренция не создаётся");
	ИначеЕсли Профиль = "TX_BATCH" Тогда
		Рез = БенчмаркПробы.ПробаФиксацияТранзакции(Данные.Товары, Данные.Склады[0], 10, Истина, Серия);
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			Рез.ДлительностьМс, "мс/10 записей", Рез.ДлительностьМс, Рез.КонтрольнаяСумма,
			"10 записей в одной транзакции");
	ИначеЕсли Профиль = "DB_CHATTER" Тогда
		Рез = БенчмаркПробы.ПробаТочечныйЗапросПоИндексу(Данные.Товары, 250);
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			Рез.ДлительностьМс, "мс/250 вызовов", Рез.ДлительностьМс,
			Рез.КонтрольнаяСумма, "250 последовательных вызовов запроса; межсеансовая нагрузка не создаётся");
	ИначеЕсли Профиль = "DOC_POST" Тогда
		ПараметрыДок = Новый Структура;
		ПараметрыДок.Вставить("Товары", Данные.Товары);
		ПараметрыДок.Вставить("Склад", Данные.Склады[0]);
		ПараметрыДок.Вставить("ЧислоСтрок", 150);
		ПараметрыДок.Вставить("ИдентификаторСерии", Серия);
		ПараметрыДок.Вставить("Проводить", Ложь);
		Документ = БенчмаркГенераторДанных.СоздатьДокументДвижения(ПараметрыДок);
		Рез = БенчмаркПробы.ПробаПроведениеДокумента(Документ.Ссылка);
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			Рез.ДлительностьМс, "мс", Рез.ДлительностьМс, Рез.СуммаКоличество,
			"проведение документа; движения проверены");
	ИначеЕсли Профиль = "SERIALIZE" Тогда
		Значения = Новый Массив;
		Для Индекс = 1 По 5000 Цикл
			Значения.Добавить(Новый Структура("Ключ,Значение", Индекс, (Индекс * 37) % 1009));
		КонецЦикла;
		НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЧислоПовторов = 0;
		ДлинаСериализованногоЗначения = 0;
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс < 10
			И ЧислоПовторов < 128 Цикл
			СтрокаЗначения = ЗначениеВСтрокуВнутр(Значения);
			ДлинаСериализованногоЗначения = СтрДлина(СтрокаЗначения);
			ЧислоПовторов = ЧислоПовторов + 1;
		КонецЦикла;
		ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
		Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
			ДлинаСериализованногоЗначения, "символов", ДлительностьМс,
			ДлинаСериализованногоЗначения,
			Строка(ЧислоПовторов) + " сериализаций BSL; формат не равен сетевой сериализации платформы");
	КонецЕсли;

	ВызватьИсключение "Для BSL-профиля не задан исполнитель: " + Профиль;

КонецФункции

Функция ИзмеритьРостКоллекции(Знач РазмерБазы, Знач ЧислоРазмеров)

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Наборы = Новый Массив;
	Для НомерНабора = 1 По ЧислоРазмеров Цикл
		Набор = Новый Массив;
		РазмерНабора = РазмерБазы * НомерНабора;
		Для Индекс = 1 По РазмерНабора Цикл
			Набор.Добавить((Индекс * 97) % 65521);
		КонецЦикла;
		Наборы.Добавить(Набор);
	КонецЦикла;

	КонтрольнаяСумма = 0;
	Для Каждого Набор Из Наборы Цикл
		Для Каждого ЗначениеНабора Из Набор Цикл
			КонтрольнаяСумма = КонтрольнаяСумма + ЗначениеНабора;
		КонецЦикла;
	КонецЦикла;
	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
	Если ДлительностьМс <= 0 Тогда
		ВызватьИсключение "Рост BSL-коллекции короче разрешения таймера";
	КонецЕсли;
	Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
		ДлительностьМс, "мс/рост", ДлительностьМс, КонтрольнаяСумма,
		"удержаны четыре массива до обхода; RSS и частная память процесса не измеряются");

КонецФункции

Функция ИзмеритьРабочийНаборСеанса(Знач РазмерНабора)

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Набор = Новый Соответствие;
	Для Индекс = 1 По РазмерНабора Цикл
		Набор.Вставить(Индекс, (Индекс * 41) % 65521);
	КонецЦикла;
	КонтрольнаяСумма = 0;
	Для Шаг = 1 По РазмерНабора Цикл
		Ключ = 1 + ((Шаг * 73) % РазмерНабора);
		КонтрольнаяСумма = КонтрольнаяСумма + Набор.Получить(Ключ);
	КонецЦикла;
	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
	Если ДлительностьМс <= 0 Тогда
		ВызватьИсключение "Обход BSL-набора сеанса короче разрешения таймера";
	КонецЕсли;
	Возврат Новый Структура("Значение,Единица,ДлительностьМс,КонтрольнаяСумма,Детали",
		ДлительностьМс, "мс/20 тыс.", ДлительностьМс, КонтрольнаяСумма,
		"создание, удержание и поиск в отображении 20 000 элементов; память процесса не измеряется");

КонецФункции

Функция ИзмеритьСортировкуДокументныхСтрок(Знач ИдентификаторСерии)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| Строки.Товар КАК Товар,
	| Строки.Количество КАК Количество,
	| Строки.Сумма КАК Сумма
	|ИЗ Документ.ДвижениеТоваров.Товары КАК Строки
	|ГДЕ Строки.Ссылка.ИдентификаторСерии = &Серия
	|УПОРЯДОЧИТЬ ПО Сумма УБЫВ";
	Запрос.УстановитьПараметр("Серия", ИдентификаторСерии);
	Итог = ИзмеритьПовторяемыйЗапрос(Запрос);
	Возврат Итог;

КонецФункции

Функция ИзмеритьГруппировкуДокументныхСтрок(Знач ИдентификаторСерии)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| Строки.Товар КАК Товар,
	| СУММА(Строки.Количество) КАК Количество,
	| СУММА(Строки.Сумма) КАК Сумма
	|ИЗ Документ.ДвижениеТоваров.Товары КАК Строки
	|ГДЕ Строки.Ссылка.ИдентификаторСерии = &Серия
	|СГРУППИРОВАТЬ ПО Строки.Товар";
	Запрос.УстановитьПараметр("Серия", ИдентификаторСерии);
	Возврат ИзмеритьПовторяемыйЗапрос(Запрос);

КонецФункции

Функция ИзмеритьПовторяемыйЗапрос(Знач Запрос)

	ЧислоПовторов = 1;
	Пока Истина Цикл
		НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		КонтрольнаяСумма = 0;
		Для Повтор = 1 По ЧислоПовторов Цикл
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				КонтрольнаяСумма = КонтрольнаяСумма + СтрДлина(Строка(Выборка.Товар))
					+ Выборка.Сумма + Выборка.Количество;
			КонецЦикла;
		КонецЦикла;
		ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
		Если ДлительностьМс >= 10 Или ЧислоПовторов >= 128 Тогда
			Прервать;
		КонецЕсли;
		ЧислоПовторов = Мин(128, ЧислоПовторов * 2);
	КонецЦикла;
	Если ДлительностьМс <= 0 Тогда
		ВызватьИсключение "Запрос короче разрешения таймера";
	КонецЕсли;
	Возврат Новый Структура("ДлительностьМс,ИтогоСумма,ЧислоПовторов",
		ДлительностьМс / ЧислоПовторов, КонтрольнаяСумма, ЧислоПовторов);

КонецФункции

Функция ИзмеритьСелективность(Знач Товары)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Товары.Код КАК Код
	|ИЗ Справочник.Товары КАК Товары
	|ГДЕ Товары.Ссылка В (&Товары)";
	ЧастьНабора = Новый Массив;
	ЧастьНабора.Добавить(Товары[0]);
	Запрос.УстановитьПараметр("Товары", ЧастьНабора);
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Сумма = 0;
	Для Повтор = 1 По 50 Цикл
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Сумма = Сумма + СтрДлина(Выборка.Код);
		КонецЦикла;
	КонецЦикла;
	ВремяУзкогоНабора = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
	Запрос.УстановитьПараметр("Товары", Товары);
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Повтор = 1 По 50 Цикл
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Сумма = Сумма + СтрДлина(Выборка.Код);
		КонецЦикла;
	КонецЦикла;
	ВремяШирокогоНабора = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
	ОбщееВремя = ВремяУзкогоНабора + ВремяШирокогоНабора;
	Если ОбщееВремя <= 0 Тогда
		ВызватьИсключение "Параметрические запросы короче разрешения таймера";
	КонецЕсли;
	Возврат Новый Структура("ДлительностьМс,ИтогоСумма,ЧислоПовторов",
		ОбщееВремя, Сумма, 100);

