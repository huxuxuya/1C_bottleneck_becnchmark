#Область ПрограммныйИнтерфейс
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТестовыйНабор("Виртуализация и NUMA")
		.ДобавитьСерверныйТест("Тест_Проба017_ВытеснениеПамятиХостом");
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба017_ВытеснениеПамятиХостом() Экспорт

	НаблюденияДо = СоздатьФазу("До", 0, 0, 0, 100);
	НаблюденияВоВремя = СоздатьФазу("ВоВремя", 1000, 0, 0, 200);
	НаблюденияПосле = СоздатьФазу("После", 1000, 0, 0, 110);
	Результат = БенчмаркПроба017ВытеснениеПамятиХостом.АнализироватьДавлениеПамяти(
		НаблюденияДо, НаблюденияВоВремя, НаблюденияПосле);
	ЮТест.ОжидаетЧто(Результат.Классификация).Равно("Balloon вырос без подтверждённой подкачки");
	ЮТест.ОжидаетЧто(Результат.ПодкачкаАктивна).Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.ИзменениеBalloonВоВремяБайт).Равно(1000);
	ЮТест.ОжидаетЧто(Результат.СдвигОбходаВоВремяПроцентов).Равно(100);
	ЮТест.ОжидаетЧто(Результат.СдвигОбходаПослеПроцентов).Равно(10);
	ЮТест.ОжидаетЧто(Результат.ВосстановлениеНаблюдается).Равно(Истина);

	НаблюденияВоВремя[0].HostSwapБайт = 500;
	НаблюденияВоВремя[1].HostSwapБайт = 500;
	НаблюденияВоВремя[2].HostSwapБайт = 500;
	РезультатСПодкачкой = БенчмаркПроба017ВытеснениеПамятиХостом.АнализироватьДавлениеПамяти(
		НаблюденияДо, НаблюденияВоВремя, НаблюденияПосле);
	ЮТест.ОжидаетЧто(РезультатСПодкачкой.ПодкачкаАктивна).Равно(Истина);
	ЮТест.ОжидаетЧто(РезультатСПодкачкой.Классификация).Равно("Одновременно выросли balloon и подкачка");

	Для Индекс = 0 По 2 Цикл
		НаблюденияВоВремя[Индекс].BalloonБайт = 0;
		НаблюденияВоВремя[Индекс].HostSwapБайт = 0;
		НаблюденияВоВремя[Индекс].GuestSwapБайт = 300;
	КонецЦикла;
	РезультатСGuestSwap = БенчмаркПроба017ВытеснениеПамятиХостом.АнализироватьДавлениеПамяти(
		НаблюденияДо, НаблюденияВоВремя, НаблюденияПосле);
	ЮТест.ОжидаетЧто(РезультатСGuestSwap.ПодкачкаАктивна).Равно(Истина);
	ЮТест.ОжидаетЧто(РезультатСGuestSwap.Классификация).Равно("Подкачка подтверждена счётчиками");

	НаблюденияВоВремя[0].ЧислоСтраниц = 900;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба017ВытеснениеПамятиХостом.АнализироватьДавлениеПамяти(
			НаблюденияДо, НаблюденияВоВремя, НаблюденияПосле);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);

КонецПроцедуры

Функция СоздатьФазу(Фаза, Balloon, HostSwap, GuestSwap, ДлительностьМс)

	Наблюдения = Новый Массив;
	Для Индекс = 0 По 2 Цикл
		Наблюдения.Добавить(Новый Структура("Фаза,ИдентификаторСтенда,ИдентификаторНагрузки,ЧислоСтраниц,BalloonБайт,HostSwapБайт,GuestSwapБайт,ДлительностьОбходаМс,КонтрольнаяСумма",
			Фаза, "vm-lab", "page-walk", 4096, Balloon, HostSwap, GuestSwap, ДлительностьМс + Индекс - 1, 515));
	КонецЦикла;
	Возврат Наблюдения;

КонецФункции
#КонецОбласти
