#Область ПрограммныйИнтерфейс

// Оценивает опоздание активного BSL-цикла относительно срока по системным часам.
// Цикл не усыпляет поток; результат не является задержкой пробуждения.
// Параметры:
//  ЧислоНаблюдений - Число - число измерений (> 0).
//  ПериодМс - Число - период активного ожидания в миллисекундах (> 0).
// Возвращаемое значение:
//  Структура: медианное, среднее и максимальное запаздывание, разрешение таймера,
//  число проверок таймера и пояснение методики.
Функция Проба003_АктивноеОжидание(Знач ЧислоНаблюдений = 20, Знач ПериодМс = 2) Экспорт

	Если ЧислоНаблюдений <= 0 Или ПериодМс <= 0 Тогда
		ВызватьИсключение "Некорректные параметры Пробы 003";
	КонецЕсли;

	Запаздывания = Новый Массив;
	СуммаЗапаздывания = 0;
	ОбщееЧислоПроверок = 0;
	Для Номер = 1 По ЧислоНаблюдений Цикл
		СрокМс = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПериодМс;
		СчетчикОжидания = 0;
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < СрокМс Цикл
			СчетчикОжидания = СчетчикОжидания + 1;
		КонецЦикла;
		ОбщееЧислоПроверок = ОбщееЧислоПроверок + СчетчикОжидания;
		ЗапаздываниеМс = Макс(0, ТекущаяУниверсальнаяДатаВМиллисекундах() - СрокМс);
		Запаздывания.Добавить(ЗапаздываниеМс);
		СуммаЗапаздывания = СуммаЗапаздывания + ЗапаздываниеМс;
	КонецЦикла;

	Отсортированные = Новый СписокЗначений;
	Для Каждого ЗначениеИзмерения Из Запаздывания Цикл
		Отсортированные.Добавить(ЗначениеИзмерения);
	КонецЦикла;
	Отсортированные.СортироватьПоЗначению();

	Результат = Новый Структура;
	Результат.Вставить("МедианаЗапаздыванияМс", Число(Отсортированные[Цел((ЧислоНаблюдений - 1) / 2)].Значение));
	Результат.Вставить("МаксимальноеЗапаздываниеМс", Число(Отсортированные[ЧислоНаблюдений - 1].Значение));
	Результат.Вставить("СреднееЗапаздываниеМс", СуммаЗапаздывания / ЧислоНаблюдений);
	Результат.Вставить("ЧислоПроверокТаймера", ОбщееЧислоПроверок);
	Результат.Вставить("РазрешениеТаймераМс", 1);
	Результат.Вставить("Детали", "Активное ожидание по часам BSL; это не задержка пробуждения спящего потока");
	Возврат Результат;

КонецФункции

#КонецОбласти
