&НаСервере
Функция КлассифицироватьРезультат(Знач КодПробы, Знач Статус)

	Код = ВРег(СокрЛП(КодПробы));
	СтатусВерхний = ВРег(СокрЛП(Статус));
	Звено = "Не классифицировано";
	Ресурс = "Прочее";
	НомерКода = 0;
	КодЧисловой = Ложь;
	Если СтрДлина(Код) = 3 Тогда
		Попытка
			НомерКода = Число(Код);
			КодЧисловой = Истина;
		Исключение
			НомерКода = 0;
		КонецПопытки;
	КонецЕсли;

	Если Код = "027_RTT" Или Код = "NET_SMALL_RTT" Тогда
		Звено = "Клиент ↔ сервер";
		Ресурс = "Сеть и вызовы";
	ИначеЕсли Код = "027_HANDLER" Тогда
		Звено = "Сервер 1С";
		Ресурс = "Сеть и вызовы";
	ИначеЕсли Код = "CPU_NATIVE_7ZIP" Или Код = "CPU_NATIVE_CLIENT" Тогда
		Звено = "Клиент";
		Ресурс = "CPU";
	ИначеЕсли Код = "CPU_NATIVE_SERVER" Тогда
		Звено = "Сервер 1С";
		Ресурс = "CPU";
	ИначеЕсли Лев(Код, 4) = "NCPU" Тогда
		Если Сред(Код, СтрДлина(Код), 1) = "C" Тогда
			Звено = "Клиент";
		Иначе
			Звено = "Сервер 1С";
		КонецЕсли;
		Ресурс = "CPU";
	ИначеЕсли Лев(Код, 5) = "FILE_" Тогда
		Звено = "Сервер 1С";
		Ресурс = "Файловый ввод-вывод";
	ИначеЕсли Лев(Код, 3) = "DB_" Тогда
		Звено = "Сервер 1С ↔ СУБД";
		Ресурс = ?(СтрНайти(Код, "WRITE") > 0 Или Код = "DB_HOT_PAGE_PROXY",
			"Запись и транзакции", "Запросы и чтение");
	ИначеЕсли Лев(Код, 3) = "TX_" Или Код = "REGISTER_MOVEMENT" Тогда
		Звено = "Сервер 1С ↔ СУБД";
		Ресурс = "Запись и транзакции";
	ИначеЕсли Лев(Код, 4) = "NET_" Или Код = "CLIENT_SERVER_CALL"
		Или Код = "WEB_PUBLICATION_PATH" Или Код = "TERMINAL_FRAME_PATH" Тогда
		Звено = "Клиент ↔ сервер";
		Ресурс = "Сеть и вызовы";
	ИначеЕсли Код = "MEM_COLLECTION" Или Код = "PROCESS_MEM_GROWTH"
		Или Код = "SESSION_MEM_PROXY" Тогда
		Звено = "Сервер 1С";
		Ресурс = "Память";
	ИначеЕсли Код = "RPHOST_SATURATION" Или Код = "SESSION_COLD_CALL"
		Или Код = "CPU_SATURATION" Тогда
		Звено = "Сервер 1С";
		Ресурс = "CPU";
	ИначеЕсли Код = "PROCESS_COLD_START" Или Код = "PROCESS_SWITCH"
		Или Код = "RPHOST_SKEW" Или Код = "BACKGROUND_QUEUE" Тогда
		Звено = "Сервер 1С";
		Ресурс = "Процессы 1С";
	ИначеЕсли Код = "FORM_CONTEXT_PROXY" Тогда
		Звено = "Клиент";
		Ресурс = "Интерфейс";
	ИначеЕсли Код = "RESPONSE_DECOMPRESS" Или Код = "FORM_MODEL_FILL"
		Или Код = "UI_READY_TIME" Тогда
		Звено = "Клиент";
		Ресурс = "Интерфейс";
	ИначеЕсли Код = "VALUE_SERIALIZATION" Тогда
		Звено = "Сервер 1С";
		Ресурс = "Сериализация";
	ИначеЕсли Код = "DATA_ACCESS_FILTER" Тогда
		Звено = "Сервер 1С ↔ СУБД";
		Ресурс = "Запросы и чтение";
	ИначеЕсли Код = "EXT_HANDLER_COST" Тогда
		Звено = "Сервер 1С";
		Ресурс = "Прочее";
	ИначеЕсли Код = "026" Или Код = "MEM_COLLECTION"
		Или Код = "DB_POINT_QUERY" Или Код = "DB_JOIN_SORT"
		Или Код = "TX_SPLIT_COMMIT" Или Код = "TX_BATCH_COMMIT"
		Или Код = "DOC_POSTING" Тогда
		Если Код = "026" Тогда
			Звено = "Сервер 1С";
			Ресурс = "CPU";
		ИначеЕсли Код = "MEM_COLLECTION" Тогда
			Звено = "Сервер 1С";
			Ресурс = "Память";
		ИначеЕсли Код = "DB_POINT_QUERY" Или Код = "DB_JOIN_SORT" Тогда
			Звено = "Сервер 1С ↔ СУБД";
			Ресурс = "Запросы и чтение";
		Иначе
			Звено = "Сервер 1С ↔ СУБД";
			Ресурс = "Запись и транзакции";
		КонецЕсли;
	ИначеЕсли КодЧисловой Тогда
		Если НомерКода >= 1 И НомерКода <= 11 Тогда
			Звено = "Сервер 1С";
			Ресурс = "CPU";
		ИначеЕсли НомерКода >= 28 И НомерКода <= 31 Тогда
			Звено = "Сервер 1С";
			Ресурс = "CPU";
		ИначеЕсли НомерКода >= 32 И НомерКода <= 33 Тогда
			Звено = "Сервер 1С";
			Ресурс = "Память";
		ИначеЕсли НомерКода >= 34 И НомерКода <= 35 Тогда
			Звено = "Сервер 1С";
			Ресурс = "Процессы 1С";
		ИначеЕсли НомерКода >= 36 И НомерКода <= 46 Тогда
			Звено = "Сервер 1С";
			Ресурс = "Файловый ввод-вывод";
		ИначеЕсли НомерКода >= 47 И НомерКода <= 58 Тогда
			Звено = "Сервер 1С ↔ СУБД";
			Ресурс = ?(НомерКода = 57, "Запись и транзакции", "Запросы и чтение");
		ИначеЕсли НомерКода >= 59 И НомерКода <= 68 Тогда
			Звено = "Сервер 1С ↔ СУБД";
			Ресурс = "Запись и транзакции";
		ИначеЕсли НомерКода >= 69 И НомерКода <= 76 Тогда
			Звено = "Клиент ↔ сервер";
			Ресурс = "Сеть и вызовы";
		ИначеЕсли НомерКода = 77 Тогда
			Звено = "Клиент";
			Ресурс = "Интерфейс";
		ИначеЕсли НомерКода = 78 Тогда
			Звено = "Клиент ↔ сервер";
			Ресурс = "Сеть и вызовы";
		ИначеЕсли НомерКода >= 79 И НомерКода <= 84 Тогда
			Звено = "Сервер 1С ↔ СУБД";
			Ресурс = ?(НомерКода = 80 Или НомерКода = 81,
				"Запись и транзакции", "Запросы и чтение");
		ИначеЕсли НомерКода = 85 Тогда
			Звено = "Сервер 1С";
			Ресурс = "Сериализация";
		ИначеЕсли НомерКода >= 86 И НомерКода <= 88 Тогда
			Звено = "Клиент";
			Ресурс = "Интерфейс";
		ИначеЕсли НомерКода >= 89 И НомерКода <= 90 Тогда
			Звено = "Клиент ↔ сервер";
			Ресурс = "Сеть и вызовы";
		КонецЕсли;
	КонецЕсли;

	Если СтрНайти(СтатусВерхний, "НЕДОСТУПНО") > 0 Тогда
		ТипСвидетельства = "Недоступно";
	ИначеЕсли СтрНайти(СтатусВерхний, "ОШИБ") > 0
		Или СтрНайти(СтатусВерхний, "НЕДЕЙСТВ") > 0
		Или СтрНайти(СтатусВерхний, "НЕДОСТАТОЧНО") > 0 Тогда
		ТипСвидетельства = "Ошибка";
	ИначеЕсли Звено = "Не классифицировано" Тогда
		ТипСвидетельства = "Не классифицировано";
	ИначеЕсли Лев(Код, 4) = "NCPU"
		Или Код = "027_RTT" Или Код = "027_HANDLER" Тогда
		ТипСвидетельства = "Прямое измерение";
	ИначеЕсли СтрНайти(СтатусВерхний, "ПРОКСИ") > 0
		Или СтрНайти(СтатусВерхний, "КОСВЕН") > 0
		Или СтрНайти(СтатусВерхний, "КОНТЕКСТ") > 0
		Или Код = "001"
		Или (КодЧисловой И НомерКода >= 2 И НомерКода <= 11)
		Или Код = "CPU_NATIVE_7ZIP" Или Код = "CPU_NATIVE_SERVER" Тогда
		ТипСвидетельства = "Контекстный сигнал";
	Иначе
		ТипСвидетельства = "Прямое измерение";
	КонецЕсли;

	Возврат Новый Структура("Звено,Ресурс,ТипСвидетельства",
		Звено, Ресурс, ТипСвидетельства);

КонецФункции

&НаСервере
Процедура ОбновитьПокрытиеНаСервере()

	ПокрытиеПоЗвеньям.Очистить();
	Звенья = Новый Массив;
	Звенья.Добавить("Клиент");
	Звенья.Добавить("Клиент ↔ сервер");
	Звенья.Добавить("Сервер 1С");
	Звенья.Добавить("Сервер 1С ↔ СУБД");
	Звенья.Добавить("Не классифицировано");
	Для Каждого Звено Из Звенья Цикл
		НоваяСтрокаПокрытия = ПокрытиеПоЗвеньям.Добавить();
		НоваяСтрокаПокрытия.Звено = Звено;
	КонецЦикла;

	Для Каждого Результат Из Результаты Цикл
		СтрокаПокрытия = Неопределено;
		Для Каждого КандидатПокрытия Из ПокрытиеПоЗвеньям Цикл
			Если КандидатПокрытия.Звено = Результат.Звено Тогда
				СтрокаПокрытия = КандидатПокрытия;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаПокрытия = Неопределено Тогда
			СтрокаПокрытия = ПокрытиеПоЗвеньям.Добавить();
			СтрокаПокрытия.Звено = "Не классифицировано";
		КонецЕсли;

		Если Результат.ТипСвидетельства = "Прямое измерение" Тогда
			СтрокаПокрытия.ПрямыеИзмерения = СтрокаПокрытия.ПрямыеИзмерения + 1;
		ИначеЕсли Результат.ТипСвидетельства = "Контекстный сигнал" Тогда
			СтрокаПокрытия.КонтекстныеСигналы = СтрокаПокрытия.КонтекстныеСигналы + 1;
		ИначеЕсли Результат.ТипСвидетельства = "Недоступно" Тогда
			СтрокаПокрытия.НедоступныеПроверки = СтрокаПокрытия.НедоступныеПроверки + 1;
		ИначеЕсли Результат.ТипСвидетельства = "Не классифицировано" Тогда
			СтрокаПокрытия.БезКлассификации = СтрокаПокрытия.БезКлассификации + 1;
		Иначе
			СтрокаПокрытия.ОшибкиИзмерения = СтрокаПокрытия.ОшибкиИзмерения + 1;
		КонецЕсли;
	КонецЦикла;

	Элементы.ТаблицаПокрытия.Видимость = Результаты.Количество() > 0;

КонецПроцедуры

