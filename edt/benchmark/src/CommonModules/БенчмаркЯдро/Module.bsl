// Базовый серверный модуль ядра конфигурации-бенчмарка.

#Область ПрограммныйИнтерфейс

// Выполняет простую детерминированную нагрузку на CPU (для smoke-проверки и калибровки).
//
// Параметры:
//  ЧислоИтераций - Число - количество итераций расчёта.
//
// Возвращаемое значение:
//  Структура:
//      * Сумма - Число
//      * ДлительностьМс - Число
//
Функция ВыполнитьТестовыйРасчет(Знач ЧислоИтераций = 1000) Экспорт

	Если ЧислоИтераций < 0 Тогда
		ВызватьИсключение "Число итераций не может быть отрицательным";
	КонецЕсли;

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Аккумулятор = 0;

	Для Индекс = 1 По ЧислоИтераций Цикл
		Аккумулятор = Аккумулятор + (Индекс * 31) % 997;
	КонецЦикла;

	КонецМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Результат = Новый Структура;
	Результат.Вставить("Сумма", Аккумулятор);
	Результат.Вставить("ДлительностьМс", КонецМс - НачалоМс);
	Возврат Результат;

КонецФункции

// Строит детерминированный псевдослучайный блок, общий для файловых проб.
Функция СоздатьБуферПробныхДанных(Знач РазмерБлокаБайт) Экспорт

	Если РазмерБлокаБайт <= 0 Тогда
		ВызватьИсключение "Размер блока пробных данных должен быть положительным";
	КонецЕсли;

	Буфер = Новый BinaryDataBuffer(РазмерБлокаБайт);
	Состояние = 1;
	Для Индекс = 0 По РазмерБлокаБайт - 1 Цикл
		Состояние = (Состояние * 48271) % 2147483647;
		Буфер[Индекс] = Состояние % 256;
	КонецЦикла;
	Возврат Буфер;

КонецФункции

// Возвращает медиану списка числовых значений; сортирует переданный список.
Функция МедианаСпискаЗначений(Знач Значения) Экспорт

	Если Значения.Количество() = 0 Тогда
		ВызватьИсключение "Для медианы нужен хотя бы один элемент";
	КонецЕсли;
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение)
		+ Число(Значения[Количество / 2].Значение)) / 2;

КонецФункции

// Удваивает повторения до минимального измеримого интервала с жёстким пределом.
Функция СледующееЧислоПовторов(Знач ТекущееЧисло, Знач ФактическаяДлительностьМс,
	Знач МинимальнаяДлительностьМс, Знач МаксимальноеЧисло) Экспорт

	Если ТекущееЧисло <= 0 Или МаксимальноеЧисло <= 0 Тогда
		ВызватьИсключение "Число повторов и их предел должны быть положительными";
	КонецЕсли;
	Если МинимальнаяДлительностьМс <= 0 Тогда
		ВызватьИсключение "Минимальная длительность должна быть положительной";
	КонецЕсли;
	Если ФактическаяДлительностьМс >= МинимальнаяДлительностьМс
		Или ТекущееЧисло >= МаксимальноеЧисло Тогда
		Возврат ТекущееЧисло;
	КонецЕсли;
	Возврат Мин(МаксимальноеЧисло, ТекущееЧисло * 2);

КонецФункции

#КонецОбласти
