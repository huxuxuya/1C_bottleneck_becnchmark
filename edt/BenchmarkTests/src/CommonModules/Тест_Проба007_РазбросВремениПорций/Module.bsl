#Область СлужебныеПроцедурыИФункции

Процедура Тест_Проба007_РазбросВремениПорций() Экспорт

	Результат = БенчмаркПроба007РазбросВремениПорций.Проба007_РазбросВремениПорций(3, 100);

	ЮТест.ОжидаетЧто(Результат.МинМс).МеньшеИлиРавно(Результат.МедианаМс);
	ЮТест.ОжидаетЧто(Результат.МедианаМс).МеньшеИлиРавно(Результат.МаксМс);
	ЮТест.ОжидаетЧто(Результат.РазбросМс).Равно(Результат.МаксМс - Результат.МинМс);
	ЮТест.ОжидаетЧто(Результат.КонтрольнаяСумма).Больше(0);

КонецПроцедуры

#КонецОбласти
