#Область ПрограммныйИнтерфейс

// Обрабатывает все значения одним обращением к серверу.
Функция ОбработатьПакетБезКонтекста(Знач Значения) Экспорт

	КонтрольнаяСумма = 0;
	Для Каждого Значение Из Значения Цикл
		КонтрольнаяСумма = КонтрольнаяСумма + ОбработатьЗначение(Значение);
	КонецЦикла;

	Возврат КонтрольнаяСумма;

КонецФункции

// Обрабатывает одно значение за отдельное обращение к серверу.
Функция ОбработатьЭлементБезКонтекста(Знач Значение) Экспорт

	Возврат ОбработатьЗначение(Значение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбработатьЗначение(Знач Значение)

	Возврат Значение * 31 + 17;

КонецФункции

#КонецОбласти
