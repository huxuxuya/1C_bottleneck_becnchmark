#Область ПрограммныйИнтерфейс
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТестовыйНабор("Память и кэши CPU")
		.ДобавитьСерверныйТест("Тест_Проба021_ЗадержкаПодНагрузкой");
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба021_ЗадержкаПодНагрузкой() Экспорт
	Точки = Новый Массив;
	Точки.Добавить(СоздатьТочку(0, 100));
	Точки.Добавить(СоздатьТочку(20, 150));
	Результат = БенчмаркПроба021ЗадержкаПамятиПодНагрузкой.АнализироватьЗадержкуПодНагрузкой(Точки);
	ЮТест.ОжидаетЧто(Результат.БазоваяЗадержкаНс).Равно(100);
	ЮТест.ОжидаетЧто(Результат.Точки[1].МедианаЗадержкиНс).Равно(150);
	ЮТест.ОжидаетЧто(Результат.Точки[1].ИзменениеЗадержкиКБазеПроцентов).Равно(50);

	Для Индекс = 0 По 2 Цикл
		Точки[0].Наблюдения[Индекс].ФоноваяПолосаГБс = 2;
	КонецЦикла;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба021ЗадержкаПамятиПодНагрузкой.АнализироватьЗадержкуПодНагрузкой(Точки);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);
КонецПроцедуры

Функция СоздатьТочку(Полоса, ЗадержкаНс)
	Наблюдения = Новый Массив;
	Для Индекс = 1 По 3 Цикл
		Наблюдения.Добавить(Новый Структура("ФоноваяПолосаГБс,ЗадержкаНс,ЧислоДоступов,КонтрольнаяСумма",
			Полоса, ЗадержкаНс, 5000, 912));
	КонецЦикла;
	Возврат Новый Структура("ЦелеваяФоноваяПолосаГБс,ИдентификаторСтенда,ИдентификаторНабора,ОбъемРабочегоНабораБайт,ИдентификаторАлгоритма,Наблюдения",
		Полоса, "mem-lab", "dependent-walk-1", 33554432, "dependent-random-v1", Наблюдения);
КонецФункции
#КонецОбласти
