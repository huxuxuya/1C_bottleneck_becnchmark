Процедура Тест_ПрогонДиагностик_ЗаписьВсехРезультатов() Экспорт

	ИдентификаторПрогона = "YAX_DIAG_" + Лев(Строка(Новый УникальныйИдентификатор), 8);
	БенчмаркРаннер.ОчиститьРезультатыПрогона(ИдентификаторПрогона);

	Попытка
		Итог = БенчмаркДиагностикиBSL.ВыполнитьПрогон(ИдентификаторПрогона);
		Записи = БенчмаркРаннер.ПолучитьРезультатыПрогона(ИдентификаторПрогона);
		ЮТест.ОжидаетЧто(Итог.КоличествоПроверок).Равно(62);
		ЮТест.ОжидаетЧто(Итог.КоличествоОшибок).Равно(0);
		ЮТест.ОжидаетЧто(Записи.Количество()).Равно(62);
		Для Каждого Запись Из Записи Цикл
			ЮТест.ОжидаетЧто(СтрНайти("0123456789", Лев(Запись.КодПробы, 1)) = 0).Равно(Истина);
			ЮТест.ОжидаетЧто(ПустаяСтрока(Запись.НаименованиеПробы)).Равно(Ложь);
			ЮТест.ОжидаетЧто(Запись.Статус = "Ошибка").Равно(Ложь);
			ЮТест.ОжидаетЧто(СтрНайти(Запись.Детали, "мс")).Больше(0);
		КонецЦикла;
	Исключение
		БенчмаркРаннер.ОчиститьРезультатыПрогона(ИдентификаторПрогона);
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;

	БенчмаркРаннер.ОчиститьРезультатыПрогона(ИдентификаторПрогона);

КонецПроцедуры

#КонецОбласти
