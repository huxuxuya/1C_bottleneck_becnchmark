#Область ПрограммныйИнтерфейс

// Регистрирует один серверный YAxUnit-тест.
Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты.ДобавитьТестовыйНабор("Пробы и генератор")
        .ДобавитьСерверныйТест("Тест_ГенераторИПроведениеДокумента_ДвиженияИОчистка");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_ГенераторИПроведениеДокумента_ДвиженияИОчистка() Экспорт

	ИдентификаторСерии = "ЮТ_ПРОВЕДЕНИЕ_01";
	БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);

	СправочникиБазы = БенчмаркГенераторДанных.ОбеспечитьСправочники(5, 2, "ЮТ");

	Параметры = Новый Структура;
	Параметры.Вставить("Товары", СправочникиБазы.Товары);
	Параметры.Вставить("Склад", СправочникиБазы.Склады[0]);
	Параметры.Вставить("ЧислоСтрок", 20);
	Параметры.Вставить("РежимРаспределения", "Равномерно");
	Параметры.Вставить("ИдентификаторСерии", ИдентификаторСерии);
	Параметры.Вставить("Проводить", Ложь);

	Создано = БенчмаркГенераторДанных.СоздатьДокументДвижения(Параметры);
	Проведение = БенчмаркПробы.ПробаПроведениеДокумента(Создано.Ссылка);

	ЮТест.ОжидаетЧто(Проведение.КоличествоДвижений).Равно(20);
	ЮТест.ОжидаетЧто(Проведение.СуммаКоличество).Равно(Создано.СуммаКоличество);

	Удалено = БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);
	ЮТест.ОжидаетЧто(Удалено).Равно(1);

КонецПроцедуры

#КонецОбласти
