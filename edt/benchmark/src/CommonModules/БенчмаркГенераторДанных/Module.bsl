// Генератор детерминированных тестовых данных для проб бенчмарка.

#Область ПрограммныйИнтерфейс

// Обеспечивает наличие заданного числа элементов в справочниках Товары и Склады.
//
// Параметры:
//  КоличествоТоваров - Число - требуемое число товаров (> 0).
//  КоличествоСкладов - Число - требуемое число складов (> 0).
//  ПрефиксКода - Строка - префикс кода для изоляции тестовых элементов.
//
// Возвращаемое значение:
//  Структура:
//      * Товары - Массив Из СправочникСсылка.Товары
//      * Склады - Массив Из СправочникСсылка.Склады
//
Функция ОбеспечитьСправочники(Знач КоличествоТоваров = 20, Знач КоличествоСкладов = 5, Знач ПрефиксКода = "БМ") Экспорт

	Если КоличествоТоваров <= 0 Или КоличествоСкладов <= 0 Тогда
		ВызватьИсключение "Количество товаров и складов должно быть больше нуля";
	КонецЕсли;

	Товары = Новый Массив;
	Для Индекс = 1 По КоличествоТоваров Цикл
		КодЭлемента = ПрефиксКода + Формат(Индекс, "ЧЦ=6; ЧВН=; ЧГ=0");
		Ссылка = Справочники.Товары.НайтиПоКоду(КодЭлемента);
		Если Ссылка.Пустая() Тогда
			Объект = Справочники.Товары.СоздатьЭлемент();
			Объект.Код = КодЭлемента;
			Объект.Наименование = "Товар " + КодЭлемента;
			Объект.Артикул = "ART-" + КодЭлемента;
			Объект.Записать();
			Ссылка = Объект.Ссылка;
		КонецЕсли;
		Товары.Добавить(Ссылка);
	КонецЦикла;

	Склады = Новый Массив;
	Для Индекс = 1 По КоличествоСкладов Цикл
		КодЭлемента = ПрефиксКода + Формат(Индекс, "ЧЦ=6; ЧВН=; ЧГ=0");
		Ссылка = Справочники.Склады.НайтиПоКоду(КодЭлемента);
		Если Ссылка.Пустая() Тогда
			Объект = Справочники.Склады.СоздатьЭлемент();
			Объект.Код = КодЭлемента;
			Объект.Наименование = "Склад " + КодЭлемента;
			Объект.Записать();
			Ссылка = Объект.Ссылка;
		КонецЕсли;
		Склады.Добавить(Ссылка);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Товары", Товары);
	Результат.Вставить("Склады", Склады);
	Возврат Результат;

КонецФункции

// Создаёт (и при необходимости проводит) документ ДвижениеТоваров.
//
// Параметры:
//  Параметры - Структура - необязательные ключи:
//   * Товары - Массив Из СправочникСсылка.Товары - товары (обязателен).
//   * Склад - СправочникСсылка.Склады - склад документа (обязателен).
//   * ЧислоСтрок - Число - число строк табличной части (по умолчанию 20).
//   * РежимРаспределения - Строка - "Равномерно" или "ГорячиеКлючи" (по умолчанию "Равномерно").
//   * Приход - Булево - вид движения (по умолчанию Истина).
//   * ИдентификаторСерии - Строка - метка серии для группировки и очистки.
//   * Проводить - Булево - проводить ли документ сразу (по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура:
//      * Ссылка - ДокументСсылка.ДвижениеТоваров
//      * ЧислоСтрок - Число
//      * СуммаКоличество - Число
//      * СуммаВсего - Число
//
Функция СоздатьДокументДвижения(Знач Параметры) Экспорт

	Подготовка = ПодготовитьДокументДвижения(Параметры);
	Документ = Подготовка.Объект;
	Если Подготовка.Проводить Тогда
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		Документ.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Документ.Ссылка);
	Результат.Вставить("ЧислоСтрок", Подготовка.ЧислоСтрок);
	Результат.Вставить("СуммаКоличество", Подготовка.СуммаКоличество);
	Результат.Вставить("СуммаВсего", Подготовка.СуммаВсего);
	Возврат Результат;

КонецФункции

// Создаёт объект документа и наполняет его данными, но не записывает в ИБ.
// Применяется пробами фиксации, чтобы не включать подготовку табличной части в замер.
Функция ПодготовитьДокументДвижения(Знач Параметры) Экспорт

	МассивТоваров = Параметры.Товары;
	Если МассивТоваров.Количество() = 0 Тогда
		ВызватьИсключение "Массив товаров не может быть пустым";
	КонецЕсли;

	ЧислоСтрок = 20;
	Если Параметры.Свойство("ЧислоСтрок") Тогда
		ЧислоСтрок = Параметры.ЧислоСтрок;
	КонецЕсли;
	Если ЧислоСтрок <= 0 Тогда
		ВызватьИсключение "Число строк должно быть больше нуля";
	КонецЕсли;

	РежимРаспределения = "Равномерно";
	Если Параметры.Свойство("РежимРаспределения") Тогда
		РежимРаспределения = Параметры.РежимРаспределения;
	КонецЕсли;

	Приход = Истина;
	Если Параметры.Свойство("Приход") Тогда
		Приход = Параметры.Приход;
	КонецЕсли;

	ИдентификаторСерии = "";
	Если Параметры.Свойство("ИдентификаторСерии") Тогда
		ИдентификаторСерии = Параметры.ИдентификаторСерии;
	КонецЕсли;

	Проводить = Ложь;
	Если Параметры.Свойство("Проводить") Тогда
		Проводить = Параметры.Проводить;
	КонецЕсли;

	Документ = Документы.ДвижениеТоваров.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Склад = Параметры.Склад;
	Документ.Приход = Приход;
	Документ.ИдентификаторСерии = ИдентификаторСерии;

	ЧислоГорячих = Мин(2, МассивТоваров.Количество());
	СуммаКоличество = 0;
	СуммаВсего = 0;

	Для Индекс = 1 По ЧислоСтрок Цикл
		Если РежимРаспределения = "ГорячиеКлючи" Тогда
			ИндексТовара = (Индекс - 1) % ЧислоГорячих;
		Иначе
			ИндексТовара = (Индекс - 1) % МассивТоваров.Количество();
		КонецЕсли;

		Количество = 1 + (Индекс % 5);
		Цена = 100 + ((Индекс * 17) % 50);
		Сумма = Количество * Цена;

		СтрокаТЧ = Документ.Товары.Добавить();
		СтрокаТЧ.Товар = МассивТоваров[ИндексТовара];
		СтрокаТЧ.Количество = Количество;
		СтрокаТЧ.Цена = Цена;
		СтрокаТЧ.Сумма = Сумма;

		СуммаКоличество = СуммаКоличество + Количество;
		СуммаВсего = СуммаВсего + Сумма;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Объект", Документ);
	Результат.Вставить("ЧислоСтрок", ЧислоСтрок);
	Результат.Вставить("СуммаКоличество", СуммаКоличество);
	Результат.Вставить("СуммаВсего", СуммаВсего);
	Результат.Вставить("Проводить", Проводить);
	Возврат Результат;

КонецФункции

// Удаляет документы заданной серии (для очистки после прогона).
//
// Параметры:
//  ИдентификаторСерии - Строка - идентификатор серии.
//
// Возвращаемое значение:
//  Число - количество удалённых документов.
//
Функция ОчиститьДанныеСерии(Знач ИдентификаторСерии) Экспорт

	Если ПустаяСтрока(ИдентификаторСерии) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДвижениеТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ДвижениеТоваров КАК ДвижениеТоваров
	|ГДЕ
	|	ДвижениеТоваров.ИдентификаторСерии = &ИдентификаторСерии";
	Запрос.УстановитьПараметр("ИдентификаторСерии", ИдентификаторСерии);

	Выборка = Запрос.Выполнить().Выбрать();
	Удалено = 0;
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.Удалить();
		Удалено = Удалено + 1;
	КонецЦикла;

	Возврат Удалено;

КонецФункции

#КонецОбласти
