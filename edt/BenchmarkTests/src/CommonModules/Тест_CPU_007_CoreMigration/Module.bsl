#Область ПрограммныйИнтерфейс
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТестовыйНабор("Нативные диагностики CPU")
		.ДобавитьКлиентскийТест("Тест_CPU_007_CoreMigration");
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура Тест_CPU_007_CoreMigration() Экспорт

	Если Не ПроверитьПодключениеВнешнейКомпоненты(
		"ОбщийМакет.CpuFrequencyProbe",
		"CpuFrequencyProbe") Тогда
		Подключена = Ложь;
		Попытка
			Подключена = ПодключитьВнешнююКомпоненту(
				"ОбщийМакет.CpuFrequencyProbe",
				"CpuFrequencyProbe",
				ТипВнешнейКомпоненты.Native);
		Исключение
		КонецПопытки;
		Если Не Подключена Тогда
			Попытка
				УстановитьВнешнююКомпоненту("ОбщийМакет.CpuFrequencyProbe");
			Исключение
				// Установка не обязательна, если клиент уже располагает компонентой.
			КонецПопытки;
			Если Не ПодключитьВнешнююКомпоненту(
				"ОбщийМакет.CpuFrequencyProbe",
				"CpuFrequencyProbe",
				ТипВнешнейКомпоненты.Native) Тогда
				ВызватьИсключение "Не удалось подключить Native API-компоненту CpuFrequencyProbe";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Измеритель = Новый("AddIn.CpuFrequencyProbe.CpuProbe");
	JSONРезультата = Измеритель.Measure(-7, 50, 1000);

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONРезультата);
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Структура"));
	ЮТест.ОжидаетЧто(Результат.schemaVersion).Равно(1);
	ЮТест.ОжидаетЧто(Результат.probeCode).Равно("CPU_007_CORE_MIGRATION");
	ЮТест.ОжидаетЧто(ПустаяСтрока(Результат.probeName)).Равно(Ложь);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Результат.primaryMetric)).Равно(Ложь);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Результат.primaryUnit)).Равно(Ложь);
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.primaryValue)).Равно(Тип("Число"));
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.measurements)).Равно(Тип("Структура"));
	ЮТест.ОжидаетЧто(Результат.status = "Косвенный сигнал"
		Или Результат.status = "Недоступно").Равно(Истина);
	Если Результат.available Тогда
		ЮТест.ОжидаетЧто(Результат.primaryUnit = "н/д").Равно(Ложь);
	Иначе
		ЮТест.ОжидаетЧто(Результат.status).Равно("Недоступно");
		ЮТест.ОжидаетЧто(Результат.primaryValue).Равно(0);
	КонецЕсли;

	// Полный JSON сохраняет фактические метрики диагностики в platform.log.
	Сообщить("CPU_NATIVE_DIAGNOSTIC_RESULT|CPU_007_CORE_MIGRATION|" + JSONРезультата);

КонецПроцедуры
#КонецОбласти
