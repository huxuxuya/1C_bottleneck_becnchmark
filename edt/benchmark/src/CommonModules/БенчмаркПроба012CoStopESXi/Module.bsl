// Сравнивает внешние ESXi-замеры %CSTP, %RDY и полезной работы для двух размеров ВМ.
// Сбор статистики ESXi выполняется отдельно; этот модуль агрегирует и проверяет входные серии.

#Область ПрограммныйИнтерфейс

// Сравнивает меньшую и большую ВМ при одинаковом размещении и активном параллелизме.
// Вариант содержит поля РазмерВМvCPU, ЧислоАктивныхИсполнителей, ИдентификаторСтенда,
// ИдентификаторРазмещения, ИдентификаторНагрузки и массив Наблюдения.
// Каждое наблюдение содержит CStopПроцент, ReadyПроцент и РаботаВСекунду.
Функция СравнитьРазмерыВМ(Знач МеньшаяВМ, Знач БольшаяВМ) Экспорт

	ПроверитьВариант(МеньшаяВМ, "меньшая ВМ");
	ПроверитьВариант(БольшаяВМ, "большая ВМ");

	Если МеньшаяВМ.РазмерВМvCPU >= БольшаяВМ.РазмерВМvCPU Тогда
		ВызватьИсключение "Размер второй ВМ должен быть больше первой ВМ";
	КонецЕсли;
	Если МеньшаяВМ.ЧислоАктивныхИсполнителей <> БольшаяВМ.ЧислоАктивныхИсполнителей Тогда
		ВызватьИсключение "Для сравнения требуется одинаковый активный параллелизм";
	КонецЕсли;
	Если МеньшаяВМ.ИдентификаторСтенда <> БольшаяВМ.ИдентификаторСтенда Тогда
		ВызватьИсключение "Варианты должны выполняться на одном стенде";
	КонецЕсли;
	Если МеньшаяВМ.ИдентификаторРазмещения <> БольшаяВМ.ИдентификаторРазмещения Тогда
		ВызватьИсключение "Размещение ВМ должно быть сопоставимым";
	КонецЕсли;
	Если МеньшаяВМ.ИдентификаторНагрузки <> БольшаяВМ.ИдентификаторНагрузки Тогда
		ВызватьИсключение "Профиль нагрузки должен совпадать";
	КонецЕсли;

	CStopМеньшая = МедианаМетрики(МеньшаяВМ.Наблюдения, "CStopПроцент");
	CStopБольшая = МедианаМетрики(БольшаяВМ.Наблюдения, "CStopПроцент");
	ReadyМеньшая = МедианаМетрики(МеньшаяВМ.Наблюдения, "ReadyПроцент");
	ReadyБольшая = МедианаМетрики(БольшаяВМ.Наблюдения, "ReadyПроцент");
	РаботаМеньшая = МедианаМетрики(МеньшаяВМ.Наблюдения, "РаботаВСекунду");
	РаботаБольшая = МедианаМетрики(БольшаяВМ.Наблюдения, "РаботаВСекунду");

	Результат = Новый Структура;
	Результат.Вставить("РазмерМеньшейВМvCPU", МеньшаяВМ.РазмерВМvCPU);
	Результат.Вставить("РазмерБольшейВМvCPU", БольшаяВМ.РазмерВМvCPU);
	Результат.Вставить("ЧислоАктивныхИсполнителей", МеньшаяВМ.ЧислоАктивныхИсполнителей);
	Результат.Вставить("CStopМеньшаяВМПроцент", CStopМеньшая);
	Результат.Вставить("CStopБольшаяВМПроцент", CStopБольшая);
	Результат.Вставить("ИзменениеCStopПп", Окр(CStopБольшая - CStopМеньшая, 2));
	Результат.Вставить("ReadyМеньшаяВМПроцент", ReadyМеньшая);
	Результат.Вставить("ReadyБольшаяВМПроцент", ReadyБольшая);
	Результат.Вставить("ИзменениеReadyПп", Окр(ReadyБольшая - ReadyМеньшая, 2));
	Результат.Вставить("РаботаМеньшаяВМСек", РаботаМеньшая);
	Результат.Вставить("РаботаБольшаяВМСек", РаботаБольшая);
	Результат.Вставить("ИзменениеРаботыПроцентов", Окр((РаботаБольшая / РаботаМеньшая - 1) * 100, 2));
	Результат.Вставить("УровеньПодтверждения", "Счётчики ESXi и одинаковая полезная нагрузка");
	Результат.Вставить("Детали", "Медианы внешних замеров; данные ESXi не собираются из процесса 1С");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьВариант(Вариант, ОписаниеВарианта)

	Если Не Вариант.Свойство("РазмерВМvCPU") Или Вариант.РазмерВМvCPU <= 0 Тогда
		ВызватьИсключение "Не задан корректный размер для " + ОписаниеВарианта;
	КонецЕсли;
	Если Не Вариант.Свойство("ЧислоАктивныхИсполнителей") Или Вариант.ЧислоАктивныхИсполнителей <= 0 Тогда
		ВызватьИсключение "Не задан активный параллелизм для " + ОписаниеВарианта;
	КонецЕсли;
	Если Не Вариант.Свойство("ИдентификаторСтенда") Или ПустаяСтрока(Вариант.ИдентификаторСтенда) Тогда
		ВызватьИсключение "Не задан идентификатор стенда для " + ОписаниеВарианта;
	КонецЕсли;
	Если Не Вариант.Свойство("ИдентификаторРазмещения") Или ПустаяСтрока(Вариант.ИдентификаторРазмещения) Тогда
		ВызватьИсключение "Не задано размещение для " + ОписаниеВарианта;
	КонецЕсли;
	Если Не Вариант.Свойство("ИдентификаторНагрузки") Или ПустаяСтрока(Вариант.ИдентификаторНагрузки) Тогда
		ВызватьИсключение "Не задан профиль нагрузки для " + ОписаниеВарианта;
	КонецЕсли;
	Если Не Вариант.Свойство("Наблюдения") Или Вариант.Наблюдения.Количество() < 3 Тогда
		ВызватьИсключение "Для каждого размера ВМ требуется не менее трех наблюдений";
	КонецЕсли;

	Для Каждого Наблюдение Из Вариант.Наблюдения Цикл
		Если Не Наблюдение.Свойство("CStopПроцент") Или Наблюдение.CStopПроцент < 0 Или Наблюдение.CStopПроцент > 100 Тогда
			ВызватьИсключение "Значение %CSTP должно быть в диапазоне 0..100";
		КонецЕсли;
		Если Не Наблюдение.Свойство("ReadyПроцент") Или Наблюдение.ReadyПроцент < 0 Или Наблюдение.ReadyПроцент > 100 Тогда
			ВызватьИсключение "Значение %RDY должно быть в диапазоне 0..100";
		КонецЕсли;
		Если Не Наблюдение.Свойство("РаботаВСекунду") Или Наблюдение.РаботаВСекунду <= 0 Тогда
			ВызватьИсключение "Полезная работа за секунду должна быть больше нуля";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция МедианаМетрики(Наблюдения, ИмяМетрики)

	Значения = Новый СписокЗначений;
	Для Каждого Наблюдение Из Наблюдения Цикл
		ЗначениеМетрики = 0;
		Если Не Наблюдение.Свойство(ИмяМетрики, ЗначениеМетрики) Тогда
			ВызватьИсключение "Наблюдение не содержит метрику " + ИмяМетрики;
		КонецЕсли;
		Значения.Добавить(ЗначениеМетрики);
	КонецЦикла;
	Значения.СортироватьПоЗначению();

	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	ЛеваяСередина = Число(Значения[Количество / 2 - 1].Значение);
	ПраваяСередина = Число(Значения[Количество / 2].Значение);
	Возврат (ЛеваяСередина + ПраваяСередина) / 2;

КонецФункции

#КонецОбласти
