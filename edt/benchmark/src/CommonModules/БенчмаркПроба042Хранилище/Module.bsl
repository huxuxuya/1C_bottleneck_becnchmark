// Принимает результаты fio 042, сохраняет точки кривой и строит сравнение прогонов.
// fio выполняется отдельным Linux-агентом; модуль 1С не запускает внешние команды.

#Область ПрограммныйИнтерфейс

// Импортирует JSON-пакет schema_version=1. Повтор того же пакета безопасен;
// другое содержимое под уже сохранённым ключом прогона и точки даёт конфликт.
Функция ИмпортироватьПакетJSON(Знач ТекстJSON) Экспорт

	Если ПустаяСтрока(ТекстJSON) Тогда
		ВызватьИсключение "JSON-пакет пробы 042 пуст";
	КонецЕсли;
	Если СтрДлина(ТекстJSON) > 50000000 Тогда
		ВызватьИсключение "JSON-пакет 042 превышает предельный размер 50 МБ";
	КонецЕсли;

	Конверт = ПрочитатьJSONИзСтроки(ТекстJSON);
	Если ТипЗнч(Конверт) <> Тип("Структура") Тогда
		ВызватьИсключение "Корень JSON-конверта должен быть объектом";
	КонецЕсли;
	ПроверитьНаличиеСвойств(Конверт, СтрРазделить("schema_version,payload_json,payload_sha256", ","));
	ПроверитьТипыПолей(Конверт, СтрРазделить("schema_version", ","), "Число");
	Если Конверт.schema_version <> 1 Тогда
		ВызватьИсключение "Неизвестная версия конверта пакета 042";
	КонецЕсли;
	ПроверитьТипыПолей(Конверт, СтрРазделить("payload_json,payload_sha256", ","), "Строка");
	Если ПустаяСтрока(Конверт.payload_json) Или СтрДлина(Конверт.payload_sha256) <> 64 Тогда
		ВызватьИсключение "Конверт не содержит полезную нагрузку и SHA-256";
	КонецЕсли;

	ХешПакета = ПолучитьSHA256СтрокиUTF8(Конверт.payload_json);
	Если ХешПакета <> НРег(Конверт.payload_sha256) Тогда
		ВызватьИсключение "SHA-256 полезной нагрузки не совпадает; пакет повреждён";
	КонецЕсли;
	Пакет = ПрочитатьJSONИзСтроки(Конверт.payload_json);

	ПроверитьПакет(Пакет);

	НачалоUTC = Пакет.started_at_utc;
	КонецUTC = Пакет.completed_at_utc;
	Окружение = Пакет.host;
	Параметры = Пакет.parameters;
	ПутьТома = ПолучитьСтроковоеПоле(Окружение, "mount_point", "неизвестно");
	ДеталиПараметров = СформироватьПараметры(Пакет);
	КлючСопоставимости = СформироватьКлючСопоставимости(Пакет);
	РезультатИмпорта = Новый Структура("ИдентификаторПрогона,Добавлено,Пропущено,Статус",
		Пакет.run_id, 0, 0, Пакет.status);

	НачатьТранзакцию();
	Попытка
		Для Каждого Точка Из Пакет.observations Цикл
			ПроверитьТочку(Точка);
			СуществующийХеш = ПолучитьХешТочки(Пакет.run_id, Точка.point_id);
			Если СуществующийХеш <> Неопределено Тогда
				Если СуществующийХеш <> ХешПакета Тогда
					ВызватьИсключение "Конфликт импорта: точка " + Точка.point_id
						+ " уже сохранена с другим хешем пакета";
				КонецЕсли;
				РезультатИмпорта.Пропущено = РезультатИмпорта.Пропущено + 1;
				Продолжить;
			КонецЕсли;

			Запись = РегистрыСведений.РезультатыПроб042.СоздатьМенеджерЗаписи();
			Запись.ИдентификаторПрогона = Пакет.run_id;
			Запись.ИдентификаторТочки = Точка.point_id;
			Запись.ЦелевойТемпЗаписиБайтВСекунду = Точка.target_write_rate_Bps;
			Запись.ФактическийТемпЗаписиБайтВСекунду = Точка.actual_write_rate_Bps;
			Запись.ОбъемЗаписиБайт = Точка.completed_write_bytes;
			Запись.ДлительностьОкнаНс = Точка.window_elapsed_ns;
			Запись.ДлительностьОкнаЗаписиНс = Точка.write_window_elapsed_ns;
			Запись.ЧтениеP50Нс = Точка.read_p50_ns;
			Запись.ЧтениеP95Нс = Точка.read_p95_ns;
			Запись.ЧтениеP99Нс = Точка.read_p99_ns;
			Запись.ЧтениеIOPS = Точка.read_iops;
			Запись.ЧтениеQD = Точка.read_qd_actual;
			Запись.SeedСлучайнойПоследовательности = Точка.random_seed;
			Запись.ОшибкиЧтения = Точка.read_errors;
			Запись.ОшибкиЗаписи = Точка.write_errors;
			Запись.НомерПовтора = Точка.repeat_no;
			Запись.Фаза = Точка.phase;
			Запись.Статус = Точка.status;
			Запись.ВерсияFio = Пакет.fio_version;
			Запись.ПутьТома = Лев(ПутьТома, 250);
			Запись.Параметры = ДеталиПараметров;
			Запись.ХешПакета = ХешПакета;
			Запись.Комментарий = Лев(Точка.message, 500);
			Запись.НачалоUTC = НачалоUTC;
			Запись.КонецUTC = КонецUTC;
			Запись.ИдентификаторРеализации = Пакет.implementation_id;
			Запись.КлючСопоставимости = КлючСопоставимости;
			Запись.Записать(Истина);
			РезультатИмпорта.Добавлено = РезультатИмпорта.Добавлено + 1;
		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат РезультатИмпорта;

КонецФункции

// Читает JSON-файл с файловой системы сервера 1С и импортирует его.
Функция ИмпортироватьПакетИзФайла(Знач ПутьКФайлу) Экспорт

	Если ПустаяСтрока(ПутьКФайлу) Тогда
		ВызватьИсключение "Не указан путь к JSON-пакету";
	КонецЕсли;

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ПутьКФайлу);
	Возврат ИмпортироватьПакетJSON(ТекстовыйДокумент.ПолучитьТекст());

КонецФункции

// Возвращает сохранённые baseline, pressure и recovery-точки одного прогона.
Функция ПолучитьТочкиПрогона(Знач ИдентификаторПрогона) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Результаты.ИдентификаторТочки КАК ИдентификаторТочки,
	|	Результаты.КлючСопоставимости КАК КлючСопоставимости,
	|	Результаты.НомерПовтора КАК НомерПовтора,
	|	Результаты.Фаза КАК Фаза,
	|	Результаты.Статус КАК Статус,
	|	Результаты.ЦелевойТемпЗаписиБайтВСекунду КАК ЦелевойТемпЗаписиБайтВСекунду,
	|	Результаты.ФактическийТемпЗаписиБайтВСекунду КАК ФактическийТемпЗаписиБайтВСекунду,
	|	Результаты.ОбъемЗаписиБайт КАК ОбъемЗаписиБайт,
	|	Результаты.ДлительностьОкнаНс КАК ДлительностьОкнаНс,
|	Результаты.ДлительностьОкнаЗаписиНс КАК ДлительностьОкнаЗаписиНс,
|	Результаты.SeedСлучайнойПоследовательности КАК SeedСлучайнойПоследовательности,
|	Результаты.ЧтениеP50Нс КАК ЧтениеP50Нс,
	|	Результаты.ЧтениеP95Нс КАК ЧтениеP95Нс,
	|	Результаты.ЧтениеP99Нс КАК ЧтениеP99Нс,
	|	Результаты.ЧтениеIOPS КАК ЧтениеIOPS,
	|	Результаты.ЧтениеQD КАК ЧтениеQD,
	|	Результаты.ОшибкиЧтения КАК ОшибкиЧтения,
	|	Результаты.ОшибкиЗаписи КАК ОшибкиЗаписи,
	|	Результаты.ПутьТома КАК ПутьТома,
	|	Результаты.Параметры КАК Параметры,
	|	Результаты.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.РезультатыПроб042 КАК Результаты
	|ГДЕ
	|	Результаты.ИдентификаторПрогона = &ИдентификаторПрогона
	|УПОРЯДОЧИТЬ ПО
	|	Результаты.НомерПовтора,
	|	Результаты.ЦелевойТемпЗаписиБайтВСекунду,
	|	Результаты.Фаза";
	Запрос.УстановитьПараметр("ИдентификаторПрогона", ИдентификаторПрогона);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Сопоставляет валидные pressure-точки совпадающих повторов и заданных темпов записи.
Функция СравнитьПрогоны(Знач ИдентификаторПрогонаA, Знач ИдентификаторПрогонаB) Экспорт

	ТочкиA = ПолучитьТочкиПрогона(ИдентификаторПрогонаA);
	ТочкиB = ПолучитьТочкиПрогона(ИдентификаторПрогонаB);
	ИндексB = Новый Соответствие;
	КлючСопоставимости = Неопределено;
	Для Каждого Точка Из ТочкиA Цикл
		Если Точка.Фаза = "pressure" Тогда
			Если КлючСопоставимости = Неопределено Тогда
				КлючСопоставимости = Точка.КлючСопоставимости;
			ИначеЕсли КлючСопоставимости <> Точка.КлючСопоставимости Тогда
				ВызватьИсключение "В прогоне A смешаны несовместимые параметры";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если КлючСопоставимости = Неопределено Тогда
		ВызватьИсключение "В прогоне A нет pressure-точек для сравнения";
	КонецЕсли;
	Для Каждого ТочкаB Из ТочкиB Цикл
		Если ТочкаB.Фаза = "pressure" Тогда
			Если КлючСопоставимости <> ТочкаB.КлючСопоставимости Тогда
				ВызватьИсключение "Параметры прогонов несовместимы; сравнение отклонено";
			КонецЕсли;
			ИндексB.Вставить(ТочкаB.ИдентификаторТочки, ТочкаB);
		КонецЕсли;
	КонецЦикла;

	Сравнение = Новый ТаблицаЗначений;
	Сравнение.Колонки.Добавить("ИдентификаторТочки");
	Сравнение.Колонки.Добавить("НомерПовтора");
	Сравнение.Колонки.Добавить("ЦелевойТемпБайтВСекунду");
	Сравнение.Колонки.Добавить("ФактическийТемпAБайтВСекунду");
	Сравнение.Колонки.Добавить("ФактическийТемпBБайтВСекунду");
	Сравнение.Колонки.Добавить("P95AНс");
	Сравнение.Колонки.Добавить("P95BНс");
	Сравнение.Колонки.Добавить("ИзменениеP95Процентов");
	Сравнение.Колонки.Добавить("СтатусA");
	Сравнение.Колонки.Добавить("СтатусB");

	Для Каждого ТочкаA Из ТочкиA Цикл
		Если ТочкаA.Фаза <> "pressure" Тогда
			Продолжить;
		КонецЕсли;

		ТочкаB = Неопределено;
		СтрокаСравнения = Сравнение.Добавить();
		СтрокаСравнения.ИдентификаторТочки = ТочкаA.ИдентификаторТочки;
		СтрокаСравнения.НомерПовтора = ТочкаA.НомерПовтора;
		СтрокаСравнения.ЦелевойТемпБайтВСекунду = ТочкаA.ЦелевойТемпЗаписиБайтВСекунду;
		СтрокаСравнения.ФактическийТемпAБайтВСекунду = ТочкаA.ФактическийТемпЗаписиБайтВСекунду;
		СтрокаСравнения.P95AНс = ТочкаA.ЧтениеP95Нс;
		СтрокаСравнения.СтатусA = ТочкаA.Статус;

		Если Не ИндексB.СодержитКлюч(ТочкаA.ИдентификаторТочки) Тогда
			СтрокаСравнения.СтатусB = "нет пары";
			Продолжить;
		КонецЕсли;
		ТочкаB = ИндексB.Получить(ТочкаA.ИдентификаторТочки);

		СтрокаСравнения.ФактическийТемпBБайтВСекунду = ТочкаB.ФактическийТемпЗаписиБайтВСекунду;
		СтрокаСравнения.P95BНс = ТочкаB.ЧтениеP95Нс;
		СтрокаСравнения.СтатусB = ТочкаB.Статус;
		Если ТочкаA.Статус = "valid" И ТочкаB.Статус = "valid" Тогда
			СтрокаСравнения.ИзменениеP95Процентов =
				Окр((ТочкаB.ЧтениеP95Нс / ТочкаA.ЧтениеP95Нс - 1) * 100, 2);
		КонецЕсли;
	КонецЦикла;

	Возврат Сравнение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПакет(Пакет)

	Если ТипЗнч(Пакет) <> Тип("Структура") Тогда
		ВызватьИсключение "Корень JSON-пакета должен быть объектом";
	КонецЕсли;
	ПроверитьНаличиеСвойств(Пакет, СтрРазделить("schema_version,probe_id,implementation_id,run_id,started_at_utc,completed_at_utc,fio_version,host,parameters,observations,status,message", ","));
	ПроверитьТипыПолей(Пакет, СтрРазделить("schema_version", ","), "Число");
	ПроверитьТипыПолей(Пакет, СтрРазделить("probe_id,implementation_id,run_id,started_at_utc,completed_at_utc,fio_version,status,message", ","), "Строка");
	Если Пакет.schema_version <> 1 Или Пакет.probe_id <> "042" Тогда
		ВызватьИсключение "Неподдерживаемая схема или идентификатор пробы";
	КонецЕсли;
	Если Пакет.implementation_id <> "fio-linux-psync-v1" Тогда
		ВызватьИсключение "Неподдерживаемый исполнитель пробы 042";
	КонецЕсли;
	Если ПустаяСтрока(Пакет.run_id) Или СтрДлина(Пакет.run_id) > 36 Тогда
		ВызватьИсключение "Некорректный идентификатор прогона";
	КонецЕсли;
	Если ПустаяСтрока(Пакет.fio_version) Или СтрДлина(Пакет.fio_version) > 64 Тогда
		ВызватьИсключение "Некорректная версия fio";
	КонецЕсли;
	Если ТипЗнч(Пакет.started_at_utc) <> Тип("Строка") Или СтрДлина(Пакет.started_at_utc) > 32
		Или ТипЗнч(Пакет.completed_at_utc) <> Тип("Строка") Или СтрДлина(Пакет.completed_at_utc) > 32 Тогда
		ВызватьИсключение "Временные метки должны быть строками до 32 символов";
	КонецЕсли;
	Если ТипЗнч(Пакет.host) <> Тип("Структура") Или ТипЗнч(Пакет.parameters) <> Тип("Структура") Тогда
		ВызватьИсключение "Снимки host и parameters должны быть объектами";
	КонецЕсли;
	ПроверитьНаличиеСвойств(Пакет.host, СтрРазделить("hostname,kernel_release,platform,mount_point,filesystem,device", ","));
	ПроверитьТипыПолей(Пакет.host, СтрРазделить("hostname,kernel_release,platform,mount_point,filesystem,device", ","), "Строка");
	ПроверитьНаличиеСвойств(Пакет.parameters, СтрРазделить("work_dir,filesystem_device,file_size_bytes,read_block_bytes,write_block_bytes,read_qd_requested,read_qd_actual,ioengine,direct,duration_seconds,ramp_seconds,setup_timeout_seconds,repeats,write_rate_targets_MiB_s,generated_files_removed", ","));
	ПроверитьТипыПолей(Пакет.parameters, СтрРазделить("work_dir,filesystem_device,ioengine", ","), "Строка");
	ПроверитьТипыПолей(Пакет.parameters, СтрРазделить("direct,generated_files_removed", ","), "Булево");
	ПроверитьПараметры(Пакет.parameters);
	Если Пакет.status <> "complete" И Пакет.status <> "partial" Тогда
		ВызватьИсключение "Импортировать можно только complete или partial пакет";
	КонецЕсли;
	Если ТипЗнч(Пакет.observations) <> Тип("Массив") Тогда
		ВызватьИсключение "Поле observations должно быть массивом";
	КонецЕсли;
	Если Пакет.observations.Количество() = 0 Тогда
		ВызватьИсключение "Пакет не содержит измерительных точек";
	КонецЕсли;

	КлючиТочек = Новый Соответствие;
	Для Каждого Точка Из Пакет.observations Цикл
		ПроверитьТочку(Точка);
		Если КлючиТочек.СодержитКлюч(Точка.point_id) Тогда
			ВызватьИсключение "Пакет содержит повторяющийся идентификатор точки " + Точка.point_id;
		КонецЕсли;
		КлючиТочек.Вставить(Точка.point_id, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьТочку(Точка)

	Если ТипЗнч(Точка) <> Тип("Структура") Тогда
		ВызватьИсключение "Наблюдение должно быть JSON-объектом";
	КонецЕсли;
	ПроверитьНаличиеСвойств(Точка, СтрРазделить("point_id,repeat_no,phase,random_seed,target_write_rate_Bps,completed_write_bytes,window_elapsed_ns,write_window_elapsed_ns,actual_write_rate_Bps,read_p50_ns,read_p95_ns,read_p99_ns,read_iops,read_qd_actual,read_errors,write_errors,status,message", ","));
	ПроверитьТипыПолей(Точка, СтрРазделить("point_id,phase,status,message", ","), "Строка");
	ПроверитьТипыПолей(Точка, СтрРазделить("repeat_no,random_seed,target_write_rate_Bps,completed_write_bytes,window_elapsed_ns,write_window_elapsed_ns,actual_write_rate_Bps,read_p50_ns,read_p95_ns,read_p99_ns,read_iops,read_qd_actual,read_errors,write_errors", ","), "Число");
	Если ПустаяСтрока(Точка.point_id) Или СтрДлина(Точка.point_id) > 50 Тогда
		ВызватьИсключение "Некорректный идентификатор точки";
	КонецЕсли;
	Если Точка.repeat_no < 1 Или Точка.random_seed < 0 Или Точка.random_seed > 2147483647 Тогда
		ВызватьИсключение "Номер повтора или seed вне допустимого диапазона";
	КонецЕсли;
	Если Точка.phase <> "baseline" И Точка.phase <> "pressure" И Точка.phase <> "recovery" Тогда
		ВызватьИсключение "Неизвестная фаза пробы 042";
	КонецЕсли;
	Если Точка.status <> "valid" И Точка.status <> "error" Тогда
		ВызватьИсключение "Неизвестный статус измерительной точки";
	КонецЕсли;
	Если Точка.target_write_rate_Bps < 0 Или Точка.actual_write_rate_Bps < 0
		Или Точка.completed_write_bytes < 0 Или Точка.window_elapsed_ns < 0 Или Точка.write_window_elapsed_ns < 0
		Или Точка.read_p50_ns < 0 Или Точка.read_p95_ns < 0 Или Точка.read_p99_ns < 0
		Или Точка.read_iops < 0 Или Точка.read_qd_actual < 0
		Или Точка.read_errors < 0 Или Точка.write_errors < 0 Тогда
		ВызватьИсключение "Метрики пробы не могут быть отрицательными";
	КонецЕсли;

	Если Точка.status = "valid" Тогда
		Если Точка.window_elapsed_ns <= 0 Или Точка.read_p50_ns <= 0
			Или Точка.read_p95_ns < Точка.read_p50_ns Или Точка.read_p99_ns < Точка.read_p95_ns
			Или Точка.read_qd_actual <> 1 Или Точка.read_errors <> 0 Или Точка.write_errors <> 0 Тогда
			ВызватьИсключение "Точка помечена valid, но не проходит проверки длительности, квантилей, QD=1 или ошибок";
		КонецЕсли;
		Если Точка.phase = "pressure" И (Точка.completed_write_bytes <= 0
			Или Точка.actual_write_rate_Bps <= 0 Или Точка.window_elapsed_ns <= 0
			Или Точка.write_window_elapsed_ns <= 0) Тогда
			ВызватьИсключение "Pressure-точка не содержит завершённой фоновой записи";
		КонецЕсли;
		Если Точка.phase <> "pressure" И (Точка.completed_write_bytes <> 0
			Или Точка.actual_write_rate_Bps <> 0 Или Точка.write_window_elapsed_ns <> 0) Тогда
			ВызватьИсключение "Baseline/recovery-точки не должны содержать запись";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьНаличиеСвойств(Данные, ИменаСвойств)

	Для Каждого ИмяСвойства Из ИменаСвойств Цикл
		Если Не Данные.Свойство(ИмяСвойства) Тогда
			ВызватьИсключение "JSON не содержит обязательное поле " + ИмяСвойства;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьТипыПолей(Данные, ИменаПолей, ИмяТипа)

	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЗначениеПоля = Неопределено;
		Данные.Свойство(ИмяПоля, ЗначениеПоля);
		Если ТипЗнч(ЗначениеПоля) <> Тип(ИмяТипа) Тогда
			ВызватьИсключение "Поле " + ИмяПоля + " должно иметь тип " + ИмяТипа;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПараметры(Параметры)

	ПроверитьТипыПолей(Параметры, СтрРазделить("file_size_bytes,read_block_bytes,write_block_bytes,read_qd_requested,read_qd_actual,duration_seconds,ramp_seconds,setup_timeout_seconds,repeats", ","), "Число");
	Если ТипЗнч(Параметры.ioengine) <> Тип("Строка") Тогда
		ВызватьИсключение "ioengine должен быть строкой";
	КонецЕсли;
	Если ТипЗнч(Параметры.direct) <> Тип("Булево") Или ТипЗнч(Параметры.generated_files_removed) <> Тип("Булево") Тогда
		ВызватьИсключение "Флаги параметров должны иметь тип Булево";
	КонецЕсли;
	ПроверитьТипыПолей(Параметры, СтрРазделить("work_dir,filesystem_device", ","), "Строка");
	Если Параметры.ioengine <> "psync" Или Не Параметры.direct
		Или Параметры.file_size_bytes <= 0 Или Параметры.read_block_bytes <= 0
		Или Параметры.write_block_bytes <= 0 Или Параметры.read_qd_requested <> 1
		Или Параметры.read_qd_actual <> 1 Или Параметры.duration_seconds < 2
		Или Параметры.ramp_seconds < 0 Или Параметры.ramp_seconds >= Параметры.duration_seconds
		Или Параметры.setup_timeout_seconds < 1 Или Параметры.repeats < 3 Тогда
		ВызватьИсключение "Параметры пробы не соответствуют методике fio-linux-psync-v1";
	КонецЕсли;
	Если ТипЗнч(Параметры.write_rate_targets_MiB_s) <> Тип("Массив") Тогда
		ВызватьИсключение "write_rate_targets_MiB_s должен быть массивом";
	КонецЕсли;
	Если Параметры.write_rate_targets_MiB_s.Количество() = 0 Тогда
		ВызватьИсключение "В пакете нет ступеней записи";
	КонецЕсли;
	КлючиСкоростей = Новый Соответствие;
	Для Каждого Скорость Из Параметры.write_rate_targets_MiB_s Цикл
		Если ТипЗнч(Скорость) <> Тип("Число") Тогда
			ВызватьИсключение "Ступень записи должна быть числом";
		КонецЕсли;
		Если Скорость <= 0 Или КлючиСкоростей.СодержитКлюч(Скорость) Тогда
			ВызватьИсключение "Ступени записи должны быть положительными и уникальными";
		КонецЕсли;
		КлючиСкоростей.Вставить(Скорость, Истина);
	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьJSONИзСтроки(ТекстJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	РезультатJSON = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат РезультатJSON;

КонецФункции

Функция ПолучитьSHA256СтрокиUTF8(Знач СтрокаДанных)

	ДвоичныеДанныеUTF8 = ПолучитьДвоичныеДанныеИзСтроки(СтрокаДанных, КодировкаТекста.UTF8);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ДвоичныеДанныеUTF8);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

Функция СформироватьКлючСопоставимости(Пакет)

	Параметры = Пакет.parameters;
	Ключ = "fio=" + Пакет.fio_version
		+ ";engine=" + Строка(Параметры.ioengine)
		+ ";direct=" + ?(Параметры.direct, "1", "0")
		+ ";file=" + Строка(Параметры.file_size_bytes)
		+ ";read_block=" + Строка(Параметры.read_block_bytes)
		+ ";write_block=" + Строка(Параметры.write_block_bytes)
		+ ";read_qd=" + Строка(Параметры.read_qd_actual)
		+ ";duration=" + Строка(Параметры.duration_seconds)
		+ ";ramp=" + Строка(Параметры.ramp_seconds);
	Возврат Лев(Ключ, 250);

КонецФункции

Функция ПолучитьХешТочки(ИдентификаторПрогона, ИдентификаторТочки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Результаты.ХешПакета КАК ХешПакета
	|ИЗ
	|	РегистрСведений.РезультатыПроб042 КАК Результаты
	|ГДЕ
	|	Результаты.ИдентификаторПрогона = &ИдентификаторПрогона
	|	И Результаты.ИдентификаторТочки = &ИдентификаторТочки";
	Запрос.УстановитьПараметр("ИдентификаторПрогона", ИдентификаторПрогона);
	Запрос.УстановитьПараметр("ИдентификаторТочки", ИдентификаторТочки);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ХешПакета;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ПолучитьСтроковоеПоле(Данные, ИмяПоля, ЗначениеПоУмолчанию)

	ЗначениеПоля = ЗначениеПоУмолчанию;
	Если Данные.Свойство(ИмяПоля, ЗначениеПоля) И Не ПустаяСтрока(Строка(ЗначениеПоля)) Тогда
		Возврат Строка(ЗначениеПоля);
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция СформироватьПараметры(Пакет)

	Параметры = Пакет.parameters;
	Окружение = Пакет.host;
	Текст = "host=" + Лев(Окружение.hostname, 50)
		+ "; kernel=" + Лев(Окружение.kernel_release, 50)
		+ "; platform=" + Лев(Окружение.platform, 60)
		+ "; mount=" + Лев(Окружение.mount_point, 100)
		+ "; fs=" + Лев(Окружение.filesystem, 20)
		+ "; device=" + Лев(Окружение.device, 60)
		+ "; block=" + Строка(Параметры.read_block_bytes) + "B/"
		+ Строка(Параметры.write_block_bytes) + "B"
		+ "; direct=" + ?(Параметры.direct, "1", "0")
		+ "; file=" + Строка(Параметры.file_size_bytes) + "B"
		+ "; engine=" + Строка(Параметры.ioengine);
	Возврат Лев(Текст, 500);

КонецФункции

#КонецОбласти
