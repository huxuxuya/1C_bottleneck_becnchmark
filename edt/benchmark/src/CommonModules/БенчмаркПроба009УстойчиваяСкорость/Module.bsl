#Область ПрограммныйИнтерфейс

// Оценивает изменение длительности одинаковых BSL-порций в последовательной серии.
// Параметры:
//  ЧислоСерий - Число - число повторов (> 0).
//  ИтерацийВСерии - Число - итерации в одном повторе (> 0).
// Возвращаемое значение:
//  Структура: медиана, длительности первого и последнего повторов,
//  их изменение в процентах, контрольная сумма и детали.
Функция Проба009_УстойчиваяСкорость(Знач ЧислоСерий = 5, Знач ИтерацийВСерии = 20000) Экспорт

	Если ЧислоСерий <= 0 Или ИтерацийВСерии <= 0 Тогда
		ВызватьИсключение "Некорректные параметры Пробы 009";
	КонецЕсли;

	Длительности = Новый СписокЗначений;
	ДлительностиПоСериям = Новый Массив;
	КонтрольнаяСумма = 0;
	Для НомерСерии = 1 По ЧислоСерий Цикл
		Замер = БенчмаркПробы.ПробаОдинПотокBSL(ИтерацийВСерии);
		Длительности.Добавить(Замер.ДлительностьМс);
		ДлительностиПоСериям.Добавить(Замер.ДлительностьМс);
		КонтрольнаяСумма = КонтрольнаяСумма + Замер.КонтрольнаяСумма;
	КонецЦикла;
	Длительности.СортироватьПоЗначению();

	ПерваяДлительность = ДлительностиПоСериям[0];
	ПоследняяДлительность = ДлительностиПоСериям[ЧислоСерий - 1];
	Результат = Новый Структура;
	Результат.Вставить("МедианаМс", Число(Длительности[Цел((ЧислоСерий - 1) / 2)].Значение));
	Результат.Вставить("ПерваяМс", ПерваяДлительность);
	Результат.Вставить("ПоследняяМс", ПоследняяДлительность);
	Результат.Вставить("ИзменениеПроцентов", ?(ПерваяДлительность = 0, 0,
		((ПоследняяДлительность - ПерваяДлительность) / ПерваяДлительность) * 100));
	Результат.Вставить("КонтрольнаяСумма", КонтрольнаяСумма);
	Результат.Вставить("Детали", "Устойчивость скорости BSL; температура и предел мощности требуют внешних датчиков");
	Возврат Результат;

КонецФункции

#КонецОбласти
