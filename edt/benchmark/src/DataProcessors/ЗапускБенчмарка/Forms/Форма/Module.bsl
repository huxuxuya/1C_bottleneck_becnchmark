#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	МасштабНагрузки = 1;
	ТочкиПроб042.Очистить();
	Результаты.Очистить();
	ФильтрЗвена = "";
	ФильтрРесурса = "";
	ИнициализироватьСпискиФильтров();
	ПокрытиеПоЗвеньям.Очистить();
	ИдентификаторПрогона = "";

	Попытка
		ИдентификаторПрогона = БенчмаркРаннер.ПолучитьПоследнийИдентификаторПрогона();
		Если Не ПустаяСтрока(ИдентификаторПрогона) Тогда
			ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);
			ОбновитьСводкуПоРезультатамНаСервере();
		КонецЕсли;
	Исключение
		Сообщить("Не удалось загрузить сохранённые результаты: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьПрогон(Команда) Экспорт

	Попытка
		ВыполнитьПрогонНаСервере();
		Попытка
			Результат027 = ИзмеритьБазовуюЦенуСерверногоВызова();
			СохранитьРезультат027НаСервере(ИдентификаторПрогона, Результат027);
			ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);
		Исключение
			Сообщить("Не удалось измерить или сохранить базовую цену серверного вызова: "
				+ ОписаниеОшибки());
		КонецПопытки;
	Исключение
		Сообщить("Не удалось выполнить бенчмарк: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФильтрРезультатов(Команда) Экспорт

	ОтборСтрок = Новый Структура;
	Если Не ПустаяСтрока(ФильтрЗвена) Тогда
		ОтборСтрок.Вставить("Звено", ФильтрЗвена);
	КонецЕсли;
	Если Не ПустаяСтрока(ФильтрРесурса) Тогда
		ОтборСтрок.Вставить("Ресурс", ФильтрРесурса);
	КонецЕсли;
	Элементы.ТаблицаРезультатов.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВсеДиагностикиBSL(Команда) Экспорт

	Попытка
		ИтогДиагностик = ВыполнитьВсеДиагностикиBSLНаСервере();
		ИдентификаторПрогона = ИтогДиагностик.ИдентификаторПрогона;
		Сообщить("Диагностик: " + Строка(ИтогДиагностик.КоличествоПроверок)
			+ "; измерено: " + Строка(ИтогДиагностик.КоличествоИзмерений)
			+ "; недоступно в BSL: " + Строка(ИтогДиагностик.КоличествоНедоступных)
			+ "; ошибок: " + Строка(ИтогДиагностик.КоличествоОшибок));
	Исключение
		Сообщить("Пакет диагностик завершился ошибкой: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПробу042(Команда) Экспорт

	Попытка
		ИтогПроб = ВыполнитьПробу042НаСервере();
		ИдентификаторПрогона042 = ИтогПроб.ИдентификаторПрогона;
		ПутьВременногоФайла042 = ИтогПроб.ПутьФайла;
		ЗагрузитьТочкиПроб042НаСервере(ИдентификаторПрогона042);
		ТекстИтога = "Сохранено результатов: " + Строка(ИтогПроб.КоличествоТочек)
			+ "; ошибок измерения: " + Строка(ИтогПроб.КоличествоОшибок);
		Если Не ПустаяСтрока(ИтогПроб.ОшибкаОчистки) Тогда
			ТекстИтога = ТекстИтога + "; не удалось удалить временный файл: " + ИтогПроб.ОшибкаОчистки;
		КонецЕсли;
		Сообщить(ТекстИтога);
	Исключение
		Сообщить("Проба 042 завершилась ошибкой: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьНативнуюПробуCPU(Команда) Экспорт

	Если НативнаяПробаCPUВыполняется = Истина Тогда
		Возврат;
	КонецЕсли;

	РежимНативнойПробыCPU = "частота";
	ОшибкаУстановкиНативнойПробыCPU = "";
	НативнаяПробаCPUВыполняется = Истина;
	Элементы.КнопкаВыполнитьНативнуюПробуCPU.Доступность = Ложь;
	Элементы.КнопкаВыполнитьНативныеДиагностикиCPU.Доступность = Ложь;

	Если ОбъектНативнойПробыCPU <> Неопределено Тогда
		Если РежимНативнойПробыCPU = "диагностики" Тогда
			НачатьВыполнениеНативныхДиагностикCPU();
		Иначе
			НачатьИзмерениеНативнойПробыCPU();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	НачатьПодключениеНативнойПробыCPU(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьНативныеДиагностикиCPU(Команда) Экспорт

	Если НативнаяПробаCPUВыполняется = Истина Тогда
		Возврат;
	КонецЕсли;

	РежимНативнойПробыCPU = "диагностики";
	ОшибкаУстановкиНативнойПробыCPU = "";
	НативнаяПробаCPUВыполняется = Истина;
	Элементы.КнопкаВыполнитьНативнуюПробуCPU.Доступность = Ложь;
	Элементы.КнопкаВыполнитьНативныеДиагностикиCPU.Доступность = Ложь;

	Если ОбъектНативнойПробыCPU <> Неопределено Тогда
		НачатьВыполнениеНативныхДиагностикCPU();
	Иначе
		НачатьПодключениеНативнойПробыCPU(Ложь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


// Проба 027: измеряет пустые обращения к серверу без формы и SQL.
&НаКлиенте
Функция ИзмеритьБазовуюЦенуСерверногоВызова(Знач ЧислоПрогревов = 3,
	Знач ЧислоСерий = 5, Знач ВызововВСерии = 20) Экспорт

	Если ЧислоПрогревов < 0 Или ЧислоСерий < 3 Или ВызововВСерии <= 0 Тогда
		ВызватьИсключение "Для пробы 027 нужны прогревы >= 0, минимум три серии и положительное число вызовов";
	КонецЕсли;

	Для Индекс = 1 По ЧислоПрогревов Цикл
		БенчмаркПроба027БазоваяЦенаСерверногоВызова.ПустойОбработчикБезКонтекста();
	КонецЦикла;

	Наблюдения = Новый Массив;
	ДатаНачалаИзмеренияUTC = Неопределено;
	ДатаЗавершенияИзмеренияUTC = Неопределено;
	Для Серия = 1 По ЧислоСерий Цикл
		ДатаНачалаСерииUTC = ПолучитьТекущуюУниверсальнуюДату();
		НачалоКлиентаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		СуммаОбработчикаМс = 0;
		Для Индекс = 1 По ВызововВСерии Цикл
			СуммаОбработчикаМс = СуммаОбработчикаМс
				+ БенчмаркПроба027БазоваяЦенаСерверногоВызова.ПустойОбработчикБезКонтекста();
		КонецЦикла;
		ДлительностьКлиентаМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоКлиентаМс;
		ДатаОкончанияСерииUTC = ПолучитьТекущуюУниверсальнуюДату();
		Если Серия = 1 Тогда
			ДатаНачалаИзмеренияUTC = ДатаНачалаСерииUTC;
		КонецЕсли;
		ДатаЗавершенияИзмеренияUTC = ДатаОкончанияСерииUTC;
		Наблюдения.Добавить(Новый Структура(
			"ЧислоВызовов,RTTНс,ВремяОбработчикаНс,ДатаНачалаUTC,ДатаЗавершенияUTC",
			ВызововВСерии, ДлительностьКлиентаМс * 1000000 / ВызововВСерии,
			СуммаОбработчикаМс * 1000000 / ВызововВСерии,
			ДатаНачалаСерииUTC, ДатаОкончанияСерииUTC));
	КонецЦикла;

	Результат = БенчмаркПроба027БазоваяЦенаСерверногоВызова.АнализироватьНаблюдения(Наблюдения);
	Результат.Вставить("Наблюдения", Наблюдения);
	Результат.Вставить("ДатаНачалаUTC", ДатаНачалаИзмеренияUTC);
	Результат.Вставить("ДатаЗавершенияUTC", ДатаЗавершенияИзмеренияUTC);
	Возврат Результат;

КонецФункции

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьТекущуюУниверсальнуюДату()

	Возврат ТекущаяУниверсальнаяДата();

КонецФункции

&НаСервере
Процедура ВыполнитьПрогонНаСервере()

	МасштабЗапуска = ?(МасштабНагрузки > 0, МасштабНагрузки, 1);
	ИдентификаторПрогона = Строка(Новый УникальныйИдентификатор);

	Попытка
		Итог = БенчмаркРаннер.ВыполнитьПолныйПрогон(ИдентификаторПрогона, МасштабЗапуска);
		ОбщийБалл = Итог.ОбщийБалл;
		ГлавноеУзкоеМесто = Итог.ГлавноеУзкоеМесто;
		ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);
		Если Результаты.Количество() = 0 Тогда
			ВызватьИсключение "Прогон завершился, но записи не найдены в регистре РезультатыПрогонов";
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		КоличествоСохраненныхСтрок = 0;
		Попытка
			ТаблицаЧастичныхРезультатов = БенчмаркРаннер.ПолучитьРезультатыПрогона(ИдентификаторПрогона);
			КоличествоСохраненныхСтрок = ТаблицаЧастичныхРезультатов.Количество();
			Если КоличествоСохраненныхСтрок > 0 Тогда
				ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогона);
				ОбщийБалл = 0;
				ГлавноеУзкоеМесто = "Прогон прерван; сводный индекс не рассчитан";
			КонецЕсли;
		Исключение
			// Сохраняем исходную ошибку прогона, даже если не удалось прочитать частичный результат.
		КонецПопытки;
		Попытка
			СсылкаНаПрогон = БенчмаркХранилищеПрогонов.ПолучитьСсылкуПрогона(ИдентификаторПрогона);
			БенчмаркХранилищеПрогонов.ЗавершитьПрогон(СсылкаНаПрогон,
				"Частично завершён", ТекстОшибки);
		Исключение
			// Первичную ошибку прогона сохраняем, даже если статус документа обновить не удалось.
		КонецПопытки;
		Сообщить("Прогон прерван: " + ТекстОшибки
			+ "; сохранено строк результатов: " + Строка(КоличествоСохраненныхСтрок));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СохранитьРезультат027НаСервере(ИдентификаторПрогона, Результат) Экспорт

	СсылкаНаПрогон = БенчмаркХранилищеПрогонов.ПолучитьСсылкуПрогона(ИдентификаторПрогона);
	Если Не ЗначениеЗаполнено(СсылкаНаПрогон) Тогда
		Возврат;
	КонецЕсли;

	Для НомерСерии = 1 По Результат.Наблюдения.Количество() Цикл
		Наблюдение = Результат.Наблюдения[НомерСерии - 1];
		ДеталиСерии = Результат.Детали + "; series=" + Строка(НомерСерии)
			+ "; calls=" + Строка(Наблюдение.ЧислоВызовов);
		СтатусRTT = ?(Наблюдение.RTTНс > 0, "успешно", "Недостаточно разрешения таймера");
		ПричинаRTT = ?(Наблюдение.RTTНс > 0, "",
			"Интервал серии не превысил миллисекундное разрешение часов клиента");
		СтатусОбработчика = ?(Наблюдение.ВремяОбработчикаНс > 0,
			"успешно", "Недостаточно разрешения таймера");
		ПричинаОбработчика = ?(Наблюдение.ВремяОбработчикаНс > 0, "",
			"Время обработчика за серию не превысило миллисекундное разрешение часов сервера");
		БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
			СсылкаНаПрогон, "CLIENT_SERVER_BASELINE", "1c.empty_handler.series_mean_ns", "027",
			"027. Время пустого обработчика по серии", Наблюдение.ВремяОбработчикаНс,
			"нс/вызов", СтатусОбработчика, ПричинаОбработчика,
			Наблюдение.ДатаНачалаUTC, Наблюдение.ДатаЗавершенияUTC, 0, ДеталиСерии,
			"server.empty_handler", "сервер 1С", "BSL-таймер",
			"пустой серверный обработчик", 1, НомерСерии, 1, "измерение", Наблюдение.ЧислоВызовов,
			Наблюдение.ВремяОбработчикаНс * Наблюдение.ЧислоВызовов, Наблюдение.ЧислоВызовов);

		БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
			СсылкаНаПрогон, "CLIENT_SERVER_BASELINE", "net.small_rtt.series_mean_ns", "027",
			"027. RTT пустого серверного вызова по серии", Наблюдение.RTTНс,
			"нс/вызов", СтатусRTT, ПричинаRTT,
			Наблюдение.ДатаНачалаUTC, Наблюдение.ДатаЗавершенияUTC, 0, ДеталиСерии,
			"client.server.rtt", "клиент 1С", "Клиентские часы 1мс",
			"RTT вызова", 1, НомерСерии, 1, "измерение", Наблюдение.ЧислоВызовов,
			Наблюдение.RTTНс * Наблюдение.ЧислоВызовов, Наблюдение.ЧислоВызовов);
	КонецЦикла;

	СтатусRTT = ?(Результат.МедианаRTTНаВызовНс > 0,
		"успешно", "Недостаточно разрешения таймера");
	ПричинаRTT = ?(Результат.МедианаRTTНаВызовНс > 0, "",
		"Медианный интервал не превысил миллисекундное разрешение часов клиента");
	СтатусОбработчика = ?(Результат.МедианаОбработчикаНаВызовНс > 0,
		"успешно", "Недостаточно разрешения таймера");
	ПричинаОбработчика = ?(Результат.МедианаОбработчикаНаВызовНс > 0, "",
		"Медианное время обработчика не превысило миллисекундное разрешение часов сервера");
	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
		СсылкаНаПрогон, "CLIENT_SERVER_BASELINE", "1c.empty_handler.median_ns", "027",
		"027. Медианное время пустого обработчика",
		Результат.МедианаОбработчикаНаВызовНс, "нс/вызов", СтатусОбработчика, ПричинаОбработчика,
		Результат.ДатаНачалаUTC, Результат.ДатаЗавершенияUTC, 0, Результат.Детали,
		"server.empty_handler", "сервер 1С", "BSL-таймер",
		"пустой серверный обработчик", 1, 1, 1, "измерение",
		Результат.ЧислоСерий, 0, 0, "медиана");
	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
		СсылкаНаПрогон, "CLIENT_SERVER_BASELINE", "net.small_rtt.median_ns", "027",
		"027. Медианный клиентский RTT пустого серверного вызова",
		Результат.МедианаRTTНаВызовНс, "нс/вызов", СтатусRTT, ПричинаRTT,
		Результат.ДатаНачалаUTC, Результат.ДатаЗавершенияUTC, 0, Результат.Детали,
		"client.server.rtt", "клиент 1С", "клиент-серверный вызов",
		"RTT пустого серверного вызова", 1, 1, 1, "измерение",
		Результат.ЧислоСерий, 0, 0, "медиана");

	ЗаписатьПредставлениеПоказателя027(ИдентификаторПрогона, "027_RTT",
		"027. Клиентский RTT пустого серверного вызова",
		Результат.МедианаRTTНаВызовНс, "нс/вызов", Результат.Детали,
		Результат.ДатаНачалаUTC);
	ЗаписатьПредставлениеПоказателя027(ИдентификаторПрогона, "027_HANDLER",
		"027. Время пустого серверного обработчика",
		Результат.МедианаОбработчикаНаВызовНс, "нс/вызов", Результат.Детали,
		Результат.ДатаНачалаUTC);

	ДокументПрогона = СсылкаНаПрогон.ПолучитьОбъект();
	ДокументПрогона.ДатаЗавершенияUTC = ТекущаяУниверсальнаяДата();
	ДокументПрогона.Записать();

КонецПроцедуры

&НаСервере
Процедура ЗаписатьПредставлениеПоказателя027(ИдентификаторПрогона, КодСтроки,
	Название, Значение, Единица, Детали, ДатаПрогона)

	Менеджер = РегистрыСведений.РезультатыПрогонов.СоздатьМенеджерЗаписи();
	Менеджер.ИдентификаторПрогона = ИдентификаторПрогона;
	Менеджер.КодПробы = КодСтроки;
	Менеджер.ДатаПрогона = ДатаПрогона;
	Менеджер.НаименованиеПробы = Название;
	Менеджер.ЗначениеМетрики = Значение;
	Менеджер.ЦелевоеЗначение = 0;
	Менеджер.ЕдиницаИзмерения = Единица;
	Менеджер.Баллы = 0;
	Менеджер.Индекс = 0;
	Менеджер.Статус = "Контекст";
	Менеджер.КонтрольнаяСумма = 0;
	Менеджер.Детали = Лев(Детали, 500);
	Менеджер.Записать(Истина);

КонецПроцедуры

