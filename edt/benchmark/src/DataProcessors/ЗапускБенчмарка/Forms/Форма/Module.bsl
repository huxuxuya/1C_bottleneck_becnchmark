&НаКлиенте
Процедура НачатьПодключениеНативнойПробыCPU(УстановкаУжеВыполнялась)

	Попытка
		Если ПроверитьПодключениеВнешнейКомпоненты(
			"ОбщийМакет.CpuFrequencyProbe",
			"CpuFrequencyProbe") Тогда
			ПослеПодключенияНативнойПробыCPU(Истина, УстановкаУжеВыполнялась);
			Возврат;
		КонецЕсли;

		Оповещение = Новый ОписаниеОповещения(
			"ПослеПодключенияНативнойПробыCPU",
			ЭтаФорма,
			УстановкаУжеВыполнялась,
			"ПриОшибкеПодключенияНативнойПробыCPU",
			ЭтаФорма);
		НачатьПодключениеВнешнейКомпоненты(
			Оповещение,
			"ОбщийМакет.CpuFrequencyProbe",
			"CpuFrequencyProbe",
			ТипВнешнейКомпоненты.Native);
	Исключение
		Если УстановкаУжеВыполнялась Тогда
			Сообщить("Не удалось подключить нативную пробу CPU: " + ОписаниеОшибки());
			ЗавершитьНативнуюПробуCPU();
		Иначе
			НачатьУстановкуНативнойПробыCPU();
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияНативнойПробыCPU(Подключена, УстановкаУжеВыполнялась) Экспорт

	Если Не Подключена Тогда
		Если УстановкаУжеВыполнялась Тогда
			Если ПустаяСтрока(ОшибкаУстановкиНативнойПробыCPU) Тогда
				Сообщить("Нативная проба CPU не поддерживается этой платформой или разрядностью клиента.");
			Иначе
				Сообщить("Не удалось подключить или установить нативную пробу CPU: "
					+ ОшибкаУстановкиНативнойПробыCPU);
			КонецЕсли;
			ЗавершитьНативнуюПробуCPU();
		Иначе
			НачатьУстановкуНативнойПробыCPU();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Попытка
		ОбъектНативнойПробыCPU = Новый("AddIn.CpuFrequencyProbe.CpuProbe");
		Если РежимНативнойПробыCPU = "диагностики" Тогда
			НачатьВыполнениеНативныхДиагностикCPU();
		Иначе
			НачатьИзмерениеНативнойПробыCPU();
		КонецЕсли;
	Исключение
		ОбъектНативнойПробыCPU = Неопределено;
		Сообщить("Не удалось создать нативную пробу CPU: " + ОписаниеОшибки());
		ЗавершитьНативнуюПробуCPU();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура НачатьВыполнениеНативныхДиагностикCPU()

	Попытка
		Оповещение = Новый ОписаниеОповещения(
			"ПослеВыполненияНативныхДиагностикCPU",
			ЭтаФорма,
			Неопределено,
			"ПриОшибкеВызоваНативнойПробыCPU",
			ЭтаФорма);
		ОбъектНативнойПробыCPU.НачатьВызовMeasure(Оповещение, -1, 0, 0);
	Исключение
		Сообщить("Ошибка запуска нативных CPU-диагностик: " + ОписаниеОшибки());
		ЗавершитьНативнуюПробуCPU();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыполненияНативныхДиагностикCPU(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт

	Попытка
		Если ТипЗнч(РезультатВызова) <> Тип("Строка") Тогда
			ВызватьИсключение "Нативная компонента вернула результат неожиданного типа";
		КонецЕсли;

		ДанныеНативныхДиагностикCPU = РазобратьНативныеДиагностикиCPU(РезультатВызова);
		ИдентификаторНативногоПрогонаCPU = Строка(Новый УникальныйИдентификатор);
		НачатьПолучениеПаспортаСистемыКлиента();
	Исключение
		Сообщить("Нативные CPU-диагностики завершились ошибкой: " + ОписаниеОшибки());
		ЗавершитьНативнуюПробуCPU();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура НачатьПолучениеПаспортаСистемыКлиента()

	Попытка
		Оповещение = Новый ОписаниеОповещения(
			"ПослеПолученияПаспортаСистемыКлиента",
			ЭтаФорма,
			Неопределено,
			"ПриОшибкеПолученияПаспортаСистемыКлиента",
			ЭтаФорма);
		ОбъектНативнойПробыCPU.НачатьВызовGetSystemInfo(Оповещение);
	Исключение
		ЗавершитьСборНативныхДиагностикИПаспортаCPU(ОписаниеОшибки(), "");
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПолученияПаспортаСистемыКлиента(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(РезультатВызова) <> Тип("Строка") Тогда
		ЗавершитьСборНативныхДиагностикИПаспортаCPU("GetSystemInfo вернул результат неожиданного типа", "");
		Возврат;
	КонецЕсли;

	ЗавершитьСборНативныхДиагностикИПаспортаCPU("", РезультатВызова);

КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеПолученияПаспортаСистемыКлиента(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	СтандартнаяОбработка = Ложь;
	ЗавершитьСборНативныхДиагностикИПаспортаCPU(ИнформацияОбОшибке.Описание, "");

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьСборНативныхДиагностикИПаспортаCPU(ОшибкаПаспортаКлиента, JSONПаспортаКлиента)

	Попытка
		Если ПустаяСтрока(ОшибкаПаспортаКлиента) Тогда
			СохранитьПаспортСистемыНаСервере(
				ИдентификаторНативногоПрогонаCPU, "client", JSONПаспортаКлиента, "");
		Иначе
			СохранитьПаспортСистемыНаСервере(
				ИдентификаторНативногоПрогонаCPU, "client", "", ОшибкаПаспортаКлиента);
		КонецЕсли;
	Исключение
		ОшибкаПаспортаКлиента = ОписаниеОшибки();
		Попытка
			СохранитьПаспортСистемыНаСервере(
				ИдентификаторНативногоПрогонаCPU, "client", "", ОшибкаПаспортаКлиента);
		Исключение
			ОшибкаПаспортаКлиента = ОшибкаПаспортаКлиента + "; запись не сохранена: " + ОписаниеОшибки();
		КонецПопытки;
	КонецПопытки;

	Попытка
		РезультатЗапускаСервера = ВыполнитьИЗаписатьНативныеДиагностикиCPUНаСервере(
			ИдентификаторНативногоПрогонаCPU,
			ДанныеНативныхДиагностикCPU);
		ОбщийБалл = 0;
		ГлавноеУзкоеМесто = "Нативные CPU-диагностики клиента и сервера; не входят в общий балл";
		ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторНативногоПрогонаCPU);

		ТекстИтога = "Нативных CPU-диагностик: " + Строка(РезультатЗапускаСервера.Количество)
			+ "; доступно: " + Строка(РезультатЗапускаСервера.Доступно)
			+ "; недоступно: " + Строка(РезультатЗапускаСервера.Недоступно)
			+ "; паспорт клиента: " + ?(ПустаяСтрока(ОшибкаПаспортаКлиента), "сохранён", "недоступен")
			+ "; паспорт сервера: " + ?(РезультатЗапускаСервера.ПаспортСервераСохранен, "сохранён", "недоступен")
			+ "; ID: " + ИдентификаторНативногоПрогонаCPU;
		Если Не ПустаяСтрока(ОшибкаПаспортаКлиента) Тогда
			ТекстИтога = ТекстИтога + "; ошибка паспорта клиента: " + ОшибкаПаспортаКлиента;
		КонецЕсли;
		Если Не РезультатЗапускаСервера.ПаспортСервераСохранен Тогда
			ТекстИтога = ТекстИтога + "; ошибка паспорта сервера: " + РезультатЗапускаСервера.ОшибкаПаспортаСервера;
		КонецЕсли;
		Если Не РезультатЗапускаСервера.СерверУспешен Тогда
			ТекстИтога = ТекстИтога + "; ошибка серверного контекста: " + РезультатЗапускаСервера.ОшибкаСервера;
		КонецЕсли;
		Сообщить(ТекстИтога);
	Исключение
		Сообщить("Нативные CPU-диагностики завершились ошибкой: " + ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьНативнуюПробуCPU();

КонецПроцедуры

&НаКлиенте
Процедура НачатьУстановкуНативнойПробыCPU()

	Попытка
		Оповещение = Новый ОписаниеОповещения(
