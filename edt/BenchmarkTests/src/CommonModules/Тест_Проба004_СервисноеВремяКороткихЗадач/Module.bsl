Процедура Тест_Проба004_СервисноеВремяКороткихЗадач() Экспорт

	Результат = БенчмаркПроба004СервисноеВремяКороткихЗадач.Проба004_СервисноеВремяКороткихЗадач(2, 100);

	ЮТест.ОжидаетЧто(Результат.ЧислоЗадач).Равно(2);
	ЮТест.ОжидаетЧто(Результат.МедианаСервисаМс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.ДлительностьПакетаМс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.КонтрольнаяСумма).Больше(0);

КонецПроцедуры

