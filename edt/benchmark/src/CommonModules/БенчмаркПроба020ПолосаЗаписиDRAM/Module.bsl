#Область ПрограммныйИнтерфейс

// Анализирует внешние замеры записи в заранее затронутые локальные буферы больше LLC.
// Точка: ЧислоПотоков, РазмерБуфераБайт, РазмерLLCБайт, ТипЗаписи,
// БуферПредварительноЗатронут, РазмещениеЛокальноеПодтверждено, идентификаторы, Наблюдения.
// Наблюдение: ОбъемЗаписанныхБайт, ДлительностьНс, КонтрольнаяСумма.
Функция АнализироватьПолосуЗаписи(Знач Точки) Экспорт

	Если Точки.Количество() < 1 Тогда
		ВызватьИсключение "Передайте хотя бы одну точку измерения полосы записи";
	КонецЕсли;

	Результаты = Новый Массив;
	ПредыдущиеПотоки = 0;
	ИдентификаторСтенда = "";
	ИдентификаторНабора = "";
	ТипЗаписи = "";
	РазмерБуфера = 0;
	РазмерLLC = 0;

	Для Каждого Точка Из Точки Цикл
		Если Точка.ЧислоПотоков <= ПредыдущиеПотоки
			Или Точка.РазмерLLCБайт <= 0
			Или Точка.РазмерБуфераБайт <= Точка.РазмерLLCБайт
			Или Не Точка.РазмещениеЛокальноеПодтверждено
			Или Не Точка.БуферПредварительноЗатронут
			Или ПустаяСтрока(Точка.ТипЗаписи) Тогда
			ВызватьИсключение "Нужны большой локальный буфер, предварительное касание и заданный тип записи";
		КонецЕсли;
		Если Точка.Наблюдения.Количество() < 3 Тогда
			ВызватьИсключение "Для каждой точки нужны минимум три повтора";
		КонецЕсли;
		Если ПустаяСтрока(Точка.ИдентификаторСтенда)
			Или ПустаяСтрока(Точка.ИдентификаторНабора) Тогда
			ВызватьИсключение "Укажите стенд и набор данных";
		КонецЕсли;
		Если ПредыдущиеПотоки = 0 Тогда
			ИдентификаторСтенда = Точка.ИдентификаторСтенда;
			ИдентификаторНабора = Точка.ИдентификаторНабора;
			ТипЗаписи = Точка.ТипЗаписи;
			РазмерБуфера = Точка.РазмерБуфераБайт;
			РазмерLLC = Точка.РазмерLLCБайт;
		ИначеЕсли ИдентификаторСтенда <> Точка.ИдентификаторСтенда
			Или ИдентификаторНабора <> Точка.ИдентификаторНабора
			Или ТипЗаписи <> Точка.ТипЗаписи
			Или РазмерБуфера <> Точка.РазмерБуфераБайт
			Или РазмерLLC <> Точка.РазмерLLCБайт Тогда
			ВызватьИсключение "Стенд, набор, тип записи, буфер и LLC должны совпадать между точками";
		КонецЕсли;

		ПолосыГБс = Новый СписокЗначений;
		ДлительностиНс = Новый СписокЗначений;
		КонтрольнаяСумма = Неопределено;
		ОбъемБайт = 0;
		Для Каждого Наблюдение Из Точка.Наблюдения Цикл
			Если Наблюдение.ОбъемЗаписанныхБайт <= 0 Или Наблюдение.ДлительностьНс <= 0 Тогда
				ВызватьИсключение "Объём записи и длительность должны быть положительными";
			КонецЕсли;
			Если ОбъемБайт = 0 Тогда
				ОбъемБайт = Наблюдение.ОбъемЗаписанныхБайт;
				КонтрольнаяСумма = Наблюдение.КонтрольнаяСумма;
			ИначеЕсли ОбъемБайт <> Наблюдение.ОбъемЗаписанныхБайт
				Или КонтрольнаяСумма <> Наблюдение.КонтрольнаяСумма Тогда
				ВызватьИсключение "Повторы должны записывать одинаковый объём и давать одну контрольную сумму";
			КонецЕсли;
			ПолосыГБс.Добавить(Наблюдение.ОбъемЗаписанныхБайт / Наблюдение.ДлительностьНс);
			ДлительностиНс.Добавить(Наблюдение.ДлительностьНс);
		КонецЦикла;

		МедианаГБс = Медиана(ПолосыГБс);
		Результаты.Добавить(Новый Структура("ЧислоПотоков,ТипЗаписи,ОбъемЗаписанныхБайт,ГБВСекунду,ГБВСекундуНаПоток,МедианаДлительностиНс,КонтрольнаяСумма",
			Точка.ЧислоПотоков, ТипЗаписи, ОбъемБайт, МедианаГБс,
			МедианаГБс / Точка.ЧислоПотоков, Медиана(ДлительностиНс), КонтрольнаяСумма));
		ПредыдущиеПотоки = Точка.ЧислоПотоков;
	КонецЦикла;

	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторНабора,ТипЗаписи,Точки",
		ИдентификаторСтенда, ИдентификаторНабора, ТипЗаписи, Результаты);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Медиана(Значения)
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение)
		+ Число(Значения[Количество / 2].Значение)) / 2;
КонецФункции

#КонецОбласти
