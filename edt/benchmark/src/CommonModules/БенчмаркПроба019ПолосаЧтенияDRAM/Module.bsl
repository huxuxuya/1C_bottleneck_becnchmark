#Область ПрограммныйИнтерфейс

// Анализирует внешние замеры чтения буферов больше LLC с локальным размещением.
// Точка: ЧислоПотоков, РазмерБуфераБайт, РазмерLLCБайт, РазмещениеЛокальноеПодтверждено,
// ИдентификаторСтенда, ИдентификаторНабора, Наблюдения.
// Наблюдение: ОбъемПрочитанныхБайт, ДлительностьНс, КонтрольнаяСумма.
Функция АнализироватьПолосуЧтения(Знач Точки) Экспорт

	Если Точки.Количество() < 1 Тогда
		ВызватьИсключение "Передайте хотя бы одну точку измерения полосы чтения";
	КонецЕсли;

	Результаты = Новый Массив;
	ПредыдущиеПотоки = 0;
	ИдентификаторСтенда = "";
	ИдентификаторНабора = "";
	РазмерБуфера = 0;
	РазмерLLC = 0;

	Для Каждого Точка Из Точки Цикл
		Если Точка.ЧислоПотоков <= ПредыдущиеПотоки
			Или Точка.РазмерLLCБайт <= 0
			Или Точка.РазмерБуфераБайт <= Точка.РазмерLLCБайт
			Или Не Точка.РазмещениеЛокальноеПодтверждено Тогда
			ВызватьИсключение "Нужны возрастающее число потоков, буфер больше LLC и подтверждённое локальное размещение";
		КонецЕсли;
		Если Точка.Наблюдения.Количество() < 3 Тогда
			ВызватьИсключение "Для каждой точки нужны минимум три повтора";
		КонецЕсли;
		Если ПустаяСтрока(Точка.ИдентификаторСтенда)
			Или ПустаяСтрока(Точка.ИдентификаторНабора) Тогда
			ВызватьИсключение "Укажите стенд и набор данных";
		КонецЕсли;
		Если ПредыдущиеПотоки = 0 Тогда
			ИдентификаторСтенда = Точка.ИдентификаторСтенда;
			ИдентификаторНабора = Точка.ИдентификаторНабора;
			РазмерБуфера = Точка.РазмерБуфераБайт;
			РазмерLLC = Точка.РазмерLLCБайт;
		ИначеЕсли ИдентификаторСтенда <> Точка.ИдентификаторСтенда
			Или ИдентификаторНабора <> Точка.ИдентификаторНабора
			Или РазмерБуфера <> Точка.РазмерБуфераБайт
			Или РазмерLLC <> Точка.РазмерLLCБайт Тогда
			ВызватьИсключение "Стенд, набор, буфер и размер LLC должны совпадать между точками";
		КонецЕсли;

		ПолосыГБс = Новый СписокЗначений;
		ДлительностиНс = Новый СписокЗначений;
		КонтрольнаяСумма = Неопределено;
		ОбъемБайт = 0;
		Для Каждого Наблюдение Из Точка.Наблюдения Цикл
			Если Наблюдение.ОбъемПрочитанныхБайт <= 0 Или Наблюдение.ДлительностьНс <= 0 Тогда
				ВызватьИсключение "Объём чтения и длительность должны быть положительными";
			КонецЕсли;
			Если ОбъемБайт = 0 Тогда
				ОбъемБайт = Наблюдение.ОбъемПрочитанныхБайт;
				КонтрольнаяСумма = Наблюдение.КонтрольнаяСумма;
			ИначеЕсли ОбъемБайт <> Наблюдение.ОбъемПрочитанныхБайт
				Или КонтрольнаяСумма <> Наблюдение.КонтрольнаяСумма Тогда
				ВызватьИсключение "Повторы должны читать одинаковый объём и давать одну контрольную сумму";
			КонецЕсли;
			ПолосыГБс.Добавить(Наблюдение.ОбъемПрочитанныхБайт / Наблюдение.ДлительностьНс);
			ДлительностиНс.Добавить(Наблюдение.ДлительностьНс);
		КонецЦикла;

		МедианаГБс = Медиана(ПолосыГБс);
		Результаты.Добавить(Новый Структура("ЧислоПотоков,ОбъемПрочитанныхБайт,ГБВСекунду,ГБВСекундуНаПоток,МедианаДлительностиНс,КонтрольнаяСумма",
			Точка.ЧислоПотоков, ОбъемБайт, МедианаГБс, МедианаГБс / Точка.ЧислоПотоков,
			Медиана(ДлительностиНс), КонтрольнаяСумма));
		ПредыдущиеПотоки = Точка.ЧислоПотоков;
	КонецЦикла;

	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторНабора,Точки",
		ИдентификаторСтенда, ИдентификаторНабора, Результаты);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Медиана(Значения)
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение)
		+ Число(Значения[Количество / 2].Значение)) / 2;
КонецФункции

#КонецОбласти
