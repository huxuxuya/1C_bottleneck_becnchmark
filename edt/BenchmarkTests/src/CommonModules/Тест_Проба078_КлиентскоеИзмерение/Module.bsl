#Область ПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("Клиент-серверные пробы")
		.ДобавитьКлиентскийТест("Тест_Проба078_КлиентскоеИзмерение");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_Проба078_КлиентскоеИзмерение() Экспорт

	Форма = ОткрытьФорму("Обработка.ЗапускБенчмарка.Форма");
	Результат = Форма.ИзмеритьСериюСерверныхВызовов(5, 3);

	ЮТест.ОжидаетЧто(Результат.КоличествоЭлементов).Равно(5);
	ЮТест.ОжидаетЧто(Результат.ЧислоСерий).Равно(3);
	ЮТест.ОжидаетЧто(Результат.КоличествоПовторовНаСерию).Равно(10);
	ЮТест.ОжидаетЧто(Результат.КоличествоИзмеримыхОтношений).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.КоличествоИзмеримыхОтношений).МеньшеИлиРавно(3);
	ЮТест.ОжидаетЧто(Результат.Наблюдения.Количество()).Равно(3);
	Для Каждого Наблюдение Из Результат.Наблюдения Цикл
		ЮТест.ОжидаетЧто(Наблюдение.КонтрольнаяСумма).Равно(5500);
	КонецЦикла;
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Детали, "batch_calls=10") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Детали, "serial_calls=50") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Детали, "checksum=") > 0).Равно(Истина);

	ИсключениеВыброшено = Ложь;
	Попытка
		Форма.ИзмеритьСериюСерверныхВызовов(0, 3);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);

	ИсключениеВыброшено = Ложь;
	Попытка
		Форма.ИзмеритьСериюСерверныхВызовов(5, 2);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);

	Форма.МасштабНагрузки = 0.05;
	Форма.ВыполнитьПрогон(Неопределено);
	ЮТест.ОжидаетЧто(Форма.Результаты.Количество()).Равно(23);

	ЕстьПакетныйРезультат = Ложь;
	ЕстьПоследовательныйРезультат = Ложь;
	ЕстьОтношениеРезультатов = Ложь;
	Для Каждого СтрокаРезультата Из Форма.Результаты Цикл
		Если СтрокаРезультата.КодПробы = "078_BATCH" Тогда
			ЕстьПакетныйРезультат = Истина;
			ЮТест.ОжидаетЧто(СтрокаРезультата.ЕдиницаИзмерения).Равно("нс/элемент");
			ЮТест.ОжидаетЧто(СтрокаРезультата.Звено).Равно("Клиент ↔ сервер");
			ЮТест.ОжидаетЧто(СтрНайти(СтрокаРезультата.Детали, "batch_calls=10") > 0)
				.Равно(Истина);
			ЮТест.ОжидаетЧто(СтрНайти(СтрокаРезультата.Детали, "checksum=") > 0)
				.Равно(Истина);
			Если СтрокаРезультата.Статус = "успешно" Тогда
				ЮТест.ОжидаетЧто(СтрокаРезультата.ТипСвидетельства).Равно("Прямое измерение");
			Иначе
				ЮТест.ОжидаетЧто(СтрокаРезультата.Статус).Равно("Недоступно");
				ЮТест.ОжидаетЧто(СтрокаРезультата.ТипСвидетельства).Равно("Недоступно");
			КонецЕсли;
		ИначеЕсли СтрокаРезультата.КодПробы = "078_SERIAL" Тогда
			ЕстьПоследовательныйРезультат = Истина;
			ЮТест.ОжидаетЧто(СтрокаРезультата.ЕдиницаИзмерения).Равно("нс/элемент");
			ЮТест.ОжидаетЧто(СтрокаРезультата.Звено).Равно("Клиент ↔ сервер");
			ЮТест.ОжидаетЧто(СтрНайти(СтрокаРезультата.Детали, "serial_calls=500") > 0)
				.Равно(Истина);
			Если СтрокаРезультата.Статус = "успешно" Тогда
				ЮТест.ОжидаетЧто(СтрокаРезультата.ТипСвидетельства).Равно("Прямое измерение");
			Иначе
				ЮТест.ОжидаетЧто(СтрокаРезультата.Статус).Равно("Недоступно");
				ЮТест.ОжидаетЧто(СтрокаРезультата.ТипСвидетельства).Равно("Недоступно");
			КонецЕсли;
		ИначеЕсли СтрокаРезультата.КодПробы = "078_SPEEDUP" Тогда
			ЕстьОтношениеРезультатов = Истина;
			ЮТест.ОжидаетЧто(СтрокаРезультата.ЕдиницаИзмерения).Равно("раз");
			ЮТест.ОжидаетЧто(СтрНайти(СтрокаРезультата.Детали,
				"valid_ratio_series=") > 0).Равно(Истина);
			Если СтрокаРезультата.Статус = "успешно" Тогда
				ЮТест.ОжидаетЧто(СтрокаРезультата.ТипСвидетельства).Равно("Прямое измерение");
			Иначе
				ЮТест.ОжидаетЧто(СтрокаРезультата.Статус).Равно("Недоступно");
				ЮТест.ОжидаетЧто(СтрокаРезультата.ТипСвидетельства).Равно("Недоступно");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЕстьПакетныйРезультат).Равно(Истина);
	ЮТест.ОжидаетЧто(ЕстьПоследовательныйРезультат).Равно(Истина);
	ЮТест.ОжидаетЧто(ЕстьОтношениеРезультатов).Равно(Истина);
	Форма.ОчиститьРезультатыПрогонаНаСервере(Форма.ИдентификаторПрогона);

КонецПроцедуры

#КонецОбласти
