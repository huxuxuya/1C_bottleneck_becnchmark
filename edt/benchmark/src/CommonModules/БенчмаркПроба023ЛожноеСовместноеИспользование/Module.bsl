#Область ПрограммныйИнтерфейс

// Сравнивает результаты внешнего двухпоточного счётчика: поля Смежные и Разнесенные
// содержат одинаковые идентификаторы, число потоков, операций на поток, размер линии,
// подтверждение привязки, смещения счетчиков и массив Наблюдения.
// Наблюдение: ДлительностьНс, ЧислоОбновлений, КонтрольнаяСумма.
Функция СравнитьРазмещениеСчетчиков(Знач Смежные, Знач Разнесенные) Экспорт

	РезультатСмежные = РассчитатьВариант(Смежные, Истина);
	РезультатРазнесенные = РассчитатьВариант(Разнесенные, Ложь);
	Если РезультатСмежные.ИдентификаторСтенда <> РезультатРазнесенные.ИдентификаторСтенда
		Или РезультатСмежные.ЧислоПотоков <> РезультатРазнесенные.ЧислоПотоков
		Или РезультатСмежные.ОбновленийНаПоток <> РезультатРазнесенные.ОбновленийНаПоток
		Или РезультатСмежные.РазмерЛинииБайт <> РезультатРазнесенные.РазмерЛинииБайт
		Или РезультатСмежные.ИдентификаторCPU0 <> РезультатРазнесенные.ИдентификаторCPU0
		Или РезультатСмежные.ИдентификаторCPU1 <> РезультатРазнесенные.ИдентификаторCPU1
		Или РезультатСмежные.КонтрольнаяСумма <> РезультатРазнесенные.КонтрольнаяСумма Тогда
		ВызватьИсключение "Стенд, операции, размер линии и результат должны совпадать";
	КонецЕсли;

	Ускорение = РезультатРазнесенные.МедианаОбновленийВСекунду
		/ РезультатСмежные.МедианаОбновленийВСекунду;
	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторCPU0,ИдентификаторCPU1,ЧислоПотоков,ОбновленийНаПоток,РазмерЛинииБайт,КонтрольнаяСумма,Смежные,Разнесенные,УскорениеПослеРазнесения,ПриростПроцентов,СобытияКогерентностиДоступны",
		РезультатСмежные.ИдентификаторСтенда, РезультатСмежные.ИдентификаторCPU0,
		РезультатСмежные.ИдентификаторCPU1, РезультатСмежные.ЧислоПотоков,
		РезультатСмежные.ОбновленийНаПоток, РезультатСмежные.РазмерЛинииБайт,
		РезультатСмежные.КонтрольнаяСумма, РезультатСмежные, РезультатРазнесенные,
		Ускорение, (Ускорение - 1) * 100,
		РезультатСмежные.СобытияКогерентностиДоступны И РезультатРазнесенные.СобытияКогерентностиДоступны);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РассчитатьВариант(Вариант, ОжидаетсяОбщаяЛиния)
	Если Вариант.ЧислоПотоков <> 2 Или Вариант.ОбновленийНаПоток <= 0
		Или Вариант.РазмерЛинииБайт <= 0 Или Не Вариант.ПривязкаПодтверждена
		Или Вариант.СмещениеСчетчика0Байт < 0 Или Вариант.СмещениеСчетчика1Байт < 0
		Или Вариант.СмещениеСчетчика0Байт = Вариант.СмещениеСчетчика1Байт
		Или ПустаяСтрока(Вариант.ИдентификаторCPU0)
		Или ПустаяСтрока(Вариант.ИдентификаторCPU1)
		Или Вариант.ИдентификаторCPU0 = Вариант.ИдентификаторCPU1
		Или ПустаяСтрока(Вариант.ИдентификаторСтенда) Тогда
		ВызватьИсключение "Нужны два закреплённых потока и известный размер линии";
	КонецЕсли;
	Если Вариант.Наблюдения.Количество() < 3 Тогда
		ВызватьИсключение "Для каждого расположения нужны минимум три повтора";
	КонецЕсли;

	ЛинияСчетчика0 = Цел(Вариант.СмещениеСчетчика0Байт / Вариант.РазмерЛинииБайт);
	ЛинияСчетчика1 = Цел(Вариант.СмещениеСчетчика1Байт / Вариант.РазмерЛинииБайт);
	Если ОжидаетсяОбщаяЛиния И ЛинияСчетчика0 <> ЛинияСчетчика1 Тогда
		ВызватьИсключение "Счётчики варианта совместной линии должны лежать в одной линии";
	КонецЕсли;
	Если Не ОжидаетсяОбщаяЛиния И ЛинияСчетчика0 = ЛинияСчетчика1 Тогда
		ВызватьИсключение "Разнесённые счётчики должны занимать разные линии";
	КонецЕсли;

	Скорости = Новый СписокЗначений;
	СобытияКогерентности = Новый СписокЗначений;
	КонтрольнаяСумма = Неопределено;
	ЧислоОбновлений = 0;
	СобытияДоступны = Истина;
	Для Каждого Наблюдение Из Вариант.Наблюдения Цикл
		Если Наблюдение.ДлительностьНс <= 0 Или Наблюдение.ЧислоОбновлений <= 0 Тогда
			ВызватьИсключение "Длительность и число обновлений должны быть положительными";
		КонецЕсли;
		Если ЧислоОбновлений = 0 Тогда
			ЧислоОбновлений = Наблюдение.ЧислоОбновлений;
			КонтрольнаяСумма = Наблюдение.КонтрольнаяСумма;
		ИначеЕсли ЧислоОбновлений <> Наблюдение.ЧислоОбновлений
			Или КонтрольнаяСумма <> Наблюдение.КонтрольнаяСумма Тогда
			ВызватьИсключение "Повторы должны делать одинаковое число обновлений";
		КонецЕсли;
		Если Наблюдение.ЧислоОбновлений <> Вариант.ОбновленийНаПоток * Вариант.ЧислоПотоков Тогда
			ВызватьИсключение "Число обновлений должно совпадать с количеством операций обоих потоков";
		КонецЕсли;
		Скорости.Добавить(Наблюдение.ЧислоОбновлений * 1000000000 / Наблюдение.ДлительностьНс);
		События = 0;
		Если Наблюдение.Свойство("СобытияКогерентности", События) Тогда
			Если События < 0 Тогда
				ВызватьИсключение "Счётчик событий когерентности не может быть отрицательным";
			КонецЕсли;
			СобытияКогерентности.Добавить(События);
		Иначе
			СобытияДоступны = Ложь;
		КонецЕсли;
	КонецЦикла;

	МедианаСобытий = 0;
	Если СобытияДоступны Тогда
		МедианаСобытий = Медиана(СобытияКогерентности);
	КонецЕсли;
	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторCPU0,ИдентификаторCPU1,ЧислоПотоков,ОбновленийНаПоток,РазмерЛинииБайт,КонтрольнаяСумма,МедианаОбновленийВСекунду,СобытияКогерентностиДоступны,МедианаСобытийКогерентности",
		Вариант.ИдентификаторСтенда, Вариант.ИдентификаторCPU0, Вариант.ИдентификаторCPU1,
		Вариант.ЧислоПотоков, Вариант.ОбновленийНаПоток, Вариант.РазмерЛинииБайт,
		КонтрольнаяСумма, Медиана(Скорости),
		СобытияДоступны, МедианаСобытий);
КонецФункции

Функция Медиана(Значения)
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение)
		+ Число(Значения[Количество / 2].Значение)) / 2;
КонецФункции

#КонецОбласти
