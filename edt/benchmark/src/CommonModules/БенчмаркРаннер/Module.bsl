Процедура ДобавитьЗаписьПрогона(Результаты, КонтекстПрогона, ДанныеПробы)

	КосвенныйСигнал = Ложь;
	СтатусПробы = "";
	ПричинаПроблемы = "";
	Если ДанныеПробы.Свойство("СтатусПробы", СтатусПробы) И Не ПустаяСтрока(СтатусПробы) Тогда
		ДанныеПробы.Свойство("ПричинаПроблемы", ПричинаПроблемы);
		Оценка = Новый Структура("Баллы,Индекс,Статус", 0, 0, СтатусПробы);
	ИначеЕсли ДанныеПробы.Свойство("КосвенныйСигнал", КосвенныйСигнал) И КосвенныйСигнал Тогда
		Оценка = Новый Структура("Баллы,Индекс,Статус", 0, 0, "Косвенный сигнал");
	Иначе
		Оценка = ОценитьПоказатель(ДанныеПробы.ЗначениеМетрики, ДанныеПробы.ЦелевоеЗначение);
	КонецЕсли;
	СтатусРезультата = Оценка.Статус;

	МенеджерЗаписи = РегистрыСведений.РезультатыПрогонов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторПрогона = КонтекстПрогона.ИдентификаторПрогона;
	МенеджерЗаписи.КодПробы = ДанныеПробы.КодПробы;
	МенеджерЗаписи.ДатаПрогона = КонтекстПрогона.ДатаПрогона;
	МенеджерЗаписи.НаименованиеПробы = ДанныеПробы.НаименованиеПробы;
	МенеджерЗаписи.ЗначениеМетрики = ДанныеПробы.ЗначениеМетрики;
	МенеджерЗаписи.ЦелевоеЗначение = ДанныеПробы.ЦелевоеЗначение;
	МенеджерЗаписи.ЕдиницаИзмерения = ДанныеПробы.ЕдиницаИзмерения;
	МенеджерЗаписи.Баллы = Оценка.Баллы;
	МенеджерЗаписи.Индекс = Оценка.Индекс;
	МенеджерЗаписи.Статус = СтатусРезультата;
	МенеджерЗаписи.КонтрольнаяСумма = ДанныеПробы.КонтрольнаяСумма;
	МенеджерЗаписи.Детали = ДанныеПробы.Детали;
	МенеджерЗаписи.Записать(Истина);

	НачалоПопыткиUTC = ТекущаяУниверсальнаяДата();
	КонтекстПрогона.Свойство("ДатаНачалаТекущейПробы", НачалоПопыткиUTC);
	КонецПопыткиUTC = ТекущаяУниверсальнаяДата();
	КонтекстПрогона.Свойство("ДатаЗавершенияТекущейПробы", КонецПопыткиUTC);
	Причина = ПричинаПроблемы;
	Если ПустаяСтрока(Причина) И СтатусРезультата = "Недостаточно разрешения таймера" Тогда
		Причина = "Измерительный интервал не превысил разрешение часов BSL";
	КонецЕсли;
	КодМетодики = БенчмаркХранилищеПрогонов.ПолучитьКодМетодикиДляПоказателя(
		ДанныеПробы.КодПробы);
	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
		КонтекстПрогона.СсылкаНаПрогон,
		БенчмаркХранилищеПрогонов.ПолучитьКодМетрикиДляПоказателя(ДанныеПробы.КодПробы),
		ДанныеПробы.КодПробы,
		КодМетодики,
		ДанныеПробы.НаименованиеПробы,
		ДанныеПробы.ЗначениеМетрики,
		ДанныеПробы.ЕдиницаИзмерения,
		СтатусРезультата,
		Причина,
		НачалоПопыткиUTC,
		КонецПопыткиUTC,
		ДанныеПробы.КонтрольнаяСумма,
		ДанныеПробы.Детали,
		"server.process", "сервер 1С", "BSL", ДанныеПробы.НаименованиеПробы,
		1, 1, 1, "измерение", 1, 0, 0,
		?(ДанныеПробы.КодПробы = "BSL_ADAPTIVE_SPEED", "медиана", "значение"));

	СтрокаРезультата = Новый Структура;
	СтрокаРезультата.Вставить("КодПробы", ДанныеПробы.КодПробы);
	СтрокаРезультата.Вставить("НаименованиеПробы", ДанныеПробы.НаименованиеПробы);
	СтрокаРезультата.Вставить("ЗначениеМетрики", ДанныеПробы.ЗначениеМетрики);
	СтрокаРезультата.Вставить("ЦелевоеЗначение", ДанныеПробы.ЦелевоеЗначение);
	СтрокаРезультата.Вставить("ЕдиницаИзмерения", ДанныеПробы.ЕдиницаИзмерения);
	СтрокаРезультата.Вставить("Баллы", Оценка.Баллы);
	СтрокаРезультата.Вставить("Индекс", Оценка.Индекс);
	СтрокаРезультата.Вставить("Статус", СтатусРезультата);
	СтрокаРезультата.Вставить("Детали", ДанныеПробы.Детали);
	Результаты.Добавить(СтрокаРезультата);

