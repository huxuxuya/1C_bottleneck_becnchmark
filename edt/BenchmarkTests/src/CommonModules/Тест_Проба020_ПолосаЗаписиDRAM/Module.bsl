#Область ПрограммныйИнтерфейс
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТестовыйНабор("Память и кэши CPU")
		.ДобавитьСерверныйТест("Тест_Проба020_ПолосаЗаписиDRAM");
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба020_ПолосаЗаписиDRAM() Экспорт
	Точки = Новый Массив;
	Точки.Добавить(СоздатьТочку(1, 125000000));
	Точки.Добавить(СоздатьТочку(2, 62500000));
	Результат = БенчмаркПроба020ПолосаЗаписиDRAM.АнализироватьПолосуЗаписи(Точки);
	ЮТест.ОжидаетЧто(Результат.ТипЗаписи).Равно("cached-store");
	ЮТест.ОжидаетЧто(Результат.Точки[0].ГБВСекунду).Равно(4);
	ЮТест.ОжидаетЧто(Результат.Точки[1].ГБВСекундуНаПоток).Равно(4);

	Точки[0].БуферПредварительноЗатронут = Ложь;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба020ПолосаЗаписиDRAM.АнализироватьПолосуЗаписи(Точки);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);
КонецПроцедуры

Функция СоздатьТочку(Потоки, ВремяНс)
	Наблюдения = Новый Массив;
	Для Индекс = 1 По 3 Цикл
		Наблюдения.Добавить(Новый Структура("ОбъемЗаписанныхБайт,ДлительностьНс,КонтрольнаяСумма",
			500000000, ВремяНс, 911));
	КонецЦикла;
	Возврат Новый Структура("ЧислоПотоков,РазмерБуфераБайт,РазмерLLCБайт,ТипЗаписи,БуферПредварительноЗатронут,РазмещениеЛокальноеПодтверждено,ИдентификаторСтенда,ИдентификаторНабора,Наблюдения",
		Потоки, 67108864, 16777216, "cached-store", Истина, Истина, "mem-lab", "write-buffer-64m", Наблюдения);
КонецФункции
#КонецОбласти
