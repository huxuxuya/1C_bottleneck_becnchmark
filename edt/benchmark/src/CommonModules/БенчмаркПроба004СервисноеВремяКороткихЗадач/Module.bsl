#Область ПрограммныйИнтерфейс

// Измеряет сервисное время коротких вычислительных вызовов, выполненных последовательно.
// Параметры:
//  ЧислоЗадач - Число - число последовательных вызовов (> 0).
//  ИтерацийНаЗадачу - Число - итерации в каждом вызове (> 0).
// Возвращаемое значение:
//  Структура: число задач, медиана сервисного времени, длительность пакета,
//  контрольная сумма и пояснение методики.
Функция Проба004_СервисноеВремяКороткихЗадач(Знач ЧислоЗадач = 10, Знач ИтерацийНаЗадачу = 5000) Экспорт

	Если ЧислоЗадач <= 0 Или ИтерацийНаЗадачу <= 0 Тогда
		ВызватьИсключение "Некорректные параметры Пробы 004";
	КонецЕсли;

	Длительности = Новый СписокЗначений;
	КонтрольнаяСумма = 0;
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для НомерЗадачи = 1 По ЧислоЗадач Цикл
		Замер = БенчмаркПробы.ПробаОдинПотокBSL(ИтерацийНаЗадачу);
		Длительности.Добавить(Замер.ДлительностьМс);
		КонтрольнаяСумма = КонтрольнаяСумма + Замер.КонтрольнаяСумма;
	КонецЦикла;
	КонецМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Длительности.СортироватьПоЗначению();

	Результат = Новый Структура;
	Результат.Вставить("ЧислоЗадач", ЧислоЗадач);
	Результат.Вставить("МедианаСервисаМс", Число(Длительности[Цел((ЧислоЗадач - 1) / 2)].Значение));
	Результат.Вставить("ДлительностьПакетаМс", КонецМс - НачалоМс);
	Результат.Вставить("КонтрольнаяСумма", КонтрольнаяСумма);
	Результат.Вставить("Детали", "Последовательные вызовы BSL; очередь ОС и время runnable не измеряются");
	Возврат Результат;

КонецФункции

#КонецОбласти
