#Область ПрограммныйИнтерфейс

// Пустой экспортируемый серверный общий модуль: вызывается с клиента без формы и SQL.
// Время возвращается в миллисекундах, это разрешение системного таймера BSL.
Функция ПустойОбработчикБезКонтекста() Экспорт
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Возврат КонецМс - НачалоМс;
КонецФункции

// Сводит клиентские серии. Наблюдение содержит RTTНс и ВремяОбработчикаНс.
// Время обработчика — сумма длительностей пустых вызовов, измеренная внутри сервера.
Функция АнализироватьНаблюдения(Знач Наблюдения, Знач ИдентификаторПроцесса = "") Экспорт

	Если Наблюдения.Количество() < 3 Тогда
		ВызватьИсключение "Для базовой цены вызова нужны минимум три независимые серии";
	КонецЕсли;

	RTT = Новый СписокЗначений;
	ВремяОбработчика = Новый СписокЗначений;
	Для Каждого Наблюдение Из Наблюдения Цикл
		Если Наблюдение.ЧислоВызовов <= 0 Или Наблюдение.RTTНс < 0
			Или Наблюдение.ВремяОбработчикаНс < 0 Тогда
			ВызватьИсключение "Число вызовов положительно, а измеренные времена неотрицательны";
		КонецЕсли;
		RTT.Добавить(Наблюдение.RTTНс);
		ВремяОбработчика.Добавить(Наблюдение.ВремяОбработчикаНс);
	КонецЦикла;

	Возврат Новый Структура("ЧислоСерий,МедианаRTTНаВызовНс,МедианаОбработчикаНаВызовНс,ИдентификаторПроцесса,PIDПолученИзВнешнегоСредства,РазрешениеТаймераМс,Детали",
		Наблюдения.Количество(), Медиана(RTT), Медиана(ВремяОбработчика),
		ИдентификаторПроцесса, Не ПустаяСтрока(ИдентификаторПроцесса), 1,
		"RTT включает клиентский путь и диспетчеризацию; серверный таймер имеет миллисекундное разрешение; PID добавляется внешним сборщиком");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Медиана(Значения)
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение)
		+ Число(Значения[Количество / 2].Значение)) / 2;
КонецФункции

#КонецОбласти
