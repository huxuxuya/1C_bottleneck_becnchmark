// Оркестратор калиброванных прогонов, расчёта баллов и локализации узких мест.

#Область ПрограммныйИнтерфейс

// Оценивает измеренный показатель относительно целевого порога (шкала 0..100 баллов).
//
// Параметры:
//  Значение - Число - измеренное значение (>= 0, меньше — лучше).
//  ЦелевоеЗначение - Число - целевой порог (> 0).
//
// Возвращаемое значение:
//  Структура - Баллы (0..100), Статус ("ОК", "Замедление", "УзкоеМесто").
//
Функция ОценитьПоказатель(Знач Значение, Знач ЦелевоеЗначение) Экспорт

	Если ЦелевоеЗначение <= 0 Тогда
		ВызватьИсключение "Целевое значение должно быть больше нуля";
	КонецЕсли;

	Если Значение <= ЦелевоеЗначение Тогда
		Баллы = 100;
	Иначе
		Баллы = Окр(Макс(0, Мин(100, (ЦелевоеЗначение / Значение) * 100)), 1);
	КонецЕсли;

	Если Баллы >= 80 Тогда
		Статус = "ОК";
	ИначеЕсли Баллы >= 50 Тогда
		Статус = "Замедление";
	Иначе
		Статус = "УзкоеМесто";
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Баллы", Баллы);
	Результат.Вставить("Статус", Статус);
	Возврат Результат;

КонецФункции

// Выполняет калиброванный прогон базовых проб, сохраняет результаты в регистр сведений
// РезультатыПрогонов и определяет главное узкое место.
//
// Параметры:
//  ИдентификаторПрогона - Строка - идентификатор прогона (если пустой, создаётся новый).
//  Масштаб - Число - коэффициент объёма нагрузки (> 0, по умолчанию 1).
//
// Возвращаемое значение:
//  Структура - ИдентификаторПрогона, ОбщийБалл, ГлавноеУзкоеМесто, Результаты.
//
Функция ВыполнитьПолныйПрогон(Знач ИдентификаторПрогона = "", Знач Масштаб = 1) Экспорт

	Если Масштаб <= 0 Тогда
		ВызватьИсключение "Масштаб нагрузки должен быть больше нуля";
	КонецЕсли;

	Если ПустаяСтрока(ИдентификаторПрогона) Тогда
		ИдентификаторПрогона = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	ИдентификаторСерии = "RUN_" + Лев(ИдентификаторПрогона, 28);
	БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);

	СправочникиБазы = БенчмаркГенераторДанных.ОбеспечитьСправочники(20, 3, "БМ");
	ДатаПрогона = ТекущаяДатаСеанса();
	Результаты = Новый Массив;

	// 1. CPU: Проба 001 (Скорость одного ядра)
	ИтерацийCPU = Макс(1000, Цел(100000 * Масштаб));
	Рез001 = БенчмаркПробы.Проба001_СкоростьОдногоЯдра(1, 3, ИтерацийCPU);
	ДобавитьЗаписьПрогона(Результаты, ИдентификаторПрогона, ДатаПрогона,
		"001", "CPU: Скорость одного ядра (BSL)", Рез001.НсНаИтерацию, 500, "нс/итер",
		Рез001.КонтрольнаяСумма,
		"Медиана: " + Строка(Рез001.МедианаМс) + " мс; расч. частота ~" + Строка(Рез001.РасчетнаяЧастотаМГц) + " МГц");

	// 2. Память: Рабочий набор коллекции
	РазмерНабора = Макс(200, Цел(5000 * Масштаб));
	ЧислоПоисков = Макс(100, Цел(2000 * Масштаб));
	РезПамять = БенчмаркПробы.ПробаРабочийНаборКоллекции(РазмерНабора, ЧислоПоисков);
	ВремяПамять = РезПамять.ВремяСозданияМс + РезПамять.ВремяОбходаМс + РезПамять.ВремяПоискаМс;
	ДобавитьЗаписьПрогона(Результаты, ИдентификаторПрогона, ДатаПрогона,
		"MEM", "Память: Рабочий набор коллекции", ВремяПамять, Макс(10, 150 * Масштаб), "мс",
		РезПамять.КонтрольнаяСумма,
		"Создание/Обход/Поиск: " + Строка(РезПамять.ВремяСозданияМс) + "/"
		+ Строка(РезПамять.ВремяОбходаМс) + "/" + Строка(РезПамять.ВремяПоискаМс) + " мс");

	// 3. БД: Точечный запрос по индексу
	ЧислоЗапросов = Макс(10, Цел(100 * Масштаб));
	РезТочка = БенчмаркПробы.ПробаТочечныйЗапросПоИндексу(СправочникиБазы.Товары, ЧислоЗапросов);
	ДобавитьЗаписьПрогона(Результаты, ИдентификаторПрогона, ДатаПрогона,
		"DB_POINT", "БД: Точечный запрос по индексу", РезТочка.ДлительностьМс, Макс(10, 100 * Масштаб), "мс",
		РезТочка.КонтрольнаяСумма, "Запросов: " + Строка(ЧислоЗапросов));

	// 4. Транзакции: Раздельная фиксация vs Пакетная
	ЧислоЗаписей = Макс(2, Цел(15 * Масштаб));
	РезРаздельно = БенчмаркПробы.ПробаФиксацияТранзакции(
		СправочникиБазы.Товары, СправочникиБазы.Склады[0], ЧислоЗаписей, Ложь, ИдентификаторСерии);
	ДобавитьЗаписьПрогона(Результаты, ИдентификаторПрогона, ДатаПрогона,
		"TX_SPLIT", "Транзакции: Раздельная фиксация", РезРаздельно.ДлительностьМс, Макс(20, 250 * Масштаб), "мс",
		РезРаздельно.КонтрольнаяСумма, "Документов: " + Строка(ЧислоЗаписей));

	РезПакет = БенчмаркПробы.ПробаФиксацияТранзакции(
		СправочникиБазы.Товары, СправочникиБазы.Склады[0], ЧислоЗаписей, Истина, ИдентификаторСерии);
	ДобавитьЗаписьПрогона(Результаты, ИдентификаторПрогона, ДатаПрогона,
		"TX_BATCH", "Транзакции: Пакетная фиксация", РезПакет.ДлительностьМс, Макс(15, 150 * Масштаб), "мс",
		РезПакет.КонтрольнаяСумма, "Документов: " + Строка(ЧислоЗаписей));

	// 5. БД: Выборка, соединение, группировка и сортировка по документам серии
	РезВыборка = БенчмаркПробы.ПробаВыборкаСоединениеСортировка(ИдентификаторСерии);
	ДобавитьЗаписьПрогона(Результаты, ИдентификаторПрогона, ДатаПрогона,
		"DB_JOIN", "БД: Выборка, соединение и сортировка", РезВыборка.ДлительностьМс, Макс(10, 80 * Масштаб), "мс",
		РезВыборка.ИтогоСумма, "Строк результата: " + Строка(РезВыборка.КоличествоСтрок));

	// 6. Прикладная операция: Проведение документа на 20/200 строк
	ЧислоСтрокДок = Макс(10, Цел(200 * Масштаб));
	ПараметрыДок = Новый Структура;
	ПараметрыДок.Вставить("Товары", СправочникиБазы.Товары);
	ПараметрыДок.Вставить("Склад", СправочникиБазы.Склады[0]);
	ПараметрыДок.Вставить("ЧислоСтрок", ЧислоСтрокДок);
	ПараметрыДок.Вставить("ИдентификаторСерии", ИдентификаторСерии);
	ПараметрыДок.Вставить("Проводить", Ложь);
	СозданныйДок = БенчмаркГенераторДанных.СоздатьДокументДвижения(ПараметрыДок);
	РезПроведение = БенчмаркПробы.ПробаПроведениеДокумента(СозданныйДок.Ссылка);
	ДобавитьЗаписьПрогона(Результаты, ИдентификаторПрогона, ДатаПрогона,
		"DOC_POST", "Операция: Проведение документа", РезПроведение.ДлительностьМс, Макс(20, 200 * Масштаб), "мс",
		РезПроведение.СуммаКоличество, "Движений: " + Строка(РезПроведение.КоличествоДвижений));

	БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);

	СуммаБаллов = 0;
	МинБалл = 101;
	ГлавноеУзкоеМесто = "";
	Для Каждого Элемент Из Результаты Цикл
		СуммаБаллов = СуммаБаллов + Элемент.Баллы;
		Если Элемент.Баллы < МинБалл Тогда
			МинБалл = Элемент.Баллы;
			ГлавноеУзкоеМесто = Элемент.КодПробы + " (" + Элемент.НаименованиеПробы + ")";
		КонецЕсли;
	КонецЦикла;

	ОбщийБалл = Окр(СуммаБаллов / Результаты.Количество(), 1);

	Итог = Новый Структура;
	Итог.Вставить("ИдентификаторПрогона", ИдентификаторПрогона);
	Итог.Вставить("ОбщийБалл", ОбщийБалл);
	Итог.Вставить("ГлавноеУзкоеМесто", ГлавноеУзкоеМесто);
	Итог.Вставить("Результаты", Результаты);
	Возврат Итог;

КонецФункции

// Возвращает сохранённые записи регистра РезультатыПрогонов по идентификатору прогона.
//
// Параметры:
//  ИдентификаторПрогона - Строка - идентификатор прогона.
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки результатов прогона.
//
Функция ПолучитьРезультатыПрогона(Знач ИдентификаторПрогона) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РезультатыПрогонов.КодПробы КАК КодПробы,
	|	РезультатыПрогонов.НаименованиеПробы КАК НаименованиеПробы,
	|	РезультатыПрогонов.ЗначениеМетрики КАК ЗначениеМетрики,
	|	РезультатыПрогонов.ЦелевоеЗначение КАК ЦелевоеЗначение,
	|	РезультатыПрогонов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	РезультатыПрогонов.Баллы КАК Баллы,
	|	РезультатыПрогонов.Статус КАК Статус,
	|	РезультатыПрогонов.КонтрольнаяСумма КАК КонтрольнаяСумма,
	|	РезультатыПрогонов.Детали КАК Детали
	|ИЗ
	|	РегистрСведений.РезультатыПрогонов КАК РезультатыПрогонов
	|ГДЕ
	|	РезультатыПрогонов.ИдентификаторПрогона = &ИдентификаторПрогона
	|
	|УПОРЯДОЧИТЬ ПО
	|	Баллы ВОЗР";
	Запрос.УстановитьПараметр("ИдентификаторПрогона", ИдентификаторПрогона);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Удаляет записи регистра РезультатыПрогонов для указанного прогона.
//
// Параметры:
//  ИдентификаторПрогона - Строка - идентификатор прогона.
//
Процедура ОчиститьРезультатыПрогона(Знач ИдентификаторПрогона) Экспорт

	НаборЗаписей = РегистрыСведений.РезультатыПрогонов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторПрогона.Установить(ИдентификаторПрогона);
	НаборЗаписей.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьЗаписьПрогона(Результаты, ИдентификаторПрогона, ДатаПрогона,
	КодПробы, НаименованиеПробы, ЗначениеМетрики, ЦелевоеЗначение, ЕдиницаИзмерения,
	КонтрольнаяСумма, Детали)

	Оценка = ОценитьПоказатель(ЗначениеМетрики, ЦелевоеЗначение);

	МенеджерЗаписи = РегистрыСведений.РезультатыПрогонов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторПрогона = ИдентификаторПрогона;
	МенеджерЗаписи.КодПробы = КодПробы;
	МенеджерЗаписи.ДатаПрогона = ДатаПрогона;
	МенеджерЗаписи.НаименованиеПробы = НаименованиеПробы;
	МенеджерЗаписи.ЗначениеМетрики = ЗначениеМетрики;
	МенеджерЗаписи.ЦелевоеЗначение = ЦелевоеЗначение;
	МенеджерЗаписи.ЕдиницаИзмерения = ЕдиницаИзмерения;
	МенеджерЗаписи.Баллы = Оценка.Баллы;
	МенеджерЗаписи.Статус = Оценка.Статус;
	МенеджерЗаписи.КонтрольнаяСумма = КонтрольнаяСумма;
	МенеджерЗаписи.Детали = Детали;
	МенеджерЗаписи.Записать(Истина);

	СтрокаРезультата = Новый Структура;
	СтрокаРезультата.Вставить("КодПробы", КодПробы);
	СтрокаРезультата.Вставить("НаименованиеПробы", НаименованиеПробы);
	СтрокаРезультата.Вставить("ЗначениеМетрики", ЗначениеМетрики);
	СтрокаРезультата.Вставить("ЦелевоеЗначение", ЦелевоеЗначение);
	СтрокаРезультата.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);
	СтрокаРезультата.Вставить("Баллы", Оценка.Баллы);
	СтрокаРезультата.Вставить("Статус", Оценка.Статус);
	СтрокаРезультата.Вставить("Детали", Детали);
	Результаты.Добавить(СтрокаРезультата);

КонецПроцедуры

#КонецОбласти
