Функция ИзмеритьВиртуальнуюТаблицуОстатков(Знач Склад)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| Остатки.Товар КАК Товар,
	| Остатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(&Момент, Склад = &Склад) КАК Остатки";
	// Используем момент в будущем, чтобы включить проводки тестового документа
	// независимо от сдвига часов между процессом и СУБД.
	Запрос.УстановитьПараметр("Момент", Дата(3999, 12, 31));
	Запрос.УстановитьПараметр("Склад", Склад);
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Количество = 0;
	КонтрольнаяСумма = 0;
	Для Повтор = 1 По 20 Цикл
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Количество = Количество + 1;
			КонтрольнаяСумма = КонтрольнаяСумма + Выборка.КоличествоОстаток;
		КонецЦикла;
	КонецЦикла;
	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
	Если ДлительностьМс <= 0 Или Количество = 0 Тогда
		ВызватьИсключение "Виртуальная таблица не вернула измеримый набор остатков";
	КонецЕсли;
	Возврат Новый Структура("ДлительностьМс,ИтогоСумма,КоличествоСтрок",
		ДлительностьМс, КонтрольнаяСумма, Количество);

