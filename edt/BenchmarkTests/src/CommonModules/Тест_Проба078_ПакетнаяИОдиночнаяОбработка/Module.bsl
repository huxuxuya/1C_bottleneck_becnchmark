Процедура Тест_Проба078_ПакетнаяИОдиночнаяОбработка() Экспорт

	Значения = Новый Массив;
	КонтрольнаяСуммаОжидаемая = 0;
	Для Значение = 1 По 50 Цикл
		Значения.Добавить(Значение);
		КонтрольнаяСуммаОжидаемая = КонтрольнаяСуммаОжидаемая
			+ Значение * 31 + 17;
	КонецЦикла;

	КонтрольнаяСуммаПакета = БенчмаркПроба078СерияСерверныхВызовов.
		ОбработатьПакетБезКонтекста(Значения);
	КонтрольнаяСуммаПоследовательно = 0;
	Для Каждого Значение Из Значения Цикл
		КонтрольнаяСуммаПоследовательно = КонтрольнаяСуммаПоследовательно
			+ БенчмаркПроба078СерияСерверныхВызовов.
				ОбработатьЭлементБезКонтекста(Значение);
	КонецЦикла;

	ЮТест.ОжидаетЧто(КонтрольнаяСуммаОжидаемая).Равно(40375);
	ЮТест.ОжидаетЧто(КонтрольнаяСуммаПакета).Равно(КонтрольнаяСуммаОжидаемая);
	ЮТест.ОжидаетЧто(КонтрольнаяСуммаПоследовательно).Равно(КонтрольнаяСуммаОжидаемая);
	ЮТест.ОжидаетЧто(БенчмаркПроба078СерияСерверныхВызовов.
		ОбработатьЭлементБезКонтекста(10)).Равно(327);

	ПустыеЗначения = Новый Массив;
	ЮТест.ОжидаетЧто(БенчмаркПроба078СерияСерверныхВызовов.
		ОбработатьПакетБезКонтекста(ПустыеЗначения)).Равно(0);

КонецПроцедуры

#КонецОбласти
