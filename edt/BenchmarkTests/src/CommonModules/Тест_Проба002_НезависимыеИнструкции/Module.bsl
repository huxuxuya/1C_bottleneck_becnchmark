#Область СлужебныеПроцедурыИФункции

Процедура Тест_Проба002_НезависимыеИнструкции() Экспорт

	Результат = БенчмаркПроба002НезависимыеИнструкции.Проба002_НезависимыеИнструкции(4000);

	ЮТест.ОжидаетЧто(Результат.ЗависимаяНсНаОперацию).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.НезависимаяНсНаОперацию).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.ОтношениеПропускнойСпособности).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.КонтрольнаяСумма).Больше(0);

КонецПроцедуры

#КонецОбласти
