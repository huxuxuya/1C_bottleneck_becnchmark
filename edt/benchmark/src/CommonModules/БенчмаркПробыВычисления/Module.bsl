#Область ПрограммныйИнтерфейс

// Запускает детерминированные BSL-цепочки и возвращает длительность и контрольную сумму.
// Параметры:
//  ЧислоИтераций - Число - итерации для каждой цепочки (> 0).
//  ЧислоЦепочек - Число - число чередуемых цепочек (> 0).
// Возвращаемое значение:
//  Структура: КонтрольнаяСумма, ДлительностьМс, КоличествоОпераций.

Функция ВыполнитьЦепочкиBSL(Знач ЧислоИтераций, Знач ЧислоЦепочек) Экспорт

	Если ЧислоИтераций <= 0 Или ЧислоЦепочек <= 0 Тогда
		ВызватьИсключение "Число итераций и цепочек должно быть больше нуля";
	КонецЕсли;

	Состояния = Новый Массив;
	Для НомерЦепочки = 0 По ЧислоЦепочек - 1 Цикл
		Состояния.Добавить(НомерЦепочки + 1);
	КонецЦикла;

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Индекс = 1 По ЧислоИтераций Цикл
		Для НомерЦепочки = 0 По ЧислоЦепочек - 1 Цикл
			Состояния[НомерЦепочки] = (Состояния[НомерЦепочки] * 1103515
				+ (Индекс + НомерЦепочки) * 31) % 1000003;
		КонецЦикла;
	КонецЦикла;
	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;

	КонтрольнаяСумма = 0;
	Для Каждого Состояние Из Состояния Цикл
		КонтрольнаяСумма = КонтрольнаяСумма + Состояние;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("КонтрольнаяСумма", КонтрольнаяСумма);
	Результат.Вставить("ДлительностьМс", ДлительностьМс);
	Результат.Вставить("КоличествоОпераций", ЧислоИтераций * ЧислоЦепочек);
	Возврат Результат;

КонецФункции

// Возвращает отношение времени базового замера к времени сравниваемого замера.
// Возвращаемое значение:
//  Число - коэффициент отношения; 0 при нулевой длительности сравниваемого замера.
Функция ОтношениеПроизводительности(Знач БазовоеВремяМс, Знач СравниваемоеВремяМс) Экспорт

	Если СравниваемоеВремяМс <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат БазовоеВремяМс / СравниваемоеВремяМс;

КонецФункции

#КонецОбласти
