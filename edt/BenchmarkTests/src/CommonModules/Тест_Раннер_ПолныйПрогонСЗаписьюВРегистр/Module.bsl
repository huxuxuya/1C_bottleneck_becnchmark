#Область ПрограммныйИнтерфейс

// Регистрирует один серверный YAxUnit-тест.
Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты.ДобавитьТестовыйНабор("Раннер бенчмарка")
        .ДобавитьСерверныйТест("Тест_Раннер_ПолныйПрогонСЗаписьюВРегистр");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_Раннер_ПолныйПрогонСЗаписьюВРегистр() Экспорт

	ИдентификаторПрогона = "ЮТ_ПРОГОН_01";
	БенчмаркРаннер.ОчиститьРезультатыПрогона(ИдентификаторПрогона);

	Итог = Обработки.ЗапускБенчмарка.ВыполнитьПрогон(ИдентификаторПрогона, 0.05);
	Записи = БенчмаркРаннер.ПолучитьРезультатыПрогона(ИдентификаторПрогона);

	ЮТест.ОжидаетЧто(Итог.Результаты.Количество()).Равно(18);
	ЮТест.ОжидаетЧто(Записи.Количество()).Равно(18);
	ЮТест.ОжидаетЧто(Итог.КоличествоОцениваемыхПроб).Равно(7);
	ЮТест.ОжидаетЧто(Итог.Результаты[0].Статус).Равно("Косвенный сигнал");
	Для Каждого Код Из СтрРазделить("001,026", ",") Цикл
		Запись = Записи.Найти(Код, "КодПробы");
		Позиция = СтрНайти(Запись.Детали, " усл. МГц BSL;");
		ЮТест.ОжидаетЧто(Позиция).Больше(1);
		ЮТест.ОжидаетЧто(Число(Лев(Запись.Детали, Позиция - 1))).Больше(0);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Итог.ОбщийБалл).Больше(0);
	ЮТест.ОжидаетЧто(Итог.ОбщийБалл).МеньшеИлиРавно(100);
	ЮТест.ОжидаетЧто(Не ПустаяСтрока(Итог.ГлавноеУзкоеМесто)).Равно(Истина);

	БенчмаркРаннер.ОчиститьРезультатыПрогона(ИдентификаторПрогона);

КонецПроцедуры

#КонецОбласти
