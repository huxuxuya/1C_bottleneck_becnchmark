#Область ПрограммныйИнтерфейс

// Пробы 002–011 дают BSL-измерения, пригодные для сравнения запусков на одном стенде.
// Они не подменяют трассировку ОС и гипервизора: причины вроде IRQ, SMT, миграции
// и не измеряет CPU Ready; BSL не предоставляет соответствующий счётчик.

// Сравнивает одну зависимую цепочку BSL с четырьмя чередуемыми цепочками.
// Число операций округляется вниз до кратного четырём.
// Параметры:
//  ЧислоОпераций - Число - число арифметических обновлений (> 0, не менее 4).
// Возвращаемое значение:
//  Структура: ЗависимаяНсНаОперацию, НезависимаяНсНаОперацию,
//  ОтношениеПропускнойСпособности, КонтрольнаяСумма, Детали.
Функция Проба002_НезависимыеИнструкции(Знач ЧислоОпераций = 40000) Экспорт

	Если ЧислоОпераций < 4 Тогда
		ВызватьИсключение "Для Пробы 002 нужно не менее четырех операций";
	КонецЕсли;

	ВсегоОпераций = Цел(ЧислоОпераций / 4) * 4;
	ЗависимаяЦепочка = БенчмаркПробыВычисления.ВыполнитьЦепочкиBSL(ВсегоОпераций, 1);
	НезависимыеЦепочки = БенчмаркПробыВычисления.ВыполнитьЦепочкиBSL(Цел(ВсегоОпераций / 4), 4);

	Результат = Новый Структура;
	Результат.Вставить("ЗависимаяНсНаОперацию", (ЗависимаяЦепочка.ДлительностьМс * 1000000) / ВсегоОпераций);
	Результат.Вставить("НезависимаяНсНаОперацию", (НезависимыеЦепочки.ДлительностьМс * 1000000) / ВсегоОпераций);
	Результат.Вставить("ОтношениеПропускнойСпособности", БенчмаркПробыВычисления.ОтношениеПроизводительности(
		ЗависимаяЦепочка.ДлительностьМс, НезависимыеЦепочки.ДлительностьМс));
	Результат.Вставить("КонтрольнаяСумма", ЗависимаяЦепочка.КонтрольнаяСумма + НезависимыеЦепочки.КонтрольнаяСумма);
	Результат.Вставить("Детали", "BSL; число цепочек 1 и 4; машинный код не анализируется");
	Возврат Результат;

КонецФункции

#КонецОбласти
