Процедура ЗавершитьНативнуюПробуCPU()

	НативнаяПробаCPUВыполняется = Ложь;
	ОбъектНативнойПробыCPU = Неопределено;
	Элементы.КнопкаВыполнитьНативнуюПробуCPU.Доступность = Истина;
	Элементы.КнопкаВыполнитьНативныеДиагностикиCPU.Доступность = Истина;

КонецПроцедуры

&НаКлиенте
Функция РазобратьРезультатНативнойПробыCPU(Знач JSONРезультата) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONРезультата);
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		ВызватьИсключение "Ответ нативной пробы должен быть JSON-объектом";
	КонецЕсли;
	Если Результат.schemaVersion <> 1
		Или Результат.physicalClockRead <> Ложь
		Или Результат.estimatedMHz <= 0
		Или Результат.operationsPerSecond <= 0
		Или Результат.medianElapsedNs <= 0
		Или Результат.sampleCount < 3
		Или ТипЗнч(Результат.sampleElapsedNs) <> Тип("Массив")
		Или Результат.sampleElapsedNs.Количество() <> Результат.sampleCount Тогда
		ВызватьИсключение "В JSON нативной пробы отсутствуют корректные измерения";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция РазобратьНативнуюДиагностикуCPU(Знач JSONРезультата) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONРезультата);
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();
	Возврат ПроверитьСтруктуруНативнойДиагностикиCPU(Результат);

КонецФункции

&НаКлиенте
Функция ПроверитьСтруктуруНативнойДиагностикиCPU(Знач Результат)

	Если ТипЗнч(Результат) <> Тип("Структура")
		Или Результат.schemaVersion <> 1
		Или ПустаяСтрока(Результат.probeCode)
		Или ПустаяСтрока(Результат.probeName)
		Или ПустаяСтрока(Результат.primaryMetric)
		Или ПустаяСтрока(Результат.primaryUnit)
		Или ПустаяСтрока(Результат.details)
		Или ТипЗнч(Результат.available) <> Тип("Булево")
		Или ТипЗнч(Результат.primaryValue) <> Тип("Число")
		Или ТипЗнч(Результат.measurements) <> Тип("Структура") Тогда
		ВызватьИсключение "JSON нативной диагностики не содержит обязательных полей";
	КонецЕсли;

	Если Результат.available Тогда
		Если Результат.status <> "Косвенный сигнал" Или Результат.primaryUnit = "н/д" Тогда
			ВызватьИсключение "Доступная нативная диагностика имеет некорректный статус или единицу";
		КонецЕсли;
	ИначеЕсли Результат.status <> "Недоступно" Или Результат.primaryValue <> 0 Тогда
		ВызватьИсключение "Недоступная нативная диагностика не должна содержать измеренное значение";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция РазобратьНативныеДиагностикиCPU(Знач JSONРезультата) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONРезультата);
	Диагностики = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Диагностики) <> Тип("Массив") Или Диагностики.Количество() <> 10 Тогда
		ВызватьИсключение "Пакет нативных диагностик должен вернуть ровно десять результатов";
	КонецЕсли;

	ОжидаемыеКоды = Новый Массив;
	ОжидаемыеКоды.Добавить("CPU_002_INDEPENDENT_INSTRUCTIONS");
	ОжидаемыеКоды.Добавить("CPU_003_WAKE_LATENCY");
	ОжидаемыеКоды.Добавить("CPU_004_READY_QUEUE");
	ОжидаемыеКоды.Добавить("CPU_005_CPU_QUOTA");
	ОжидаемыеКоды.Добавить("CPU_006_SMT_COMPETITION");
	ОжидаемыеКоды.Добавить("CPU_007_CORE_MIGRATION");
	ОжидаемыеКоды.Добавить("CPU_008_IDLE_RECOVERY");
	ОжидаемыеКоды.Добавить("CPU_009_SUSTAINED_SPEED");
	ОжидаемыеКоды.Добавить("CPU_010_INTERRUPT_JITTER");
	ОжидаемыеКоды.Добавить("CPU_011_VCPU_WAIT");

	Для Каждого СырыеДанные Из Диагностики Цикл
		Результат = ПроверитьСтруктуруНативнойДиагностикиCPU(СырыеДанные);
		Если ОжидаемыеКоды.Найти(Результат.probeCode) = Неопределено Тогда
			ВызватьИсключение "Пакет содержит неизвестный код нативной диагностики: " + Результат.probeCode;
		КонецЕсли;
		ОжидаемыеКоды.Удалить(ОжидаемыеКоды.Найти(Результат.probeCode));
	КонецЦикла;
	Если ОжидаемыеКоды.Количество() <> 0 Тогда
		ВызватьИсключение "Пакет нативных диагностик пропустил одну или несколько проверок";
	КонецЕсли;

	Возврат Диагностики;

КонецФункции

&НаКлиенте
Функция СформироватьДеталиНативнойПробыCPU(Знач РезультатИзмерения) Экспорт

	ДлительностиСерий = "";
	Для Каждого Длительность Из РезультатИзмерения.sampleElapsedNs Цикл
		Если Не ПустаяСтрока(ДлительностиСерий) Тогда
			ДлительностиСерий = ДлительностиСерий + ",";
		КонецЕсли;
		ДлительностиСерий = ДлительностиСерий + Строка(Длительность);
	КонецЦикла;

	Детали = "Native API " + РезультатИзмерения.componentVersion
		+ "; arch=" + РезультатИзмерения.architecture
		+ "; compiler=" + РезультатИзмерения.compiler
		+ "; algorithm=" + РезультатИзмерения.algorithm
		+ "; blocks=" + Строка(РезультатИзмерения.blocksPerSample)
		+ "; warmups=" + Строка(РезультатИзмерения.warmups)
		+ "; samples=" + Строка(РезультатИзмерения.sampleCount)
		+ "; median_ns=" + Строка(РезультатИзмерения.medianElapsedNs)
		+ "; ops/s=" + Строка(РезультатИзмерения.operationsPerSecond)
		+ "; sample_ns=" + ДлительностиСерий
		+ "; checksum=" + Строка(РезультатИзмерения.checksum)
		+ "; экв. МГц=ops/s/1e6, не физическая частота";
	Возврат Лев(Детали, 500);

КонецФункции

&НаСервере
Процедура СохранитьНативнуюПробуCPUНаСервере(ИдентификаторПрогона, ЗначениеЭквивалентнойЧастоты, КонтрольнаяСумма, Детали) Экспорт

	БенчмаркРаннер.СохранитьНативныйРезультатCPU(
		ИдентификаторПрогона,
		ЗначениеЭквивалентнойЧастоты,
		КонтрольнаяСумма,
		Детали);

КонецПроцедуры

&НаСервере
Процедура СохранитьПаспортСистемыНаСервере(ИдентификаторПрогона, КонтекстИсполнения,
	JSONПаспорта, ПричинаНедоступности) Экспорт

	Если ПустаяСтрока(ИдентификаторПрогона)
		Или СтрДлина(ИдентификаторПрогона) > 36
		Или (КонтекстИсполнения <> "client" И КонтекстИсполнения <> "server") Тогда
		ВызватьИсключение "Для паспорта системы нужны корректный ID прогона и контекст";
	КонецЕсли;

	СтатусПаспорта = "Доступен";
	Если Не ПустаяСтрока(ПричинаНедоступности) Тогда
		СтатусПаспорта = "Недоступно";
		JSONПаспорта = "";
	Иначе
		Если ТипЗнч(JSONПаспорта) <> Тип("Строка")
			Или ПустаяСтрока(JSONПаспорта)
			Или СтрДлина(JSONПаспорта) > 1024 Тогда
			ВызватьИсключение "Компонента вернула пустой или слишком большой паспорт системы";
		КонецЕсли;

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(JSONПаспорта);
		ДанныеПаспорта = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
		СхемаПаспорта = 0;
		СведенияСистемы = Неопределено;
		СведенияCPU = Неопределено;
		СведенияПамяти = Неопределено;
		Если ТипЗнч(ДанныеПаспорта) <> Тип("Структура") Тогда
			ВызватьИсключение "Компонента вернула JSON паспорта системы неожиданной структуры";
		КонецЕсли;
		Если Не ДанныеПаспорта.Свойство("schemaVersion", СхемаПаспорта) Или СхемаПаспорта <> 1 Тогда
			ВызватьИсключение "Компонента вернула неподдерживаемую версию паспорта системы";
		КонецЕсли;
		Если Не ДанныеПаспорта.Свойство("system", СведенияСистемы)
			Или ТипЗнч(СведенияСистемы) <> Тип("Структура") Тогда
			ВызватьИсключение "В паспорте системы нет раздела system";
		КонецЕсли;
		Если Не ДанныеПаспорта.Свойство("cpu", СведенияCPU)
			Или ТипЗнч(СведенияCPU) <> Тип("Структура") Тогда
			ВызватьИсключение "В паспорте системы нет раздела cpu";
		КонецЕсли;
		Если Не ДанныеПаспорта.Свойство("memory", СведенияПамяти)
			Или ТипЗнч(СведенияПамяти) <> Тип("Структура") Тогда
			ВызватьИсключение "Компонента вернула JSON паспорта системы неожиданной структуры";
		КонецЕсли;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ПаспортаСистем.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторПрогона = ИдентификаторПрогона;
	МенеджерЗаписи.Контекст = КонтекстИсполнения;
	МенеджерЗаписи.ДатаСбора = ТекущаяДатаСеанса();
	МенеджерЗаписи.Статус = СтатусПаспорта;
	МенеджерЗаписи.ДанныеJSON = JSONПаспорта;
	МенеджерЗаписи.Причина = Лев(ПричинаНедоступности, 500);
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

&НаСервере
Функция ВыполнитьИЗаписатьНативныеДиагностикиCPUНаСервере(ИдентификаторПрогона,
	ДиагностикиКлиента) Экспорт

	КоличествоДоступных = 0;
	Для Каждого Диагностика Из ДиагностикиКлиента Цикл
		Если Диагностика.available Тогда
			КоличествоДоступных = КоличествоДоступных + 1;
		КонецЕсли;
	КонецЦикла;
	СохранитьМассивНативныхДиагностикCPU(ИдентификаторПрогона, ДиагностикиКлиента, "client");

	СерверУспешен = Истина;
	ОшибкаСервера = "";
	КоличествоДоступныхСервера = 0;
	Попытка
		Если Не ПроверитьПодключениеВнешнейКомпоненты(
			"ОбщийМакет.CpuFrequencyProbe",
			"CpuFrequencyProbe") Тогда
			ПодключитьВнешнююКомпоненту(
				"ОбщийМакет.CpuFrequencyProbe",
				"CpuFrequencyProbe",
				ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		ИзмерительCPUСервера = Новый("AddIn.CpuFrequencyProbe.CpuProbe");
		JSONДиагностикСервера = ИзмерительCPUСервера.Measure(-1, 0, 0);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(JSONДиагностикСервера);
		ДиагностикиСервера = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
		Если ТипЗнч(ДиагностикиСервера) <> Тип("Массив")
			Или ДиагностикиСервера.Количество() <> 10 Тогда
			ВызватьИсключение "Серверная Native API-компонента должна вернуть десять диагностик";
		КонецЕсли;
		Для Каждого Диагностика Из ДиагностикиСервера Цикл
			Если ТипЗнч(Диагностика) <> Тип("Структура")
				Или Диагностика.schemaVersion <> 1
				Или ТипЗнч(Диагностика.available) <> Тип("Булево")
				Или ТипЗнч(Диагностика.measurements) <> Тип("Структура") Тогда
				ВызватьИсключение "Серверная Native API-компонента вернула некорректную диагностику";
			КонецЕсли;
			Если Диагностика.available Тогда
				КоличествоДоступныхСервера = КоличествоДоступныхСервера + 1;
			КонецЕсли;
		КонецЦикла;
		СохранитьМассивНативныхДиагностикCPU(ИдентификаторПрогона, ДиагностикиСервера, "server");
	Исключение
		СерверУспешен = Ложь;
		ОшибкаСервера = ОписаниеОшибки();
		СохранитьНедоступныеНативныеДиагностикиCPU(ИдентификаторПрогона, "server", ОшибкаСервера);
	КонецПопытки;

	ПаспортСервераСохранен = Ложь;
	ОшибкаПаспортаСервера = "";
	Попытка
		Если Не ПроверитьПодключениеВнешнейКомпоненты(
			"ОбщийМакет.CpuFrequencyProbe",
			"CpuFrequencyProbe") Тогда
			ПодключитьВнешнююКомпоненту(
				"ОбщийМакет.CpuFrequencyProbe",
				"CpuFrequencyProbe",
				ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		ИзмерительСистемыСервера = Новый("AddIn.CpuFrequencyProbe.CpuProbe");
		JSONПаспортаСервера = ИзмерительСистемыСервера.GetSystemInfo();
		СохранитьПаспортСистемыНаСервере(ИдентификаторПрогона, "server", JSONПаспортаСервера, "");
		ПаспортСервераСохранен = Истина;
	Исключение
		ОшибкаПаспортаСервера = ОписаниеОшибки();
		Попытка
			СохранитьПаспортСистемыНаСервере(
				ИдентификаторПрогона, "server", "", ОшибкаПаспортаСервера);
		Исключение
			ОшибкаПаспортаСервера = ОшибкаПаспортаСервера + "; запись не сохранена: " + ОписаниеОшибки();
		КонецПопытки;
	КонецПопытки;

	Возврат Новый Структура(
		"Количество,Доступно,Недоступно,СерверУспешен,ОшибкаСервера,ПаспортСервераСохранен,ОшибкаПаспортаСервера",
		20,
		КоличествоДоступных + КоличествоДоступныхСервера,
		20 - КоличествоДоступных - КоличествоДоступныхСервера,
		СерверУспешен,
		ОшибкаСервера,
		ПаспортСервераСохранен,
		ОшибкаПаспортаСервера);

КонецФункции

&НаСервере
Процедура СохранитьМассивНативныхДиагностикCPU(ИдентификаторПрогона, Диагностики, КонтекстИсполнения)

	СуффиксКонтекста = ?(КонтекстИсполнения = "client", "C", "S");
	Для Каждого Диагностика Из Диагностики Цикл
		НомерПробы = Сред(Диагностика.probeCode, 5, 3);
		КодПробыРегистра = "NCPU" + НомерПробы + СуффиксКонтекста;
		НаименованиеПробы = Диагностика.probeName + " / " + КонтекстИсполнения;
		Детали = "execution_context=" + КонтекстИсполнения
			+ "; source_code=" + Диагностика.probeCode
			+ "; primary_metric=" + Диагностика.primaryMetric
			+ "; primary_value=" + Строка(Диагностика.primaryValue)
			+ " " + Диагностика.primaryUnit
			+ "; " + Диагностика.details;

		КлючиИзмерений = Новый Массив;
		Если НомерПробы = "002" Тогда
			КлючиИзмерений.Добавить("singleChainOpsPerSecond");
			КлючиИзмерений.Добавить("twoChainOpsPerSecond");
			КлючиИзмерений.Добавить("fourChainOpsPerSecond");
			КлючиИзмерений.Добавить("eightChainOpsPerSecond");
			КлючиИзмерений.Добавить("bestIndependentSpeedup");
		ИначеЕсли НомерПробы = "003" Тогда
			КлючиИзмерений.Добавить("p50WakeLatenessNs");
			КлючиИзмерений.Добавить("p95WakeLatenessNs");
			КлючиИзмерений.Добавить("p99WakeLatenessNs");
			КлючиИзмерений.Добавить("maxWakeLatenessNs");
		ИначеЕсли НомерПробы = "004" Тогда
			КлючиИзмерений.Добавить("competingWorkers");
			КлючиИзмерений.Добавить("p95ScheduledStartLatenessNs");
			КлючиИзмерений.Добавить("p95ControlWorkNs");
			КлючиИзмерений.Добавить("p95ControlResponseNs");
		ИначеЕсли НомерПробы = "005" Тогда
			КлючиИзмерений.Добавить("quota");
			КлючиИзмерений.Добавить("quotaCores");
			КлючиИзмерений.Добавить("nrThrottledDelta");
			КлючиИзмерений.Добавить("throttledUsecDelta");
		ИначеЕсли НомерПробы = "006" Тогда
			КлючиИзмерений.Добавить("baselineOpsPerSecond");
			КлючиИзмерений.Добавить("smtNeighborOpsPerSecond");
			КлючиИзмерений.Добавить("separateCoreOpsPerSecond");
			КлючиИзмерений.Добавить("smtThroughputPercentOfBaseline");
		ИначеЕсли НомерПробы = "007" Тогда
			КлючиИзмерений.Добавить("chunks");
			КлючиИзмерений.Добавить("migrationCount");
			КлючиИзмерений.Добавить("medianChunkNs");
			КлючиИзмерений.Добавить("medianPostMigrationChunkNs");
		ИначеЕсли НомерПробы = "008" Тогда
			КлючиИзмерений.Добавить("firstAfterIdleNsPerUpdate");
			КлючиИзмерений.Добавить("warmMedianNsPerUpdate");
			КлючиИзмерений.Добавить("firstToWarmRatio");
		ИначеЕсли НомерПробы = "009" Тогда
			КлючиИзмерений.Добавить("windowCount");
			КлючиИзмерений.Добавить("medianOpsPerSecond");
			КлючиИзмерений.Добавить("minOpsPerSecond");
			КлючиИзмерений.Добавить("maxOpsPerSecond");
		ИначеЕсли НомерПробы = "010" Тогда
			КлючиИзмерений.Добавить("sampleCount");
			КлючиИзмерений.Добавить("targetBlockUs");
			КлючиИзмерений.Добавить("p50BlockDurationNs");
			КлючиИзмерений.Добавить("p95BlockDurationNs");
			КлючиИзмерений.Добавить("p999BlockDurationNs");
			КлючиИзмерений.Добавить("maxBlockDurationNs");
			КлючиИзмерений.Добавить("contextSwitchCountersAvailable");
			КлючиИзмерений.Добавить("voluntaryContextSwitchesDelta");
			КлючиИзмерений.Добавить("involuntaryContextSwitchesDelta");
		ИначеЕсли НомерПробы = "011" Тогда
			КлючиИзмерений.Добавить("observationWindowMs");
			КлючиИзмерений.Добавить("chunkCount");
			КлючиИзмерений.Добавить("workUpdatesPerSecond");
			КлючиИзмерений.Добавить("effectiveCpuPercentOfWall");
			КлючиИзмерений.Добавить("p95SchedulingGapNs");
			КлючиИзмерений.Добавить("maxSchedulingGapNs");
			КлючиИзмерений.Добавить("suspectedPauseCount");
			КлючиИзмерений.Добавить("systemStealTimeCountersAvailable");
			КлючиИзмерений.Добавить("systemStealTimeDeltaNs");
		КонецЕсли;

		Для Каждого Ключ Из КлючиИзмерений Цикл
			ЗначениеИзмерения = Неопределено;
			Если Диагностика.measurements.Свойство(Ключ, ЗначениеИзмерения) Тогда
				Детали = Детали + "; " + Ключ + "=" + Строка(ЗначениеИзмерения);
			КонецЕсли;
		КонецЦикла;

		БенчмаркРаннер.СохранитьНативнуюДиагностику(
			ИдентификаторПрогона,
			КодПробыРегистра,
			НаименованиеПробы,
			Диагностика.primaryValue,
			Диагностика.primaryUnit,
			Диагностика.checksum,
			Детали,
			Диагностика.status);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СохранитьНедоступныеНативныеДиагностикиCPU(ИдентификаторПрогона, КонтекстИсполнения, Причина)

	Пробники = Новый Массив;
	Пробники.Добавить(Новый Структура("Номер,Название", "002", "Независимые инструкции"));
	Пробники.Добавить(Новый Структура("Номер,Название", "003", "Задержка пробуждения"));
	Пробники.Добавить(Новый Структура("Номер,Название", "004", "Очередь готовых потоков"));
	Пробники.Добавить(Новый Структура("Номер,Название", "005", "Квота CPU"));
	Пробники.Добавить(Новый Структура("Номер,Название", "006", "Конкуренция SMT"));
	Пробники.Добавить(Новый Структура("Номер,Название", "007", "Миграция между ядрами"));
	Пробники.Добавить(Новый Структура("Номер,Название", "008", "Восстановление после простоя"));
	Пробники.Добавить(Новый Структура("Номер,Название", "009", "Устойчивая скорость CPU"));
	Пробники.Добавить(Новый Структура("Номер,Название", "010", "Выбросы времени CPU-порций"));
	Пробники.Добавить(Новый Структура("Номер,Название", "011", "Ожидание vCPU"));
	СуффиксКонтекста = ?(КонтекстИсполнения = "client", "C", "S");
	Для Каждого Проба Из Пробники Цикл
		БенчмаркРаннер.СохранитьНативнуюДиагностику(
			ИдентификаторПрогона,
			"NCPU" + Проба.Номер + СуффиксКонтекста,
			"" + Проба.Номер + ". " + Проба.Название + " / " + КонтекстИсполнения,
			0,
			"н/д",
			0,
			"execution_context=" + КонтекстИсполнения + "; компонент недоступен: " + Причина,
			"Недоступно");
	КонецЦикла;

КонецПроцедуры

// В клиент-серверной ИБ выполняется в rphost. Подключение и создание компоненты
// происходят заново при каждом вызове: кластер может направить вызов на другой узел.
&НаСервере
Функция ВыполнитьНативнуюПробуCPUНаСервере(ИдентификаторПрогона,
	КоличествоБлоков, КоличествоПрогревов, КоличествоСерий) Экспорт

	Попытка
		Если Не ПроверитьПодключениеВнешнейКомпоненты(
			"ОбщийМакет.CpuFrequencyProbe",
			"CpuFrequencyProbe") Тогда
			ПодключитьВнешнююКомпоненту(
				"ОбщийМакет.CpuFrequencyProbe",
				"CpuFrequencyProbe",
				ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		ИзмерительCPUСервера = Новый("AddIn.CpuFrequencyProbe.CpuProbe");
		JSONРезультата = ИзмерительCPUСервера.Measure(
			КоличествоБлоков, КоличествоПрогревов, КоличествоСерий);
		РезультатИзмерения = РазобратьРезультатНативнойПробыCPUНаСервере(JSONРезультата);
		ДеталиИзмерения = СформироватьДеталиСервернойНативнойПробыCPU(РезультатИзмерения);

		БенчмаркРаннер.СохранитьНативныйРезультатCPUДляКонтекста(
			ИдентификаторПрогона,
			"CPU_NATIVE_SERVER",
			"Нативная скорость CPU сервера",
			РезультатИзмерения.estimatedMHz,
			РезультатИзмерения.checksum,
			ДеталиИзмерения,
			"Косвенный сигнал");

		Возврат Новый Структура("Успешно,ЗначениеМетрики,Ошибка",
			Истина, РезультатИзмерения.estimatedMHz, "");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ДеталиОшибки = "execution_context=server; ошибка подключения или замера: " + ТекстОшибки;
		Попытка
			БенчмаркРаннер.СохранитьНативныйРезультатCPUДляКонтекста(
				ИдентификаторПрогона,
				"CPU_NATIVE_SERVER",
				"Нативная скорость CPU сервера",
				0,
				0,
				ДеталиОшибки,
				"Недоступно");
		Исключение
			ТекстОшибки = ТекстОшибки + "; запись статуса не выполнена: " + ОписаниеОшибки();
		КонецПопытки;
		Возврат Новый Структура("Успешно,ЗначениеМетрики,Ошибка", Ложь, 0, ТекстОшибки);
	КонецПопытки;

КонецФункции

&НаСервере
Функция РазобратьРезультатНативнойПробыCPUНаСервере(Знач JSONРезультата)

	Если ТипЗнч(JSONРезультата) <> Тип("Строка") Тогда
		ВызватьИсключение "Серверная Native API-проба вернула результат неожиданного типа";
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(JSONРезультата);
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Результат) <> Тип("Структура")
		Или Результат.schemaVersion <> 1
		Или Результат.physicalClockRead <> Ложь
		Или Результат.estimatedMHz <= 0
		Или Результат.operationsPerSecond <= 0
		Или Результат.medianElapsedNs <= 0
		Или Результат.sampleCount < 3
		Или ТипЗнч(Результат.sampleElapsedNs) <> Тип("Массив")
		Или Результат.sampleElapsedNs.Количество() <> Результат.sampleCount Тогда
		ВызватьИсключение "В JSON серверной Native API-пробы нет корректных измерений";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция СформироватьДеталиСервернойНативнойПробыCPU(Знач РезультатИзмерения)

	ДлительностиСерий = "";
	Для Каждого Длительность Из РезультатИзмерения.sampleElapsedNs Цикл
		Если Не ПустаяСтрока(ДлительностиСерий) Тогда
			ДлительностиСерий = ДлительностиСерий + ",";
		КонецЕсли;
		ДлительностиСерий = ДлительностиСерий + Строка(Длительность);
	КонецЦикла;

	Детали = "execution_context=server; Native API " + РезультатИзмерения.componentVersion
		+ "; arch=" + РезультатИзмерения.architecture
		+ "; compiler=" + РезультатИзмерения.compiler
		+ "; algorithm=" + РезультатИзмерения.algorithm
		+ "; blocks=" + Строка(РезультатИзмерения.blocksPerSample)
		+ "; warmups=" + Строка(РезультатИзмерения.warmups)
		+ "; samples=" + Строка(РезультатИзмерения.sampleCount)
		+ "; median_ns=" + Строка(РезультатИзмерения.medianElapsedNs)
		+ "; ops/s=" + Строка(РезультатИзмерения.operationsPerSecond)
		+ "; sample_ns=" + ДлительностиСерий
		+ "; checksum=" + Строка(РезультатИзмерения.checksum)
		+ "; экв. МГц=ops/s/1e6, не физическая частота";
	Возврат Лев(Детали, 500);

КонецФункции

#КонецОбласти
