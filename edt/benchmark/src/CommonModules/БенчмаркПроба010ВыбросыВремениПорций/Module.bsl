#Область ПрограммныйИнтерфейс

// Вычисляет медиану, P95 и максимум длительности одинаковых BSL-порций.
// Параметры:
//  ЧислоНаблюдений - Число - число повторов (> 0).
//  ИтерацийВСерии - Число - итерации в одном повторе (> 0).
// Возвращаемое значение:
//  Структура: медиана, P95, максимум, отношение хвоста, контрольная сумма и детали.
Функция Проба010_ВыбросыВремениПорций(Знач ЧислоНаблюдений = 10, Знач ИтерацийВСерии = 10000) Экспорт

	Если ЧислоНаблюдений <= 0 Или ИтерацийВСерии <= 0 Тогда
		ВызватьИсключение "Некорректные параметры Пробы 010";
	КонецЕсли;

	Длительности = Новый СписокЗначений;
	КонтрольнаяСумма = 0;
	Для Номер = 1 По ЧислоНаблюдений Цикл
		Замер = БенчмаркПробы.ПробаОдинПотокBSL(ИтерацийВСерии);
		Длительности.Добавить(Замер.ДлительностьМс);
		КонтрольнаяСумма = КонтрольнаяСумма + Замер.КонтрольнаяСумма;
	КонецЦикла;
	Длительности.СортироватьПоЗначению();

	ИндексP95 = Мин(ЧислоНаблюдений - 1, Цел(ЧислоНаблюдений * 0.95));
	Медиана = Число(Длительности[Цел((ЧислоНаблюдений - 1) / 2)].Значение);
	P95 = Число(Длительности[ИндексP95].Значение);
	Результат = Новый Структура;
	Результат.Вставить("МедианаМс", Медиана);
	Результат.Вставить("P95Мс", P95);
	Результат.Вставить("МаксимумМс", Число(Длительности[ЧислоНаблюдений - 1].Значение));
	Результат.Вставить("КоэффициентХвоста", БенчмаркПробыВычисления.ОтношениеПроизводительности(P95, Медиана));
	Результат.Вставить("КонтрольнаяСумма", КонтрольнаяСумма);
	Результат.Вставить("Детали", "Выбросы длительности BSL-порций; источник задержки не локализуется");
	Возврат Результат;

КонецФункции

#КонецОбласти
