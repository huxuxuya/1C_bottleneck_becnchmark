#Область ПрограммныйИнтерфейс
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТестовыйНабор("Рабочий процесс и кластер 1С")
		.ДобавитьСерверныйТест("Тест_Проба026_СкоростьBSL");
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба026_СкоростьBSL() Экспорт
	Результат = БенчмаркПроба026СкоростьBSL.ИзмеритьСкоростьBSL(10000, 300);
	ЮТест.ОжидаетЧто(Результат.ДлительностиМс.Количество()).Равно(7);
	ЮТест.ОжидаетЧто(Результат.ИтерацийВСерии).БольшеИлиРавно(10000);
	ЮТест.ОжидаетЧто(Результат.НсНаИтерацию).Больше(0);
	Эталон = БенчмаркПробы.ПробаОдинПотокBSL(Результат.ИтерацийВСерии);
	ЮТест.ОжидаетЧто(Результат.КонтрольнаяСумма).Равно(Эталон.КонтрольнаяСумма);
	Если Результат.МедианаМс >= 10 Тогда
		ЮТест.ОжидаетЧто(Результат.ЭквивалентЭталонаМГц).Равно(Окр(900000 / Результат.НсНаИтерацию, 0));
	Иначе
		ЮТест.ОжидаетЧто(Результат.ЭквивалентЭталонаМГц = Неопределено).Равно(Истина);
	КонецЕсли;

	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба026СкоростьBSL.ИзмеритьСкоростьBSL(-1, 300);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);
КонецПроцедуры
#КонецОбласти
