	БенчмаркХранилищеПрогонов.ЗавершитьПрогон(СсылкаНаПрогон, СтатусПрогона);

	Итог = Новый Структура;
	Итог.Вставить("ИдентификаторПрогона", ИдентификаторПрогона);
	Итог.Вставить("ОбщийБалл", ОбщийБалл);
