#Область ПрограммныйИнтерфейс
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТестовыйНабор("Рабочий процесс и кластер 1С")
		.ДобавитьКлиентскийТест("Тест_Проба027_БазоваяЦенаСерверногоВызова");
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба027_БазоваяЦенаСерверногоВызова() Экспорт
	Форма = ОткрытьФорму("Обработка.ЗапускБенчмарка.Форма");
	Результат = Форма.ИзмеритьБазовуюЦенуСерверногоВызова(1, 3, 5);
	ЮТест.ОжидаетЧто(Результат.ЧислоСерий).Равно(3);
	ЮТест.ОжидаетЧто(Результат.Наблюдения.Количество()).Равно(3);
	ЮТест.ОжидаетЧто(Результат.МедианаRTTНаВызовНс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.МедианаОбработчикаНаВызовНс).БольшеИлиРавно(0);
	Для Каждого Серия Из Результат.Наблюдения Цикл
		ЮТест.ОжидаетЧто(Серия.ЧислоВызовов).Равно(5);
		ЮТест.ОжидаетЧто(Серия.RTTНс).БольшеИлиРавно(0);
		ЮТест.ОжидаетЧто(Серия.ВремяОбработчикаНс).БольшеИлиРавно(0);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Результат.Детали).Содержит("PID и счётчики ОС средствами этой пробы не измеряются");
	Форма.Закрыть();
КонецПроцедуры
#КонецОбласти
