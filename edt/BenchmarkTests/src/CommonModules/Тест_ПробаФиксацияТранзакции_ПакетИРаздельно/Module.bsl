#Область ПрограммныйИнтерфейс

// Регистрирует один серверный YAxUnit-тест.
Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты.ДобавитьТестовыйНабор("Пробы и генератор")
        .ДобавитьСерверныйТест("Тест_ПробаФиксацияТранзакции_ПакетИРаздельно");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_ПробаФиксацияТранзакции_ПакетИРаздельно() Экспорт

	ИдентификаторСерии = "ЮТ_ТРАНЗ_01";
	БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);

	СправочникиБазы = БенчмаркГенераторДанных.ОбеспечитьСправочники(3, 1, "ЮТТ");

	Раздельно = БенчмаркПробы.ПробаФиксацияТранзакции(
		СправочникиБазы.Товары, СправочникиБазы.Склады[0], 3, Ложь, ИдентификаторСерии
	);
	Пакетно = БенчмаркПробы.ПробаФиксацияТранзакции(
		СправочникиБазы.Товары, СправочникиБазы.Склады[0], 3, Истина, ИдентификаторСерии
	);

	ЮТест.ОжидаетЧто(Раздельно.ЧислоЗаписей).Равно(3);
	ЮТест.ОжидаетЧто(Пакетно.ЧислоЗаписей).Равно(3);
	ЮТест.ОжидаетЧто(Раздельно.КонтрольнаяСумма).Равно(Пакетно.КонтрольнаяСумма);

	Удалено = БенчмаркГенераторДанных.ОчиститьДанныеСерии(ИдентификаторСерии);
	ЮТест.ОжидаетЧто(Удалено).Равно(6);

КонецПроцедуры

#КонецОбласти
