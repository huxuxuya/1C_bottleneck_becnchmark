// Анализирует перекрёстные замеры одинаковых исполнителей, закреплённых по одному на vCPU.
// Потоки и affinity задаются внешним гостевым измерителем; этот модуль оценивает, за чем следует задержка.

#Область ПрограммныйИнтерфейс

// Измерение содержит ИдентификаторПрохода, ИдентификаторvCPU,
// ИдентификаторИсполнителя, ЧислоОпераций, ДлительностьМикросекунд и КонтрольнаяСумма.
// Нужна полная матрица «исполнитель × vCPU» и минимум три повторения каждой пары.
Функция ОценитьАсимметрию(Знач Измерения, Знач ПорогАсимметрииПроцентов = 5) Экспорт

	Если Измерения.Количество() < 12 Тогда
		ВызватьИсключение "Нужно не менее 12 измерений для матрицы 2x2 с тремя повторами";
	КонецЕсли;
	Если ПорогАсимметрииПроцентов <= 0 Тогда
		ВызватьИсключение "Порог асимметрии должен быть больше нуля";
	КонецЕсли;

	vCPU = Новый Массив;
	Исполнители = Новый Массив;
	Проходы = Новый Массив;
	ЧислоОпераций = Неопределено;
	КонтрольнаяСумма = Неопределено;
	Для Каждого Измерение Из Измерения Цикл
		Если Не Измерение.Свойство("ИдентификаторПрохода") Или ПустаяСтрока(Строка(Измерение.ИдентификаторПрохода)) Тогда
			ВызватьИсключение "Не задан идентификатор прохода";
		КонецЕсли;
		Если Не Измерение.Свойство("ИдентификаторvCPU") Или ПустаяСтрока(Строка(Измерение.ИдентификаторvCPU)) Тогда
			ВызватьИсключение "Не задан идентификатор vCPU";
		КонецЕсли;
		Если Не Измерение.Свойство("ИдентификаторИсполнителя") Или ПустаяСтрока(Строка(Измерение.ИдентификаторИсполнителя)) Тогда
			ВызватьИсключение "Не задан идентификатор исполнителя";
		КонецЕсли;
		Если Не Измерение.Свойство("ЧислоОпераций") Или Измерение.ЧислоОпераций <= 0 Тогда
			ВызватьИсключение "Число операций должно быть больше нуля";
		КонецЕсли;
		Если Не Измерение.Свойство("ДлительностьМикросекунд") Или Измерение.ДлительностьМикросекунд <= 0 Тогда
			ВызватьИсключение "Длительность измерения должна быть больше нуля";
		КонецЕсли;
		Если Не Измерение.Свойство("КонтрольнаяСумма") Тогда
			ВызватьИсключение "Измерение не содержит контрольную сумму";
		КонецЕсли;

		ДобавитьУникальноеЗначение(vCPU, Строка(Измерение.ИдентификаторvCPU));
		ДобавитьУникальноеЗначение(Исполнители, Строка(Измерение.ИдентификаторИсполнителя));
		ДобавитьУникальноеЗначение(Проходы, Строка(Измерение.ИдентификаторПрохода));
		Если ЧислоОпераций = Неопределено Тогда
			ЧислоОпераций = Измерение.ЧислоОпераций;
			КонтрольнаяСумма = Измерение.КонтрольнаяСумма;
		ИначеЕсли ЧислоОпераций <> Измерение.ЧислоОпераций Или КонтрольнаяСумма <> Измерение.КонтрольнаяСумма Тогда
			ВызватьИсключение "Все исполнители должны выполнить одинаковую работу с одинаковой контрольной суммой";
		КонецЕсли;
	КонецЦикла;

	Если vCPU.Количество() < 2 Или vCPU.Количество() <> Исполнители.Количество() Тогда
		ВызватьИсключение "Нужно одинаковое число исполнителей и vCPU, не менее двух";
	КонецЕсли;
	Если Проходы.Количество() < 2 Тогда
		ВызватьИсключение "Нужны как минимум два прохода с перестановкой исполнителей";
	КонецЕсли;
	ПроверитьНазначенияПоПроходам(Измерения);

	Для Каждого ИдентификаторvCPU Из vCPU Цикл
		Для Каждого ИдентификаторИсполнителя Из Исполнители Цикл
			Если ЧислоИзмеренийПары(Измерения, ИдентификаторvCPU, ИдентификаторИсполнителя) < 3 Тогда
				ВызватьИсключение "Для каждой пары исполнитель/vCPU нужно не менее трех повторов";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ВремяПоvCPU = Новый Массив;
	Для Каждого ИдентификаторvCPU Из vCPU Цикл
		ВремяПоvCPU.Добавить(МедианаПоИдентификатору(Измерения, "ИдентификаторvCPU", ИдентификаторvCPU));
	КонецЦикла;
	ВремяПоИсполнителям = Новый Массив;
	Для Каждого ИдентификаторИсполнителя Из Исполнители Цикл
		ВремяПоИсполнителям.Добавить(МедианаПоИдентификатору(Измерения, "ИдентификаторИсполнителя", ИдентификаторИсполнителя));
	КонецЦикла;

	РазбросvCPU = РассчитатьРазбросПроцентов(ВремяПоvCPU);
	РазбросИсполнителей = РассчитатьРазбросПроцентов(ВремяПоИсполнителям);
	Если РазбросvCPU >= ПорогАсимметрииПроцентов И РазбросИсполнителей < ПорогАсимметрииПроцентов Тогда
		Классификация = "Задержка следует за vCPU";
	ИначеЕсли РазбросИсполнителей >= ПорогАсимметрииПроцентов И РазбросvCPU < ПорогАсимметрииПроцентов Тогда
		Классификация = "Задержка следует за исполнителем";
	ИначеЕсли РазбросИсполнителей >= ПорогАсимметрииПроцентов И РазбросvCPU >= ПорогАсимметрииПроцентов Тогда
		Классификация = "Смешанный эффект: vCPU и исполнитель";
	Иначе
		Классификация = "Асимметрия выше порога не выявлена";
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ЧислоvCPU", vCPU.Количество());
	Результат.Вставить("ЧислоИсполнителей", Исполнители.Количество());
	Результат.Вставить("РазбросvCPUПроцентов", РазбросvCPU);
	Результат.Вставить("РазбросИсполнителейПроцентов", РазбросИсполнителей);
	Результат.Вставить("ПорогАсимметрииПроцентов", ПорогАсимметрииПроцентов);
	Результат.Вставить("Классификация", Классификация);
	Результат.Вставить("КонтрольнаяСумма", КонтрольнаяСумма);
	Результат.Вставить("КоличествоИзмерений", Измерения.Количество());
	Результат.Вставить("Детали", "Перекрёстная матрица; affinity и таймер задаются внешним измерителем");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьУникальноеЗначение(Значения, Значение)

	Для Каждого Элемент Из Значения Цикл
		Если Элемент = Значение Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Значения.Добавить(Значение);

КонецПроцедуры

Процедура ПроверитьНазначенияПоПроходам(Измерения)

	Для ИндексПервого = 0 По Измерения.Количество() - 1 Цикл
		ПервоеИзмерение = Измерения[ИндексПервого];
		Для ИндексВторого = ИндексПервого + 1 По Измерения.Количество() - 1 Цикл
			ВтороеИзмерение = Измерения[ИндексВторого];
			Если Строка(ПервоеИзмерение.ИдентификаторПрохода) <> Строка(ВтороеИзмерение.ИдентификаторПрохода) Тогда
				Продолжить;
			КонецЕсли;
			Если Строка(ПервоеИзмерение.ИдентификаторvCPU) = Строка(ВтороеИзмерение.ИдентификаторvCPU)
				И Строка(ПервоеИзмерение.ИдентификаторИсполнителя) <> Строка(ВтороеИзмерение.ИдентификаторИсполнителя) Тогда
				ВызватьИсключение "В каждом проходе на vCPU должен быть закреплён один исполнитель";
			КонецЕсли;
			Если Строка(ПервоеИзмерение.ИдентификаторИсполнителя) = Строка(ВтороеИзмерение.ИдентификаторИсполнителя)
				И Строка(ПервоеИзмерение.ИдентификаторvCPU) <> Строка(ВтороеИзмерение.ИдентификаторvCPU) Тогда
				ВызватьИсключение "В каждом проходе исполнитель должен быть закреплён на одном vCPU";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ЧислоИзмеренийПары(Измерения, ИдентификаторvCPU, ИдентификаторИсполнителя)

	Количество = 0;
	Для Каждого Измерение Из Измерения Цикл
		Если Строка(Измерение.ИдентификаторvCPU) = ИдентификаторvCPU
			И Строка(Измерение.ИдентификаторИсполнителя) = ИдентификаторИсполнителя Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

Функция МедианаПоИдентификатору(Измерения, ИмяИдентификатора, Идентификатор)

	Значения = Новый СписокЗначений;
	Для Каждого Измерение Из Измерения Цикл
		ЗначениеИД = "";
		Если Не Измерение.Свойство(ИмяИдентификатора, ЗначениеИД) Тогда
			ВызватьИсключение "Измерение не содержит " + ИмяИдентификатора;
		КонецЕсли;
		Если Строка(ЗначениеИД) = Идентификатор Тогда
			Значения.Добавить(Измерение.ДлительностьМикросекунд / Измерение.ЧислоОпераций);
		КонецЕсли;
	КонецЦикла;
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество = 0 Тогда
		ВызватьИсключение "Нет измерений для " + ИмяИдентификатора + " " + Идентификатор;
	КонецЕсли;
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение)
		+ Число(Значения[Количество / 2].Значение)) / 2;

КонецФункции

Функция РассчитатьРазбросПроцентов(Значения)

	Минимум = 0;
	Максимум = 0;
	Для Индекс = 0 По Значения.Количество() - 1 Цикл
		Если Индекс = 0 Тогда
			Минимум = Значения[Индекс];
			Максимум = Значения[Индекс];
		Иначе
			Минимум = Мин(Минимум, Значения[Индекс]);
			Максимум = Макс(Максимум, Значения[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Если Минимум <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Окр((Максимум / Минимум - 1) * 100, 2);

КонецФункции

#КонецОбласти
