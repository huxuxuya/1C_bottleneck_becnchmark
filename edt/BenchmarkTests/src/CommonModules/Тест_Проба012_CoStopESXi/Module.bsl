#Область СлужебныеПроцедурыИФункции

Процедура Тест_Проба012_CoStopESXi() Экспорт

	МеньшаяВМ = СоздатьВариантВМ(2, 2, 3, 4, 100);
	БольшаяВМ = СоздатьВариантВМ(4, 2, 6, 6, 90);
	Результат = БенчмаркПроба012CoStopESXi.СравнитьРазмерыВМ(МеньшаяВМ, БольшаяВМ);

	ЮТест.ОжидаетЧто(Результат.РазмерМеньшейВМvCPU).Равно(2);
	ЮТест.ОжидаетЧто(Результат.РазмерБольшейВМvCPU).Равно(4);
	ЮТест.ОжидаетЧто(Результат.ИзменениеCStopПп).Равно(3);
	ЮТест.ОжидаетЧто(Результат.ИзменениеReadyПп).Равно(2);
	ЮТест.ОжидаетЧто(Результат.ИзменениеРаботыПроцентов).Равно(-10);
	ЮТест.ОжидаетЧто(Результат.Детали).Содержит("не собираются");

	БольшаяВМ.ЧислоАктивныхИсполнителей = 3;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба012CoStopESXi.СравнитьРазмерыВМ(МеньшаяВМ, БольшаяВМ);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);

КонецПроцедуры

Функция СоздатьВариантВМ(РазмерvCPU, АктивныхИсполнителей, БазовыйCStop, БазовыйReady, БазоваяРабота)

	Наблюдения = Новый Массив;
	Для Индекс = 0 По 2 Цикл
		Наблюдения.Добавить(Новый Структура("CStopПроцент,ReadyПроцент,РаботаВСекунду",
			БазовыйCStop + Индекс - 1, БазовыйReady + Индекс - 1, БазоваяРабота + (Индекс - 1) * 10));
	КонецЦикла;
	Возврат Новый Структура("РазмерВМvCPU,ЧислоАктивныхИсполнителей,ИдентификаторСтенда,ИдентификаторРазмещения,ИдентификаторНагрузки,Наблюдения",
		РазмерvCPU, АктивныхИсполнителей, "esxi-lab-01", "cluster-a/pool-1", "workload-a", Наблюдения);

КонецФункции

#КонецОбласти
