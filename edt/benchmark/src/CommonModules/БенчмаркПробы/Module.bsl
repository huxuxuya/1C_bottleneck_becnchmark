// Набор атомарных и прикладных проб производительности 1С с проверяемым результатом.

#Область ПрограммныйИнтерфейс

// Проба 001 (docs/tests/cpu/001.md): Скорость одного ядра.
// Выполняет прогрев, затем серию замеров зависимой арифметической цепочки с контрольной суммой.
//
// Параметры:
//  ЧислоПрогревов - Число - число прогревочных запусков (>= 0).
//  ЧислоСерий - Число - число замерных серий (> 0).
//  ИтерацийВСерии - Число - длина цепочки в каждой серии (> 0).
//  ЭталонНсДля3000МГц - Число - калибровочная длительность одной итерации при 3000 МГц.
//
// Возвращаемое значение:
//  Структура:
//      * КонтрольнаяСумма - Число
//      * МинМс - Число
//      * МедианаМс - Число
//      * МаксМс - Число
//      * НсНаИтерацию - Число
//      * РасчетнаяЧастотаМГц - Число
//      * ДлительностиМс - Массив Из Число
//
Функция Проба001_СкоростьОдногоЯдра(Знач ЧислоПрогревов, Знач ЧислоСерий = 5, Знач ИтерацийВСерии = 100000, Знач ЭталонНсДля3000МГц = 250) Экспорт

	Если ЧислоПрогревов < 0 Или ЧислоСерий <= 0 Или ИтерацийВСерии <= 0 Тогда
		ВызватьИсключение "Некорректные параметры Пробы 001";
	КонецЕсли;

	Для Шаг = 1 По ЧислоПрогревов Цикл
		ПробаОдинПотокBSL(ИтерацийВСерии);
	КонецЦикла;

	ДлительностиМс = Новый Массив;
	Отсортированные = Новый СписокЗначений;
	КонтрольнаяСумма = 0;

	Для Серия = 1 По ЧислоСерий Цикл
		Замер = ПробаОдинПотокBSL(ИтерацийВСерии);
		Если Серия = 1 Тогда
			КонтрольнаяСумма = Замер.КонтрольнаяСумма;
		ИначеЕсли КонтрольнаяСумма <> Замер.КонтрольнаяСумма Тогда
			ВызватьИсключение "Нарушена детерминированность контрольной суммы в Пробе 001";
		КонецЕсли;
		ДлительностиМс.Добавить(Замер.ДлительностьМс);
		Отсортированные.Добавить(Замер.ДлительностьМс);
	КонецЦикла;

	Отсортированные.СортироватьПоЗначению();
	МинМс = Число(Отсортированные[0].Значение);
	МаксМс = Число(Отсортированные[ЧислоСерий - 1].Значение);
	МедианаМс = Число(Отсортированные[Цел((ЧислоСерий - 1) / 2)].Значение);
	НсНаИтерацию = (МедианаМс * 1000000) / ИтерацийВСерии;
	Если НсНаИтерацию > 0 Тогда
		РасчетнаяЧастотаМГц = Окр((3000 * ЭталонНсДля3000МГц) / НсНаИтерацию, 0);
	Иначе
		РасчетнаяЧастотаМГц = 0;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("КонтрольнаяСумма", КонтрольнаяСумма);
	Результат.Вставить("МинМс", МинМс);
	Результат.Вставить("МедианаМс", МедианаМс);
	Результат.Вставить("МаксМс", МаксМс);
	Результат.Вставить("НсНаИтерацию", НсНаИтерацию);
	Результат.Вставить("РасчетнаяЧастотаМГц", РасчетнаяЧастотаМГц);
	Результат.Вставить("ДлительностиМс", ДлительностиМс);
	Возврат Результат;

КонецФункции

// Проба 1 (CPU / один поток BSL): зависимая цепочка целочисленных операций без обращений к БД.
//
// Параметры:
//  ЧислоИтераций - Число - длина цепочки (>= 0).
//
// Возвращаемое значение:
//  Структура:
//      * КонтрольнаяСумма - Число
//      * ДлительностьМс - Число
//      * ЧислоИтераций - Число
//
Функция ПробаОдинПотокBSL(Знач ЧислоИтераций = 100000) Экспорт

	Если ЧислоИтераций < 0 Тогда
		ВызватьИсключение "Число итераций не может быть отрицательным";
	КонецЕсли;

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Состояние = 1;

	Для Индекс = 1 По ЧислоИтераций Цикл
		Состояние = (Состояние * 1103515 + Индекс * 31) % 1000003;
	КонецЦикла;

	КонецМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Результат = Новый Структура;
	Результат.Вставить("КонтрольнаяСумма", Состояние);
	Результат.Вставить("ДлительностьМс", КонецМс - НачалоМс);
	Результат.Вставить("ЧислоИтераций", ЧислоИтераций);
	Возврат Результат;

КонецФункции

// Проба 2 (Память / рабочий набор): создание, последовательный обход и поиск по ключу.
//
// Параметры:
//  РазмерНабора - Число - количество строк в коллекции (> 0).
//  ЧислоПоисков - Число - количество операций поиска по ключу (>= 0).
//
// Возвращаемое значение:
//  Структура:
//      * ВремяСозданияМс - Число
//      * ВремяОбходаМс - Число
//      * ВремяПоискаМс - Число
//      * КонтрольнаяСумма - Число
//
Функция ПробаРабочийНаборКоллекции(Знач РазмерНабора = 5000, Знач ЧислоПоисков = 1000) Экспорт

	Если РазмерНабора <= 0 Или ЧислоПоисков < 0 Тогда
		ВызватьИсключение "Некорректные параметры рабочего набора";
	КонецЕсли;

	НачалоСозданияМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Значение", Новый ОписаниеТипов("Число"));
	Карта = Новый Соответствие;

	Для Индекс = 1 По РазмерНабора Цикл
		Строка = Таблица.Добавить();
		Строка.Ключ = Индекс;
		Строка.Значение = (Индекс * 17) % 1009;
		Карта.Вставить(Индекс, Строка.Значение);
	КонецЦикла;
	КонецСозданияМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	СуммаОбхода = 0;
	Для Каждого Строка Из Таблица Цикл
		СуммаОбхода = СуммаОбхода + Строка.Значение;
	КонецЦикла;
	КонецОбходаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	СуммаПоиска = 0;
	Для Шаг = 1 По ЧислоПоисков Цикл
		ИскомыйКлюч = 1 + ((Шаг * 73) % РазмерНабора);
		Найденное = Карта.Получить(ИскомыйКлюч);
		Если Найденное <> Неопределено Тогда
			СуммаПоиска = СуммаПоиска + Найденное;
		КонецЕсли;
	КонецЦикла;
	КонецПоискаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Результат = Новый Структура;
	Результат.Вставить("ВремяСозданияМс", КонецСозданияМс - НачалоСозданияМс);
	Результат.Вставить("ВремяОбходаМс", КонецОбходаМс - КонецСозданияМс);
	Результат.Вставить("ВремяПоискаМс", КонецПоискаМс - КонецОбходаМс);
	Результат.Вставить("КонтрольнаяСумма", СуммаОбхода + СуммаПоиска);
	Возврат Результат;

КонецФункции

// Проба 3 (БД / точечный запрос по индексу): серия одиночных выборок по ссылке товара.
//
// Параметры:
//  МассивТоваров - Массив из СправочникСсылка.Товары - ссылки на товары.
//  ЧислоЗапросов - Число - число последовательных запросов (> 0).
//
// Возвращаемое значение:
//  Структура:
//      * НайденоСтрок - Число
//      * КонтрольнаяСумма - Число
//      * ДлительностьМс - Число
//
Функция ПробаТочечныйЗапросПоИндексу(Знач МассивТоваров, Знач ЧислоЗапросов = 50) Экспорт

	Если МассивТоваров.Количество() = 0 Или ЧислоЗапросов <= 0 Тогда
		ВызватьИсключение "Требуются непустой массив товаров и положительное число запросов";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Код КАК Код
	|ИЗ
	|	Справочник.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Товар";

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НайденоСтрок = 0;
	КонтрольнаяСумма = 0;

	// Отдельный индексный запрос на каждой итерации — измеряемая нагрузка этой пробы.
	Для Индекс = 1 По ЧислоЗапросов Цикл
		Товар = МассивТоваров[(Индекс - 1) % МассивТоваров.Количество()];
		Запрос.УстановитьПараметр("Товар", Товар);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НайденоСтрок = НайденоСтрок + 1;
			КонтрольнаяСумма = КонтрольнаяСумма + СтрДлина(Выборка.Код);
		КонецЦикла;
	КонецЦикла;

	КонецМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Результат = Новый Структура;
	Результат.Вставить("НайденоСтрок", НайденоСтрок);
	Результат.Вставить("КонтрольнаяСумма", КонтрольнаяСумма);
	Результат.Вставить("ДлительностьМс", КонецМс - НачалоМс);
	Возврат Результат;

КонецФункции

// Проба 4 (БД / выборка, соединение, группировка и сортировка по документам серии).
//
// Параметры:
//  ИдентификаторСерии - Строка - метка серии документов.
//
// Возвращаемое значение:
//  Структура:
//      * КоличествоСтрок - Число
//      * ИтогоКоличество - Число
//      * ИтогоСумма - Число
//      * ДлительностьМс - Число
//
Функция ПробаВыборкаСоединениеСортировка(Знач ИдентификаторСерии) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабличнаяЧасть.Товар КАК Товар,
	|	СУММА(ТабличнаяЧасть.Количество) КАК Количество,
	|	СУММА(ТабличнаяЧасть.Сумма) КАК Сумма
	|ИЗ
	|	Документ.ДвижениеТоваров.Товары КАК ТабличнаяЧасть
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Товары КАК СправочникТовары
	|		ПО ТабличнаяЧасть.Товар = СправочникТовары.Ссылка
	|ГДЕ
	|	ТабличнаяЧасть.Ссылка.ИдентификаторСерии = &ИдентификаторСерии
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабличнаяЧасть.Товар
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сумма УБЫВ";
	Запрос.УстановитьПараметр("ИдентификаторСерии", ИдентификаторСерии);

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Выборка = Запрос.Выполнить().Выбрать();

	КоличествоСтрок = 0;
	ИтогоКоличество = 0;
	ИтогоСумма = 0;
	Пока Выборка.Следующий() Цикл
		КоличествоСтрок = КоличествоСтрок + 1;
		ИтогоКоличество = ИтогоКоличество + Выборка.Количество;
		ИтогоСумма = ИтогоСумма + Выборка.Сумма;
	КонецЦикла;
	КонецМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Результат = Новый Структура;
	Результат.Вставить("КоличествоСтрок", КоличествоСтрок);
	Результат.Вставить("ИтогоКоличество", ИтогоКоличество);
	Результат.Вставить("ИтогоСумма", ИтогоСумма);
	Результат.Вставить("ДлительностьМс", КонецМс - НачалоМс);
	Возврат Результат;

КонецФункции

// Проба 5 (Транзакции / фиксация): сравнение раздельных фиксаций и пакетной транзакции.
//
// Параметры:
//  МассивТоваров - Массив из СправочникСсылка.Товары - товары для создания документов.
//  Склад - СправочникСсылка.Склады - склад.
//  ЧислоЗаписей - Число - количество документов (по 1 строке).
//  ВОднуТранзакцию - Булево - оборачивать ли все записи в одну транзакцию.
//  ИдентификаторСерии - Строка - метка серии для последующей очистки.
//
// Возвращаемое значение:
//  Структура:
//      * ЧислоЗаписей - Число
//      * ВОднуТранзакцию - Булево
//      * ДлительностьМс - Число
//      * КонтрольнаяСумма - Число
//
Функция ПробаФиксацияТранзакции(Знач МассивТоваров, Знач Склад, Знач ЧислоЗаписей = 10, Знач ВОднуТранзакцию = Ложь, Знач ИдентификаторСерии = "") Экспорт

	Если ЧислоЗаписей <= 0 Тогда
		ВызватьИсключение "Число записей должно быть больше нуля";
	КонецЕсли;

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонтрольнаяСумма = 0;

	Если ВОднуТранзакцию Тогда
		НачатьТранзакцию();
	КонецЕсли;

	Попытка
		Для Индекс = 1 По ЧислоЗаписей Цикл
			ПараметрыДокумента = Новый Структура;
			ПараметрыДокумента.Вставить("Товары", МассивТоваров);
			ПараметрыДокумента.Вставить("Склад", Склад);
			ПараметрыДокумента.Вставить("ЧислоСтрок", 1);
			ПараметрыДокумента.Вставить("ИдентификаторСерии", ИдентификаторСерии);
			ПараметрыДокумента.Вставить("Проводить", Ложь);

			Инфо = БенчмаркГенераторДанных.СоздатьДокументДвижения(ПараметрыДокумента);
			КонтрольнаяСумма = КонтрольнаяСумма + Инфо.СуммаВсего;
		КонецЦикла;

		Если ВОднуТранзакцию Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если ВОднуТранзакцию И ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	КонецМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Результат = Новый Структура;
	Результат.Вставить("ЧислоЗаписей", ЧислоЗаписей);
	Результат.Вставить("ВОднуТранзакцию", ВОднуТранзакцию);
	Результат.Вставить("ДлительностьМс", КонецМс - НачалоМс);
	Результат.Вставить("КонтрольнаяСумма", КонтрольнаяСумма);
	Возврат Результат;

КонецФункции

// Проба 6 (Прикладная операция): проведение документа с проверкой сформированных движений.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка.ДвижениеТоваров - документ для проведения.
//
// Возвращаемое значение:
//  Структура:
//      * ДлительностьМс - Число
//      * КоличествоДвижений - Число
//      * СуммаКоличество - Число
//
Функция ПробаПроведениеДокумента(Знач СсылкаНаДокумент) Экспорт

	Объект = СсылкаНаДокумент.ПолучитьОбъект();

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	КонецМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	НаборЗаписей = РегистрыНакопления.ОстаткиТоваров.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(СсылкаНаДокумент);
	НаборЗаписей.Прочитать();

	СуммаКоличество = 0;
	Для Каждого Запись Из НаборЗаписей Цикл
		СуммаКоличество = СуммаКоличество + Запись.Количество;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ДлительностьМс", КонецМс - НачалоМс);
	Результат.Вставить("КоличествоДвижений", НаборЗаписей.Количество());
	Результат.Вставить("СуммаКоличество", СуммаКоличество);
	Возврат Результат;

КонецФункции

#КонецОбласти
