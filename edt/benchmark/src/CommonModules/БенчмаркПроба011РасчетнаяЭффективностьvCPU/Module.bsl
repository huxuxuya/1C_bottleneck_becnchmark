#Область ПрограммныйИнтерфейс

// Возвращает скорость BSL-цикла пробы 001 и её эквивалент на выбранной шкале.
// Параметры:
//  ЧислоПрогревов - Число - число прогревочных запусков (>= 0).
//  ЧислоСерий - Число - число измеряемых повторов (> 0).
//  ИтерацийВСерии - Число - итерации в одном повторе (> 0).
//  БазаНс - Число, Неопределено - нс/итерацию при 3000 условных МГц.
// Возвращаемое значение:
//  Структура: условные МГц BSL, нс на итерацию, медианная длительность,
//  контрольная сумма и детали.
Функция Проба011_РасчетнаяЭффективностьvCPU(Знач ЧислоПрогревов = 1, Знач ЧислоСерий = 5, Знач ИтерацийВСерии = 100000, Знач БазаНс = 250) Экспорт

	Замер = БенчмаркПробы.Проба001_СкоростьОдногоЯдра(ЧислоПрогревов, ЧислоСерий, ИтерацийВСерии, БазаНс);
	Результат = Новый Структура;
	Результат.Вставить("ЭквивалентЭталонаМГц", Замер.ЭквивалентЭталонаМГц);
	Результат.Вставить("РасчетнаяЧастотаМГц", Замер.ЭквивалентЭталонаМГц);
	Результат.Вставить("НсНаИтерацию", Замер.НсНаИтерацию);
	Результат.Вставить("МедианаМс", Замер.МедианаМс);
	Результат.Вставить("КонтрольнаяСумма", Замер.КонтрольнаяСумма);
	Результат.Вставить("Детали", Замер.Детали + "; CPU Ready гипервизора не измеряется");
	Возврат Результат;

КонецФункции

#КонецОбласти
