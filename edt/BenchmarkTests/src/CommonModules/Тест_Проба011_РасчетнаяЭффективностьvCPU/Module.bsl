#Область ПрограммныйИнтерфейс

// Регистрирует один серверный YAxUnit-тест.
Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты.ДобавитьТестовыйНабор("Пробы и генератор")
        .ДобавитьСерверныйТест("Тест_Проба011_РасчетнаяЭффективностьvCPU");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_Проба011_РасчетнаяЭффективностьvCPU() Экспорт

	Результат = БенчмаркПроба011РасчетнаяЭффективностьvCPU.Проба011_РасчетнаяЭффективностьvCPU(0, 1, 5000);

	Если Результат.МедианаМс >= 10 Тогда
		ЮТест.ОжидаетЧто(Результат.РасчетнаяЧастотаМГц).Равно(Окр(750000 / Результат.НсНаИтерацию, 0));
	Иначе
		ЮТест.ОжидаетЧто(Результат.РасчетнаяЧастотаМГц = Неопределено).Равно(Истина);
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.НсНаИтерацию).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.Детали).Содержит("CPU Ready гипервизора не измеряется");

КонецПроцедуры

#КонецОбласти
