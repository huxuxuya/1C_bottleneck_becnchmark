#Область ПрограммныйИнтерфейс

// Регистрирует один серверный YAxUnit-тест.
Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты.ДобавитьТестовыйНабор("Пробы и генератор")
        .ДобавитьСерверныйТест("Тест_Проба001_СкоростьОдногоЯдра")
        .ДобавитьСерверныйТест("Тест_Проба026_АдаптивныйПакет");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_Проба001_СкоростьОдногоЯдра() Экспорт

	Результат = БенчмаркПробы.Проба001_СкоростьОдногоЯдра(1, 3, 2000);
	Эталон = БенчмаркПробы.ПробаОдинПотокBSL(2000);

	ЮТест.ОжидаетЧто(Результат.КонтрольнаяСумма).Равно(Эталон.КонтрольнаяСумма);
	ЮТест.ОжидаетЧто(Результат.ДлительностиМс.Количество()).Равно(3);
	ЮТест.ОжидаетЧто(Результат.МинМс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.МедианаМс).БольшеИлиРавно(Результат.МинМс);
	ЮТест.ОжидаетЧто(Результат.МаксМс).БольшеИлиРавно(Результат.МедианаМс);
	ЮТест.ОжидаетЧто(Результат.НсНаИтерацию).БольшеИлиРавно(0);
	Если Результат.МедианаМс >= 10 Тогда
		ЮТест.ОжидаетЧто(Результат.РасчетнаяЧастотаМГц).Равно(Окр(750000 / Результат.НсНаИтерацию, 0));
	Иначе
		ЮТест.ОжидаетЧто(Результат.РасчетнаяЧастотаМГц = Неопределено).Равно(Истина);
	КонецЕсли;

КонецПроцедуры

Процедура Тест_Проба026_АдаптивныйПакет() Экспорт
	Замер = БенчмаркПробы.Проба026_СкоростьBSL(10000, 300);
	ЮТест.ОжидаетЧто(Замер.ДлительностиМс.Количество()).Равно(7);
	ЮТест.ОжидаетЧто(Замер.ИтерацийВСерии).БольшеИлиРавно(10000);
	ЮТест.ОжидаетЧто(Замер.ЭквивалентЭталонаМГц).Равно(Окр(900000 / Замер.НсНаИтерацию, 0));
КонецПроцедуры

#КонецОбласти
