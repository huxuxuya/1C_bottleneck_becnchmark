// Анализирует гостевую задержку обхода до, во время и после контролируемого давления памяти.
// Balloon, host swap и guest swap считываются внешними адаптерами и нормализуются в байты.

#Область ПрограммныйИнтерфейс

// Каждая серия содержит минимум три наблюдения с одинаковыми стендом, нагрузкой,
// числом страниц и контрольной суммой. Фазы: До, ВоВремя, После.
Функция АнализироватьДавлениеПамяти(Знач НаблюденияДо, Знач НаблюденияВоВремя, Знач НаблюденияПосле,
	Знач ПорогИзмененияПамятиБайт = 0, Знач ДопустимоеОтклонениеВосстановленияПроцентов = 10) Экспорт

	Если ПорогИзмененияПамятиБайт < 0 Или ДопустимоеОтклонениеВосстановленияПроцентов <= 0 Тогда
		ВызватьИсключение "Порог изменения памяти должен быть неотрицательным, а порог восстановления - положительным";
	КонецЕсли;
	ПроверитьФазу(НаблюденияДо, "До");
	ПроверитьФазу(НаблюденияВоВремя, "ВоВремя");
	ПроверитьФазу(НаблюденияПосле, "После");
	ПроверитьСопоставимостьФаз(НаблюденияДо, НаблюденияВоВремя);
	ПроверитьСопоставимостьФаз(НаблюденияДо, НаблюденияПосле);

	BalloonДо = МедианаМетрики(НаблюденияДо, "BalloonБайт");
	BalloonВоВремя = МедианаМетрики(НаблюденияВоВремя, "BalloonБайт");
	BalloonПосле = МедианаМетрики(НаблюденияПосле, "BalloonБайт");
	HostSwapДо = МедианаМетрики(НаблюденияДо, "HostSwapБайт");
	HostSwapВоВремя = МедианаМетрики(НаблюденияВоВремя, "HostSwapБайт");
	HostSwapПосле = МедианаМетрики(НаблюденияПосле, "HostSwapБайт");
	GuestSwapДо = МедианаМетрики(НаблюденияДо, "GuestSwapБайт");
	GuestSwapВоВремя = МедианаМетрики(НаблюденияВоВремя, "GuestSwapБайт");
	GuestSwapПосле = МедианаМетрики(НаблюденияПосле, "GuestSwapБайт");
	ОбходДо = МедианаМетрики(НаблюденияДо, "ДлительностьОбходаМс");
	ОбходВоВремя = МедианаМетрики(НаблюденияВоВремя, "ДлительностьОбходаМс");
	ОбходПосле = МедианаМетрики(НаблюденияПосле, "ДлительностьОбходаМс");

	ИзменениеBalloon = BalloonВоВремя - BalloonДо;
	ИзменениеHostSwap = HostSwapВоВремя - HostSwapДо;
	ИзменениеGuestSwap = GuestSwapВоВремя - GuestSwapДо;
	BalloonВырос = ИзменениеBalloon > ПорогИзмененияПамятиБайт;
	HostSwapВырос = ИзменениеHostSwap > ПорогИзмененияПамятиБайт;
	GuestSwapВырос = ИзменениеGuestSwap > ПорогИзмененияПамятиБайт;
	ПодкачкаАктивна = HostSwapВырос Или GuestSwapВырос;
	Если BalloonВырос И ПодкачкаАктивна Тогда
		Классификация = "Одновременно выросли balloon и подкачка";
	ИначеЕсли BalloonВырос Тогда
		Классификация = "Balloon вырос без подтверждённой подкачки";
	ИначеЕсли ПодкачкаАктивна Тогда
		Классификация = "Подкачка подтверждена счётчиками";
	Иначе
		Классификация = "Счётчики не подтверждают давление памяти";
	КонецЕсли;

	СдвигОбходаВоВремя = Окр((ОбходВоВремя / ОбходДо - 1) * 100, 2);
	СдвигОбходаПосле = Окр((ОбходПосле / ОбходДо - 1) * 100, 2);
	АбсолютноеОтклонениеПосле = СдвигОбходаПосле;
	Если АбсолютноеОтклонениеПосле < 0 Тогда
		АбсолютноеОтклонениеПосле = -АбсолютноеОтклонениеПосле;
	КонецЕсли;
	ВосстановлениеНаблюдается = АбсолютноеОтклонениеПосле <= ДопустимоеОтклонениеВосстановленияПроцентов;
	Результат = Новый Структура;
	Результат.Вставить("BalloonДоБайт", BalloonДо);
	Результат.Вставить("BalloonВоВремяБайт", BalloonВоВремя);
	Результат.Вставить("BalloonПослеБайт", BalloonПосле);
	Результат.Вставить("ИзменениеBalloonВоВремяБайт", ИзменениеBalloon);
	Результат.Вставить("ИзменениеHostSwapВоВремяБайт", ИзменениеHostSwap);
	Результат.Вставить("ИзменениеGuestSwapВоВремяБайт", ИзменениеGuestSwap);
	Результат.Вставить("ПодкачкаАктивна", ПодкачкаАктивна);
	Результат.Вставить("Классификация", Классификация);
	Результат.Вставить("ОбходДоМс", ОбходДо);
	Результат.Вставить("ОбходВоВремяМс", ОбходВоВремя);
	Результат.Вставить("ОбходПослеМс", ОбходПосле);
	Результат.Вставить("СдвигОбходаВоВремяПроцентов", СдвигОбходаВоВремя);
	Результат.Вставить("СдвигОбходаПослеПроцентов", СдвигОбходаПосле);
	Результат.Вставить("ВосстановлениеНаблюдается", ВосстановлениеНаблюдается);
	Результат.Вставить("Детали", "Медианы внешних счётчиков и задержки обхода для трёх фаз");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьФазу(Наблюдения, ОжидаемаяФаза)

	Если Наблюдения.Количество() < 3 Тогда
		ВызватьИсключение "Для каждой фазы нужны минимум три наблюдения";
	КонецЕсли;
	Первое = Наблюдения[0];
	ПроверитьНаблюдение(Первое, ОжидаемаяФаза);
	Для Каждого Наблюдение Из Наблюдения Цикл
		ПроверитьНаблюдение(Наблюдение, ОжидаемаяФаза);
		Если Наблюдение.ИдентификаторСтенда <> Первое.ИдентификаторСтенда
			Или Наблюдение.ИдентификаторНагрузки <> Первое.ИдентификаторНагрузки
			Или Наблюдение.ЧислоСтраниц <> Первое.ЧислоСтраниц
			Или Наблюдение.КонтрольнаяСумма <> Первое.КонтрольнаяСумма Тогда
			ВызватьИсключение "Наблюдения одной фазы должны выполнять одинаковую работу";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНаблюдение(Наблюдение, ОжидаемаяФаза)

	Если Не Наблюдение.Свойство("Фаза") Или Наблюдение.Фаза <> ОжидаемаяФаза Тогда
		ВызватьИсключение "Наблюдение не относится к фазе " + ОжидаемаяФаза;
	КонецЕсли;
	Если Не Наблюдение.Свойство("ИдентификаторСтенда") Или ПустаяСтрока(Строка(Наблюдение.ИдентификаторСтенда))
		Или Не Наблюдение.Свойство("ИдентификаторНагрузки") Или ПустаяСтрока(Строка(Наблюдение.ИдентификаторНагрузки)) Тогда
		ВызватьИсключение "Не заданы стенд или нагрузка";
	КонецЕсли;
	Если Не Наблюдение.Свойство("ЧислоСтраниц") Или Наблюдение.ЧислоСтраниц <= 0
		Или Не Наблюдение.Свойство("КонтрольнаяСумма") Тогда
		ВызватьИсключение "Не заданы число страниц или контрольная сумма";
	КонецЕсли;
	Если Не Наблюдение.Свойство("BalloonБайт") Или Наблюдение.BalloonБайт < 0
		Или Не Наблюдение.Свойство("HostSwapБайт") Или Наблюдение.HostSwapБайт < 0
		Или Не Наблюдение.Свойство("GuestSwapБайт") Или Наблюдение.GuestSwapБайт < 0 Тогда
		ВызватьИсключение "Счётчики памяти не могут быть отрицательными";
	КонецЕсли;
	Если Не Наблюдение.Свойство("ДлительностьОбходаМс") Или Наблюдение.ДлительностьОбходаМс <= 0 Тогда
		ВызватьИсключение "Длительность обхода должна быть больше нуля";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСопоставимостьФаз(ПерваяФаза, ВтораяФаза)

	Первое = ПерваяФаза[0];
	Второе = ВтораяФаза[0];
	Если Первое.ИдентификаторСтенда <> Второе.ИдентификаторСтенда
		Или Первое.ИдентификаторНагрузки <> Второе.ИдентификаторНагрузки
		Или Первое.ЧислоСтраниц <> Второе.ЧислоСтраниц
		Или Первое.КонтрольнаяСумма <> Второе.КонтрольнаяСумма Тогда
		ВызватьИсключение "Фазы должны использовать один стенд и одинаковую полезную работу";
	КонецЕсли;

КонецПроцедуры

Функция МедианаМетрики(Наблюдения, ИмяМетрики)

	Значения = Новый СписокЗначений;
	Для Каждого Наблюдение Из Наблюдения Цикл
		ЗначениеМетрики = 0;
		Если Не Наблюдение.Свойство(ИмяМетрики, ЗначениеМетрики) Тогда
			ВызватьИсключение "Наблюдение не содержит метрику " + ИмяМетрики;
		КонецЕсли;
		Значения.Добавить(ЗначениеМетрики);
	КонецЦикла;
	Значения.СортироватьПоЗначению();
	Количество = Значения.Количество();
	Если Количество % 2 = 1 Тогда
		Возврат Число(Значения[Цел(Количество / 2)].Значение);
	КонецЕсли;
	Возврат (Число(Значения[Количество / 2 - 1].Значение) + Число(Значения[Количество / 2].Значение)) / 2;

КонецФункции

#КонецОбласти
