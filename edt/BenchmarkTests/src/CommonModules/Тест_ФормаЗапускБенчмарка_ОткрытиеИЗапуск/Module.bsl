#Область ПрограммныйИнтерфейс

// Регистрирует один клиентский YAxUnit-тест.
Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты.ДобавитьТестовыйНабор("Интерфейс и формы")
        .ДобавитьКлиентскийТест("Тест_ФормаЗапускБенчмарка_ОткрытиеИЗапуск");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Тест_ФормаЗапускБенчмарка_ОткрытиеИЗапуск() Экспорт

	Форма = ОткрытьФорму("Обработка.ЗапускБенчмарка.Форма");

	ЮТест.ОжидаетЧто(Форма.Элементы.КнопкаВыполнитьПрогон.Видимость).Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.Элементы.КнопкаВыполнитьПрогон.Доступность).Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.Элементы.КнопкаВыполнитьВсеДиагностикиBSL.Видимость).Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.Элементы.КнопкаВыполнитьВсеДиагностикиBSL.Доступность).Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.Элементы.КнопкаВыполнитьНативнуюПробуCPU.Видимость).Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.Элементы.КнопкаВыполнитьНативнуюПробуCPU.Доступность).Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.Элементы.КнопкаВыполнитьНативныеДиагностикиCPU.Видимость).Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.Элементы.КнопкаВыполнитьНативныеДиагностикиCPU.Доступность).Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.МасштабНагрузки).Равно(1);

	Форма.МасштабНагрузки = 0.05;
	Форма.ВыполнитьПрогон(Неопределено);

	ЮТест.ОжидаетЧто(Форма.ОбщийБалл).Больше(0);
	ЮТест.ОжидаетЧто(Форма.Результаты.Количество()).Равно(18);
	ИдентификаторПрогонаБенчмарка = Форма.ИдентификаторПрогона;

	Форма.ВыполнитьВсеДиагностикиBSL(Неопределено);
	ЮТест.ОжидаетЧто(Форма.Результаты.Количество()).Равно(62);
	Для Каждого РезультатДиагностики Из Форма.Результаты Цикл
		Если РезультатДиагностики.Статус = "Ошибка" Тогда
			ВызватьИсключение РезультатДиагностики.Код + ": " + РезультатДиагностики.Детали;
		КонецЕсли;
		ЮТест.ОжидаетЧто(РезультатДиагностики.Статус = "Ошибка").Равно(Ложь);
	КонецЦикла;
	Форма.ОчиститьРезультатыПрогонаНаСервере(ИдентификаторПрогонаБенчмарка);
	Форма.ОчиститьРезультатыПрогонаНаСервере(Форма.ИдентификаторПрогона);

	ТестовыйJSONНативнойПробы = "{""schemaVersion"":1,""componentVersion"":""0.1.0"",""algorithm"":""dependent_u32_add_xor_7zip_style_v1"",""architecture"":""x86_64"",""compiler"":""test"",""blocksPerSample"":1000000,""warmups"":1,""sampleCount"":3,""sampleElapsedNs"":[1000,1100,1200],""minElapsedNs"":1000,""medianElapsedNs"":1100,""maxElapsedNs"":1200,""operationsPerSecond"":116363636,""estimatedMHz"":116.4,""checksum"":123456,""physicalClockRead"":false}";
	ДанныеНативнойПробы = Форма.РазобратьРезультатНативнойПробыCPU(ТестовыйJSONНативнойПробы);
	ЮТест.ОжидаетЧто(ДанныеНативнойПробы.estimatedMHz).Равно(116.4);
	ЮТест.ОжидаетЧто(ДанныеНативнойПробы.sampleElapsedNs.Количество()).Равно(3);

	ПодключитьВнешнююКомпоненту(
		"ОбщийМакет.CpuFrequencyProbe",
		"CpuFrequencyProbe",
		ТипВнешнейКомпоненты.Native);
	ИзмерительCPUКлиента = Новый("AddIn.CpuFrequencyProbe.CpuProbe");
	JSONИзмеренияКлиента = ИзмерительCPUКлиента.Measure(1000000, 1, 7);
	ДанныеИзмеренияКлиента = Форма.РазобратьРезультатНативнойПробыCPU(JSONИзмеренияКлиента);
	ЮТест.ОжидаетЧто(ДанныеИзмеренияКлиента.estimatedMHz > 0).Равно(Истина);
	JSONНативнойПробы002 = ИзмерительCPUКлиента.Measure(-2, 20000, 3);
	ДанныеНативнойПробы002 = Форма.РазобратьНативнуюДиагностикуCPU(JSONНативнойПробы002);
	ЮТест.ОжидаетЧто(ДанныеНативнойПробы002.probeCode)
		.Равно("CPU_002_INDEPENDENT_INSTRUCTIONS");

	ПараметрыНативныхДиагностик = Новый Массив;
	ПараметрыНативныхДиагностик.Добавить(Новый Структура("Код,КодВызова,Аргумент1,Аргумент2", "CPU_002_INDEPENDENT_INSTRUCTIONS", -2, 20000, 3));
	ПараметрыНативныхДиагностик.Добавить(Новый Структура("Код,КодВызова,Аргумент1,Аргумент2", "CPU_003_WAKE_LATENCY", -3, 3, 1));
	ПараметрыНативныхДиагностик.Добавить(Новый Структура("Код,КодВызова,Аргумент1,Аргумент2", "CPU_004_READY_QUEUE", -4, 1, 50));
	ПараметрыНативныхДиагностик.Добавить(Новый Структура("Код,КодВызова,Аргумент1,Аргумент2", "CPU_005_CPU_QUOTA", -5, 10, 0));
	ПараметрыНативныхДиагностик.Добавить(Новый Структура("Код,КодВызова,Аргумент1,Аргумент2", "CPU_006_SMT_COMPETITION", -6, 50, 0));
	ПараметрыНативныхДиагностик.Добавить(Новый Структура("Код,КодВызова,Аргумент1,Аргумент2", "CPU_007_CORE_MIGRATION", -7, 50, 1000));
	ПараметрыНативныхДиагностик.Добавить(Новый Структура("Код,КодВызова,Аргумент1,Аргумент2", "CPU_008_IDLE_RECOVERY", -8, 1, 10000));
	ПараметрыНативныхДиагностик.Добавить(Новый Структура("Код,КодВызова,Аргумент1,Аргумент2", "CPU_009_SUSTAINED_SPEED", -9, 50, 10));
	Для Каждого ПараметрыДиагностики Из ПараметрыНативныхДиагностик Цикл
		JSONНативнойДиагностики = ИзмерительCPUКлиента.Measure(
			ПараметрыДиагностики.КодВызова,
			ПараметрыДиагностики.Аргумент1,
			ПараметрыДиагностики.Аргумент2);
		ДанныеНативнойДиагностики = Форма.РазобратьНативнуюДиагностикуCPU(JSONНативнойДиагностики);
		ЮТест.ОжидаетЧто(ДанныеНативнойДиагностики.probeCode).Равно(ПараметрыДиагностики.Код);
		ЮТест.ОжидаетЧто(ТипЗнч(ДанныеНативнойДиагностики.measurements)).Равно(Тип("Структура"));
		ЮТест.ОжидаетЧто(ДанныеНативнойДиагностики.status = "Косвенный сигнал"
			Или ДанныеНативнойДиагностики.status = "Недоступно").Равно(Истина);
	КонецЦикла;

	JSONВсехНативныхДиагностик = ИзмерительCPUКлиента.Measure(-1, 0, 0);
	ДиагностикиКлиента = Форма.РазобратьНативныеДиагностикиCPU(JSONВсехНативныхДиагностик);
	ЮТест.ОжидаетЧто(ДиагностикиКлиента.Количество()).Равно(8);

	ИдентификаторПрогонаНативныхДиагностик = Строка(Новый УникальныйИдентификатор);
	ИтогНативныхДиагностик = Форма.ВыполнитьИЗаписатьНативныеДиагностикиCPUНаСервере(
		ИдентификаторПрогонаНативныхДиагностик,
		ДиагностикиКлиента);
	ЮТест.ОжидаетЧто(ИтогНативныхДиагностик.Количество).Равно(16);
	ЮТест.ОжидаетЧто(ИтогНативныхДиагностик.СерверУспешен).Равно(Истина);
	ЮТест.ОжидаетЧто(ИтогНативныхДиагностик.Доступно > 0).Равно(Истина);
	Форма.ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторПрогонаНативныхДиагностик);
	ЮТест.ОжидаетЧто(Форма.Результаты.Количество()).Равно(16);
	Для Каждого РезультатНативнойДиагностики Из Форма.Результаты Цикл
		ЮТест.ОжидаетЧто(Лев(РезультатНативнойДиагностики.КодПробы, 4)).Равно("NCPU");
		ЮТест.ОжидаетЧто(РезультатНативнойДиагностики.Статус = "Косвенный сигнал"
			Или РезультатНативнойДиагностики.Статус = "Недоступно").Равно(Истина);
	КонецЦикла;
	Форма.ОчиститьРезультатыПрогонаНаСервере(ИдентификаторПрогонаНативныхДиагностик);

	ИдентификаторНативногоПрогона = Строка(Новый УникальныйИдентификатор);
	ДеталиНативнойПробы = Форма.СформироватьДеталиНативнойПробыCPU(ДанныеИзмеренияКлиента);
	ЮТест.ОжидаетЧто(СтрНайти(ДеталиНативнойПробы, "не физическая частота") > 0).Равно(Истина);
	Форма.СохранитьНативнуюПробуCPUНаСервере(
		ИдентификаторНативногоПрогона,
		ДанныеИзмеренияКлиента.estimatedMHz,
		ДанныеИзмеренияКлиента.checksum,
		ДеталиНативнойПробы);
	Форма.ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторНативногоПрогона);

	ЮТест.ОжидаетЧто(Форма.Результаты.Количество()).Равно(1);
	НативныйРезультатВТаблице = Форма.Результаты[0];
	ЮТест.ОжидаетЧто(НативныйРезультатВТаблице.КодПробы).Равно("CPU_NATIVE_7ZIP");
	ЮТест.ОжидаетЧто(НативныйРезультатВТаблице.ЗначениеМетрики > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(НативныйРезультатВТаблице.ЕдиницаИзмерения).Равно("экв. МГц");
	ЮТест.ОжидаетЧто(НативныйРезультатВТаблице.Статус).Равно("Косвенный сигнал");

	РезультатСервернойНативнойПробы = Форма.ВыполнитьНативнуюПробуCPUНаСервере(
		ИдентификаторНативногоПрогона, 1000000, 1, 7);
	Если Не РезультатСервернойНативнойПробы.Успешно Тогда
		ВызватьИсключение "Серверная Native API-проба не выполнилась: "
			+ РезультатСервернойНативнойПробы.Ошибка;
	КонецЕсли;
	ЮТест.ОжидаетЧто(РезультатСервернойНативнойПробы.Успешно).Равно(Истина);
	ЮТест.ОжидаетЧто(РезультатСервернойНативнойПробы.ЗначениеМетрики > 0).Равно(Истина);
	Форма.ЗагрузитьРезультатыПрогонаНаСервере(ИдентификаторНативногоПрогона);
	ЮТест.ОжидаетЧто(Форма.Результаты.Количество()).Равно(2);
	ЕстьРезультатCPUКлиента = Ложь;
	ЕстьРезультатCPUСервера = Ложь;
	Для Каждого СтрокаНативногоРезультата Из Форма.Результаты Цикл
		Если СтрокаНативногоРезультата.КодПробы = "CPU_NATIVE_7ZIP" Тогда
			ЕстьРезультатCPUКлиента = Истина;
		ИначеЕсли СтрокаНативногоРезультата.КодПробы = "CPU_NATIVE_SERVER" Тогда
			ЕстьРезультатCPUСервера = Истина;
			ЮТест.ОжидаетЧто(СтрокаНативногоРезультата.ЗначениеМетрики > 0).Равно(Истина);
			ЮТест.ОжидаетЧто(СтрокаНативногоРезультата.ЕдиницаИзмерения).Равно("экв. МГц");
			ЮТест.ОжидаетЧто(СтрокаНативногоРезультата.Статус).Равно("Косвенный сигнал");
			ЮТест.ОжидаетЧто(СтрНайти(СтрокаНативногоРезультата.Детали, "execution_context=server") > 0).Равно(Истина);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЕстьРезультатCPUКлиента).Равно(Истина);
	ЮТест.ОжидаетЧто(ЕстьРезультатCPUСервера).Равно(Истина);
	Сообщить("CPU_NATIVE_VALUES|client="
		+ Строка(ДанныеИзмеренияКлиента.estimatedMHz)
		+ "|server=" + Строка(РезультатСервернойНативнойПробы.ЗначениеМетрики));
	Форма.ОчиститьРезультатыПрогонаНаСервере(ИдентификаторНативногоПрогона);

	Форма.Закрыть();

КонецПроцедуры

#КонецОбласти
