#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба022_ДавлениеНаTLB() Экспорт
	Обычные = СоздатьВариант("4k", 4096, 1000000, 10000);
	Крупные = СоздатьВариант("2m", 2097152, 700000, 2000);
	Результат = БенчмаркПроба022ДавлениеНаTLB.СравнитьРежимыСтраниц(Обычные, Крупные);
	ЮТест.ОжидаетЧто(Результат.ОбычныеСтраницы.МедианаНсНаДоступ).Равно(100);
	ЮТест.ОжидаетЧто(Результат.КрупныеСтраницы.МедианаНсНаДоступ).Равно(70);
	ЮТест.ОжидаетЧто(Результат.КрупныеСтраницы.PageWalksНа1000Доступов).Равно(200);
	ЮТест.ОжидаетЧто(Результат.СнижениеPageWalksПроцентов).Равно(80);

	Крупные.ФактическийРазмерСтраницыБайт = 4096;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба022ДавлениеНаTLB.СравнитьРежимыСтраниц(Обычные, Крупные);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);
КонецПроцедуры

Функция СоздатьВариант(ТипСтраниц, РазмерСтраницы, ВремяНс, PageWalks)
	Наблюдения = Новый Массив;
	Для Индекс = 1 По 3 Цикл
		Наблюдения.Добавить(Новый Структура("ЧислоДоступов,ДлительностьНс,ЧислоОбходовТаблицСтраниц,КонтрольнаяСумма",
			10000, ВремяНс, PageWalks, 913));
	КонецЦикла;
	Возврат Новый Структура("ИдентификаторСтенда,ИдентификаторНабора,ТипСтраниц,ФактическийРазмерСтраницыБайт,ОбъемРабочегоНабораБайт,РазмещениеПодтверждено,Наблюдения",
		"mem-lab", "tlb-walk-64m", ТипСтраниц, РазмерСтраницы, 67108864, Истина, Наблюдения);
КонецФункции
#КонецОбласти
