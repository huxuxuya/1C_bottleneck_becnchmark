# Auto detect text files and perform LF normalization
* text=auto eol=lf

# 1C XML metadata and BSL modules (UTF-8 with or without BOM; preserve LF in git)
*.bsl text eol=lf
*.xml text eol=lf
*.mdo text eol=lf
*.os  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Binary 1C artifacts (if ever tracked via Git LFS)
*.cf  binary
*.cfe binary
*.epf binary
*.erf binary
*.dt  binary
*.1cd binary
