Процедура Тест_Диагностика_RPHOST_SATURATION() Экспорт

	Результат = БенчмаркДиагностикиBSL.ВыполнитьПоКоду("RPHOST_SATURATION");
	ЮТест.ОжидаетЧто(Результат.Код).Равно("RPHOST_SATURATION");
	ЮТест.ОжидаетЧто(Результат.Статус).Равно("BSL-прокси");
	ЮТест.ОжидаетЧто(Результат.ДлительностьМс).Больше(0);
	ЮТест.ОжидаетЧто(Результат.ЗначениеМетрики).Больше(0);
	ЮТест.ОжидаетЧто(Результат.ЕдиницаИзмерения = "нет").Равно(Ложь);

КонецПроцедуры

