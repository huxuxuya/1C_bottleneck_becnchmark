		"BSL FileStream", "временный файл", 1,
		НомерПовтора, 1, "измерение", 1, Результат.ОбъемБайт, Результат.ДлительностьМс);
	БенчмаркХранилищеПрогонов.СохранитьИтогПоказателя(
		СсылкаНаПрогон, Точка, "file.checksum_sample", "042", "042. Контрольная сумма образца",
		Результат.КонтрольнаяСумма, "байт-сумма", СтатусХранилища, Причина,
		Результат.ДатаНачалаUTC, Результат.ДатаЗавершенияUTC, Результат.КонтрольнаяСумма,
		Параметры + "; " + Результат.Комментарий, Ряд, "сервер 1С",
