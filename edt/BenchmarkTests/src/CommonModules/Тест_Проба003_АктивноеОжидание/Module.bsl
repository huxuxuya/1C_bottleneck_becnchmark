Процедура Тест_Проба003_АктивноеОжидание() Экспорт

	Результат = БенчмаркПроба003АктивноеОжидание.Проба003_АктивноеОжидание(2, 1);

	ЮТест.ОжидаетЧто(Результат.МедианаЗапаздыванияМс).БольшеИлиРавно(0);
	ЮТест.ОжидаетЧто(Результат.МаксимальноеЗапаздываниеМс).БольшеИлиРавно(Результат.МедианаЗапаздыванияМс);
	ЮТест.ОжидаетЧто(Результат.РазрешениеТаймераМс).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Детали).Содержит("не задержка пробуждения");

