#Область ПрограммныйИнтерфейс
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТестовыйНабор("Виртуализация и NUMA")
		.ДобавитьСерверныйТест("Тест_Проба014_УдаленнаяNUMAПамять");
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура Тест_Проба014_УдаленнаяNUMAПамять() Экспорт

	Измерения = СоздатьМатрицуЗадержек();
	Результат = БенчмаркПроба014УдаленнаяNUMAПамять.АнализироватьМатрицу(Измерения);
	Пара01 = НайтиПару(Результат.Матрица, "0", "1");
	Пара10 = НайтиПару(Результат.Матрица, "1", "0");
	ЮТест.ОжидаетЧто(Результат.ЧислоNUMAУзлов).Равно(2);
	ЮТест.ОжидаетЧто(Результат.Матрица.Количество()).Равно(4);
	ЮТест.ОжидаетЧто(Пара01.МедианаНсНаЧтение).Равно(200);
	ЮТест.ОжидаетЧто(Пара01.ЛокальнаяМедианаНсНаЧтение).Равно(100);
	ЮТест.ОжидаетЧто(Пара01.ШтрафПроцентов).Равно(100);
	ЮТест.ОжидаетЧто(Пара10.ШтрафНсНаЧтение).Равно(120);

	Измерения[0].РезидентностьПодтверждена = Ложь;
	ИсключениеВыброшено = Ложь;
	Попытка
		БенчмаркПроба014УдаленнаяNUMAПамять.АнализироватьМатрицу(Измерения);
	Исключение
		ИсключениеВыброшено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(ИсключениеВыброшено).Равно(Истина);

КонецПроцедуры

Функция СоздатьМатрицуЗадержек()

	Измерения = Новый Массив;
	ДобавитьТриЗамера(Измерения, "0", "0", "cpu-node-0", 100);
	ДобавитьТриЗамера(Измерения, "0", "1", "cpu-node-0", 200);
	ДобавитьТриЗамера(Измерения, "1", "0", "cpu-node-1", 240);
	ДобавитьТриЗамера(Измерения, "1", "1", "cpu-node-1", 120);
	Возврат Измерения;

КонецФункции

Процедура ДобавитьТриЗамера(Измерения, УзелCPU, УзелПамяти, ИдентификаторCPU, НсНаЧтение)

	Для Индекс = 0 По 2 Цикл
		СтруктураЗамера = Новый Структура("ИдентификаторСтенда,ИдентификаторНабораДанных,ИдентификаторCPU,УзелCPU,УзелПамяти,ЧислоЧтений,ДлительностьНс,КонтрольнаяСумма,ПривязкаCPUПодтверждена,РезидентностьПодтверждена",
			"numa-lab", "dependent-chain-64mb", ИдентификаторCPU, УзелCPU, УзелПамяти, 1000, (НсНаЧтение + Индекс - 1) * 1000, 707, Истина, Истина);
		Измерения.Добавить(СтруктураЗамера);
	КонецЦикла;

КонецПроцедуры

Функция НайтиПару(Матрица, УзелCPU, УзелПамяти)

	Для Каждого СтрокаРезультата Из Матрица Цикл
		Если СтрокаРезультата.УзелCPU = УзелCPU И СтрокаРезультата.УзелПамяти = УзелПамяти Тогда
			Возврат СтрокаРезультата;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Пара NUMA не найдена";

КонецФункции
#КонецОбласти
