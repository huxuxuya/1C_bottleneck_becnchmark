#Область ПрограммныйИнтерфейс

// Сравнивает одну и две арифметические цепочки, чередуемые в одном потоке BSL.
// Параметры:
//  ЧислоОпераций - Число - общее число арифметических обновлений (не менее 2).
// Возвращаемое значение:
//  Структура: длительность одного и двух вариантов, их отношение,
//  контрольная сумма и пояснение методики.
Функция Проба006_ПараллельныеЦепочкиВОдномПотоке(Знач ЧислоОпераций = 40000) Экспорт

	Если ЧислоОпераций < 2 Тогда
		ВызватьИсключение "Для Пробы 006 нужно не менее двух операций";
	КонецЕсли;

	ВсегоОпераций = Цел(ЧислоОпераций / 2) * 2;
	ОднаЦепочка = БенчмаркПробыВычисления.ВыполнитьЦепочкиBSL(ВсегоОпераций, 1);
	ДвеЦепочки = БенчмаркПробыВычисления.ВыполнитьЦепочкиBSL(Цел(ВсегоОпераций / 2), 2);

	Результат = Новый Структура;
	Результат.Вставить("ВремяОднойЦепочкиМс", ОднаЦепочка.ДлительностьМс);
	Результат.Вставить("ВремяДвухЦепочекМс", ДвеЦепочки.ДлительностьМс);
	Результат.Вставить("ОтношениеПропускнойСпособности", БенчмаркПробыВычисления.ОтношениеПроизводительности(
		ОднаЦепочка.ДлительностьМс, ДвеЦепочки.ДлительностьМс));
	Результат.Вставить("КонтрольнаяСумма", ОднаЦепочка.КонтрольнаяСумма + ДвеЦепочки.КонтрольнаяСумма);
	Результат.Вставить("Детали", "Цепочки чередуются в одном потоке BSL; конкуренция SMT не создается");
	Возврат Результат;

КонецФункции

#КонецОбласти
