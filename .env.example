# Версия платформы 1С
ONEC_VERSION=8.3.25.1286

# Целевая платформа Docker (для Apple Silicon указывайте linux/amd64, если бинарники 1С под amd64)
DOCKER_PLATFORM=linux/amd64

# Этап 0 (edt-export): образ с установленной 1C:EDT CLI (1cedtcli / ring)
ONEC_EDT_IMAGE=onec-benchmark-edt:latest
EDT_VMARGS=-Xmx4g

# Вариант 1 (ibcmd): базовый образ с установленными ibcmd / платформой 1С
# Можно указать ваш локально собранный образ (например, cluster-lic-1c:8.5.1.1529)
# или собрать из .deb пакетов через docker/1c-ibcmd/Dockerfile
ONEC_IBCMD_IMAGE=onec-benchmark-ibcmd:latest

# Вариант 2 (postgres + server): образы сервера 1С и PostgreSQL для 1С
ONEC_SERVER_IMAGE=onec-benchmark-server:latest
POSTGRES_1C_IMAGE=postgres:16-bookworm

# Параметры информационной базы
IB_USER=Администратор
IB_PASSWORD=
PG_HOST=postgres
PG_PORT=5432
# Тестовую PG_DB создаёт ibcmd; Compose запускает PostgreSQL со служебной БД postgres.
PG_DB=benchmark_ib
PG_USER=postgres
PG_PASSWORD=postgres

# Версия YAxUnit (скачивается в build/deps/YAxUnit.cfe при сборке)
YAXUNIT_VERSION=25.04
